{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-team-production-contract-manifest-3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_id",
    "schema_version",
    "contract_id",
    "interface_schema_ids",
    "registry_schema_id",
    "eval_schema_ids",
    "activation_policy",
    "skill_ids",
    "authoring_seed_edges",
    "skills"
  ],
  "properties": {
    "$schema": {"const": "../schemas/production-contract-manifest-3.0.schema.json"},
    "schema_id": {"const": "guru-team-production-contract-manifest-3.0"},
    "schema_version": {"const": "3.0"},
    "contract_id": {"const": "production-current-v3"},
    "interface_schema_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["guru-team-skill-interface-1.4", "guru-team-skill-interface-1.5"]}
    },
    "registry_schema_id": {"const": "guru-team-skill-registry-1.4"},
    "eval_schema_ids": {
      "const": ["guru-team-skill-evals-1.0", "guru-team-skill-evals-2.0"]
    },
    "activation_policy": {"const": "preset_transaction"},
    "skill_ids": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/skillId"}
    },
    "authoring_seed_edges": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/authoringSeedEdge"}
    },
    "skills": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/skill"}
    }
  },
  "$defs": {
    "localId": {"type": "string", "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"},
    "skillId": {"type": "string", "pattern": "^guru-[a-z0-9]+(?:-[a-z0-9]+)+$"},
    "authoringSeedEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_skill_id",
        "exit_id",
        "consumer_skill_id",
        "profile_id",
        "consumer_input_id",
        "projection_id",
        "authoring_example_id"
      ],
      "properties": {
        "producer_skill_id": {"$ref": "#/$defs/skillId"},
        "exit_id": {"$ref": "#/$defs/localId"},
        "consumer_skill_id": {"$ref": "#/$defs/skillId"},
        "profile_id": {"$ref": "#/$defs/localId"},
        "consumer_input_id": {"$ref": "#/$defs/localId"},
        "projection_id": {"$ref": "#/$defs/localId"},
        "authoring_example_id": {"$ref": "#/$defs/localId"}
      }
    },
    "evalCaseSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_case_count"],
      "properties": {
        "input_profile_id": {"$ref": "#/$defs/localId"},
        "expected_exit": {"$ref": "#/$defs/localId"},
        "scenario_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["rejected", "legitimate"]}
        },
        "pressure_framings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "neutral",
              "attack_security",
              "severity",
              "independent_reviewer",
              "already_implemented",
              "already_tested",
              "best_practice",
              "theoretical_bypass"
            ]
          }
        },
        "expected_case_count": {"type": "integer", "minimum": 0}
      }
    },
    "exitBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_id",
        "output_schema_id",
        "output_example_id",
        "consumer_input_id",
        "projection_id"
      ],
      "properties": {
        "exit_id": {"$ref": "#/$defs/localId"},
        "output_schema_id": {"type": "string", "minLength": 1},
        "output_example_id": {"$ref": "#/$defs/localId"},
        "consumer_input_id": {"$ref": "#/$defs/localId"},
        "projection_id": {"$ref": "#/$defs/localId"},
        "eval_case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/localId"}
        },
        "eval_case_selector": {"$ref": "#/$defs/evalCaseSelector"}
      },
      "oneOf": [
        {"required": ["eval_case_ids"]},
        {"required": ["eval_case_selector"]}
      ]
    },
    "profileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/localId"},
        "eval_case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/localId"}
        },
        "eval_case_selector": {"$ref": "#/$defs/evalCaseSelector"}
      },
      "oneOf": [
        {"required": ["eval_case_ids"]},
        {"required": ["eval_case_selector"]}
      ]
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "interface_schema_id",
        "eval_schema_id",
        "input_kind",
        "input_profile_ids",
        "profile_case_bindings",
        "exit_bindings",
        "private_artifact_ids",
        "eval_case_selector"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/skillId"},
        "interface_schema_id": {
          "enum": ["guru-team-skill-interface-1.4", "guru-team-skill-interface-1.5"]
        },
        "eval_schema_id": {
          "enum": ["guru-team-skill-evals-1.0", "guru-team-skill-evals-2.0"]
        },
        "input_kind": {"const": "structured_json"},
        "input_profile_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/localId"}
        },
        "profile_case_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/profileBinding"}
        },
        "exit_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/exitBinding"}
        },
        "private_artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/localId"}
        },
        "eval_case_selector": {"$ref": "#/$defs/evalCaseSelector"},
        "production_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_id", "fresh_invocations_per_case", "required_passes_per_case"],
          "properties": {
            "model_id": {"const": "gpt-5.6-sol"},
            "fresh_invocations_per_case": {"const": 5},
            "required_passes_per_case": {"const": 5}
          }
        }
      }
    }
  }
}
