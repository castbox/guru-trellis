{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-team-skill-eval-adapter-request-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "adapter_id", "platform", "skill_id", "package_root",
    "interface", "case_id", "prompt", "files", "workdir", "corpus_path",
    "corpus_sha256", "matrix_sha256", "package_sha256", "model_id",
    "invocation_index", "fresh_invocations_per_case", "runtime_target"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "adapter_id": {"const": "codex"},
    "platform": {"const": "codex"},
    "skill_id": {"const": "guru-qualify-normal-scenario"},
    "package_root": {"type": "string", "minLength": 1},
    "interface": {"type": "object"},
    "case_id": {"type": "string", "minLength": 1},
    "prompt": {"type": "string", "minLength": 1},
    "files": {"type": "array", "items": {"type": "string"}},
    "workdir": {"type": "string", "minLength": 1},
    "corpus_path": {"type": "string", "minLength": 1},
    "corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "matrix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_id": {"const": "gpt-5.6-sol"},
    "invocation_index": {"type": "integer", "minimum": 1, "maximum": 5},
    "fresh_invocations_per_case": {"const": 5},
    "runtime_target": {"type": "string", "minLength": 1}
  }
}
