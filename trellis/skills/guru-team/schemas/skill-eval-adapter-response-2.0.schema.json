{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-team-skill-eval-adapter-response-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "capability_status", "corpus_sha256", "matrix_sha256",
    "package_sha256", "prompt_sha256", "model_id", "invocation_index",
    "public_stdout", "public_stderr", "trace_events", "transcript_locator",
    "native_trace_locator", "timing_ms"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "capability_status": {"enum": ["executed", "unsupported", "execution_error"]},
    "corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "matrix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_id": {"const": "gpt-5.6-sol"},
    "invocation_index": {"type": "integer", "minimum": 1, "maximum": 5},
    "public_stdout": {"type": "string"},
    "public_stderr": {"type": "string"},
    "trace_events": {
      "type": "array",
      "items": {
        "enum": ["public_invocation", "evals_not_loaded", "private_runtime_not_read"]
      }
    },
    "transcript_locator": {"type": "string", "minLength": 1},
    "native_trace_locator": {"type": "string", "minLength": 1},
    "timing_ms": {"type": "integer", "minimum": 0}
  }
}
