{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-team-skill-evals-1.0",
  "schema_version": "1.0",
  "skill_name": "guru-select-workflow-mode",
  "evals": [
    {
      "id": "explicit-task-free",
      "prompt": "The user says `这次走 task-free`. Select the mode directly without another mode question.",
      "expected_exit": "task_free",
      "expected_output": "The bounded current-checkout route is selected.",
      "input_profile_id": "initial_request",
      "files": [
        "evals/files/eval-public-input.json",
        "evals/files/eval-explicit-task-free-facts.json"
      ],
      "assertions": {
        "deterministic": [
          {
            "id": "expected-route",
            "kind": "json_path",
            "pointer": "/exit_id",
            "operation": "equals",
            "expected": "task_free"
          },
          {
            "id": "public-only",
            "kind": "trace",
            "invariant": "public_invocation_only"
          },
          {
            "id": "evals-not-loaded",
            "kind": "trace",
            "invariant": "evals_not_loaded_by_skill"
          },
          {
            "id": "private-runtime-not-read",
            "kind": "trace",
            "invariant": "private_runtime_not_read_by_agent"
          }
        ]
      }
    },
    {
      "id": "automatic-high-confidence",
      "prompt": "A no-Issue request identifies one reversible Markdown typo with no runtime or public-contract effect. Select without asking.",
      "expected_exit": "task_free",
      "expected_output": "High-confidence bounded low-risk work automatically selects task-free.",
      "input_profile_id": "initial_request",
      "files": [
        "evals/files/eval-public-input.json",
        "evals/files/eval-automatic-high-confidence-facts.json"
      ],
      "assertions": {
        "deterministic": [
          {
            "id": "expected-route",
            "kind": "json_path",
            "pointer": "/exit_id",
            "operation": "equals",
            "expected": "task_free"
          }
        ]
      }
    },
    {
      "id": "insufficient-confirmed",
      "prompt": "Task-free is likely but scope evidence was insufficient. The single mode question was answered affirmatively; do not ask again.",
      "expected_exit": "task_free",
      "expected_output": "One affirmative clarification selects task-free.",
      "input_profile_id": "initial_request",
      "files": [
        "evals/files/eval-public-input.json",
        "evals/files/eval-insufficient-confirmed-facts.json"
      ],
      "assertions": {
