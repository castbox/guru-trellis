{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-finish-task-closure-result-snapshot-2.0",
  "type": "object", "additionalProperties": false,
  "required": ["result_ref", "terminal", "action_set"],
  "properties": {
    "result_ref": {"type": "object", "additionalProperties": false, "required": ["task_id", "lifecycle_generation", "result_id"], "properties": {"task_id": {"type": "string", "minLength": 1}, "lifecycle_generation": {"type": "integer", "minimum": 0}, "result_id": {"type": "string", "minLength": 1}}},
    "terminal": {"enum": ["closed", "no_mutation"]},
    "action_set": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["issue_ref", "disposition"], "properties": {"issue_ref": {"type": "object", "additionalProperties": false, "required": ["repo_ref", "issue_number"], "properties": {"repo_ref": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}, "issue_number": {"type": "integer", "minimum": 1}}}, "disposition": {"enum": ["close", "already_closed_at_review", "no_close_authority"]}}}}
  }
}
