{
  "schema_version": "1.1",
  "package_id": "guru-approve-task-plan",
  "commands": [
    {
      "id": "resolve-planning-artifacts",
      "owner": "guru-approve-task-plan",
      "entrypoint": "runtime/check.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root or a path below it.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--task",
          "required": false,
          "kind": "string",
          "description": "Task directory, task-relative path, or task slug.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--delivery-key",
          "required": true,
          "kind": "json",
          "description": "Exact public DeliveryKey for its own planning_root. Accepts inline JSON, one regular UTF-8 JSON file, or dash for stdin; nonregular carriers including process substitution are unsupported.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "none",
      "stdout": "intermediate_receipt",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "unsafe_path",
        "internal_error"
      ],
      "side_effect": "repo_read",
      "schema_bindings": [],
      "validator_id": "planning_artifact_resolver",
      "runtime_role": "check"
    },
    {
      "id": "record-planning-approval",
      "owner": "guru-approve-task-plan",
      "entrypoint": "runtime/record.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--task",
          "required": false,
          "kind": "string",
          "description": "Task locator.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--input",
          "required": true,
          "kind": "string",
          "description": "AI review JSON locator.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--dry-run",
          "required": false,
          "kind": "boolean",
          "description": "Validate without persistence.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--delivery-key",
          "required": true,
          "kind": "json",
          "description": "Exact public DeliveryKey for its own planning_root. Accepts inline JSON, one regular UTF-8 JSON file, or dash for stdin; nonregular carriers including process substitution are unsupported.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "none",
      "stdout": "intermediate_receipt",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "runtime_write",
      "schema_bindings": [],
      "validator_id": "planning_approval_recorder",
      "runtime_role": "record"
    },
    {
      "id": "check-planning-approval",
      "owner": "guru-approve-task-plan",
      "entrypoint": "runtime/check.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--task",
          "required": false,
          "kind": "string",
          "description": "Task locator.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--require-exit",
          "required": false,
          "kind": "enum",
          "values": [
            "approved",
            "revision_required",
            "clarify_scope",
            "blocked"
          ],
          "description": "Required typed exit.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--delivery-key",
          "required": true,
          "kind": "json",
          "description": "Exact public DeliveryKey for its own planning_root. Accepts inline JSON, one regular UTF-8 JSON file, or dash for stdin; nonregular carriers including process substitution are unsupported.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "none",
      "stdout": "intermediate_receipt",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "git_read",
      "schema_bindings": [],
      "validator_id": "planning_approval_checker",
      "runtime_role": "check"
    },
    {
      "id": "invoke-guru-approve-task-plan",
      "owner": "guru-approve-task-plan",
      "entrypoint": "runtime/invoke.py",
      "arguments": [
        {
          "flag": "--invocation",
          "required": false,
          "kind": "json",
          "description": "Call-local invocation envelope or dash for stdin.",
          "repeatable": false,
          "conflicts": [
            "--input",
            "--owner-result"
          ]
        },
        {
          "flag": "--input",
          "required": false,
          "kind": "string",
          "description": "Public input JSON locator.",
          "repeatable": false,
          "conflicts": [
            "--invocation"
          ]
        },
        {
          "flag": "--owner-result",
          "required": false,
          "kind": "string",
          "description": "Completed owner result JSON locator.",
          "repeatable": false,
          "conflicts": [
            "--invocation"
          ]
        }
      ],
      "stdin": "optional_json",
      "stdout": "single_typed_exit",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "runtime_write",
      "schema_bindings": [],
      "validator_id": "public_invocation",
      "runtime_role": "invoke"
    },
    {
      "id": "legacy-maintenance-guru-approve-task-plan",
      "owner": "guru-approve-task-plan",
      "entrypoint": "runtime/recover.py",
      "arguments": [
        {
          "flag": "--root",
          "required": true,
          "kind": "string",
          "description": "Explicit legacy target.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--input",
          "required": true,
          "kind": "json",
          "description": "Separate original-owner legacy input.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "optional_json",
      "stdout": "intermediate_receipt",
      "errors": [
        "schema_mismatch",
        "invalid_arguments",
        "invalid_json",
        "internal_error"
      ],
      "side_effect": "repo_write",
      "schema_bindings": [
        "schemas/legacy-maintenance-input-1.0.schema.json"
      ],
      "validator_id": "legacy_maintenance",
      "runtime_role": "recover"
    }
  ]
}
