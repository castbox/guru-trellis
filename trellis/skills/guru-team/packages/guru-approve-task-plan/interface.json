{
  "$schema": "../../schemas/skill-interface-1.4.schema.json",
  "schema_version": "1.4",
  "id": "guru-approve-task-plan",
  "name": "guru-approve-task-plan",
  "description": "Approve current task planning through one AI-owned semantic review, compact private evidence, and four minimal typed exits.",
  "state": "active",
  "judgment_mode": "semantic",
  "modes": {
    "workflow": {
      "routing": "global_workflow",
      "entry_precondition_ids": [
        "runtime_dependency",
        "task_checkout",
        "current_authority",
        "planning_documents",
        "docs_ssot",
        "wording_result",
        "invocation_freshness"
      ]
    },
    "standalone": {
      "routing": "direct_discovery",
      "entry_precondition_ids": [
        "runtime_dependency",
        "task_checkout",
        "current_authority",
        "planning_documents",
        "docs_ssot",
        "wording_result",
        "invocation_freshness"
      ]
    }
  },
  "entry_preconditions": [
    {
      "id": "runtime_dependency",
      "evidence": "installed extension manifest, dispatcher, active package inventory, schema, and declared recorder/checker commands",
      "binding": "complete compatible Guru Team preset runtime",
      "freshness": "run-skill-command validates the managed runtime before each command"
    },
    {
      "id": "task_checkout",
      "evidence": "active TaskId, task.json, current branch binding, and resolved checkout",
      "binding": "one active task in its resolved repository checkout",
      "freshness": "task identity and checkout resolution are refreshed before record and check"
    },
    {
      "id": "current_authority",
      "evidence": "live issue, selected current comments, user request, and task-local authority references",
      "binding": "the current authority for every load-bearing planning decision",
      "freshness": "the AI rereads live authority before the semantic result"
    },
    {
      "id": "planning_documents",
      "evidence": "current non-empty prd.md, design.md, and implement.md plus their closed Delivery slice policy",
      "binding": "the three planning documents and their task scope, current Delivery slice, remaining work, independent conditions, validation boundaries, and remaining-work owner",
      "freshness": "the AI rereads current files and the validator recomputes one owner-private composite token over the three planning paths"
    },
    {
      "id": "docs_ssot",
      "evidence": "current strategy, durable paths, and semantic execution summary",
      "binding": "the durable documentation responsibility for the task",
      "freshness": "the AI classifies current Docs SSOT meaning before recording"
    },
    {
      "id": "wording_result",
      "evidence": "current passed planning wording result",
      "binding": "the same planning scope consumed by this owner",
      "freshness": "the wording owner is rerun only when its semantic dependency changes"
    },
    {
      "id": "invocation_freshness",
      "evidence": "mode, task, one local composite planning-content token, current semantic result, typed exit, reason, and consumer",
      "binding": "one complete owner round",
      "freshness": "the checker rejects missing, stale, multiple, unknown, or consumer-mismatched results"
    }
  ],
  "runtime_dependency": {
    "extension_id": "guru-team",
    "api_version": "1.0",
    "manifest_path": ".trellis/guru-team/extension.json",
    "dispatcher": "run-skill-command",
    "distribution": "guru-team-preset",
    "package_portability": "not-self-contained"
  },
  "ordered_stages": [
    "forward_behavior",
    "ai_review_gate",
    "conditional_human_confirmation",
    "recorder_validator",
    "typed_exit"
  ],
