{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-consumer-guru-approve-task-plan-revision_required-delivery-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "task_ref",
    "delivery_key",
    "revision_actions"
  ],
  "properties": {
    "exit_id": {
      "const": "revision_required"
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "delivery_key": {
      "type": "object",
      "description": "Opaque upstream DeliveryKey; validated by the installed public API."
    },
    "revision_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
