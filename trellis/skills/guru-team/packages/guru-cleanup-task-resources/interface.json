{
  "$schema": "../../schemas/skill-interface-1.4.schema.json",
  "schema_version": "1.4",
  "id": "guru-cleanup-task-resources",
  "name": "guru-cleanup-task-resources",
  "description": "Clean sealed Guru-owned resources or explicitly selected manual and machine-handoff targets.",
  "state": "active",
  "judgment_mode": "semantic",
  "modes": {
    "workflow": {
      "routing": "global_workflow",
      "entry_precondition_ids": [
        "runtime_dependency",
        "finish_success",
        "owned_resources",
        "cleanup_freshness"
      ]
    },
    "standalone": {
      "routing": "direct_discovery",
      "entry_precondition_ids": [
        "runtime_dependency",
        "finish_success",
        "owned_resources",
        "cleanup_freshness"
      ]
    }
  },
  "entry_preconditions": [
    {
      "id": "runtime_dependency",
      "evidence": "installed cleanup package",
      "binding": "Guru Team preset",
      "freshness": "each call"
    },
    {
      "id": "finish_success",
      "evidence": "current ResourceSealRefDTO or terminal manual/handoff identity",
      "binding": "one finish identity",
      "freshness": "current"
    },
    {
      "id": "owned_resources",
      "evidence": "common-dir resource ledger or exact user-selected manual targets",
      "binding": "this task only",
      "freshness": "fresh discovery"
    },
    {
      "id": "cleanup_freshness",
      "evidence": "current consumers and user resources",
      "binding": "deletion scope",
      "freshness": "before confirmation"
    }
  ],
  "runtime_dependency": {
    "extension_id": "guru-team",
    "api_version": "1.0",
    "manifest_path": ".trellis/guru-team/extension.json",
    "dispatcher": "run-skill-command",
    "distribution": "guru-team-preset",
    "package_portability": "not-self-contained"
  },
  "ordered_stages": [
    "forward_behavior",
    "ai_review_gate",
    "conditional_human_confirmation",
    "recorder_validator",
    "typed_exit"
  ],
  "artifacts": [
    {
      "id": "input",
      "path": "examples/public-input.json"
    },
    {
      "id": "semantic_result",
      "path": "examples/semantic-result.json"
    },
    {
      "id": "cleaned_output",
      "path": "examples/public-output.json"
    },
    {
      "id": "remaining_resources_output",
      "path": "examples/public-remaining-resources-output.json"
    },
    {
      "id": "blocked_output",
      "path": "examples/public-blocked-output.json"
    },
    {
      "id": "self_authoring",
      "path": "examples/self-authoring.json"
    },
    {"id": "manual_input", "path": "examples/public-manual-input.json"},
    {"id": "handoff_input", "path": "examples/public-handoff-input.json"},
    {"id": "manual_selection_output", "path": "examples/public-manual-selection-output.json"},
    {"id": "manual_authoring", "path": "examples/manual-authoring.json"},
    {"id": "handoff_complete_output", "path": "examples/public-handoff-complete-output.json"},
    {"id": "handoff_remaining_output", "path": "examples/public-handoff-remaining-output.json"},
    {"id": "handoff_authoring", "path": "examples/handoff-authoring.json"}
  ],
  "schemas": [
    {
      "id": "public_input",
      "path": "schemas/public-input.schema.json"
    },
    {
      "id": "semantic_result",
      "path": "schemas/semantic-result.schema.json"
    },
    {
      "id": "public_output",
      "path": "schemas/public-output.schema.json"
    },
    {
      "id": "cleaned_output",
      "path": "schemas/public-cleaned-output.schema.json"
    },
    {
      "id": "remaining_resources_output",
      "path": "schemas/public-remaining-resources-output.schema.json"
    },
    {
      "id": "blocked_output",
      "path": "schemas/public-blocked-output.schema.json"
    },
    {"id": "manual_selection_output", "path": "schemas/public-manual-selection-output.schema.json"},
    {"id": "handoff_complete_output", "path": "schemas/public-handoff-complete-output.schema.json"},
    {"id": "handoff_remaining_output", "path": "schemas/public-handoff-remaining-output.schema.json"}
  ],
  "validators": [
    {
      "id": "public_invocation",
      "command": "scripts/invoke.sh",
      "runtime_command": "invoke-guru-cleanup-task-resources",
      "objective_scope": "Validate current Finish identity and cleanup scope."
    }
  ],
  "external_exits": [
    {
      "id": "cleaned",
      "evidence": "the reviewed resource set was durably resolved and its Cleanup result recorded",
      "consumer": {
        "kind": "stop",
        "id": "task-cleanup-complete"
      }
    },
    {
      "id": "remaining_resources",
      "evidence": "confirmation or deletion remains pending",
      "consumer": {
        "kind": "skill",
        "id": "guru-cleanup-task-resources"
      }
    },
    {
      "id": "blocked",
      "evidence": "resource ownership is ambiguous",
      "consumer": {
        "kind": "stop",
        "id": "task-cleanup-blocked"
      }
    },
    {"id": "manual_selection_required", "evidence": "terminal ownership missing or selected manual targets await confirmation", "consumer": {"kind": "skill", "id": "guru-cleanup-task-resources"}},
    {"id": "handoff_cleanup_complete", "evidence": "the exact source handoff inventory was resolved and its result recorded", "consumer": {"kind": "stop", "id": "task-handoff-cleanup-await-destination"}},
    {"id": "handoff_cleanup_remaining", "evidence": "the exact source handoff inventory still needs confirmation or deletion", "consumer": {"kind": "skill", "id": "guru-cleanup-task-resources"}}
  ],
  "reentry": {
    "identity": "TaskId, generation, sealed Finish result and ledger inventory",
    "freshness": "resolve current ledger and revalidate every target before deletion",
    "stale_behavior": "fail_closed"
  },
  "tests": [
    "tests/test_cleanup_contract.py"
  ],
  "platform_destinations": [
    "shared",
    "claude",
    "cursor",
    "opencode",
    "codex",
    "kilo",
    "kiro",
    "gemini",
    "antigravity",
    "devin",
    "qoder",
    "codebuddy",
    "copilot",
    "droid",
    "dsh",
    "pi",
    "reasonix",
    "zcode",
    "trae",
    "omp",
    "grok",
    "kimi",
    "snow"
  ],
  "public_contracts": {
    "input": {
      "kind": "structured_json",
      "aggregate_schema": {
        "schema_id": "guru-cleanup-task-resources-input-2.0",
        "path": "schemas/public-input.schema.json"
      },
      "profiles": [
        {
          "id": "normal",
          "schema": {
            "schema_id": "guru-cleanup-task-resources-input-2.0",
            "path": "schemas/public-input.schema.json"
          },
          "example": {
            "id": "input",
            "path": "examples/public-input.json"
          },
          "discriminator": {
            "field": "profile",
            "value": "normal"
          }
        },
        {"id": "manual", "schema": {"schema_id": "guru-cleanup-task-resources-input-2.0", "path": "schemas/public-input.schema.json"}, "example": {"id": "manual_input", "path": "examples/public-manual-input.json"}, "discriminator": {"field": "profile", "value": "manual"}},
        {"id": "machine_handoff", "schema": {"schema_id": "guru-cleanup-task-resources-input-2.0", "path": "schemas/public-input.schema.json"}, "example": {"id": "handoff_input", "path": "examples/public-handoff-input.json"}, "discriminator": {"field": "profile", "value": "machine_handoff"}}
      ]
    },
    "invocation": {
      "command_id": "run-skill-command",
      "wrapper": "scripts/invoke.sh",
      "input_binding": {
        "kind": "structured_json",
        "profile_id": "normal"
      },
      "stdout_contract": "single_typed_exit",
      "error_schema": {
        "schema_id": "guru-cleanup-task-resources-output-aggregate-2.0",
        "path": "schemas/public-output.schema.json"
      },
      "error_example": {
        "id": "input",
        "path": "examples/public-input.json"
      },
      "example_argv": [
        "--input",
        "examples/public-input.json",
        "--semantic-result",
        "examples/semantic-result.json"
      ]
    },
    "outputs": [
      {
        "exit_id": "cleaned",
        "schema": {
          "schema_id": "guru-cleanup-task-resources-output-cleaned-2.0",
          "path": "schemas/public-cleaned-output.schema.json"
        },
        "example": {
          "id": "cleaned_output",
          "path": "examples/public-output.json"
        },
        "consumer_use_ids": [
          "terminal"
        ]
      },
      {
        "exit_id": "remaining_resources",
        "schema": {
          "schema_id": "guru-cleanup-task-resources-output-remaining-resources-2.0",
          "path": "schemas/public-remaining-resources-output.schema.json"
        },
        "example": {
          "id": "remaining_resources_output",
          "path": "examples/public-remaining-resources-output.json"
        },
        "consumer_use_ids": [
          "self"
        ]
      },
      {
        "exit_id": "blocked",
        "schema": {
          "schema_id": "guru-cleanup-task-resources-output-blocked-2.0",
          "path": "schemas/public-blocked-output.schema.json"
        },
        "example": {
          "id": "blocked_output",
          "path": "examples/public-blocked-output.json"
        },
        "consumer_use_ids": ["blocked"]
      },
      {"exit_id": "manual_selection_required", "schema": {"schema_id": "guru-cleanup-task-resources-output-manual-selection-2.0", "path": "schemas/public-manual-selection-output.schema.json"}, "example": {"id": "manual_selection_output", "path": "examples/public-manual-selection-output.json"}, "consumer_use_ids": ["manual"]},
      {"exit_id": "handoff_cleanup_complete", "schema": {"schema_id": "guru-cleanup-task-resources-output-handoff-complete-2.0", "path": "schemas/public-handoff-complete-output.schema.json"}, "example": {"id": "handoff_complete_output", "path": "examples/public-handoff-complete-output.json"}, "consumer_use_ids": ["handoff_terminal"]},
      {"exit_id": "handoff_cleanup_remaining", "schema": {"schema_id": "guru-cleanup-task-resources-output-handoff-remaining-2.0", "path": "schemas/public-handoff-remaining-output.schema.json"}, "example": {"id": "handoff_remaining_output", "path": "examples/public-handoff-remaining-output.json"}, "consumer_use_ids": ["handoff_self"]}
    ],
    "consumer_inputs": [
      {
        "id": "terminal",
        "consumer": {
          "kind": "stop",
          "id": "task-cleanup-complete"
        },
        "payload_kind": "structured_json",
        "contract": {"kind": "json_schema", "schema_id": "guru-cleanup-task-resources-complete-stop-2.0", "path": "consumers/stop/production/cleanup-complete.schema.json"}
      },
      {
        "id": "self",
        "consumer": {
          "kind": "skill",
          "id": "guru-cleanup-task-resources"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "skill_input_authoring_seed",
          "interface_path": "packages/guru-cleanup-task-resources/interface.json",
          "input_kind": "structured_json",
          "profile_id": "normal",
          "seed_fields": [
            "task_id", "lifecycle_generation", "finish_result_id"
          ],
          "authoring_fields": [
            "profile", "mode", "inventory_id"
          ],
          "authoring_example": {
            "id": "self_authoring",
            "path": "examples/self-authoring.json"
          }
        }
      },
      {
        "id": "blocked",
        "consumer": {
          "kind": "stop",
          "id": "task-cleanup-blocked"
        },
        "payload_kind": "structured_json",
        "contract": {"kind": "json_schema", "schema_id": "guru-cleanup-task-resources-blocked-stop-2.0", "path": "consumers/stop/production/cleanup-blocked.schema.json"}
      },
      {"id": "manual", "consumer": {"kind": "skill", "id": "guru-cleanup-task-resources"}, "payload_kind": "structured_json", "contract": {"kind": "skill_input_authoring_seed", "interface_path": "packages/guru-cleanup-task-resources/interface.json", "input_kind": "structured_json", "profile_id": "manual", "seed_fields": ["task_id", "lifecycle_generation", "finish_result_id"], "authoring_fields": ["profile", "mode", "cleanup_state", "selected_targets"], "authoring_example": {"id": "manual_authoring", "path": "examples/manual-authoring.json"}}},
      {"id": "handoff_terminal", "consumer": {"kind": "stop", "id": "task-handoff-cleanup-await-destination"}, "payload_kind": "structured_json", "contract": {"kind": "json_schema", "schema_id": "guru-cleanup-task-resources-handoff-await-destination-2.0", "path": "consumers/stop/production/handoff-await-destination.schema.json"}},
      {"id": "handoff_self", "consumer": {"kind": "skill", "id": "guru-cleanup-task-resources"}, "payload_kind": "structured_json", "contract": {"kind": "skill_input_authoring_seed", "interface_path": "packages/guru-cleanup-task-resources/interface.json", "input_kind": "structured_json", "profile_id": "machine_handoff", "seed_fields": ["task_id", "lifecycle_generation", "handoff_inventory"], "authoring_fields": ["profile", "mode"], "authoring_example": {"id": "handoff_authoring", "path": "examples/handoff-authoring.json"}}}
    ],
    "projections": [
      {
        "id": "terminal",
        "exit_id": "cleaned",
        "consumer_input_id": "terminal",
        "operation": "direct"
      },
      {
        "id": "self",
        "exit_id": "remaining_resources",
        "consumer_input_id": "self",
        "operation": "select",
        "mappings": [
          {"source": "task_id", "target": "task_id"},
          {"source": "lifecycle_generation", "target": "lifecycle_generation"},
          {"source": "finish_result_id", "target": "finish_result_id"}
        ]
      },
      {
        "id": "blocked",
        "exit_id": "blocked",
        "consumer_input_id": "blocked",
        "operation": "direct"
      },
      {"id": "manual", "exit_id": "manual_selection_required", "consumer_input_id": "manual", "operation": "select", "mappings": [{"source": "task_id", "target": "task_id"}, {"source": "lifecycle_generation", "target": "lifecycle_generation"}, {"source": "finish_result_id", "target": "finish_result_id"}]},
      {"id": "handoff_terminal", "exit_id": "handoff_cleanup_complete", "consumer_input_id": "handoff_terminal", "operation": "direct"},
      {"id": "handoff_self", "exit_id": "handoff_cleanup_remaining", "consumer_input_id": "handoff_self", "operation": "select", "mappings": [{"source": "task_id", "target": "task_id"}, {"source": "lifecycle_generation", "target": "lifecycle_generation"}, {"source": "handoff_inventory", "target": "handoff_inventory"}]}
    ],
    "private_artifacts": []
  }
}
