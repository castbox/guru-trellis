{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-ensure-task-checkout-semantic-result-1.0",
  "oneOf": [{"$ref": "#/$defs/ready"}, {"$ref": "#/$defs/resume"}, {"$ref": "#/$defs/blocked"}],
  "$defs": {
    "taskId": {"type": "string", "pattern": "^(?!.*\\.\\.)(?!.*(?:\\.lock|\\.)$)[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "taskRef": {"type": "string", "pattern": "^\\.trellis/tasks/(?!archive(?:/|$))(?!\\.{1,2}$)[^/\\\\]+$|^\\.trellis/tasks/archive/[0-9]{4}-[0-9]{2}/(?!\\.{1,2}$)[^/\\\\]+$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "taskArtifact": {"type": "object", "additionalProperties": false, "required": ["task_id", "task_ref", "lifecycle_generation"], "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "lifecycle_generation": {"type": "integer", "minimum": 0}}},
    "branchBinding": {"type": "object", "additionalProperties": false, "required": ["task_id", "lifecycle_generation", "binding_epoch", "binding_revision"], "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "lifecycle_generation": {"type": "integer", "minimum": 0}, "binding_epoch": {"type": "integer", "minimum": 0}, "binding_revision": {"type": "integer", "minimum": 0}}},
    "result": {"type": "object", "additionalProperties": false, "required": ["task_id", "lifecycle_generation", "result_id"], "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "lifecycle_generation": {"type": "integer", "minimum": 0}, "result_id": {"$ref": "#/$defs/identifier"}}},
    "transaction": {"type": "object", "additionalProperties": false, "required": ["task_id", "lifecycle_generation", "transaction_id", "result_id"], "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "lifecycle_generation": {"type": "integer", "minimum": 0}, "transaction_id": {"$ref": "#/$defs/identifier"}, "result_id": {"$ref": "#/$defs/identifier"}}},
    "reason": {"type": "object", "additionalProperties": false, "required": ["reason_code", "reason_refs"], "properties": {"reason_code": {"$ref": "#/$defs/identifier"}, "reason_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "ready": {"type": "object", "additionalProperties": false, "required": ["typed_exit", "task_artifact", "branch_binding_ref", "result_ref"], "properties": {"typed_exit": {"const": "checkout_ready"}, "task_artifact": {"$ref": "#/$defs/taskArtifact"}, "branch_binding_ref": {"$ref": "#/$defs/branchBinding"}, "result_ref": {"$ref": "#/$defs/result"}}},
    "resume": {"type": "object", "additionalProperties": false, "required": ["typed_exit", "transaction_ref", "reason"], "properties": {"typed_exit": {"const": "resume_checkout_acquisition"}, "transaction_ref": {"$ref": "#/$defs/transaction"}, "reason": {"$ref": "#/$defs/reason"}}},
    "blocked": {"type": "object", "additionalProperties": false, "required": ["typed_exit", "reason"], "properties": {"typed_exit": {"const": "blocked"}, "reason": {"$ref": "#/$defs/reason"}}}
  }
}
