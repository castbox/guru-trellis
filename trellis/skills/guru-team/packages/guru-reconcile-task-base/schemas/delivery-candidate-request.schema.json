{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-reconcile-task-base-candidate-request-2.0-delivery-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_head",
    "new_base_head",
    "validation_commands"
  ],
  "properties": {
    "task_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "new_base_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "validation_commands": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "resolved_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage0_tree",
        "integration_paths"
      ],
      "properties": {
        "stage0_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "integration_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
