{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-reconcile-task-base-pair-guard-result-2.0-delivery-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "task_ref",
    "task_head",
    "old_base_head",
    "new_base_head",
    "resume_target",
    "typed_output",
    "delivery_key"
  ],
  "properties": {
    "status": {
      "enum": [
        "unchanged",
        "current_pair",
        "new_pair",
        "blocked"
      ]
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "task_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "old_base_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "new_base_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "resume_target": {
      "enum": [
        "delivery_activation",
        "task_commit",
        "branch_review",
        "publication_review",
        "delivery_publication",
        "finalization_resume"
      ]
    },
    "typed_output": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "delivery-public-reconciled-output.schema.json"
        },
        {
          "$ref": "delivery-public-review-continuity-required-output.schema.json"
        },
        {
          "$ref": "delivery-public-implementation-required-output.schema.json"
        },
        {
          "$ref": "delivery-public-planning-stale-output.schema.json"
        },
        {
          "$ref": "delivery-public-scope-confirmation-required-output.schema.json"
        },
        {
          "$ref": "delivery-public-blocked-output.schema.json"
        }
      ]
    },
    "delivery_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "lifecycle_generation",
        "delivery_id"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle_generation": {
          "type": "integer",
          "minimum": 0
        },
        "delivery_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "current_pair"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "typed_output": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "unchanged",
              "new_pair",
              "blocked"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "typed_output": {
            "type": "null"
          }
        }
      }
    }
  ]
}
