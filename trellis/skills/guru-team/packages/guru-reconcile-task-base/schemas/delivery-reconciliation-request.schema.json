{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-reconcile-task-base-reconciliation-request-1.0-delivery-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "task_ref",
    "branch",
    "prior_task_head",
    "selected_base_ref",
    "old_base_head",
    "new_base_head",
    "resume_target",
    "candidate_tree_sha256",
    "commit_message",
    "delivery_key"
  ],
  "properties": {
    "profile": {
      "enum": [
        "delivery_post_plan",
        "delivery_post_check",
        "delivery_post_commit",
        "delivery_post_branch_review",
        "delivery_post_publication",
        "delivery_finalizer_base_mismatch"
      ]
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "prior_task_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "selected_base_ref": {
      "type": "string",
      "minLength": 1
    },
    "old_base_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "new_base_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "resume_target": {
      "enum": [
        "delivery_activation",
        "task_commit",
        "branch_review",
        "publication_review",
        "delivery_publication",
        "finalization_resume"
      ]
    },
    "branch_review_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_tree_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit_message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\r\\n]+$"
    },
    "delivery_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "lifecycle_generation",
        "delivery_id"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle_generation": {
          "type": "integer",
          "minimum": 0
        },
        "delivery_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "resolved_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage0_tree",
        "integration_paths"
      ],
      "properties": {
        "stage0_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "integration_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "enum": [
              "delivery_post_branch_review",
              "delivery_post_publication",
              "delivery_finalizer_base_mismatch"
            ]
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "required": [
          "branch_review_commit"
        ]
      },
      "else": {
        "not": {
          "required": [
            "branch_review_commit"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "resolved_candidate"
        ]
      },
      "then": {
        "properties": {
          "profile": {
            "const": "delivery_post_plan"
          },
          "resume_target": {
            "const": "delivery_activation"
          }
        }
      }
    }
  ]
}
