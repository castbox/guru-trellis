{
  "schema_version": "1.0",
  "package_id": "guru-create-task-commit",
  "commands": [
    {
      "id": "prepare-task-commit",
      "owner": "guru-create-task-commit",
      "entrypoint": "runtime/record.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root."
        },
        {
          "flag": "--input",
          "required": true,
          "kind": "string",
          "description": "Public commit input JSON locator."
        },
        {
          "flag": "--candidate-json",
          "required": true,
          "kind": "string",
          "description": "AI-authored candidate JSON locator."
        }
      ],
      "stdin": "none",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "runtime_write",
      "schema_bindings": [],
      "validator_id": "candidate_builder"
    },
    {
      "id": "check-commit-messages",
      "owner": "guru-create-task-commit",
      "entrypoint": "runtime/check.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root."
        },
        {
          "flag": "--task",
          "required": false,
          "kind": "string",
          "description": "Task locator."
        },
        {
          "flag": "--candidate-artifact",
          "required": false,
          "kind": "string",
          "description": "Prepared candidate locator."
        }
      ],
      "stdin": "none",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "git_read",
      "schema_bindings": [],
      "validator_id": "candidate_validator"
    },
    {
      "id": "create-task-commit",
      "owner": "guru-create-task-commit",
      "entrypoint": "runtime/execute.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root."
        },
        {
          "flag": "--task",
          "required": false,
          "kind": "string",
          "description": "Task locator."
        },
        {
          "flag": "--candidate-artifact",
          "required": true,
          "kind": "string",
          "description": "Prepared candidate locator."
        }
      ],
      "stdin": "none",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "git_write",
      "schema_bindings": [],
      "validator_id": "exact_executor"
    },
    {
      "id": "invoke-stage0-skill",
      "owner": "guru-create-task-commit",
      "entrypoint": "runtime/invoke.py",
      "arguments": [
        {
          "flag": "--invocation",
          "required": false,
          "kind": "json",
          "description": "Call-local invocation envelope or dash for stdin."
        },
        {
          "flag": "--input",
          "required": false,
          "kind": "string",
          "description": "Public input JSON locator."
        },
        {
          "flag": "--owner-result",
          "required": false,
          "kind": "string",
          "description": "Completed owner result JSON locator."
        }
      ],
      "stdin": "optional_json",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "git_write",
      "schema_bindings": [],
      "validator_id": "public_invocation"
    }
  ]
}
