{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/castbox/guru-trellis/schemas/guru-task-commit-candidate-3.0.json",
  "title": "Guru Team owner-private task commit candidate",
  "description": "Short-lived AI-owned candidate. It contains no user authorization, cross-Skill digest authority, or terminal result journal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "skill_id",
    "sequence",
    "task",
    "git",
    "dirty_snapshot",
    "path_classifications",
    "exact_stage_paths",
    "message",
    "ai_review"
  ],
  "properties": {
    "$schema": {"const": "https://github.com/castbox/guru-trellis/schemas/guru-task-commit-candidate-3.0.json"},
    "schema_version": {"const": "3.0"},
    "skill_id": {"const": "guru-create-task-commit"},
    "sequence": {"type": "string", "pattern": "^[0-9]{3}$"},
    "task": {"$ref": "#/$defs/task"},
    "git": {"$ref": "#/$defs/git"},
    "dirty_snapshot": {"$ref": "#/$defs/snapshot"},
    "path_classifications": {
      "type": "array",
      "items": {"$ref": "#/$defs/classification"}
    },
    "exact_stage_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/repoPath"}
    },
    "message": {"$ref": "#/$defs/message"},
    "ai_review": {"$ref": "#/$defs/aiReview"}
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "status", "branch"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/repoPath"},
        "status": {"const": "in_progress"},
        "branch": {"type": "string", "minLength": 1}
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_branch", "base_ref", "pre_commit_head", "phase2_commit_anchor"],
      "properties": {
        "base_branch": {"type": "string", "minLength": 1},
        "base_ref": {"type": "string", "minLength": 1},
        "pre_commit_head": {"$ref": "#/$defs/gitSha"},
        "phase2_commit_anchor": {"$ref": "#/$defs/gitSha"}
      }
    },
    "snapshotEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "index_status",
        "worktree_status",
        "untracked",
        "deleted",
        "renamed_from",
        "copied_from",
        "index_blob",
        "worktree_sha256",
        "mode"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/repoPath"},
        "index_status": {"type": "string", "maxLength": 1},
        "worktree_status": {"type": "string", "maxLength": 1},
        "untracked": {"type": "boolean"},
        "deleted": {"type": "boolean"},
        "renamed_from": {
          "anyOf": [{"type": "null"}, {"$ref": "#/$defs/repoPath"}]
        },
        "copied_from": {
          "anyOf": [{"type": "null"}, {"$ref": "#/$defs/repoPath"}]
        },
        "index_blob": {
          "anyOf": [{"type": "null"}, {"$ref": "#/$defs/gitSha"}]
        },
        "worktree_sha256": {
          "anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
        },
        "mode": {
          "anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-7]{6}$"}]
        },
        "gitlink_head": {
          "anyOf": [{"type": "null"}, {"$ref": "#/$defs/gitSha"}]
        },
        "gitlink_initialized": {
          "anyOf": [{"type": "null"}, {"type": "boolean"}]
        },
        "gitlink_dirty": {
          "anyOf": [{"type": "null"}, {"type": "boolean"}]
        }
      },
      "allOf": [
        {
          "not": {
            "properties": {
              "renamed_from": {"type": "string"},
              "copied_from": {"type": "string"}
            },
            "required": ["renamed_from", "copied_from"]
          }
        },
        {
          "if": {
            "properties": {"mode": {"const": "160000"}, "deleted": {"const": false}},
            "required": ["mode", "deleted"]
          },
          "then": {
            "required": ["gitlink_head", "gitlink_initialized", "gitlink_dirty"],
            "properties": {
              "worktree_sha256": {"type": "null"},
              "gitlink_head": {"$ref": "#/$defs/gitSha"},
              "gitlink_initialized": {"const": true},
              "gitlink_dirty": {"const": false}
            }
          }
        },
        {
          "if": {
            "properties": {"mode": {"const": "160000"}, "deleted": {"const": true}},
            "required": ["mode", "deleted"]
          },
          "then": {
            "required": ["gitlink_head", "gitlink_initialized", "gitlink_dirty"],
            "properties": {
              "worktree_sha256": {"type": "null"},
              "gitlink_head": {"type": "null"},
              "gitlink_initialized": {"const": false},
              "gitlink_dirty": {"type": "null"}
            }
          }
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "entries": {"type": "array", "items": {"$ref": "#/$defs/snapshotEntry"}}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "category", "reason", "coverage_source"],
      "properties": {
        "path": {"$ref": "#/$defs/repoPath"},
        "category": {
          "enum": ["task-reviewed", "unrelated-preserved", "unreviewed-blocking", "ambiguous-blocking"]
        },
        "reason": {"type": "string", "minLength": 1},
        "coverage_source": {"type": "string", "minLength": 1}
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "scope",
        "summary",
        "background",
        "changes",
        "boundaries",
        "validations",
        "subject",
        "body",
        "bytes"
      ],
      "properties": {
        "type": {"enum": ["feat", "fix", "refactor", "perf", "test", "docs", "style", "build", "ci", "chore", "revert"]},
        "scope": {"type": "string", "pattern": "^[a-z0-9._/-]+$"},
        "summary": {"type": "string", "minLength": 1},
        "background": {"type": "string", "minLength": 1},
        "changes": {"type": "string", "minLength": 1},
        "boundaries": {"type": "string", "minLength": 1},
        "validations": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "body": {"type": "string", "minLength": 1},
        "bytes": {"type": "string", "minLength": 1}
      }
    },
    "aiReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "evidence"],
      "properties": {
        "status": {"enum": ["passed", "revision-required", "blocked"]},
        "summary": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
