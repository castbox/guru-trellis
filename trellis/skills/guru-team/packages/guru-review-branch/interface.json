{
  "$schema": "../../schemas/skill-interface-1.4.schema.json",
  "schema_version": "1.4",
  "id": "guru-review-branch",
  "name": "guru-review-branch",
  "description": "Review committed task content, bounded base continuity, or a completed archive through independent semantic review.",
  "state": "active",
  "judgment_mode": "semantic",
  "modes": {
    "workflow": {
      "routing": "global_workflow",
      "entry_precondition_ids": [
        "runtime_dependency",
        "workspace_boundary",
        "task_identity",
        "commit_identity",
        "review_range",
        "working_tree",
        "invocation_freshness"
      ]
    },
    "standalone": {
      "routing": "direct_discovery",
      "entry_precondition_ids": [
        "runtime_dependency",
        "workspace_boundary",
        "task_identity",
        "commit_identity",
        "review_range",
        "working_tree",
        "invocation_freshness"
      ]
    }
  },
  "entry_preconditions": [
    {
      "id": "runtime_dependency",
      "evidence": "installed extension, dispatcher, active package, schemas and review commands",
      "binding": "complete current Guru Team preset",
      "freshness": "validated before each command"
    },
    {
      "id": "workspace_boundary",
      "evidence": "current task identity, TaskBranchBinding and live Git checkout facts",
      "binding": "actual root is the unique resolved active task checkout",
      "freshness": "rebuilt before record and check"
    },
    {
      "id": "task_identity",
      "evidence": "task.json and exact locator",
      "binding": "public Task and Delivery identity for ordinary review; exact completed archive and historical generation for archived_review",
      "freshness": "current task reread"
    },
    {
      "id": "commit_identity",
      "evidence": "guru-create-task-commit minimal committed DTO plus live Git",
      "binding": "Delivery key, current Check and exact committed candidate; archived review uses its independent historical profile",
      "freshness": "commit, parent and changed paths reread; message format is not downstream freshness authority"
    },
    {
      "id": "review_range",
      "evidence": "origin base, branch_review_commit, complete diff, approved Delivery slice, remaining work, and independent-delivery conditions",
      "binding": "origin/<base>...<branch_review_commit> plus the current closed Delivery policy",
      "freshness": "rebuilt for every round"
    },
    {
      "id": "working_tree",
      "evidence": "complete status snapshot and reviewed-content identity",
      "binding": "ordinary review excludes task/runtime metadata; archived_review requires completely clean status",
      "freshness": "checked before record and check"
    },
    {
      "id": "invocation_freshness",
      "evidence": "public input, AI Gate, artifact and actual exit",
      "binding": "one complete owner invocation",
      "freshness": "checker rejects drift or ambiguity"
    }
  ],
  "runtime_dependency": {
    "extension_id": "guru-team",
    "api_version": "1.0",
    "manifest_path": ".trellis/guru-team/extension.json",
    "dispatcher": "run-skill-command",
    "distribution": "guru-team-preset",
    "package_portability": "not-self-contained"
  },
  "ordered_stages": [
    "forward_behavior",
    "ai_review_gate",
    "conditional_human_confirmation",
    "recorder_validator",
    "typed_exit"
  ],
