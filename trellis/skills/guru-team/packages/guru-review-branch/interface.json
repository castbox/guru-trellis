  "validators": [
    {
      "id": "review_gate_recorder",
      "command": "scripts/review-branch.sh",
      "runtime_command": "review-branch",
      "objective_scope": "Record an already completed AI review while rebuilding objective task, range, HEAD and freshness facts"
    },
    {
      "id": "review_gate_checker",
      "command": "scripts/check-review-gate.sh",
      "runtime_command": "check-review-gate",
      "objective_scope": "Validate the compact gate, complete range, finding closure, fresh final review and exact typed exit"
    },
    {
      "id": "public_invocation",
      "command": "scripts/invoke.sh",
      "runtime_command": "invoke-guru-review-branch",
      "objective_scope": "Validate the public input, rerun the owner checker, derive actual exit and serialize one declared minimal DTO"
    },
    {
      "id": "reviewed_content_identity",
      "command": "scripts/reviewed-content-identity.sh",
      "runtime_command": "review-branch-content-identity",
      "objective_scope": "Compute the canonical metadata-excluded reviewed-content identity for one Git commit"
    }
  ],
  "external_exits": [
    {
      "id": "passed",
      "evidence": "all qualified findings closed and a fresh final reviewer passed the complete current range",
      "consumer": {
        "kind": "skill",
        "id": "guru-review-task-delivery"
      }
    },
    {
      "id": "continuity_passed",
      "evidence": "the bounded base delta is compatible with the unchanged task-content review and exact candidate pair",
      "consumer": {
        "kind": "workflow",
        "id": "guru-base-continuity-passed-router"
      }
    },
    {
      "id": "implementation_required",
      "evidence": "one or more qualified current-scope findings remain open",
      "consumer": {
        "kind": "workflow",
        "id": "guru-branch-review-implementation-router"
      }
    },
    {
      "id": "scope_confirmation_required",
      "evidence": "one or more unconfirmed nonstandard proposals require dedicated clarification",
      "consumer": {
        "kind": "workflow",
        "id": "guru-branch-review-scope-router"
      }
    },
    {
      "id": "blocked",
      "evidence": "required evidence, lifecycle, dependency or objective freshness is unavailable",
      "consumer": {
        "kind": "stop",
        "id": "branch-review-blocked"
      }
    },
    {
      "id": "archived_review_passed",
      "evidence": "Fresh independent completed archive review binds current A, B and existing PR payload snapshot.",
      "consumer": {
        "kind": "stop",
        "id": "legacy-archived-review-disposition-required"
      }
    },
    {
      "id": "delivery_stopped",
      "evidence": "Current stage owner reviewed withdrawal, recorded public stop and released selection.",
      "consumer": {
        "kind": "skill",
        "id": "guru-review-task-completion"
      }
    },
    {
      "id": "delivery_scope_revised",
      "evidence": "Current stage owner reviewed actual accepted scope; public same-Delivery rework succeeded or its exact output was recovered.",
      "consumer": {
        "kind": "workflow",
        "id": "guru-delivery-scope-revised-router"
      }
    }
  ],
  "reentry": {
    "identity": "mode, task, base, review_commit, reviewed-content identity, review intent, findings, range, Gate and actual exit",
    "freshness": "real implementation, durable SSOT, scope, authority or reviewed-content changes rerun affected checks and current semantic review; ordinary review preserves excluded metadata identity; archived_review also requires exact A, B and PR payload",
    "stale_behavior": "fail_closed"
  },
