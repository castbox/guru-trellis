{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-merge-task-delivery-input-delivery-ready-for-merge-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "task_ref",
    "repo_ref",
    "pr_number",
    "expected_head_sha",
    "publication_body_sha256",
    "delivery_key",
    "publication_result_id"
  ],
  "properties": {
    "profile": {
      "const": "delivery_ready_for_merge"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "repo_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "expected_head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "publication_body_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "delivery_key": {
      "type": "object"
    },
    "publication_result_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
