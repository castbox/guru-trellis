{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"guru-merge-task-delivery-semantic-review-1.0",
  "type":"object","additionalProperties":false,
  "required":["dimensions","route"],
  "properties":{
    "dimensions":{"type":"array","minItems":6,"maxItems":6,"items":{"type":"object","additionalProperties":false,"required":["id","status","summary"],"properties":{"id":{"enum":["active_task","pr_identity","checks_and_reviews","mergeability","repository_policy","message_and_delivery_boundary"]},"status":{"enum":["passed","blocked"]},"summary":{"type":"string","minLength":1}}}},
    "route":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["typed_exit","merge_method","merge_message"],"properties":{"typed_exit":{"const":"delivered"},"merge_method":{"const":"merge"},"merge_message":{"type":"object","additionalProperties":false,"required":["subject","body"],"properties":{"subject":{"type":"string","minLength":1,"maxLength":240,"pattern":"^[^\\r\\n]+$"},"body":{"type":"string","minLength":1}}}}},
      {"type":"object","additionalProperties":false,"required":["typed_exit","reason_code","remediation"],"properties":{"typed_exit":{"const":"merge_blocked"},"reason_code":{"type":"string","pattern":"^[a-z0-9]+(?:_[a-z0-9]+)*$"},"remediation":{"type":"string","minLength":1}}},
      {"type":"object","additionalProperties":false,"required":["typed_exit","finding_refs"],"properties":{"typed_exit":{"const":"implementation_required"},"finding_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}}},
      {"type":"object","additionalProperties":false,"required":["typed_exit","reason_code"],"properties":{"typed_exit":{"const":"review_refresh_required"},"reason_code":{"type":"string","pattern":"^[a-z0-9]+(?:_[a-z0-9]+)*$"}}}
    ]}
  }
}
