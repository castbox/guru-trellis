{
  "$schema": "../../schemas/skill-interface-1.4.schema.json",
  "schema_version": "1.4",
  "id": "guru-merge-task-delivery",
  "name": "guru-merge-task-delivery",
  "description": "Merge one reviewed active-task Delivery PR through a semantic live gate, exact merge-commit trailers, and terminal recovery.",
  "state": "active",
  "judgment_mode": "semantic",
  "modes": {
    "workflow": {
      "routing": "global_workflow",
      "entry_precondition_ids": [
        "runtime_dependency",
        "active_task",
        "publication_handoff",
        "live_merge_readiness",
        "merge_message",
        "invocation_freshness"
      ]
    },
    "standalone": {
      "routing": "direct_discovery",
      "entry_precondition_ids": [
        "runtime_dependency",
        "active_task",
        "publication_handoff",
        "live_merge_readiness",
        "merge_message",
        "invocation_freshness"
      ]
    }
  },
  "entry_preconditions": [
    {
      "id": "runtime_dependency",
      "evidence": "installed extension, dispatcher, active package, schemas and commands",
      "binding": "complete current Guru Team preset",
      "freshness": "validated before every command"
    },
    {
      "id": "active_task",
      "evidence": "task.json, current branch/worktree and Git HEAD",
      "binding": "public Task identity and selected Delivery key; active unique checkout is required for a new merge, historical recovery validates actual immutable Task/Delivery attribution",
      "freshness": "reread before gate, mutation and terminal projection"
    },
    {
      "id": "publication_handoff",
      "evidence": "Publish ready_for_merge DTO",
      "binding": "Delivery key, exact Publication result, repository, PR, reviewed head and actual PR-body revision",
      "freshness": "compared with the first live PR read"
    },
    {
      "id": "live_merge_readiness",
      "evidence": "Ready/Open PR, checks, reviews, mergeability, base ref and repository policy",
      "binding": "one same-repository merge-commit candidate",
      "freshness": "reread at the mutation boundary"
    },
    {
      "id": "merge_message",
      "evidence": "AI-reviewed subject, body and exact Delivery trailers",
      "binding": "stable Task and Delivery identities, schema 2, generation and reviewed head for new merges; original schema-1 bytes only for bounded historical recovery",
      "freshness": "stored only in the current owner-private gate"
    },
    {
      "id": "invocation_freshness",
      "evidence": "public input, semantic review, private gate and terminal live facts",
      "binding": "one PR and one expected-head merge action",
      "freshness": "checker rejects any identity drift or ambiguous terminal state"
    }
  ],
  "runtime_dependency": {
    "extension_id": "guru-team",
    "api_version": "1.0",
    "manifest_path": ".trellis/guru-team/extension.json",
    "dispatcher": "run-skill-command",
    "distribution": "guru-team-preset",
    "package_portability": "not-self-contained"
  },
  "ordered_stages": [
    "forward_behavior",
    "ai_review_gate",
    "conditional_human_confirmation",
    "recorder_validator",
    "typed_exit"
  ],
