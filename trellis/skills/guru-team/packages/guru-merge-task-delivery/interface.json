  "validators": [
    {
      "id": "merge_previewer",
      "command": "scripts/preview-task-delivery-merge.sh",
      "runtime_command": "preview-task-delivery-merge",
      "objective_scope": "Read the exact active task, live PR, checks, policy, base and terminal facts without mutation"
    },
    {
      "id": "merge_recorder",
      "command": "scripts/record-task-delivery-merge.sh",
      "runtime_command": "record-task-delivery-merge",
      "objective_scope": "Record one already completed semantic route and exact action identity in owner-private runtime"
    },
    {
      "id": "merge_checker",
      "command": "scripts/check-task-delivery-merge.sh",
      "runtime_command": "check-task-delivery-merge",
      "objective_scope": "Validate gate structure, live freshness, exact trailers and route consistency"
    },
    {
      "id": "delivery_history_discoverer",
      "command": "scripts/discover-task-deliveries.sh",
      "runtime_command": "discover-task-deliveries",
      "objective_scope": "Read target-base merge history and reconstruct exact task Delivery facts from schema-1 trailers plus GitHub PR and merge identity without reading PR bodies or current task branches"
    },
    {
      "id": "merge_executor",
      "command": "scripts/execute-task-delivery-merge.sh",
      "runtime_command": "execute-task-delivery-merge",
      "objective_scope": "Perform at most one merge-commit-only expected-head mutation and exact post-read verification"
    },
    {
      "id": "public_invocation",
      "command": "scripts/invoke.sh",
      "runtime_command": "invoke-guru-merge-task-delivery",
      "objective_scope": "Sole public entry with one pre-read, one mutation maximum, one post-read and read-only terminal recovery"
    },
    {
      "id": "private_delivery_migration",
      "command": "scripts/migrate-delivery-transaction.sh",
      "runtime_command": "migrate-task-delivery-merge",
      "objective_scope": "Original schema-1 terminal merge recovery with exact PR/message/parents and public historical fact projection; incomplete merges fresh reenter original owner."
    }
  ],
  "external_exits": [
    {
      "id": "delivered",
      "evidence": "PR merged through the reviewed expected-head merge commit and exact task/head trailers were verified",
      "consumer": {
        "kind": "skill",
        "id": "guru-review-task-completion"
      }
    },
    {
      "id": "merge_blocked",
      "evidence": "one current external or objective condition prevents the reviewed merge mutation",
      "consumer": {
        "kind": "stop",
        "id": "task-delivery-merge-blocked"
      }
    },
    {
      "id": "implementation_required",
      "evidence": "one current Delivery-slice finding requires Phase 2 task work before a new review",
      "consumer": {
        "kind": "workflow",
        "id": "guru-resume-implementation"
      }
    },
    {
      "id": "review_refresh_required",
      "evidence": "the current Delivery review authority is stale and must be rebuilt for the active task",
      "consumer": {
        "kind": "skill",
        "id": "guru-review-task-delivery"
      }
    },
    {
      "id": "delivery_stopped",
      "evidence": "Current stage owner reviewed withdrawal, recorded public stop and released selection.",
      "consumer": {
        "kind": "skill",
        "id": "guru-review-task-completion"
      }
    },
    {
      "id": "delivery_scope_revised",
      "evidence": "Current stage owner reviewed actual accepted scope; public same-Delivery rework succeeded or its exact output was recovered.",
      "consumer": {
        "kind": "workflow",
        "id": "guru-delivery-scope-revised-router"
      }
    }
  ],
  "reentry": {
    "identity": "task ref, delivery cycle, repository, PR number, expected head, publication body digest, reviewed message and action digest",
    "freshness": "live task/PR/base/policy/commit facts are reread before mutation and terminal projection",
    "stale_behavior": "fail_closed"
  },
