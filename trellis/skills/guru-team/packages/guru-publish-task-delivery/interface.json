        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "skill_input_authoring_seed",
          "interface_path": "packages/guru-publish-task-delivery/interface.json",
          "input_kind": "structured_json",
          "profile_id": "reprepare_publication",
          "seed_fields": [
            "task_ref",
            "reason_code"
          ],
          "authoring_fields": [
            "profile",
            "mode"
          ],
          "authoring_example": {
            "id": "reprepare_publication_authoring",
            "path": "examples/public-reprepare-publication-authoring.json"
          }
        }
      },
      {
        "id": "blocked_stop_input",
        "consumer": {
          "kind": "stop",
          "id": "task-delivery-publication-blocked"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "json_schema",
          "schema_id": "guru-publish-task-delivery-stop-blocked-input-1.0",
          "path": "consumers/stop/production/publish-task-delivery-blocked.schema.json"
        }
      }
    ],
    "projections": [
      {
        "id": "project_ready_for_merge",
        "exit_id": "ready_for_merge",
        "consumer_input_id": "ready_for_merge_input",
        "operation": "select",
        "mappings": [
          {
            "source": "task_ref",
            "target": "task_ref"
          },
          {
            "source": "delivery_cycle_ref",
            "target": "delivery_cycle_ref"
          },
          {
            "source": "repo_ref",
            "target": "repo_ref"
          },
