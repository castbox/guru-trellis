        "operation": "select",
        "mappings": [
          {
            "source": "task_ref",
            "target": "task_ref"
          },
          {
            "source": "reason_code",
            "target": "reason_code"
          }
        ]
      },
      {
        "id": "project_blocked",
        "exit_id": "blocked",
        "consumer_input_id": "blocked_stop_input",
        "operation": "direct"
      }
    ],
    "private_artifacts": [
      {
        "id": "publication_transaction",
        "kind": "runtime_checkpoint",
        "schema": {
          "schema_id": "guru-publish-task-delivery-transaction-1.0",
          "path": "schemas/publication-transaction.schema.json"
        },
        "persistence": "ignored_runtime"
      },
      {
        "id": "publication_gate",
        "kind": "gate_evidence",
        "schema": {
          "schema_id": "guru-publish-task-delivery-gate-1.0",
          "path": "schemas/publication-gate.schema.json"
        },
