{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"guru-publish-task-delivery-output-ready-for-merge-1.0",
  "type":"object","additionalProperties":false,"required":["exit_id","task_ref","delivery_cycle_ref","repo_ref","pr_number","expected_head_sha","publication_body_sha256"],
  "properties":{"exit_id":{"const":"ready_for_merge"},"task_ref":{"type":"string","pattern":"^\\.trellis/tasks/[A-Za-z0-9._/-]+$"},"delivery_cycle_ref":{"type":"string","pattern":"^delivery-cycle:v1:[0-9a-f]{64}$"},"repo_ref":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},"pr_number":{"type":"integer","minimum":1},"expected_head_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"publication_body_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
