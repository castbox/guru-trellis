    "skill_id": {"const": "guru-merge-task-pr"},
    "input": {"$ref": "public-input-2.0.schema.json"},
    "facts_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pre_merge_base_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "reviewed_message_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_review": {"type": "object"},
    "route": {"type": "object"},
    "terminal_output": {"type": "object"}
  }
}
