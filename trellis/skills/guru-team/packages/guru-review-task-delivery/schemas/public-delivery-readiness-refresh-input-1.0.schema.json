{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-review-task-delivery-input-delivery-readiness-refresh-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "task_ref",
    "delivery_key",
    "reentry_reason"
  ],
  "properties": {
    "profile": {
      "const": "delivery_readiness_refresh"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "delivery_key": {
      "type": "object"
    },
    "reentry_reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
