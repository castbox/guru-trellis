  "validators": [
    {
      "id": "contract_wording_recorder",
      "command": "scripts/record-contract-wording-review.sh",
      "runtime_command": "record-contract-wording-review",
      "objective_scope": "single-read review-invocation.schema.json envelope for change_request scan/record, unmixed legacy file-input compatibility, fixed profile scope reconstruction, deterministic scan, schema and whitelist validation, exact planning-profile dimension shape/value validation, derived unchecked hits, live issue payload/result identities and canonical digests"
    },
    {
      "id": "contract_wording_checker",
      "command": "scripts/check-contract-wording-review.sh",
      "runtime_command": "check-contract-wording-review",
      "objective_scope": "single-read review-invocation.schema.json envelope or unmixed legacy inputs, published schema, fixed scope and scan completeness, selected-comment metadata, live issue payload/preimage/result binding, content freshness, classification structure, exact planning-profile dimension shape/value validation, Gate/exit biconditional and result digest validation; returns actual call-local validation_receipt"
    },
    {
      "id": "public_invocation",
      "command": "scripts/invoke.sh",
      "runtime_command": "invoke-guru-review-contract-wording",
      "objective_scope": "Caller-owned input validation and deterministic typed-exit serialization after the owner closed loop"
    }
  ],
  "external_exits": [
    {
      "id": "pass",
      "evidence": "current complete scope and scan, zero unchecked hits, passed AI Review Gate, and no unconsumed content revision",
      "consumer": {
        "kind": "workflow",
        "id": "guru-contract-wording-pass-router"
      }
    },
    {
      "id": "content_changed",
      "evidence": "one or more completed revisions are bound to rebuilt scope, current content hashes, a complete rescan, and a passed AI Review Gate",
      "consumer": {
        "kind": "workflow",
        "id": "guru-contract-wording-change-router"
      }
    },
    {
      "id": "blocked",
      "evidence": "missing scope or mutation preconditions, unresolved semantic change, unchecked violation, or blocked AI Review Gate",
      "consumer": {
        "kind": "stop",
        "id": "contract-wording-blocked"
      }
    },
    {
      "id": "supplemented",
      "evidence": "completed original-owner semantic review for this Issue and continuation",
      "consumer": {
        "kind": "skill",
        "id": "guru-review-change-request"
      }
    },
    {
      "id": "requirements_gap",
      "evidence": "completed original-owner semantic review for this Issue and continuation",
      "consumer": {
        "kind": "skill",
        "id": "guru-review-change-request"
      }
    }
  ],
  "reentry": {
    "identity": "the fixed profile and current normalized scope rebuilt for this invocation",
    "freshness": "every content mutation invalidates the caller-private result; mapped re-entry discards it and reruns the complete owner loop without a replacement digest or history",
    "stale_behavior": "fail_closed"
  },
