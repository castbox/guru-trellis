{
  "schema_version": "1.0",
  "package_id": "guru-check-task",
  "commands": [
    {
      "id": "record-phase2-check",
      "owner": "guru-check-task",
      "entrypoint": "runtime/record.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--task",
          "required": false,
          "kind": "string",
          "description": "Task locator.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--input",
          "required": true,
          "kind": "string",
          "description": "AI check JSON locator.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--dry-run",
          "required": false,
          "kind": "boolean",
          "description": "Validate without persistence.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "none",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "runtime_write",
      "schema_bindings": [],
      "validator_id": "phase2_check_recorder",
      "runtime_role": "record"
    },
    {
      "id": "check-phase2-check",
      "owner": "guru-check-task",
      "entrypoint": "runtime/check.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--task",
          "required": false,
          "kind": "string",
          "description": "Task locator.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "none",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "git_read",
      "schema_bindings": [],
      "validator_id": "phase2_check_checker",
      "runtime_role": "check"
    },
    {
      "id": "invoke-guru-check-task",
      "owner": "guru-check-task",
      "entrypoint": "runtime/invoke.py",
      "arguments": [
        {
          "flag": "--invocation",
          "required": false,
          "kind": "json",
          "description": "Call-local invocation envelope or dash for stdin.",
          "repeatable": false,
          "conflicts": [
            "--input",
            "--owner-result"
          ]
        },
        {
          "flag": "--input",
          "required": false,
          "kind": "string",
          "description": "Public input JSON locator.",
          "repeatable": false,
          "conflicts": [
            "--invocation"
          ]
        },
        {
          "flag": "--owner-result",
          "required": false,
          "kind": "string",
          "description": "Completed owner result JSON locator.",
          "repeatable": false,
          "conflicts": [
            "--invocation"
          ]
        }
      ],
      "stdin": "optional_json",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "runtime_write",
      "schema_bindings": [],
      "validator_id": "public_invocation",
      "runtime_role": "invoke"
    }
  ]
}
