{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-team-skill-evals-1.0",
  "schema_version": "1.0",
  "skill_name": "guru-check-task",
  "evals": [
    {
      "id": "legacy-control-retirement",
      "prompt": "Consume the preserved historical Check gate through the original legacy retirement wrapper. The adapter stages the original inspection and freeze prerequisites and physically preserves the source. This case checks reader transport and deterministic retirement only; it does not prove the original AI retirement judgment, a historical gate producer, or a current quality review.",
      "expected_exit": "legacy_controls_retired",
      "expected_output": "The original wrapper returns the legacy_controls_retired DTO for example-task generation 0. The selected historical gate is removed and the physically preserved source remains unchanged. No current Check or Review pass is produced.",
      "input_profile_id": "legacy_control_retirement",
      "native_execution_mode": "post_owner",
      "files": [
        "evals/files/legacy-control-retirement-facts.json",
        "evals/files/legacy-control-retirement-source-gate.json"
      ],
      "assertions": {
        "deterministic": [
          {
            "id": "expected-route",
            "kind": "json_path",
            "pointer": "/exit_id",
            "operation": "equals",
            "expected": "legacy_controls_retired"
          },
          {
            "id": "original-owner",
            "kind": "json_path",
            "pointer": "/owner_id",
            "operation": "equals",
            "expected": "guru-check-task"
          },
          {
            "id": "original-task",
            "kind": "json_path",
            "pointer": "/key/task_id",
            "operation": "equals",
            "expected": "example-task"
          },
          {
            "id": "original-generation",
            "kind": "json_path",
            "pointer": "/key/lifecycle_generation",
            "operation": "equals",
            "expected": 0
          },
          {
            "id": "public-invocation-only",
            "kind": "trace",
            "invariant": "public_invocation_only"
          },
          {
            "id": "evals-not-loaded-by-skill",
            "kind": "trace",
            "invariant": "evals_not_loaded_by_skill"
          },
          {
            "id": "private-runtime-not-read-by-agent",
            "kind": "trace",
            "invariant": "private_runtime_not_read_by_agent"
          }
        ]
      }
    }
  ]
}
