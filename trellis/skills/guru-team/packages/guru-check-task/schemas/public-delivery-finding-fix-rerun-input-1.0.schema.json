{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-check-task-input-delivery-finding-fix-rerun-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "task_ref",
    "source_exit",
    "rerun_reason",
    "finding_refs",
    "delivery_key",
    "planning_accepted_result_id"
  ],
  "properties": {
    "profile": {
      "const": "delivery_finding_fix_rerun"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "source_exit": {
      "const": "implementation_required"
    },
    "rerun_reason": {
      "const": "finding_fix"
    },
    "finding_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "delivery_key": {
      "type": "object"
    },
    "planning_accepted_result_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
