{
  "$schema": "../../schemas/skill-interface-1.4.schema.json",
  "schema_version": "1.4",
  "id": "guru-check-task",
  "name": "guru-check-task",
  "description": "Check the complete current task through one AI-owned semantic round, compact private evidence, and four minimal typed exits.",
  "state": "active",
  "judgment_mode": "semantic",
  "modes": {
    "workflow": {
      "routing": "global_workflow",
      "entry_precondition_ids": [
        "runtime_dependency",
        "task_checkout",
        "approved_planning",
        "live_implementation",
        "validation_scope",
        "docs_ssot",
        "invocation_freshness"
      ]
    },
    "standalone": {
      "routing": "direct_discovery",
      "entry_precondition_ids": [
        "runtime_dependency",
        "task_checkout",
        "approved_planning",
        "live_implementation",
        "validation_scope",
        "docs_ssot",
        "invocation_freshness"
      ]
    }
  },
  "entry_preconditions": [
    {
      "id": "runtime_dependency",
      "evidence": "installed extension manifest, dispatcher, active package inventory, schema, and declared recorder/checker commands",
      "binding": "complete compatible Guru Team preset runtime",
      "freshness": "run-skill-command validates the managed runtime before each command"
    },
    {
      "id": "task_checkout",
      "evidence": "active TaskId, task.json, current branch binding, and resolved checkout",
      "binding": "one active task in its resolved repository checkout",
      "freshness": "task identity and checkout resolution are refreshed before record and check"
    },
    {
      "id": "approved_planning",
      "evidence": "the active task status plus the three live planning documents Scope revision instead consumes original Clarify current accepted scope and this current-stage semantic slice judgment; stale downstream gates are not prerequisites.",
      "binding": "the planning contract already consumed by Phase 1 activation and implementation",
      "freshness": "the owner rereads the live plans and classifies semantic deltas without opening producer-private evidence"
    },
    {
      "id": "live_implementation",
      "evidence": "live base diff, staged, unstaged, untracked and new files, code, tests, docs, and generated outputs",
      "binding": "the complete current implementation candidate",
      "freshness": "the AI rereads live Git and files before the semantic result and the checker recomputes one owner-private composite worktree token"
    },
    {
      "id": "validation_scope",
      "evidence": "applicable repository lint, type, test, schema, generated, drift, installation, and external checks",
      "binding": "the validation needed for the current task scope",
      "freshness": "command summaries and unverified items describe the current complete round"
    },
    {
      "id": "docs_ssot",
      "evidence": "current durable paths, strategy, and semantic reconciliation conclusion",
      "binding": "the task's durable documentation responsibility",
      "freshness": "the AI rereads current docs and planning before recording"
    },
    {
      "id": "invocation_freshness",
      "evidence": "mode, task, checked content identity, one local composite worktree token, reviewed paths, compact semantic result, typed exit, reason, and consumer",
      "binding": "one complete current Phase 2 owner round",
      "freshness": "the checker rejects missing, stale, partial, multiple, unknown, or consumer-mismatched results"
    }
  ],
  "runtime_dependency": {
    "extension_id": "guru-team",
    "api_version": "1.0",
    "manifest_path": ".trellis/guru-team/extension.json",
    "dispatcher": "run-skill-command",
    "distribution": "guru-team-preset",
    "package_portability": "not-self-contained"
  },
  "ordered_stages": [
    "forward_behavior",
    "ai_review_gate",
    "conditional_human_confirmation",
    "recorder_validator",
    "typed_exit"
  ],
