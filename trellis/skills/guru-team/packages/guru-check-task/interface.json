  "validators": [
    {
      "id": "phase2_check_recorder",
      "command": "scripts/record-phase2-check.sh",
      "runtime_command": "record-phase2-check",
      "objective_scope": "write the completed compact semantic result after current task, planning, candidate hygiene, and reviewed-path checks"
    },
    {
      "id": "phase2_check_checker",
      "command": "scripts/check-phase2-check.sh",
      "runtime_command": "check-phase2-check",
      "objective_scope": "validate current schema 5.0 closure, task and planning linkage, capture-commit ancestry, reviewed-content identity, dirty-path coverage, semantic union, typed exit, and unique consumer"
    },
    {
      "id": "public_invocation",
      "command": "scripts/invoke.sh",
      "runtime_command": "invoke-guru-check-task",
      "objective_scope": "validate the minimal route input, check the owner-private result, and serialize one minimal typed exit"
    },
    {
      "id": "resolved_reconciliation_projection",
      "command": "scripts/project-resolved-reconciliation.sh",
      "runtime_command": "project-resolved-reconciliation",
      "objective_scope": "validate one checked private resolved-tree Phase 2 result and emit the target-owned Reconcile input without a workflow exit"
    },
    {
      "id": "legacy_maintenance",
      "command": "scripts/legacy-maintenance.sh",
      "runtime_command": "legacy-maintenance-guru-check-task",
      "objective_scope": "Exact legacy original-owner facts, attribution and fixed preimage retirement; no current lifecycle or publication/merge/Finish action."
    }
  ],
  "external_exits": [
    {
      "id": "passed",
      "evidence": "all nine dimensions passed with no open finding or blocking unverified item",
      "consumer": {
        "kind": "skill",
        "id": "guru-create-task-commit"
      }
    },
    {
      "id": "implementation_required",
      "evidence": "one or more supported current-scope findings remain open",
      "consumer": {
        "kind": "workflow",
        "id": "guru-resume-implementation"
      }
    },
    {
      "id": "planning_stale",
      "evidence": "a current scope or authority decision requires planning re-entry",
      "consumer": {
        "kind": "workflow",
        "id": "guru-task-check-planning-router"
      }
    },
    {
      "id": "blocked",
      "evidence": "a concrete evidence or dependency gap prevents a reliable complete check",
      "consumer": {
        "kind": "stop",
        "id": "task-check-blocked"
      }
    },
    {
      "id": "delivery_stopped",
      "evidence": "Current stage owner reviewed withdrawal, recorded public stop and released selection.",
      "consumer": {
        "kind": "skill",
        "id": "guru-review-task-completion"
      }
    },
    {
      "id": "resolved_reconciliation_passed",
      "evidence": "Current resolved tree and complete semantic Check, before its exact reconciliation commit.",
      "consumer": {
        "kind": "workflow",
        "id": "guru-delivery-resolved-reconciliation-router"
      }
    },
    {
      "id": "delivery_scope_revised",
      "evidence": "Current stage owner reviewed actual accepted scope; public same-Delivery rework succeeded or its exact output was recovered.",
      "consumer": {
        "kind": "workflow",
        "id": "guru-delivery-scope-revised-router"
      }
    },
    {
      "id": "legacy_controls_retired",
      "evidence": "This original gate owner verified preserved raw source and retired only its fixed selected legacy gate.",
      "consumer": {
        "kind": "workflow",
        "id": "legacy-maintenance-check-task-legacy-controls-retired"
      }
    }
  ],
  "reentry": {
    "identity": "mode, task, checked content identity, one local composite worktree token, reviewed paths, current semantic result, typed exit, route, and consumer",
