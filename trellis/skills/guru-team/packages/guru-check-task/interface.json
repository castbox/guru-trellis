{
  "$schema": "../../schemas/skill-interface-1.4.schema.json",
  "schema_version": "1.4",
  "id": "guru-check-task",
  "name": "guru-check-task",
  "description": "Check the complete current task through one AI-owned semantic round, compact private evidence, and four minimal typed exits.",
  "state": "active",
  "judgment_mode": "semantic",
  "modes": {
    "workflow": {
      "routing": "global_workflow",
      "entry_precondition_ids": [
        "runtime_dependency",
        "task_workspace",
        "approved_planning",
        "live_implementation",
        "validation_scope",
        "docs_ssot",
        "issue_scope",
        "invocation_freshness"
      ]
    },
    "standalone": {
      "routing": "direct_discovery",
      "entry_precondition_ids": [
        "runtime_dependency",
        "task_workspace",
        "approved_planning",
        "live_implementation",
        "validation_scope",
        "docs_ssot",
        "issue_scope",
        "invocation_freshness"
      ]
    }
  },
  "entry_preconditions": [
    {
      "id": "runtime_dependency",
      "evidence": "installed extension manifest, dispatcher, active package inventory, schema, and declared recorder/checker commands",
      "binding": "complete compatible Guru Team preset runtime",
      "freshness": "run-skill-command validates the managed runtime before each command"
    },
    {
      "id": "task_workspace",
      "evidence": "direct active task locator, task.json, current checkout, and workspace boundary",
      "binding": "one task in its expected repository worktree",
      "freshness": "the workspace boundary is rebuilt before record and check"
    },
    {
      "id": "approved_planning",
      "evidence": "the active task status plus the three live planning documents",
      "binding": "the planning contract already consumed by Phase 1 activation and implementation",
      "freshness": "the owner rereads the live plans and classifies semantic deltas without opening producer-private evidence"
    },
    {
      "id": "live_implementation",
      "evidence": "live base diff, staged, unstaged, untracked and new files, code, tests, docs, and generated outputs",
      "binding": "the complete current implementation candidate",
      "freshness": "the AI rereads live Git and files before the semantic result and the checker recomputes one owner-private composite worktree token"
    },
    {
      "id": "validation_scope",
      "evidence": "applicable repository lint, type, test, schema, generated, drift, installation, and external checks",
      "binding": "the validation needed for the current task scope",
      "freshness": "command summaries and unverified items describe the current complete round"
    },
    {
      "id": "docs_ssot",
      "evidence": "current durable paths, strategy, and semantic reconciliation conclusion",
      "binding": "the task's durable documentation responsibility",
      "freshness": "the AI rereads current docs and planning before recording"
    },
    {
      "id": "issue_scope",
      "evidence": "current primary, close, related, and follow-up issue decisions",
      "binding": "the accepted task scope and finding boundary",
      "freshness": "the AI rereads the issue scope ledger and live authority"
    },
    {
      "id": "invocation_freshness",
      "evidence": "mode, task, checked content identity, one local composite worktree token, reviewed paths, compact semantic result, typed exit, reason, and consumer",
      "binding": "one complete current Phase 2 owner round",
      "freshness": "the checker rejects missing, stale, partial, multiple, unknown, or consumer-mismatched results"
    }
  ],
  "runtime_dependency": {
    "extension_id": "guru-team",
    "api_version": "1.0",
    "manifest_path": ".trellis/guru-team/extension.json",
    "dispatcher": "run-skill-command",
    "distribution": "guru-team-preset",
    "package_portability": "not-self-contained"
  },
  "ordered_stages": [
    "forward_behavior",
    "ai_review_gate",
    "conditional_human_confirmation",
    "recorder_validator",
    "typed_exit"
  ],
  "artifacts": [
    {"id": "phase2_check_example", "path": "examples/phase2-check.json"},
    {"id": "public_input_initial_check_example", "path": "examples/public-initial-check-input.json"},
    {"id": "public_input_finding_fix_rerun_example", "path": "examples/public-finding-fix-rerun-input.json"},
    {"id": "public_input_planning_reentry_example", "path": "examples/public-planning-reentry-input.json"},
    {"id": "public_invocation_error_example", "path": "examples/public-invocation-error.json"},
    {"id": "public_output_passed_example", "path": "examples/public-passed-output.json"},
    {"id": "public_output_implementation_required_example", "path": "examples/public-implementation-required-output.json"},
    {"id": "public_output_planning_stale_example", "path": "examples/public-planning-stale-output.json"},
    {"id": "public_output_blocked_example", "path": "examples/public-blocked-output.json"}
  ],
  "schemas": [
    {"id": "phase2_check_schema", "path": "schemas/phase2-check.schema.json"},
    {"id": "public_input_initial_check", "path": "schemas/public-initial-check-input.schema.json"},
    {"id": "public_input_finding_fix_rerun", "path": "schemas/public-finding-fix-rerun-input.schema.json"},
    {"id": "public_input_planning_reentry", "path": "schemas/public-planning-reentry-input.schema.json"},
    {"id": "public_input_aggregate", "path": "schemas/public-input.schema.json"},
    {"id": "public_invocation_error", "path": "schemas/public-invocation-error.schema.json"},
    {"id": "public_output_passed", "path": "schemas/public-passed-output.schema.json"},
    {"id": "public_output_implementation_required", "path": "schemas/public-implementation-required-output.schema.json"},
    {"id": "public_output_planning_stale", "path": "schemas/public-planning-stale-output.schema.json"},
    {"id": "public_output_blocked", "path": "schemas/public-blocked-output.schema.json"}
  ],
  "validators": [
    {
      "id": "phase2_check_recorder",
      "command": "scripts/record-phase2-check.sh",
      "runtime_command": "record-phase2-check",
      "objective_scope": "write the completed compact semantic result after current task, planning, candidate hygiene, and reviewed-path checks"
    },
    {
      "id": "phase2_check_checker",
      "command": "scripts/check-phase2-check.sh",
      "runtime_command": "check-phase2-check",
      "objective_scope": "validate schema 4.0 closure, task and planning linkage, capture-commit ancestry, reviewed-content identity, dirty-path coverage, semantic union, typed exit, and unique consumer"
    },
    {
      "id": "public_invocation",
      "command": "scripts/invoke.sh",
      "runtime_command": "invoke-stage0-skill",
      "objective_scope": "validate the minimal route input, check the owner-private result, and serialize one minimal typed exit"
    }
  ],
  "external_exits": [
    {
      "id": "passed",
      "evidence": "all nine dimensions passed with no open finding or blocking unverified item",
      "consumer": {"kind": "skill", "id": "guru-create-task-commit"}
    },
    {
      "id": "implementation_required",
      "evidence": "one or more supported current-scope findings remain open",
      "consumer": {"kind": "workflow", "id": "guru-resume-implementation"}
    },
    {
      "id": "planning_stale",
      "evidence": "a current scope or authority decision requires planning re-entry",
      "consumer": {"kind": "workflow", "id": "guru-task-check-planning-router"}
    },
    {
      "id": "blocked",
      "evidence": "a concrete evidence or dependency gap prevents a reliable complete check",
      "consumer": {"kind": "stop", "id": "task-check-blocked"}
    }
  ],
  "reentry": {
    "identity": "mode, task, checked content identity, one local composite worktree token, reviewed paths, current semantic result, typed exit, route, and consumer",
    "freshness": "the AI classifies each current delta and reruns only the semantic owner whose dependency changed",
    "stale_behavior": "fail_closed"
  },
  "tests": ["tests/test_contract.py"],
  "platform_destinations": ["shared", "codex", "cursor", "claude"],
  "public_contracts": {
    "input": {
      "kind": "structured_json",
      "aggregate_schema": {
        "schema_id": "guru-production-check-task-input-aggregate-2.0",
        "path": "schemas/public-input.schema.json"
      },
      "profiles": [
        {
          "id": "initial_check",
          "schema": {"schema_id": "guru-production-check-task-input-initial-check-2.0", "path": "schemas/public-initial-check-input.schema.json"},
          "example": {"id": "initial_check_input", "path": "examples/public-initial-check-input.json"},
          "discriminator": {"field": "profile", "value": "initial_check"}
        },
        {
          "id": "finding_fix_rerun",
          "schema": {"schema_id": "guru-production-check-task-input-finding-fix-rerun-2.0", "path": "schemas/public-finding-fix-rerun-input.schema.json"},
          "example": {"id": "finding_fix_rerun_input", "path": "examples/public-finding-fix-rerun-input.json"},
          "discriminator": {"field": "profile", "value": "finding_fix_rerun"}
        },
        {
          "id": "planning_reentry",
          "schema": {"schema_id": "guru-production-check-task-input-planning-reentry-2.0", "path": "schemas/public-planning-reentry-input.schema.json"},
          "example": {"id": "planning_reentry_input", "path": "examples/public-planning-reentry-input.json"},
          "discriminator": {"field": "profile", "value": "planning_reentry"}
        }
      ]
    },
    "invocation": {
      "command_id": "run-skill-command",
      "wrapper": "scripts/invoke.sh",
      "input_binding": {"kind": "structured_json", "profile_id": "initial_check"},
      "stdout_contract": "single_typed_exit",
      "error_schema": {"schema_id": "guru-production-check-task-invocation-error-1.0", "path": "schemas/public-invocation-error.schema.json"},
      "error_example": {"id": "invalid_public_input", "path": "examples/public-invocation-error.json"},
      "example_argv": ["--input", "examples/public-initial-check-input.json", "--owner-result", "examples/phase2-check.json"]
    },
    "outputs": [
      {
        "exit_id": "passed",
        "schema": {"schema_id": "guru-production-check-task-output-passed-3.0", "path": "schemas/public-passed-output.schema.json"},
        "example": {"id": "passed_output", "path": "examples/public-passed-output.json"},
        "consumer_use_ids": ["project_passed"]
      },
      {
        "exit_id": "implementation_required",
        "schema": {"schema_id": "guru-production-check-task-output-implementation-required-1.0", "path": "schemas/public-implementation-required-output.schema.json"},
        "example": {"id": "implementation_required_output", "path": "examples/public-implementation-required-output.json"},
        "consumer_use_ids": ["project_implementation_required"]
      },
      {
        "exit_id": "planning_stale",
        "schema": {"schema_id": "guru-production-check-task-output-planning-stale-1.0", "path": "schemas/public-planning-stale-output.schema.json"},
        "example": {"id": "planning_stale_output", "path": "examples/public-planning-stale-output.json"},
        "consumer_use_ids": ["project_planning_stale"]
      },
      {
        "exit_id": "blocked",
        "schema": {"schema_id": "guru-production-check-task-output-blocked-1.0", "path": "schemas/public-blocked-output.schema.json"},
        "example": {"id": "blocked_output", "path": "examples/public-blocked-output.json"},
        "consumer_use_ids": ["project_blocked"]
      }
    ],
    "consumer_inputs": [
      {
        "id": "initial_commit_seed_input",
        "consumer": {"kind": "skill", "id": "guru-create-task-commit"},
        "payload_kind": "structured_json",
        "contract": {
          "kind": "skill_input_authoring_seed",
          "interface_path": "packages/guru-create-task-commit/interface.json",
          "input_kind": "structured_json",
          "profile_id": "initial_commit",
          "seed_fields": ["source_exit", "task_ref", "phase2_commit_anchor"],
          "authoring_fields": ["profile", "mode"],
          "authoring_example": {"id": "initial_commit_authoring", "path": "examples/public-initial-commit-authoring.json"}
        }
      },
      {
        "id": "implementation_required_workflow_input",
        "consumer": {"kind": "workflow", "id": "guru-resume-implementation"},
        "payload_kind": "structured_json",
        "contract": {"kind": "json_schema", "schema_id": "guru-production-check-task-workflow-implementation-required-input-1.0", "path": "consumers/workflow/production/check-task-implementation-required.schema.json"}
      },
      {
        "id": "planning_stale_workflow_input",
        "consumer": {"kind": "workflow", "id": "guru-task-check-planning-router"},
        "payload_kind": "structured_json",
        "contract": {"kind": "json_schema", "schema_id": "guru-production-check-task-workflow-planning-stale-input-1.0", "path": "consumers/workflow/production/check-task-planning-stale.schema.json"}
      },
      {
        "id": "blocked_stop_input",
        "consumer": {"kind": "stop", "id": "task-check-blocked"},
        "payload_kind": "zero_payload"
      }
    ],
    "projections": [
      {
        "id": "project_passed",
        "exit_id": "passed",
        "consumer_input_id": "initial_commit_seed_input",
        "operation": "rename",
        "mappings": [
          {"source": "exit_id", "target": "source_exit"},
          {"source": "task_ref", "target": "task_ref"},
          {"source": "phase2_commit_anchor", "target": "phase2_commit_anchor"}
        ]
      },
      {"id": "project_implementation_required", "exit_id": "implementation_required", "consumer_input_id": "implementation_required_workflow_input", "operation": "direct"},
      {"id": "project_planning_stale", "exit_id": "planning_stale", "consumer_input_id": "planning_stale_workflow_input", "operation": "direct"},
      {"id": "project_blocked", "exit_id": "blocked", "consumer_input_id": "blocked_stop_input", "operation": "select", "mappings": []}
    ],
    "private_artifacts": [
      {
        "id": "phase2_check",
        "kind": "gate_evidence",
        "schema": {"schema_id": "https://github.com/castbox/guru-trellis/schemas/guru-phase2-check-4.0.json", "path": "schemas/phase2-check.schema.json"},
        "persistence": "ignored_runtime"
      }
    ]
  }
}
