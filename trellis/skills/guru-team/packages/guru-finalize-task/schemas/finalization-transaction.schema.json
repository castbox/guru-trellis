{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-finalization-transaction-3.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_id", "mode", "task_ref", "repo_ref", "base_branch", "branch", "branch_review_commit", "publication_head", "plan_digest", "publication", "close_issues", "next_transition"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "skill_id": {"const": "guru-finalize-task"},
    "mode": {"enum": ["ordinary_publication", "existing_pr_recovery"]},
    "task_ref": {"type": "string", "minLength": 1},
    "repo_ref": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "base_branch": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "branch_review_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "publication_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publication": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {"title": {"type": "string", "minLength": 1}, "body": {"type": "string", "minLength": 1}}
    },
    "close_issues": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "next_transition": {"enum": ["push_content", "bind_pr", "archive", "push_archive", "mark_ready"]},
    "pre_push_remote_head": {"type": "string", "pattern": "^(?:|[0-9a-f]{40})$"},
    "pr": {
      "type": "object", "additionalProperties": false,
      "required": ["number", "url"],
      "properties": {"number": {"type": "integer", "minimum": 1}, "url": {"type": "string", "minLength": 1}}
    },
    "adopted_pr": {
      "type": "object", "additionalProperties": false,
      "required": ["number", "url", "initial_is_draft", "pre_push_remote_head"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "url": {"type": "string", "minLength": 1},
        "initial_is_draft": {"type": "boolean"},
        "pre_push_remote_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"next_transition": {"const": "push_content"}},
        "required": ["next_transition"]
      },
      "then": {"required": ["pre_push_remote_head"]},
      "else": {"not": {"required": ["pre_push_remote_head"]}}
    },
    {
      "if": {
        "properties": {"mode": {"const": "existing_pr_recovery"}},
        "required": ["mode"]
      },
      "then": {"required": ["adopted_pr", "pr"]},
      "else": {
        "not": {"anyOf": [{"required": ["adopted_pr"]}]}
      }
    }
  ]
}
