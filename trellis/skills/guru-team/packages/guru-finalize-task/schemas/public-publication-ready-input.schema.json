{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-finalize-task-input-publication-ready-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "mode", "task_ref", "reviewed_head", "publication_ref", "finalization_intent"],
  "properties": {
    "profile": {"const": "publication_ready"},
    "mode": {"const": "workflow"},
    "task_ref": {"type": "string", "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"},
    "reviewed_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "publication_ref": {"type": "string", "minLength": 1},
    "finalization_intent": {"type": "string", "minLength": 1}
  }
}
