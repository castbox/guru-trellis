{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-clarify-requirements-issue-review-owner-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "public_input",
    "typed_exit",
    "result_summary",
    "source_refs",
    "ai_review_gate",
    "source_selection",
    "clarification"
  ],
  "properties": {
    "public_input": {
      "type": "object"
    },
    "typed_exit": {
      "enum": [
        "supplemented",
        "needs_context",
        "blocked"
      ]
    },
    "result_summary": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ai_review_gate": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "guru-issue-review-gate-1.0",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "reroute",
            "blocked"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_selection": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locator",
          "section",
          "authority_kind"
        ],
        "properties": {
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "authority_kind": {
            "enum": [
              "requirement",
              "design_constraint",
              "advisory"
            ]
          }
        }
      }
    },
    "clarification": {
      "$ref": "issue-clarification-1.0.schema.json"
    }
  }
}
