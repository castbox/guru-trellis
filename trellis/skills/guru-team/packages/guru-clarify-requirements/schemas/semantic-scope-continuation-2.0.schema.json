{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-clarify-requirements-semantic-scope-continuation-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "public_input",
    "typed_exit",
    "reason",
    "ai_review_gate"
  ],
  "properties": {
    "public_input": {
      "type": "object"
    },
    "typed_exit": {
      "enum": [
        "scope_ready",
        "blocked"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "ai_review_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "blocked"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_selection": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locator",
          "section",
          "authority_kind"
        ],
        "properties": {
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "authority_kind": {
            "enum": [
              "requirement",
              "design_constraint",
              "advisory"
            ]
          }
        }
      }
    },
    "revision_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope_action": {
      "enum": [
        "revised",
        "withdrawal_required",
        "no_change"
      ]
    },
    "authority": {
      "type": "object",
      "description": "Opaque upstream AuthorityRef; fresh verified by the installed parser/store."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "typed_exit": {
            "const": "scope_ready"
          }
        }
      },
      "then": {
        "required": [
          "source_selection",
          "revision_refs",
          "scope_action"
        ]
      }
    }
  ]
}
