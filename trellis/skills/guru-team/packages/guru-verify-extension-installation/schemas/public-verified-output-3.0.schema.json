{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-extension-verify-installation-output-verified-3.0",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_id", "mode", "task_ref", "plan_ref", "branch_review_commit", "publication_head", "verification_ref"],
      "properties": {
        "exit_id": {"const": "verified"},
        "mode": {"const": "workflow"},
        "task_ref": {"type": "string", "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"},
        "plan_ref": {"type": "string", "minLength": 1},
        "branch_review_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "publication_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "verification_ref": {"type": "string", "minLength": 1}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_id", "mode", "repo_ref", "resolved_head", "verification_ref"],
      "properties": {
        "exit_id": {"const": "verified"},
        "mode": {"const": "standalone"},
        "repo_ref": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "resolved_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "verification_ref": {"type": "string", "minLength": 1}
      }
    }
  ]
}
