  "state": "active",
  "judgment_mode": "semantic",
  "modes": {
    "workflow": {
      "routing": "global_workflow",
      "entry_precondition_ids": [
        "runtime_dependency",
        "profile_binding",
        "architecture_authority",
        "project_change_contract",
        "invocation_freshness"
      ]
    },
    "standalone": {
      "routing": "direct_discovery",
      "entry_precondition_ids": [
        "runtime_dependency",
        "profile_binding",
        "architecture_authority",
        "project_change_contract",
        "invocation_freshness"
      ]
    }
  },
  "entry_preconditions": [
    {
      "id": "runtime_dependency",
      "evidence": "compatible Guru Team runtime",
      "binding": "current installation",
      "freshness": "validated before invocation"
    },
    {
      "id": "profile_binding",
      "evidence": "planning-purpose-specific 3.0 input or nonplanning 2.0 input",
      "binding": "the exact caller, mode, profile, stage, task, and continuation",
      "freshness": "fresh for every stage judgment"
    },
    {
      "id": "architecture_authority",
      "evidence": "live baseline plus explicit current-or-pending design-constitution locator, identity, status, and five principle identities",
      "binding": "the project-owned Architecture authority reread by the AI",
      "freshness": "identity or authority-status changes require complete re-entry"
    },
    {
      "id": "project_change_contract",
      "evidence": "project change-contract, required-concern-set identity, and current project-check descriptors",
      "binding": "the task-local project architecture contract and descriptor authority",
      "freshness": "scope, owner, boundary, applicability, descriptor, or check changes require re-entry"
    },
    {
      "id": "invocation_freshness",
      "evidence": "input digest, semantic gate, exact consumer and minimal output",
      "binding": "one call-local semantic round",
      "freshness": "baseline, constitution, contribution, project check, or committed range changes invalidate the result"
    }
  ],
  "runtime_dependency": {
    "extension_id": "guru-team",
    "api_version": "1.0",
    "manifest_path": ".trellis/guru-team/extension.json",
    "dispatcher": "run-skill-command",
