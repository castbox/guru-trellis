{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-establish-task-branch-binding-input-delivery-restored-checkout-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "task_id",
    "task_ref",
    "lifecycle_generation",
    "branch_name",
    "expected_head"
  ],
  "properties": {
    "profile": {
      "const": "delivery_restored_checkout"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_ref": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle_generation": {
      "type": "integer",
      "minimum": 0
    },
    "branch_name": {
      "type": "string",
      "minLength": 1
    },
    "expected_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
