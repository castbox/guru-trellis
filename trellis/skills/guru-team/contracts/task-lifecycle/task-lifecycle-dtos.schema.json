{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-task-lifecycle-dtos-1.0",
  "title": "Guru Team task lifecycle DTO catalog",
  "oneOf": [
    {"$ref": "#/$defs/TaskIdentityDTO"},
    {"$ref": "#/$defs/TaskLifecycleDTO"},
    {"$ref": "#/$defs/TaskArtifactDTO"},
    {"$ref": "#/$defs/ResultRefDTO"},
    {"$ref": "#/$defs/IssueRefDTO"},
    {"$ref": "#/$defs/IssueIntakeRefDTO"},
    {"$ref": "#/$defs/SourceRelationRefDTO"},
    {"$ref": "#/$defs/SourceCorrectionReadyDTO"},
    {"$ref": "#/$defs/DeliveryTargetRefDTO"},
    {"$ref": "#/$defs/BranchBindingRefDTO"},
    {"$ref": "#/$defs/CheckoutAcquisitionPlanDTO"},
    {"$ref": "#/$defs/CheckoutCandidateDTO"},
    {"$ref": "#/$defs/CheckoutResolutionDTO"},
    {"$ref": "#/$defs/CheckoutSelectionDTO"},
    {"$ref": "#/$defs/CheckpointRefDTO"},
    {"$ref": "#/$defs/HandoffRefDTO"},
    {"$ref": "#/$defs/HandoffInventoryRefDTO"},
    {"$ref": "#/$defs/ResourceSealRefDTO"},
    {"$ref": "#/$defs/TerminalFinishRefDTO"},
    {"$ref": "#/$defs/CleanupResultRefDTO"},
    {"$ref": "#/$defs/PlanningApprovalRefDTO"},
    {"$ref": "#/$defs/BaseReconcileResultDTO"},
    {"$ref": "#/$defs/BaseContinuitySeedDTO"},
    {"$ref": "#/$defs/BaseContinuityResultDTO"},
    {"$ref": "#/$defs/Phase2ResultDTO"},
    {"$ref": "#/$defs/TaskCommitResultDTO"},
    {"$ref": "#/$defs/BranchReviewResultDTO"},
    {"$ref": "#/$defs/PublicationReadyDTO"},
    {"$ref": "#/$defs/DeliveryReviewReadyDTO"},
    {"$ref": "#/$defs/MergeReadyDTO"},
    {"$ref": "#/$defs/DeliveryMergeReadyDTO"},
    {"$ref": "#/$defs/TaskMergeResultDTO"},
    {"$ref": "#/$defs/DeliveryMergeResultDTO"},
    {"$ref": "#/$defs/FinalizerBaseReconcileSeedDTO"},
    {"$ref": "#/$defs/PublicationRefreshSeedDTO"},
    {"$ref": "#/$defs/FinalizationReprepareRefDTO"},
    {"$ref": "#/$defs/MergedPRRecoveryRefDTO"},
    {"$ref": "#/$defs/TransactionRefDTO"},
    {"$ref": "#/$defs/ReasonDTO"}
  ],
  "$defs": {
    "taskId": {"type": "string", "pattern": "^(?!.*\\.\\.)(?!.*(?:\\.lock|\\.)$)[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "taskRef": {"type": "string", "pattern": "^\\.trellis/tasks/(?!archive(?:/|$))(?!\\.{1,2}$)[^/\\\\]+$|^\\.trellis/tasks/archive/[0-9]{4}-[0-9]{2}/(?!\\.{1,2}$)[^/\\\\]+$"},
    "generation": {"type": "integer", "minimum": 0},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "repoRef": {"type": "string", "pattern": "^(?![^/]+/[^/]+\\.git$)[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "branchRef": {"type": "string", "minLength": 1, "pattern": "^(?!-)(?!HEAD$)(?!/)(?!refs/remotes/)(?!(?:refs/heads/)?guru-task-lifecycle(?:/|$))(?!.*(?:^|/)\\.)(?!.*(?:^|/)[^/]*\\.lock(?:/|$))(?!.*\\.\\.)(?!.*@\\{)(?!.*[ ~^:?*\\[\\]\\\\])(?!.*[./]$)[^/]+(?:/[^/]+)*$"},
    "handoffReceiptRef": {"type": "string", "pattern": "^refs/heads/guru-task-lifecycle/(?!.*\\.\\.)(?!.*(?:\\.lock|\\.)$)[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repoPath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$"},
    "absolutePath": {"type": "string", "minLength": 1, "pattern": "^(?:/|[A-Za-z]:[\\\\/]).+$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "IssueSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repo_ref", "number"],
      "properties": {
        "kind": {"const": "issue"},
        "repo_ref": {"$ref": "#/$defs/repoRef"},
        "number": {"type": "integer", "minimum": 1}
      }
    },
    "NoIssueSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {"kind": {"const": "no_issue"}}
    },
    "TaskSource": {
      "oneOf": [
        {"$ref": "#/$defs/IssueSource"},
        {"$ref": "#/$defs/NoIssueSource"}
      ]
    },
    "DeliveryTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_ref", "branch_ref"],
      "properties": {
        "repo_ref": {"$ref": "#/$defs/repoRef"},
        "branch_ref": {"$ref": "#/$defs/branchRef"}
      }
    },
    "TaskIdentityDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "task_ref"],
      "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "task_ref": {"$ref": "#/$defs/taskRef"}}
    },
    "TaskLifecycleDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "lifecycle_generation"],
      "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "lifecycle_generation": {"$ref": "#/$defs/generation"}}
    },
    "TaskArtifactDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "task_ref", "lifecycle_generation"],
      "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "lifecycle_generation": {"$ref": "#/$defs/generation"}}
    },
    "ResultRefDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "lifecycle_generation", "result_id"],
      "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "lifecycle_generation": {"$ref": "#/$defs/generation"}, "result_id": {"$ref": "#/$defs/identifier"}}
    },
    "IssueRefDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["repo_ref", "issue_number"],
      "properties": {"repo_ref": {"$ref": "#/$defs/repoRef"}, "issue_number": {"type": "integer", "minimum": 1}}
    },
    "IssueIntakeRefDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["repo_ref", "issue_number", "result_id"],
      "properties": {"repo_ref": {"$ref": "#/$defs/repoRef"}, "issue_number": {"type": "integer", "minimum": 1}, "result_id": {"$ref": "#/$defs/identifier"}}
    },
    "SourceRelationRefDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "lifecycle_generation", "source_relation_id"],
      "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "lifecycle_generation": {"$ref": "#/$defs/generation"}, "source_relation_id": {"$ref": "#/$defs/identifier"}}
    },
    "SourceCorrectionReadyDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "task_ref", "lifecycle_generation", "current_source", "reviewed_source", "accepted_scope_identity", "target_relation_id", "result_id"],
      "properties": {
        "task_id": {"$ref": "#/$defs/taskId"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "lifecycle_generation": {"$ref": "#/$defs/generation"},
        "current_source": {"$ref": "#/$defs/TaskSource"}, "reviewed_source": {"$ref": "#/$defs/TaskSource"},
        "accepted_scope_identity": {"$ref": "#/$defs/identifier"}, "target_relation_id": {"$ref": "#/$defs/identifier"}, "result_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "DeliveryTargetRefDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "lifecycle_generation", "target_relation_id"],
      "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "lifecycle_generation": {"$ref": "#/$defs/generation"}, "target_relation_id": {"$ref": "#/$defs/identifier"}}
    },
    "BranchBindingRefDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "lifecycle_generation", "binding_epoch", "binding_revision"],
      "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "lifecycle_generation": {"$ref": "#/$defs/generation"}, "binding_epoch": {"type": "integer", "minimum": 0}, "binding_revision": {"type": "integer", "minimum": 0}}
    },
    "CheckoutAcquisitionPlanDTO": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["task_id", "task_ref", "lifecycle_generation", "route", "branch_ref", "decision_head", "task_artifact_expectation", "invocation_checkout", "transaction_id", "result_id"],
          "properties": {
            "task_id": {"$ref": "#/$defs/taskId"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "lifecycle_generation": {"$ref": "#/$defs/generation"},
            "route": {"const": "adopt_invocation_checkout"}, "branch_ref": {"$ref": "#/$defs/branchRef"}, "decision_head": {"$ref": "#/$defs/commit"},
            "task_artifact_expectation": {"enum": ["required", "absent"]},
            "invocation_checkout": {"$ref": "#/$defs/absolutePath"}, "transaction_id": {"$ref": "#/$defs/identifier"}, "result_id": {"$ref": "#/$defs/identifier"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["task_id", "task_ref", "lifecycle_generation", "route", "branch_ref", "decision_head", "task_artifact_expectation", "provision_disposition", "target_path", "transaction_id", "result_id"],
          "properties": {
            "task_id": {"$ref": "#/$defs/taskId"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "lifecycle_generation": {"$ref": "#/$defs/generation"},
            "route": {"const": "provision_linked_worktree"}, "branch_ref": {"$ref": "#/$defs/branchRef"}, "decision_head": {"$ref": "#/$defs/commit"},
            "task_artifact_expectation": {"enum": ["required", "absent"]},
            "provision_disposition": {"enum": ["new_branch", "existing_branch", "existing_checkout"]}, "target_path": {"$ref": "#/$defs/absolutePath"},
            "transaction_id": {"$ref": "#/$defs/identifier"}, "result_id": {"$ref": "#/$defs/identifier"}
          }
        }
      ]
    },
    "CheckoutCandidateDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "path", "head", "branch_ref", "topology", "dirty_paths", "discovered_at", "validation_state", "reason_code"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/identifier"}, "path": {"$ref": "#/$defs/absolutePath"},
        "head": {"anyOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
        "branch_ref": {"anyOf": [{"$ref": "#/$defs/branchRef"}, {"type": "null"}]}, "topology": {"enum": ["primary", "linked", "registered"]},
        "dirty_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "discovered_at": {"$ref": "#/$defs/timestamp"}, "validation_state": {"enum": ["valid", "invalid_candidate", "authority_conflict"]},
        "reason_code": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}
      },
      "allOf": [
        {"if": {"properties": {"validation_state": {"const": "valid"}}, "required": ["validation_state"]}, "then": {"properties": {"reason_code": {"type": "null"}}}},
        {"if": {"properties": {"validation_state": {"enum": ["invalid_candidate", "authority_conflict"]}}, "required": ["validation_state"]}, "then": {"properties": {"reason_code": {"$ref": "#/$defs/identifier"}}}}
      ]
    },
    "CheckoutResolutionDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["resolution_kind", "reason_code", "candidate_ids", "selected_candidate_id"],
      "properties": {
        "resolution_kind": {"enum": ["checkout_resolved", "selection_required", "authority_conflict"]},
        "reason_code": {"$ref": "#/$defs/identifier"},
        "candidate_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "selected_candidate_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}
      },
      "allOf": [
        {"if": {"properties": {"resolution_kind": {"const": "checkout_resolved"}}, "required": ["resolution_kind"]}, "then": {"properties": {"selected_candidate_id": {"$ref": "#/$defs/identifier"}}}},
        {"if": {"properties": {"resolution_kind": {"enum": ["selection_required", "authority_conflict"]}}, "required": ["resolution_kind"]}, "then": {"properties": {"selected_candidate_id": {"type": "null"}}}}
      ]
    },
    "CheckoutSelectionDTO": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["selection_kind", "candidate_id", "branch_ref", "expected_head", "selected_at"],
          "properties": {
            "selection_kind": {"const": "discovered_candidate"}, "candidate_id": {"$ref": "#/$defs/identifier"},
            "branch_ref": {"$ref": "#/$defs/branchRef"}, "expected_head": {"$ref": "#/$defs/commit"}, "selected_at": {"$ref": "#/$defs/timestamp"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["selection_kind", "target_path", "branch_ref", "expected_head", "selected_at"],
          "properties": {
            "selection_kind": {"const": "explicit_target"}, "target_path": {"$ref": "#/$defs/absolutePath"},
            "branch_ref": {"$ref": "#/$defs/branchRef"}, "expected_head": {"$ref": "#/$defs/commit"}, "selected_at": {"$ref": "#/$defs/timestamp"}
          }
        }
      ]
    },
    "CheckpointRefDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "lifecycle_generation", "checkpoint_commit", "checkpoint_ref", "result_id"],
      "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "lifecycle_generation": {"$ref": "#/$defs/generation"}, "checkpoint_commit": {"$ref": "#/$defs/commit"}, "checkpoint_ref": {"$ref": "#/$defs/branchRef"}, "result_id": {"$ref": "#/$defs/identifier"}}
    },
    "HandoffRefDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "lifecycle_generation", "handoff_id", "receipt_ref", "result_id"],
      "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "lifecycle_generation": {"$ref": "#/$defs/generation"}, "handoff_id": {"$ref": "#/$defs/identifier"}, "receipt_ref": {"$ref": "#/$defs/handoffReceiptRef"}, "result_id": {"$ref": "#/$defs/identifier"}}
    },
    "HandoffInventoryRefDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "lifecycle_generation", "handoff_id", "inventory_id"],
      "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "lifecycle_generation": {"$ref": "#/$defs/generation"}, "handoff_id": {"$ref": "#/$defs/identifier"}, "inventory_id": {"$ref": "#/$defs/identifier"}}
    },
    "ResourceSealRefDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "lifecycle_generation", "finish_result_id", "inventory_id"],
      "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "lifecycle_generation": {"$ref": "#/$defs/generation"}, "finish_result_id": {"$ref": "#/$defs/identifier"}, "inventory_id": {"$ref": "#/$defs/identifier"}}
    },
    "TerminalFinishRefDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "lifecycle_generation", "finish_result_id", "cleanup_state"],
      "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "lifecycle_generation": {"$ref": "#/$defs/generation"}, "finish_result_id": {"$ref": "#/$defs/identifier"}, "cleanup_state": {"const": "manual_cleanup_required"}}
    },
    "CleanupResultRefDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "lifecycle_generation", "cleanup_result_id"],
      "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "lifecycle_generation": {"$ref": "#/$defs/generation"}, "cleanup_result_id": {"$ref": "#/$defs/identifier"}}
    },
    "PlanningApprovalRefDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "task_ref", "lifecycle_generation", "result_id"],
      "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "lifecycle_generation": {"$ref": "#/$defs/generation"}, "result_id": {"$ref": "#/$defs/identifier"}}
    },
    "BaseReconcileResultDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "task_ref", "lifecycle_generation", "task_head", "new_base_head", "resume_target", "result_id"],
      "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "lifecycle_generation": {"$ref": "#/$defs/generation"}, "task_head": {"$ref": "#/$defs/commit"}, "new_base_head": {"$ref": "#/$defs/commit"}, "resume_target": {"$ref": "#/$defs/identifier"}, "result_id": {"$ref": "#/$defs/identifier"}}
    },
    "BaseContinuitySeedDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "task_ref", "lifecycle_generation", "task_head", "old_base_head", "new_base_head", "branch_review_commit", "candidate_tree_sha256", "relevant_paths", "resume_target", "result_id"],
      "properties": {
        "task_id": {"$ref": "#/$defs/taskId"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "lifecycle_generation": {"$ref": "#/$defs/generation"},
        "task_head": {"$ref": "#/$defs/commit"}, "old_base_head": {"$ref": "#/$defs/commit"}, "new_base_head": {"$ref": "#/$defs/commit"}, "branch_review_commit": {"$ref": "#/$defs/commit"},
        "candidate_tree_sha256": {"$ref": "#/$defs/sha256"}, "relevant_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repoPath"}},
        "resume_target": {"$ref": "#/$defs/identifier"}, "result_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "BaseContinuityResultDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "task_ref", "lifecycle_generation", "branch_review_commit", "resume_target", "result_id"],
      "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "lifecycle_generation": {"$ref": "#/$defs/generation"}, "branch_review_commit": {"$ref": "#/$defs/commit"}, "resume_target": {"$ref": "#/$defs/identifier"}, "result_id": {"$ref": "#/$defs/identifier"}}
    },
    "Phase2ResultDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "task_ref", "lifecycle_generation", "phase2_commit_anchor", "result_id"],
      "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "lifecycle_generation": {"$ref": "#/$defs/generation"}, "phase2_commit_anchor": {"$ref": "#/$defs/commit"}, "result_id": {"$ref": "#/$defs/identifier"}}
    },
    "TaskCommitResultDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "task_ref", "lifecycle_generation", "base_ref", "branch_review_commit", "result_id"],
      "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "lifecycle_generation": {"$ref": "#/$defs/generation"}, "base_ref": {"$ref": "#/$defs/branchRef"}, "branch_review_commit": {"$ref": "#/$defs/commit"}, "result_id": {"$ref": "#/$defs/identifier"}}
    },
    "BranchReviewResultDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "task_ref", "lifecycle_generation", "branch_review_commit", "result_id"],
      "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "lifecycle_generation": {"$ref": "#/$defs/generation"}, "branch_review_commit": {"$ref": "#/$defs/commit"}, "result_id": {"$ref": "#/$defs/identifier"}}
    },
    "PublicationReadyDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "task_ref", "lifecycle_generation", "branch_review_commit", "pr_title", "pr_body", "result_id"],
      "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "lifecycle_generation": {"$ref": "#/$defs/generation"}, "branch_review_commit": {"$ref": "#/$defs/commit"}, "pr_title": {"type": "string", "minLength": 1}, "pr_body": {"type": "string", "minLength": 1}, "result_id": {"$ref": "#/$defs/identifier"}}
    },
    "DeliveryReviewReadyDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "task_ref", "lifecycle_generation", "delivery_cycle_ref", "reviewed_head", "pr_title", "pr_body", "remaining_work_state", "result_id"],
      "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "lifecycle_generation": {"$ref": "#/$defs/generation"}, "delivery_cycle_ref": {"$ref": "#/$defs/identifier"}, "reviewed_head": {"$ref": "#/$defs/commit"}, "pr_title": {"type": "string", "minLength": 1}, "pr_body": {"type": "string", "minLength": 1}, "remaining_work_state": {"enum": ["none", "remaining"]}, "result_id": {"$ref": "#/$defs/identifier"}}
    },
    "MergeReadyDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "lifecycle_generation", "repo_ref", "pr_number", "expected_head_sha", "expected_base_branch", "expected_head_branch", "publication_body_sha256", "result_id"],
      "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "lifecycle_generation": {"$ref": "#/$defs/generation"}, "repo_ref": {"$ref": "#/$defs/repoRef"}, "pr_number": {"type": "integer", "minimum": 1}, "expected_head_sha": {"$ref": "#/$defs/commit"}, "expected_base_branch": {"$ref": "#/$defs/branchRef"}, "expected_head_branch": {"$ref": "#/$defs/branchRef"}, "publication_body_sha256": {"$ref": "#/$defs/sha256"}, "result_id": {"$ref": "#/$defs/identifier"}}
    },
    "DeliveryMergeReadyDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "task_ref", "lifecycle_generation", "delivery_cycle_ref", "repo_ref", "pr_number", "expected_head_sha", "publication_body_sha256", "result_id"],
      "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "lifecycle_generation": {"$ref": "#/$defs/generation"}, "delivery_cycle_ref": {"$ref": "#/$defs/identifier"}, "repo_ref": {"$ref": "#/$defs/repoRef"}, "pr_number": {"type": "integer", "minimum": 1}, "expected_head_sha": {"$ref": "#/$defs/commit"}, "publication_body_sha256": {"$ref": "#/$defs/sha256"}, "result_id": {"$ref": "#/$defs/identifier"}}
    },
    "TaskMergeResultDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "lifecycle_generation", "repo_ref", "pr_number", "merge_commit_sha", "merge_lineage", "result_id"],
      "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "lifecycle_generation": {"$ref": "#/$defs/generation"}, "repo_ref": {"$ref": "#/$defs/repoRef"}, "pr_number": {"type": "integer", "minimum": 1}, "merge_commit_sha": {"$ref": "#/$defs/commit"}, "merge_lineage": {"enum": ["closeout", "pre_cutover_recovered"]}, "result_id": {"$ref": "#/$defs/identifier"}}
    },
    "DeliveryMergeResultDTO": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "task_ref", "lifecycle_generation", "delivery_cycle_ref", "repo_ref", "pr_number", "reviewed_head", "merge_commit_sha", "result_id"],
