{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/castbox/guru-trellis/schemas/upstream-ownership-3.0.json",
  "title": "Guru Team current ownership inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_id",
    "target_trellis_cli",
    "overlay_root",
    "guru_owned_rules",
    "managed_path_claims"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "inventory_id": {"const": "guru-team-upstream-ownership"},
    "target_trellis_cli": {"const": "0.6.5"},
    "overlay_root": {"const": "trellis/presets/guru-team/overlays"},
    "guru_owned_rules": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/guruOwnedRule"}
    },
    "managed_path_claims": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/managedPathClaim"}
    }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f]+$"
    },
    "guruOwnedRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "match_type", "pattern", "category"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "match_type": {"enum": ["path_prefix", "path_glob", "skill_id_prefix"]},
        "pattern": {"type": "string", "minLength": 1},
        "category": {"const": "guru_owned"}
      }
    },
    "managedPathClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "category", "classification_rule"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "category": {"const": "guru_owned"},
        "classification_rule": {"type": "string", "minLength": 1}
      }
    }
  }
}
