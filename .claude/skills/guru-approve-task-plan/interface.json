{
  "$schema": "../../schemas/skill-interface-1.4.schema.json",
  "schema_version": "1.4",
  "id": "guru-approve-task-plan",
  "name": "guru-approve-task-plan",
  "description": "Approve current task planning through one AI-owned semantic review, compact private evidence, and four minimal typed exits.",
  "state": "active",
  "judgment_mode": "semantic",
  "modes": {
    "workflow": {
      "routing": "global_workflow",
      "entry_precondition_ids": [
        "runtime_dependency",
        "task_workspace",
        "current_authority",
        "planning_documents",
        "docs_ssot",
        "wording_result",
        "issue_scope",
        "invocation_freshness"
      ]
    },
    "standalone": {
      "routing": "direct_discovery",
      "entry_precondition_ids": [
        "runtime_dependency",
        "task_workspace",
        "current_authority",
        "planning_documents",
        "docs_ssot",
        "wording_result",
        "issue_scope",
        "invocation_freshness"
      ]
    }
  },
  "entry_preconditions": [
    {
      "id": "runtime_dependency",
      "evidence": "installed extension manifest, dispatcher, active package inventory, schema, and declared recorder/checker commands",
      "binding": "complete compatible Guru Team preset runtime",
      "freshness": "run-skill-command validates the managed runtime before each command"
    },
    {
      "id": "task_workspace",
      "evidence": "direct active task locator, task.json, current checkout, and workspace boundary",
      "binding": "one task in its expected repository worktree",
      "freshness": "the workspace boundary is rebuilt before record and check"
    },
    {
      "id": "current_authority",
      "evidence": "live issue, selected current comments, user request, and task-local authority references",
      "binding": "the current authority for every load-bearing planning decision",
      "freshness": "the AI rereads live authority before the semantic result"
    },
    {
      "id": "planning_documents",
      "evidence": "current non-empty prd.md, design.md, and implement.md",
      "binding": "the three planning documents reviewed by this owner",
      "freshness": "the AI rereads current files and the validator recomputes one owner-private composite token over the three planning paths"
    },
    {
      "id": "docs_ssot",
      "evidence": "current strategy, durable paths, and semantic execution summary",
      "binding": "the durable documentation responsibility for the task",
      "freshness": "the AI classifies current Docs SSOT meaning before recording"
    },
    {
      "id": "wording_result",
      "evidence": "current passed planning wording result",
      "binding": "the same planning scope consumed by this owner",
      "freshness": "the wording owner is rerun only when its semantic dependency changes"
    },
    {
      "id": "issue_scope",
      "evidence": "current primary, close, related, and follow-up issue decisions",
      "binding": "the accepted task scope",
      "freshness": "the AI rereads the issue scope ledger and live authority"
    },
    {
      "id": "invocation_freshness",
      "evidence": "mode, task, one local composite planning-content token, current semantic result, typed exit, reason, and consumer",
      "binding": "one complete owner round",
      "freshness": "the checker rejects missing, stale, multiple, unknown, or consumer-mismatched results"
    }
  ],
  "runtime_dependency": {
    "extension_id": "guru-team",
    "api_version": "1.0",
    "manifest_path": ".trellis/guru-team/extension.json",
    "dispatcher": "run-skill-command",
    "distribution": "guru-team-preset",
    "package_portability": "not-self-contained"
  },
  "ordered_stages": [
    "forward_behavior",
    "ai_review_gate",
    "conditional_human_confirmation",
    "recorder_validator",
    "typed_exit"
  ],
  "artifacts": [
    {"id": "planning_approval_example", "path": "examples/planning-approval.json"},
    {"id": "public_input_initial_review_example", "path": "examples/public-initial-review-input.json"},
    {"id": "public_input_revision_reentry_example", "path": "examples/public-revision-reentry-input.json"},
    {"id": "revision_reentry_authoring", "path": "examples/public-revision-reentry-authoring.json"},
    {"id": "public_input_clarification_reentry_example", "path": "examples/public-clarification-reentry-input.json"},
    {"id": "public_invocation_error_example", "path": "examples/public-invocation-error.json"},
    {"id": "public_output_approved_example", "path": "examples/public-approved-output.json"},
    {"id": "public_output_revision_required_example", "path": "examples/public-revision-required-output.json"},
    {"id": "public_output_clarify_scope_example", "path": "examples/public-clarify-scope-output.json"},
    {"id": "public_output_blocked_example", "path": "examples/public-blocked-output.json"}
  ],
  "schemas": [
    {"id": "planning_approval_schema", "path": "schemas/planning-approval.schema.json"},
    {"id": "public_input_initial_review", "path": "schemas/public-initial-review-input.schema.json"},
    {"id": "public_input_revision_reentry", "path": "schemas/public-revision-reentry-input.schema.json"},
    {"id": "public_input_clarification_reentry", "path": "schemas/public-clarification-reentry-input.schema.json"},
    {"id": "public_input_aggregate", "path": "schemas/public-input.schema.json"},
    {"id": "public_invocation_error", "path": "schemas/public-invocation-error.schema.json"},
    {"id": "public_output_approved", "path": "schemas/public-approved-output.schema.json"},
    {"id": "public_output_revision_required", "path": "schemas/public-revision-required-output.schema.json"},
    {"id": "public_output_clarify_scope", "path": "schemas/public-clarify-scope-output.schema.json"},
    {"id": "public_output_blocked", "path": "schemas/public-blocked-output.schema.json"}
  ],
  "validators": [
    {
      "id": "planning_artifact_resolver",
      "command": "scripts/resolve-human-artifacts.sh",
      "runtime_command": "resolve-planning-artifacts",
      "objective_scope": "resolve the current or explicitly selected Trellis task and report its three human planning documents without judging plan adequacy"
    },
    {
      "id": "planning_approval_recorder",
      "command": "scripts/record-planning-approval.sh",
      "runtime_command": "record-planning-approval",
      "objective_scope": "write the completed compact semantic result after current task and required planning locators pass objective checks"
    },
    {
      "id": "planning_approval_checker",
      "command": "scripts/check-planning-approval.sh",
      "runtime_command": "check-planning-approval",
      "objective_scope": "validate schema 3.0 closure, task and required-file locators, semantic union, typed exit, and unique consumer"
    },
    {
      "id": "public_invocation",
      "command": "scripts/invoke.sh",
      "runtime_command": "invoke-guru-approve-task-plan",
      "objective_scope": "validate the minimal route input, check the owner-private result, and serialize one minimal typed exit"
    }
  ],
  "external_exits": [
    {
      "id": "approved",
      "evidence": "the current eight-dimension semantic result passed with no finding, revision, scope proposal, or blocker",
      "consumer": {"kind": "workflow", "id": "phase-1-task-activation"}
    },
    {
      "id": "revision_required",
      "evidence": "the AI identified one or more task-local planning revisions",
      "consumer": {"kind": "skill", "id": "guru-approve-task-plan"}
    },
    {
      "id": "clarify_scope",
      "evidence": "the AI identified one or more exact scope proposals",
      "consumer": {"kind": "workflow", "id": "guru-task-plan-clarify-scope-router"}
    },
    {
      "id": "blocked",
      "evidence": "a concrete authority or evidence gap prevents a reliable planning result",
      "consumer": {"kind": "stop", "id": "task-plan-approval-blocked"}
    }
  ],
  "reentry": {
    "identity": "mode, task, current authority and planning locators, one local composite planning-content token, compact semantic result, typed exit, and consumer",
    "freshness": "the AI classifies each current delta and reruns only the semantic owner whose dependency changed",
    "stale_behavior": "fail_closed"
  },
  "tests": ["tests/test_contract.py"],
  "platform_destinations": ["shared", "codex", "cursor", "claude"],
  "public_contracts": {
    "input": {
      "kind": "structured_json",
      "aggregate_schema": {
        "schema_id": "guru-production-approve-task-plan-input-aggregate-2.0",
        "path": "schemas/public-input.schema.json"
      },
      "profiles": [
        {
          "id": "initial_review",
          "schema": {"schema_id": "guru-production-approve-task-plan-input-initial-review-2.0", "path": "schemas/public-initial-review-input.schema.json"},
          "example": {"id": "initial_review_input", "path": "examples/public-initial-review-input.json"},
          "discriminator": {"field": "profile", "value": "initial_review"}
        },
        {
          "id": "revision_reentry",
          "schema": {"schema_id": "guru-production-approve-task-plan-input-revision-reentry-2.0", "path": "schemas/public-revision-reentry-input.schema.json"},
          "example": {"id": "revision_reentry_input", "path": "examples/public-revision-reentry-input.json"},
          "discriminator": {"field": "profile", "value": "revision_reentry"}
        },
        {
          "id": "clarification_reentry",
          "schema": {"schema_id": "guru-production-approve-task-plan-input-clarification-reentry-2.0", "path": "schemas/public-clarification-reentry-input.schema.json"},
          "example": {"id": "clarification_reentry_input", "path": "examples/public-clarification-reentry-input.json"},
          "discriminator": {"field": "profile", "value": "clarification_reentry"}
        }
      ]
    },
    "invocation": {
      "command_id": "run-skill-command",
      "wrapper": "scripts/invoke.sh",
      "input_binding": {"kind": "structured_json", "profile_id": "initial_review"},
      "stdout_contract": "single_typed_exit",
      "error_schema": {"schema_id": "guru-production-approve-task-plan-invocation-error-1.0", "path": "schemas/public-invocation-error.schema.json"},
      "error_example": {"id": "invalid_public_input", "path": "examples/public-invocation-error.json"},
      "example_argv": ["--input", "examples/public-initial-review-input.json", "--owner-result", "examples/planning-approval.json"]
    },
    "outputs": [
      {
        "exit_id": "approved",
        "schema": {"schema_id": "guru-production-approve-task-plan-output-approved-2.0", "path": "schemas/public-approved-output.schema.json"},
        "example": {"id": "approved_output", "path": "examples/public-approved-output.json"},
        "consumer_use_ids": ["project_approved"]
      },
      {
        "exit_id": "revision_required",
        "schema": {"schema_id": "guru-production-approve-task-plan-output-revision-required-1.0", "path": "schemas/public-revision-required-output.schema.json"},
        "example": {"id": "revision_required_output", "path": "examples/public-revision-required-output.json"},
        "consumer_use_ids": ["project_revision_required"]
      },
      {
        "exit_id": "clarify_scope",
        "schema": {"schema_id": "guru-production-approve-task-plan-output-clarify-scope-1.0", "path": "schemas/public-clarify-scope-output.schema.json"},
        "example": {"id": "clarify_scope_output", "path": "examples/public-clarify-scope-output.json"},
        "consumer_use_ids": ["project_clarify_scope"]
      },
      {
        "exit_id": "blocked",
        "schema": {"schema_id": "guru-production-approve-task-plan-output-blocked-1.0", "path": "schemas/public-blocked-output.schema.json"},
        "example": {"id": "blocked_output", "path": "examples/public-blocked-output.json"},
        "consumer_use_ids": ["project_blocked"]
      }
    ],
    "consumer_inputs": [
      {
        "id": "approved_workflow_input",
        "consumer": {"kind": "workflow", "id": "phase-1-task-activation"},
        "payload_kind": "structured_json",
        "contract": {"kind": "json_schema", "schema_id": "guru-production-approve-task-plan-workflow-approved-input-2.0", "path": "consumers/workflow/production/approve-task-plan-approved.schema.json"}
      },
      {
        "id": "revision_reentry_seed_input",
        "consumer": {"kind": "skill", "id": "guru-approve-task-plan"},
        "payload_kind": "structured_json",
        "contract": {
          "kind": "skill_input_authoring_seed",
          "interface_path": "packages/guru-approve-task-plan/interface.json",
          "input_kind": "structured_json",
          "profile_id": "revision_reentry",
          "seed_fields": ["source_exit", "task_ref"],
          "authoring_fields": ["profile", "mode", "reentry_reason"],
          "authoring_example": {"id": "revision_reentry_authoring", "path": "examples/public-revision-reentry-authoring.json"}
        }
      },
      {
        "id": "clarify_scope_workflow_input",
        "consumer": {"kind": "workflow", "id": "guru-task-plan-clarify-scope-router"},
        "payload_kind": "structured_json",
        "contract": {"kind": "json_schema", "schema_id": "guru-production-approve-task-plan-workflow-clarify-scope-input-1.0", "path": "consumers/workflow/production/approve-task-plan-clarify-scope.schema.json"}
      },
      {
        "id": "blocked_stop_input",
        "consumer": {"kind": "stop", "id": "task-plan-approval-blocked"},
        "payload_kind": "zero_payload"
      }
    ],
    "projections": [
      {"id": "project_approved", "exit_id": "approved", "consumer_input_id": "approved_workflow_input", "operation": "direct"},
      {
        "id": "project_revision_required",
        "exit_id": "revision_required",
        "consumer_input_id": "revision_reentry_seed_input",
        "operation": "rename",
        "mappings": [
          {"source": "exit_id", "target": "source_exit"},
          {"source": "task_ref", "target": "task_ref"}
        ]
      },
      {"id": "project_clarify_scope", "exit_id": "clarify_scope", "consumer_input_id": "clarify_scope_workflow_input", "operation": "direct"},
      {"id": "project_blocked", "exit_id": "blocked", "consumer_input_id": "blocked_stop_input", "operation": "select", "mappings": []}
    ],
    "private_artifacts": [
      {
        "id": "planning_approval",
        "kind": "gate_evidence",
        "schema": {"schema_id": "https://github.com/castbox/guru-trellis/schemas/guru-planning-approval-3.0.json", "path": "schemas/planning-approval.schema.json"},
        "persistence": "ignored_runtime"
      }
    ]
  }
}
