      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root."
        },
        {
          "flag": "--input",
          "required": false,
          "kind": "string",
          "description": "Reviewed plan JSON locator."
        },
        {
          "flag": "--invocation",
          "required": false,
          "kind": "json",
          "description": "Call-local plan envelope."
        }
      ],
      "stdin": "none",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "runtime_write",
      "schema_bindings": [],
      "validator_id": "task_workspace_plan_recorder"
    },
    {
