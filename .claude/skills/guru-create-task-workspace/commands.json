        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root."
        },
        {
          "flag": "--input",
          "required": false,
          "kind": "string",
          "description": "Reviewed plan JSON locator."
        },
        {
          "flag": "--invocation",
          "required": false,
          "kind": "json",
          "description": "Call-local execution envelope."
        }
      ],
      "stdin": "none",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "invalid_json",
