{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-check-task-input-delivery-resolved-reconciliation-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "task_ref",
    "source_exit",
    "delivery_key",
    "planning_accepted_result_id"
  ],
  "properties": {
    "profile": {
      "const": "delivery_resolved_reconciliation"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "source_exit": {
      "const": "resolved_tree_ready"
    },
    "delivery_key": {
      "type": "object"
    },
    "planning_accepted_result_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
