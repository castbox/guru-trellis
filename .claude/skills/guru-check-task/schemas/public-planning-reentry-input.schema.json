{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-production-check-task-input-planning-reentry-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "mode", "task_ref", "source_exit", "rerun_reason"],
  "properties": {
    "profile": {"const": "planning_reentry"},
    "mode": {"enum": ["workflow", "standalone"]},
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "source_exit": {"const": "planning_stale"},
    "rerun_reason": {"const": "planning_refreshed"}
  }
}
