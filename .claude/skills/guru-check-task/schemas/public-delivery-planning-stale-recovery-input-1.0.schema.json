          "$ref": "public-delivery-candidate-check-input-1.0.schema.json"
        },
        {
          "$ref": "public-delivery-initial-check-input-1.0.schema.json"
        },
        {
          "$ref": "public-delivery-finding-fix-rerun-input-1.0.schema.json"
        },
        {
          "$ref": "public-delivery-planning-reentry-input-1.0.schema.json"
        },
        {
          "$ref": "public-delivery-resolved-reconciliation-input-1.0.schema.json"
        }
      ]
    }
  }
}
