{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-consumer-guru-check-task-candidate-checked-delivery-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "task_ref",
    "delivery_key",
    "candidate"
  ],
  "properties": {
    "exit_id": {
      "const": "candidate_checked"
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "delivery_key": {
      "type": "object"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "content_identity"
      ],
      "properties": {
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "content_identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
