{
  "schema_version": "1.1",
  "package_id": "guru-check-task",
  "commands": [
    {
      "id": "record-phase2-check",
      "owner": "guru-check-task",
      "entrypoint": "runtime/record.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--task",
          "required": false,
          "kind": "string",
          "description": "Task locator.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--input",
          "required": true,
          "kind": "string",
          "description": "11-field semantic authoring JSON file; complete 6.0 results are output/consumer-only (MIGRATION-710).",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--dry-run",
          "required": true,
          "kind": "boolean",
          "description": "Required for original rollback semantic correction; no current development checkpoint write.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--skill-input",
          "required": true,
          "kind": "string",
          "description": "Original delivery_planning_stale_recovery input; required for dry-run correction.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "optional_json",
      "stdout": "intermediate_receipt",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "none",
      "schema_bindings": [
        "schemas/public-delivery-planning-stale-recovery-input-1.0.schema.json",
        "schemas/phase2-check.schema.json"
      ],
      "validator_id": "phase2_check_recorder",
      "runtime_role": "record"
    },
    {
      "id": "invoke-guru-check-task",
      "owner": "guru-check-task",
      "entrypoint": "runtime/invoke.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Target checkout; a complete external provider uses its own runtime and this target installed Task schema 2 / Delivery API 1.0, C4 and current selection. Recover an unchanged old target before tool adoption.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--invocation",
          "required": false,
          "kind": "json",
          "description": "Call-local invocation envelope or dash for stdin.",
          "repeatable": false,
          "conflicts": [
            "--input",
            "--owner-result"
          ]
        },
        {
          "flag": "--input",
          "required": false,
          "kind": "string",
          "description": "Public input JSON locator.",
          "repeatable": false,
          "conflicts": [
            "--invocation"
          ]
        },
        {
          "flag": "--owner-result",
          "required": false,
          "kind": "string",
          "description": "Complete recorder result; recovery instead uses the same-owner original_result/corrected_result/original_delivery envelope.",
          "repeatable": false,
          "conflicts": [
            "--invocation"
          ]
        }
      ],
      "stdin": "optional_json",
      "stdout": "single_typed_exit",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "runtime_write",
      "schema_bindings": [],
      "validator_id": "public_invocation",
      "runtime_role": "invoke"
    },
    {
      "id": "legacy-maintenance-guru-check-task",
      "owner": "guru-check-task",
      "entrypoint": "runtime/recover.py",
      "arguments": [
        {
          "flag": "--root",
          "required": true,
          "kind": "string",
          "description": "Explicit legacy target.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--input",
          "required": true,
          "kind": "json",
          "description": "Separate original-owner legacy input. Inline JSON is additive; existing regular UTF-8 JSON file and dash-for-stdin inputs remain supported. Nonregular carriers including process substitution are unsupported.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "optional_json",
      "stdout": "intermediate_receipt",
      "errors": [
        "schema_mismatch",
        "invalid_arguments",
        "invalid_json",
        "internal_error"
      ],
      "side_effect": "repo_write",
      "schema_bindings": [
        "schemas/legacy-maintenance-input-1.0.schema.json"
      ],
      "validator_id": "legacy_maintenance",
      "runtime_role": "recover"
    }
  ]
}
