{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-stage0-discover-change-context-input-context-request-3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "source_exit",
    "mode",
    "change_input",
    "continuation_id",
    "return_identity"
  ],
  "properties": {
    "profile": {
      "const": "context_request"
    },
    "source_exit": {
      "enum": [
        "needs_context",
        "baseline_ready"
      ]
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "change_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_refs",
        "pr_refs",
        "branches",
        "paths",
        "commands",
        "config_keys",
        "schema_fields",
        "symbols",
        "terms",
        "queries"
      ],
      "anyOf": [
        {
          "properties": {
            "issue_refs": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "pr_refs": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "branches": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "paths": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "commands": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "config_keys": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "schema_fields": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "symbols": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "terms": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "queries": {
              "minItems": 1
            }
          }
        }
      ],
      "properties": {
        "issue_refs": {
          "$ref": "#/$defs/stringList"
        },
        "pr_refs": {
          "$ref": "#/$defs/stringList"
        },
        "branches": {
          "$ref": "#/$defs/stringList"
        },
        "paths": {
          "$ref": "#/$defs/stringList"
        },
        "commands": {
          "$ref": "#/$defs/stringList"
        },
        "config_keys": {
          "$ref": "#/$defs/stringList"
        },
        "schema_fields": {
          "$ref": "#/$defs/stringList"
        },
        "symbols": {
          "$ref": "#/$defs/stringList"
        },
        "terms": {
          "$ref": "#/$defs/stringList"
        },
        "queries": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "continuation_id": {
      "type": "string",
      "minLength": 1
    },
    "return_identity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "target_locator",
            "continuation_id"
          ],
          "properties": {
            "profile": {
              "const": "standard_intake"
            },
            "target_locator": {
              "type": "string",
              "minLength": 1
            },
            "continuation_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "target_locator",
            "continuation_id",
            "source_locators"
          ],
          "properties": {
            "profile": {
              "const": "reviewed_plan_intake"
            },
            "target_locator": {
              "type": "string",
              "minLength": 1
            },
            "continuation_id": {
              "type": "string",
              "minLength": 1
            },
            "source_locators": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "locator",
                  "section"
                ],
                "properties": {
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "section": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "target_locator",
            "continuation_id",
            "task_locator",
            "task_id",
            "lifecycle_generation",
            "resume_target"
          ],
          "properties": {
            "profile": {
              "const": "active_task_scope_change"
            },
            "target_locator": {
              "type": "string",
              "minLength": 1
            },
            "continuation_id": {
              "type": "string",
              "minLength": 1
            },
            "task_locator": {
              "type": "string",
              "minLength": 1
            },
            "task_id": {
              "type": "string",
              "minLength": 1
            },
            "lifecycle_generation": {
              "type": "integer",
              "minimum": 0
            },
            "resume_target": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "target_locator",
            "continuation_id",
            "resume_target"
          ],
          "properties": {
            "profile": {
              "const": "standalone_review"
            },
            "target_locator": {
              "type": "string",
              "minLength": 1
            },
            "continuation_id": {
              "type": "string",
              "minLength": 1
            },
            "resume_target": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "target_locator",
            "resume_target",
            "continuation_id",
            "candidate_refs"
          ],
          "properties": {
            "profile": {
              "const": "normal_scenario_scope_confirmation"
            },
            "target_locator": {
              "type": "string",
              "minLength": 1
            },
            "resume_target": {
              "enum": [
                "guru-approve-task-plan",
                "guru-author-task-plan",
                "guru-check-task",
                "guru-clarify-requirements",
                "guru-execute-task-free-change",
                "guru-reconcile-task-base",
                "guru-resume-implementation",
                "guru-review-branch",
                "guru-review-change-request",
                "guru-review-task-delivery"
              ]
            },
            "continuation_id": {
              "type": "string",
              "minLength": 1
            },
            "candidate_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "task_ref": {
              "type": "string",
              "minLength": 1
            },
            "delivery_key": {
              "type": "object",
              "description": "Opaque upstream DeliveryKey validated by its original public owner."
            }
          },
          "allOf": [
            {
              "oneOf": [
                {
                  "required": [
                    "task_ref",
                    "delivery_key"
                  ]
                },
                {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "task_ref"
                        ]
                      },
                      {
                        "required": [
                          "delivery_key"
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "target_locator",
            "resume_target",
            "continuation_id",
            "candidate_refs"
          ],
          "properties": {
            "profile": {
              "const": "solution_mechanism_scope_confirmation"
            },
            "target_locator": {
              "type": "string",
              "minLength": 1
            },
            "resume_target": {
              "enum": [
                "guru-approve-task-plan",
                "guru-author-task-plan",
                "guru-check-task",
                "guru-clarify-requirements",
                "guru-execute-task-free-change",
                "guru-reconcile-task-base",
                "guru-resume-implementation",
                "guru-review-branch",
                "guru-review-change-request",
                "guru-review-task-delivery"
              ]
            },
            "continuation_id": {
              "type": "string",
              "minLength": 1
            },
            "candidate_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "task_ref": {
              "type": "string",
              "minLength": 1
            },
            "delivery_key": {
              "type": "object",
              "description": "Opaque upstream DeliveryKey validated by its original public owner."
            }
          },
          "allOf": [
            {
              "oneOf": [
                {
                  "required": [
                    "task_ref",
                    "delivery_key"
                  ]
                },
                {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "task_ref"
                        ]
                      },
                      {
                        "required": [
                          "delivery_key"
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "candidate_file": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
