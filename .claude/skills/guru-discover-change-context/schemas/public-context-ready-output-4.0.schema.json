{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-stage0-discover-change-context-output-context-ready-4.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "handoff_profile",
    "handoff_mode",
    "handoff_target_locator",
    "handoff_continuation_id",
    "transition"
  ],
  "properties": {
    "exit_id": {
      "const": "context_ready"
    },
    "handoff_profile": {
      "enum": [
        "standard_intake",
        "reviewed_plan_intake",
        "active_task_scope_change",
        "standalone_review"
      ]
    },
    "handoff_mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "handoff_target_locator": {
      "type": "string",
      "minLength": 1
    },
    "handoff_continuation_id": {
      "type": "string",
      "minLength": 1
    },
    "duplicate_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "checked_at",
        "target_locator",
        "authority_content_sha256",
        "candidates",
        "facts_sha256"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "target_locator": {
          "type": "string",
          "minLength": 1
        },
        "authority_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "facts_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repo",
              "number",
              "url",
              "updated_at",
              "facts_sha256"
            ],
            "properties": {
              "repo": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              },
              "facts_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "transition_id",
        "stage",
        "mode",
        "repo_locator",
        "base",
        "target_locator",
        "continuation_id",
        "context_result_sha256",
        "authority_content_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "transition_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]+$"
        },
        "stage": {
          "const": "context_current"
        },
        "mode": {
          "enum": [
            "workflow",
            "standalone"
          ]
        },
        "repo_locator": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "selected_base",
            "remote",
            "ordered_candidates",
            "decision_head",
            "local_base_head",
            "remote_base_head",
            "post_sync_resolution_sha256"
          ],
          "properties": {
            "source": {
              "enum": [
                "explicit",
                "config",
                "config-candidate",
                "remote-default"
              ]
            },
            "selected_base": {
              "type": "string",
              "minLength": 1
            },
            "remote": {
              "type": "string",
              "minLength": 1
            },
            "ordered_candidates": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "decision_head": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "local_base_head": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "remote_base_head": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "post_sync_resolution_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "target_locator": {
          "type": "string",
          "minLength": 1
        },
        "continuation_id": {
          "type": "string",
          "minLength": 1
        },
        "context_result_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authority_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "clarify_profile": {
          "enum": [
            "standard_intake",
            "reviewed_plan_intake",
            "active_task_scope_change",
            "standalone_review",
            "normal_scenario_scope_confirmation",
            "solution_mechanism_scope_confirmation"
          ]
        },
        "source_locators": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "locator",
              "section"
            ],
            "properties": {
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "section": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "source_locators": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locator",
          "section"
        ],
        "properties": {
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "handoff_task_locator": {
      "type": "string",
      "minLength": 1
    },
    "handoff_task_id": {
      "type": "string",
      "minLength": 1
    },
    "handoff_lifecycle_generation": {
      "type": "integer",
      "minimum": 0
    },
    "handoff_resume_target": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {"if": {"properties": {"handoff_profile": {"enum": ["standard_intake", "reviewed_plan_intake"]}}}, "then": {"required": ["duplicate_snapshot"]}, "else": {"not": {"required": ["duplicate_snapshot"]}}},
    {
      "if": {
        "properties": {
          "handoff_profile": {
            "const": "reviewed_plan_intake"
          }
        }
      },
      "then": {
        "required": [
          "source_locators"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "handoff_profile": {
            "const": "active_task_scope_change"
          }
        }
      },
      "then": {
        "required": [
          "handoff_task_locator",
          "handoff_task_id",
          "handoff_lifecycle_generation",
          "handoff_resume_target"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "handoff_profile": {
            "const": "standalone_review"
          }
        }
      },
      "then": {
        "required": [
          "handoff_resume_target"
        ]
      }
    }
  ]
}
