{
  "schema_version": "1.0",
  "package_id": "guru-review-task-publication",
  "commands": [
    {
      "id": "record-task-publication-review",
      "owner": "guru-review-task-publication",
      "entrypoint": "runtime/record.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--task",
          "required": false,
          "kind": "string",
          "description": "Task locator.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--input",
          "required": true,
          "kind": "json",
          "description": "Semantic review.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--branch-review-commit",
          "required": true,
          "kind": "string",
          "description": "Reviewed commit.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--dry-run",
          "required": false,
          "kind": "boolean",
          "description": "Do not write.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "optional_json",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "publication_stale",
        "internal_error"
      ],
      "side_effect": "runtime_write",
      "schema_bindings": [
        "schemas/pr-readiness.schema.json"
      ],
      "validator_id": "publication_review_recorder",
      "runtime_role": "record"
    },
    {
      "id": "check-task-publication-review",
      "owner": "guru-review-task-publication",
      "entrypoint": "runtime/check.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--task",
          "required": false,
          "kind": "string",
          "description": "Task locator.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--expected-exit",
          "required": false,
          "kind": "string",
          "description": "Expected exit.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "none",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "publication_stale",
        "internal_error"
      ],
      "side_effect": "git_read",
      "schema_bindings": [
        "schemas/pr-readiness.schema.json"
      ],
      "validator_id": "publication_review_checker",
      "runtime_role": "check"
    },
    {
      "id": "invoke-guru-review-task-publication",
      "owner": "guru-review-task-publication",
      "entrypoint": "runtime/invoke.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--input",
          "required": true,
          "kind": "json",
          "description": "Public input.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--owner-result",
          "required": true,
          "kind": "json",
          "description": "Owner result.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "optional_json",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "publication_stale",
        "internal_error"
      ],
      "side_effect": "runtime_write",
      "schema_bindings": [
        "schemas/public-invocation-error.schema.json"
      ],
      "validator_id": "public_invocation",
      "runtime_role": "invoke"
    }
  ]
}
