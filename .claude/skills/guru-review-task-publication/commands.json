{
  "schema_version": "1.0",
  "package_id": "guru-review-task-publication",
  "commands": [
    {
      "id": "record-task-publication-review",
      "owner": "guru-review-task-publication",
      "entrypoint": "runtime/record.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--task",
          "required": false,
          "kind": "string",
          "description": "Task locator.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--input",
          "required": true,
          "kind": "json",
          "description": "Semantic review.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--branch-review-commit",
          "required": true,
          "kind": "string",
          "description": "Reviewed commit.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--dry-run",
          "required": false,
          "kind": "boolean",
          "description": "Do not write.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "optional_json",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "publication_stale",
        "publication_input_invalid",
        "reviewed_content_continuity_failed",
        "github_cli_missing",
        "github_auth_failed",
        "github_repo_access_denied",
        "github_permission_denied",
        "github_api_unavailable",
        "github_response_incomplete",
        "internal_error"
      ],
      "side_effect": "runtime_write",
      "schema_bindings": [
        "schemas/pr-readiness.schema.json"
      ],
      "validator_id": "publication_review_recorder",
      "runtime_role": "record"
    },
    {
      "id": "check-task-publication-review",
      "owner": "guru-review-task-publication",
      "entrypoint": "runtime/check.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--task",
          "required": false,
          "kind": "string",
          "description": "Task locator.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--expected-exit",
          "required": false,
          "kind": "string",
          "description": "Expected exit.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "none",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "publication_stale",
        "publication_input_invalid",
        "reviewed_content_continuity_failed",
        "github_cli_missing",
        "github_auth_failed",
        "github_repo_access_denied",
        "github_permission_denied",
        "github_api_unavailable",
        "github_response_incomplete",
        "internal_error"
      ],
      "side_effect": "git_read",
      "schema_bindings": [
        "schemas/pr-readiness.schema.json"
      ],
      "validator_id": "publication_review_checker",
      "runtime_role": "check"
    },
    {
      "id": "invoke-guru-review-task-publication",
      "owner": "guru-review-task-publication",
      "entrypoint": "runtime/invoke.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--input",
          "required": true,
          "kind": "json",
          "description": "Public input.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--semantic-result",
          "required": false,
          "kind": "json",
          "description": "AI-completed semantic Publication result for the normal path.",
          "repeatable": false,
          "conflicts": [
            "--owner-result"
          ]
        },
        {
          "flag": "--owner-result",
          "required": false,
          "kind": "json",
          "description": "Separately recorded owner result for compatibility callers.",
          "repeatable": false,
          "conflicts": [
            "--semantic-result"
          ]
        }
      ],
      "stdin": "optional_json",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "publication_stale",
        "publication_input_invalid",
        "reviewed_content_continuity_failed",
        "github_cli_missing",
        "github_auth_failed",
        "github_repo_access_denied",
        "github_permission_denied",
        "github_api_unavailable",
        "github_response_incomplete",
        "internal_error"
      ],
      "side_effect": "runtime_write",
      "schema_bindings": [
        "schemas/public-invocation-error.schema.json",
        "schemas/pr-readiness.schema.json"
      ],
      "validator_id": "public_invocation",
      "runtime_role": "invoke"
    },
    {
      "id": "review-task-publication-content-identity",
      "owner": "guru-review-task-publication",
      "entrypoint": "runtime/check.py",
      "arguments": [
        {"flag": "--root", "required": false, "kind": "string", "description": "Repository root.", "repeatable": false, "conflicts": []},
        {"flag": "--commit", "required": false, "kind": "string", "description": "Git commit; defaults to HEAD.", "repeatable": false, "conflicts": []},
        {"flag": "--include-worktree", "required": false, "kind": "boolean", "description": "Overlay current worktree state.", "repeatable": false, "conflicts": []}
      ],
      "stdin": "none",
      "stdout": "single_json_object",
      "errors": ["invalid_arguments", "conflicting_arguments", "reviewed_content_continuity_failed", "internal_error"],
      "side_effect": "none",
      "schema_bindings": ["schemas/reviewed-content-identity-output.schema.json"],
      "validator_id": "reviewed_content_identity",
      "runtime_role": "check"
    }
  ]
}
