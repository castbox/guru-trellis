{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-review-branch-input-delivery-draft-content-review-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "task_ref",
    "delivery_key",
    "base_ref",
    "branch_review_commit"
  ],
  "properties": {
    "profile": {
      "const": "delivery_draft_content_review"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "delivery_key": {
      "type": "object"
    },
    "base_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "branch_review_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
