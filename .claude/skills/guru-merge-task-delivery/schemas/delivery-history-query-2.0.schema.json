{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-merge-task-delivery-history-query-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_identity",
    "repo_ref",
    "base_ref",
    "task_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "task_identity": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "repo_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "base_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    }
  }
}
