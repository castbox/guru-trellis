{
  "schema_version": "1.1",
  "package_id": "guru-review-task-completion",
  "commands": [
    {
      "id": "invoke-guru-review-task-completion",
      "owner": "guru-review-task-completion",
      "entrypoint": "runtime/invoke.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--input",
          "required": true,
          "kind": "json",
          "description": "Current delivery_completion, delivery_evidence_refresh or delivery_reactivation_validation input. Use an existing regular UTF-8 JSON file; stdin and inline JSON are not supported by this command.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--semantic-result",
          "required": true,
          "kind": "json",
          "description": "AI-authored current TaskKey Completion judgment matching the selected input profile; use schemas/semantic-delivery-result-1.0.schema.json and examples/semantic-delivery-result-1.0.json. Use an existing regular UTF-8 JSON file; this is not a recorder receipt.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "none",
      "stdout": "single_typed_exit",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "runtime_write",
      "schema_bindings": [
        "schemas/public-input-delivery-1.0.schema.json",
        "schemas/semantic-delivery-result-1.0.schema.json",
        "schemas/public-output-delivery-1.0.schema.json"
      ],
      "validator_id": "public_invocation",
      "runtime_role": "invoke"
    }
  ]
}
