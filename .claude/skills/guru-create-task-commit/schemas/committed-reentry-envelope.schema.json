{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-task-commit-committed-reentry-envelope-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "public_input",
    "owner_result"
  ],
  "properties": {
    "public_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "mode",
        "task_ref",
        "source_exit",
        "phase2_commit_anchor"
      ],
      "properties": {
        "profile": {
          "const": "committed_reentry"
        },
        "mode": {
          "enum": [
            "workflow",
            "standalone"
          ]
        },
        "task_ref": {
          "type": "string",
          "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
        },
        "source_exit": {
          "const": "passed"
        },
        "phase2_commit_anchor": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "owner_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "revision-required",
            "blocked"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
