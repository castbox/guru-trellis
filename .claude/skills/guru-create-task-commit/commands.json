{
  "schema_version": "1.0",
  "package_id": "guru-create-task-commit",
  "commands": [
    {
      "id": "prepare-task-commit",
      "owner": "guru-create-task-commit",
      "entrypoint": "runtime/record.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--input",
          "required": true,
          "kind": "string",
          "description": "Public commit input JSON locator.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--candidate-json",
          "required": true,
          "kind": "string",
          "description": "AI-authored candidate JSON locator.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "none",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "runtime_write",
      "schema_bindings": [],
      "validator_id": "candidate_builder",
      "runtime_role": "record"
    },
    {
      "id": "check-commit-messages",
      "owner": "guru-create-task-commit",
      "entrypoint": "runtime/check.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--task",
          "required": false,
          "kind": "string",
          "description": "Task locator.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--candidate-artifact",
          "required": false,
          "kind": "string",
          "description": "Prepared candidate locator.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "none",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "git_read",
      "schema_bindings": [],
      "validator_id": "candidate_validator",
      "runtime_role": "check"
    },
    {
      "id": "create-task-commit",
      "owner": "guru-create-task-commit",
      "entrypoint": "runtime/execute.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--task",
          "required": false,
          "kind": "string",
          "description": "Task locator.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--candidate-artifact",
          "required": true,
          "kind": "string",
          "description": "Prepared candidate locator.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "none",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "git_write",
      "schema_bindings": [],
      "validator_id": "exact_executor",
      "runtime_role": "execute"
    },
    {
      "id": "invoke-guru-create-task-commit",
      "owner": "guru-create-task-commit",
      "entrypoint": "runtime/invoke.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--candidate-artifact",
          "required": false,
          "kind": "string",
          "description": "Prepared candidate locator shown in the confirmed commit action.",
          "repeatable": false,
          "conflicts": [
            "--invocation"
          ]
        },
        {
          "flag": "--invocation",
          "required": false,
          "kind": "json",
          "description": "Compatibility-only call-local invocation envelope or dash for stdin.",
          "repeatable": false,
          "conflicts": [
            "--candidate-artifact"
          ]
        }
      ],
      "stdin": "optional_json",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "git_write",
      "schema_bindings": [
        "schemas/happy-path-result.schema.json"
      ],
      "validator_id": "public_invocation",
      "runtime_role": "invoke"
    }
  ]
