{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/castbox/guru-trellis/schemas/guru-task-finalization-semantic-review-input-1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_id", "review", "confirmation", "route", "supersedes_gate_ref"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "skill_id": {"const": "guru-finalize-task"},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "evidence_refs"],
      "properties": {
        "status": {"enum": ["passed", "reroute", "blocked"]},
        "summary": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confirmed_plan_digest", "summary"],
      "properties": {
        "status": {"enum": ["confirmed", "not_required"]},
        "confirmed_plan_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typed_exit", "consumer", "output"],
      "properties": {
        "typed_exit": {"enum": ["verification_required", "publication_review_stale", "resume_finalization", "reprepare_required", "published", "blocked"]},
        "consumer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": {"enum": ["skill", "workflow", "stop"]},
            "id": {"type": "string", "minLength": 1}
          }
        },
        "output": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["materialization"],
              "properties": {
                "materialization": {"const": "executor"}
              }
            },
            {
              "type": "object",
              "minProperties": 1,
              "not": {
                "type": "object",
                "additionalProperties": false,
                "required": ["materialization"],
                "properties": {
                  "materialization": {"const": "executor"}
                }
              }
            }
          ]
        }
      }
    },
    "supersedes_gate_ref": {"type": ["string", "null"], "minLength": 1}
  }
}
