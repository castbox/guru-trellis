          }
        ]
      },
      "files": [
        "evals/files/publication-ready-input.json",
        "evals/files/publication-ready-published-facts.json"
      ]
    },
    {
      "id": "same-plan-published",
      "prompt": "Invoke workflow finalization after the unchanged plan has reached its terminal ready state.",
      "expected_exit": "published",
      "expected_output": "The terminal DTO contains the exact task and canonical pull request identity.",
      "input_profile_id": "same_plan_resume",
      "assertions": {
        "deterministic": [
          {
            "id": "expected-route",
            "kind": "json_path",
            "pointer": "/exit_id",
            "operation": "equals",
            "expected": "published"
