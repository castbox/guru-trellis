      ]
    },
    {
      "id": "blocked-private-state",
      "prompt": "Invoke standalone finalization for an invalid objective state with no unique continuation.",
      "expected_exit": "blocked",
      "expected_output": "The terminal DTO contains only the stable blocker code and remediation.",
      "input_profile_id": "standalone_finalization",
      "assertions": {
        "deterministic": [
          {"id": "expected-route", "kind": "json_path", "pointer": "/exit_id", "operation": "equals", "expected": "blocked"}
        ]
      },
      "files": [
        "evals/files/standalone-finalization-input.json",
        "evals/files/blocked-private-state-facts.json"
      ]
    },
    {
      "id": "verified-reentry-published",
      "prompt": "Invoke the finalizer from current verified installation evidence for the same plan and reviewed HEAD.",
      "expected_exit": "published",
      "expected_output": "The checked terminal DTO contains the exact published pull request identity.",
      "input_profile_id": "verification_verified",
      "assertions": {
        "deterministic": [
          {"id": "expected-route", "kind": "json_path", "pointer": "/exit_id", "operation": "equals", "expected": "published"}
        ]
      },
      "files": [
        "evals/files/verification-verified-input.json",
        "evals/files/verified-reentry-published-facts.json"
      ]
    },
    {
      "id": "not-required-reentry-published",
      "prompt": "Invoke the standalone verifier, apply its declared not-required projection without overwrite, and invoke the finalizer for the same private plan and resolved HEAD.",
      "expected_exit": "published",
      "expected_output": "The checked terminal DTO contains the exact published pull request identity.",
      "input_profile_id": "standalone_verification_not_required",
      "assertions": {
        "deterministic": [
          {"id": "expected-route", "kind": "json_path", "pointer": "/exit_id", "operation": "equals", "expected": "published"}
        ]
      },
      "files": [
        "evals/files/verification-not-required-input.json",
        "evals/files/not-required-reentry-published-facts.json"
      ]
    }
  ]
}
