{
  "$schema": "../../schemas/skill-interface-1.4.schema.json",
  "schema_version": "1.4",
  "id": "guru-merge-task-pr",
  "name": "guru-merge-task-pr",
  "description": "Merge one Ready task PR through a semantic live gate, expected-head mutation, and post-merge closure verification. Supports a separate read-only archived review request.",
  "state": "active",
  "modes": {
    "workflow": {
      "routing": "global_workflow",
      "entry_precondition_ids": [
        "runtime_dependency",
        "repo_bound_pr",
        "expected_head",
        "live_merge_readiness",
        "invocation_freshness",
        "archived_review_identity"
      ]
    },
    "standalone": {
      "routing": "direct_discovery",
      "entry_precondition_ids": [
        "runtime_dependency",
        "repo_bound_pr",
        "expected_head",
        "live_merge_readiness",
        "invocation_freshness",
        "archived_review_identity"
      ]
    }
  },
  "entry_preconditions": [
    {
      "id": "runtime_dependency",
      "evidence": "installed extension, dispatcher, active package and merge commands",
      "binding": "complete current Guru Team preset",
      "freshness": "validated before each command"
    },
    {
      "id": "repo_bound_pr",
      "evidence": "canonical repository and PR number/URL",
      "binding": "one repo-bound GitHub pull request",
      "freshness": "reread through authenticated gh before every gate and mutation"
    },
    {
      "id": "expected_head",
      "evidence": "Finalizer or caller supplied expected immutable head SHA and reviewed base/head branches",
      "binding": "PR headRefOid, baseRefName and headRefName equality",
      "freshness": "reread immediately before gh pr merge"
    },
    {
      "id": "live_merge_readiness",
      "evidence": "Open/Ready PR, checks, reviews, mergeability and repository policy",
      "binding": "one current semantic merge gate",
      "freshness": "reread by preview and checker"
    },
    {
      "id": "invocation_freshness",
      "evidence": "current input identity and owner-private gate",
      "binding": "one repository, PR and expected head",
      "freshness": "checker recomputes live facts"
    },
    {
      "id": "archived_review_identity",
      "evidence": "archived_review_request only: committed clean completed archive, dual mappings, origin, worktree, branch/base, local/remote/PR HEAD and Ready Open PR",
      "binding": "one task_ref and current immutable archive HEAD; snapshot is not Publication approval",
      "freshness": "recomputed read-only on each archived request command"
    }
  ],
  "judgment_mode": "semantic",
  "ordered_stages": [
    "forward_behavior",
    "ai_review_gate",
    "conditional_human_confirmation",
    "recorder_validator",
    "typed_exit"
  ],
  "artifacts": [
    {
      "id": "workflow_input",
      "path": "examples/public-ready-for-merge-input-2.0.json"
    },
    {
      "id": "workflow_authoring",
      "path": "examples/public-ready-for-merge-authoring-2.0.json"
    },
    {
      "id": "standalone_input",
      "path": "examples/public-standalone-merge-input-2.0.json"
    },
    {
      "id": "merged_output",
      "path": "examples/public-merged-output.json"
    },
    {
      "id": "merge_blocked_output",
      "path": "examples/public-merge-blocked-output.json"
    },
    {
      "id": "phase2_reentry_required_output",
      "path": "examples/public-phase2-reentry-required-output.json"
    },
    {
      "id": "restore_archived_task_authoring",
      "path": "examples/public-restore-archived-task-authoring.json"
    },
    {
      "id": "closure_mismatch_output",
      "path": "examples/public-closure-mismatch-output.json"
    },
    {
      "id": "invocation_error",
      "path": "examples/public-invocation-error.json"
    },
    {
      "id": "semantic_review",
      "path": "examples/semantic-review-input.json"
    },
    {
      "id": "check_watcher_result",
      "path": "examples/check-watcher-result.json"
    },
    {
      "id": "private_gate",
      "path": "examples/task-pr-merge-gate-2.0.json"
    },
    {
      "id": "archived_review_input",
      "path": "examples/public-archived-review-request-input.json"
    },
    {
      "id": "review_refresh_required_output",
      "path": "examples/public-review-refresh-required-output.json"
    },
    {
      "id": "archived_review_authoring",
      "path": "examples/public-archived-review-authoring.json"
    },
    {
      "id": "archived_review_semantic",
      "path": "examples/archived-review-semantic-input.json"
    }
  ],
  "schemas": [
    {
      "id": "workflow_input",
      "path": "schemas/public-ready-for-merge-input-2.0.schema.json"
    },
    {
      "id": "standalone_input",
      "path": "schemas/public-standalone-merge-input-2.0.schema.json"
    },
    {
      "id": "aggregate_input",
      "path": "schemas/public-input-3.0.schema.json"
    },
    {
      "id": "merged_output",
      "path": "schemas/public-merged-output.schema.json"
    },
    {
      "id": "merge_blocked_output",
      "path": "schemas/public-merge-blocked-output.schema.json"
    },
    {
      "id": "phase2_reentry_required_output",
      "path": "schemas/public-phase2-reentry-required-output.schema.json"
    },
    {
      "id": "closure_mismatch_output",
      "path": "schemas/public-closure-mismatch-output.schema.json"
    },
    {
      "id": "invocation_error",
      "path": "schemas/public-invocation-error.schema.json"
    },
    {
      "id": "private_gate",
      "path": "schemas/task-pr-merge-gate-2.0.schema.json"
    },
    {
      "id": "check_watcher_result",
      "path": "schemas/check-watcher-result.schema.json"
    },
    {
      "id": "archived_review_input",
      "path": "schemas/public-archived-review-request-input.schema.json"
    },
    {
      "id": "review_refresh_required_output",
      "path": "schemas/public-review-refresh-required-output.schema.json"
    },
    {
      "id": "archived_review_gate",
      "path": "schemas/archived-review-gate.schema.json"
    }
  ],
  "validators": [
    {
      "id": "merge_previewer",
      "command": "scripts/preview-task-pr-merge.sh",
      "runtime_command": "preview-task-pr-merge",
      "objective_scope": "Read complete repo-bound PR, checks, review, policy without mutation"
    },
    {
      "id": "merge_recorder",
      "command": "scripts/record-task-pr-merge.sh",
      "runtime_command": "record-task-pr-merge",
      "objective_scope": "Record only the completed semantic dimensions and selected route"
    },
    {
      "id": "merge_checker",
      "command": "scripts/check-task-pr-merge.sh",
      "runtime_command": "check-task-pr-merge",
      "objective_scope": "Reread live facts and validate exact expected-head readiness"
    },
    {
      "id": "merge_executor",
      "command": "scripts/execute-task-pr-merge.sh",
      "runtime_command": "execute-task-pr-merge",
      "objective_scope": "Execute one repo-bound expected-head merge and post-merge read-only closure verification"
    },
    {
      "id": "required_checks_watcher",
      "command": "scripts/watch-task-pr-checks.sh",
      "runtime_command": "watch-task-pr-checks",
      "objective_scope": "Watch required CI facts for one repository, PR and expected head without selecting semantic readiness or performing mutation"
    },
    {
      "id": "public_invocation",
      "command": "scripts/invoke.sh",
      "runtime_command": "invoke-task-pr-merge",
      "objective_scope": "After exact confirmation, run the single public Happy Path with one pre snapshot, one expected-head merge, one post snapshot, exact recovery and terminal projection"
    }
  ],
  "public_contracts": {
    "input": {
      "kind": "structured_json",
      "aggregate_schema": {
        "schema_id": "guru-merge-task-pr-input-aggregate-3.0",
        "path": "schemas/public-input-3.0.schema.json"
      },
      "profiles": [
        {
          "id": "ready_for_merge",
          "schema": {
            "schema_id": "guru-merge-task-pr-input-ready-for-merge-2.0",
            "path": "schemas/public-ready-for-merge-input-2.0.schema.json"
          },
          "example": {
            "id": "ready_for_merge_input",
            "path": "examples/public-ready-for-merge-input-2.0.json"
          },
          "discriminator": {
            "field": "profile",
            "value": "ready_for_merge"
          }
        },
        {
          "id": "standalone_merge",
          "schema": {
            "schema_id": "guru-merge-task-pr-input-standalone-merge-2.0",
            "path": "schemas/public-standalone-merge-input-2.0.schema.json"
          },
          "example": {
            "id": "standalone_merge_input",
            "path": "examples/public-standalone-merge-input-2.0.json"
          },
          "discriminator": {
            "field": "profile",
            "value": "standalone_merge"
          }
        },
        {
          "id": "archived_review_request",
          "schema": {
            "schema_id": "guru-merge-task-pr-input-archived-review-request-1.0",
            "path": "schemas/public-archived-review-request-input.schema.json"
          },
          "example": {
            "id": "archived_review_request_input",
            "path": "examples/public-archived-review-request-input.json"
          },
          "discriminator": {
            "field": "profile",
            "value": "archived_review_request"
          }
        }
      ]
    },
    "invocation": {
      "command_id": "run-skill-command",
      "wrapper": "scripts/invoke.sh",
      "input_binding": {
        "kind": "structured_json",
        "profile_id": "ready_for_merge"
      },
      "stdout_contract": "single_typed_exit",
      "error_schema": {
        "schema_id": "guru-merge-task-pr-invocation-error-1.0",
        "path": "schemas/public-invocation-error.schema.json"
      },
      "error_example": {
        "id": "invalid_public_input",
        "path": "examples/public-invocation-error.json"
      },
      "example_argv": [
        "--input",
        "examples/public-ready-for-merge-input-2.0.json",
        "--review-input",
        "examples/semantic-review-input.json"
      ]
    },
    "outputs": [
      {
        "exit_id": "merged",
        "schema": {
          "schema_id": "guru-merge-task-pr-output-merged-1.0",
          "path": "schemas/public-merged-output.schema.json"
        },
        "example": {
          "id": "merged_output",
          "path": "examples/public-merged-output.json"
        },
        "consumer_use_ids": [
          "project_merged"
        ]
      },
      {
        "exit_id": "merge_blocked",
        "schema": {
          "schema_id": "guru-merge-task-pr-output-merge-blocked-1.0",
          "path": "schemas/public-merge-blocked-output.schema.json"
        },
        "example": {
          "id": "merge_blocked_output",
          "path": "examples/public-merge-blocked-output.json"
        },
        "consumer_use_ids": [
          "project_merge_blocked"
        ]
      },
      {
        "exit_id": "phase2_reentry_required",
        "schema": {
          "schema_id": "guru-merge-task-pr-output-phase2-reentry-required-1.0",
          "path": "schemas/public-phase2-reentry-required-output.schema.json"
        },
        "example": {
          "id": "phase2_reentry_required_output",
          "path": "examples/public-phase2-reentry-required-output.json"
        },
        "consumer_use_ids": [
          "project_phase2_reentry_required"
        ]
      },
      {
        "exit_id": "closure_mismatch",
        "schema": {
          "schema_id": "guru-merge-task-pr-output-closure-mismatch-1.0",
          "path": "schemas/public-closure-mismatch-output.schema.json"
        },
        "example": {
          "id": "closure_mismatch_output",
          "path": "examples/public-closure-mismatch-output.json"
        },
        "consumer_use_ids": [
          "project_closure_mismatch"
        ]
      },
      {
        "exit_id": "review_refresh_required",
        "schema": {
          "schema_id": "guru-merge-task-pr-output-review-refresh-required-1.0",
          "path": "schemas/public-review-refresh-required-output.schema.json"
        },
        "example": {
          "id": "review_refresh_required_output",
          "path": "examples/public-review-refresh-required-output.json"
        },
        "consumer_use_ids": [
          "project_review_refresh_required"
        ]
      }
    ],
    "consumer_inputs": [
      {
        "id": "merged_workflow_input",
        "consumer": {
          "kind": "workflow",
          "id": "guru-finalization-finish-response"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "json_schema",
          "schema_id": "guru-merge-task-pr-workflow-merged-input-1.0",
          "path": "consumers/workflow/production/merge-task-pr-merged.schema.json"
        }
      },
      {
        "id": "merge_blocked_stop_input",
        "consumer": {
          "kind": "stop",
          "id": "task-pr-merge-blocked"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "json_schema",
          "schema_id": "guru-merge-task-pr-stop-merge-blocked-input-1.0",
          "path": "consumers/stop/production/merge-task-pr-blocked.schema.json"
        }
      },
      {
        "id": "phase2_reentry_required_input",
        "consumer": {
          "kind": "skill",
          "id": "guru-restore-archived-task"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "skill_input_authoring_seed",
          "interface_path": "packages/guru-restore-archived-task/interface.json",
          "input_kind": "structured_json",
          "profile_id": "restore_archived_task",
          "seed_fields": [
            "exit_id",
            "repo_ref",
            "pr_number",
            "pr_url",
            "expected_head_sha",
            "expected_base_branch",
            "expected_head_branch",
            "task_id",
            "archive_locator",
            "active_locator",
            "archive_commit",
            "finding_refs",
            "resume_target"
          ],
          "authoring_fields": [
            "schema_version",
            "profile",
            "mode"
          ],
          "authoring_example": {
            "id": "restore_archived_task_authoring",
            "path": "examples/public-restore-archived-task-authoring.json"
          }
        }
      },
      {
        "id": "closure_mismatch_stop_input",
        "consumer": {
          "kind": "stop",
          "id": "task-pr-closure-mismatch"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "json_schema",
          "schema_id": "guru-merge-task-pr-stop-closure-mismatch-input-1.0",
          "path": "consumers/stop/production/merge-task-pr-closure-mismatch.schema.json"
        }
      },
      {
        "id": "archived_review_seed_input",
        "consumer": {
          "kind": "skill",
          "id": "guru-review-branch"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "skill_input_authoring_seed",
          "interface_path": "packages/guru-review-branch/interface.json",
          "input_kind": "structured_json",
          "profile_id": "archived_review",
          "seed_fields": [
            "task_ref",
            "branch_review_commit",
            "pr_payload_snapshot_sha256"
          ],
          "authoring_fields": [
            "profile",
            "mode"
          ],
          "authoring_example": {
            "id": "archived_review_authoring",
            "path": "examples/public-archived-review-authoring.json"
          }
        }
      }
    ],
    "projections": [
      {
        "id": "project_merged",
        "exit_id": "merged",
        "consumer_input_id": "merged_workflow_input",
        "operation": "direct"
      },
      {
        "id": "project_merge_blocked",
        "exit_id": "merge_blocked",
        "consumer_input_id": "merge_blocked_stop_input",
        "operation": "direct"
      },
      {
        "id": "project_phase2_reentry_required",
        "exit_id": "phase2_reentry_required",
        "consumer_input_id": "phase2_reentry_required_input",
        "operation": "select",
        "mappings": [
          {
            "source": "exit_id",
            "target": "exit_id"
          },
          {
            "source": "repo_ref",
            "target": "repo_ref"
          },
          {
            "source": "pr_number",
            "target": "pr_number"
          },
          {
            "source": "pr_url",
            "target": "pr_url"
          },
          {
            "source": "expected_head_sha",
            "target": "expected_head_sha"
          },
          {
            "source": "expected_base_branch",
            "target": "expected_base_branch"
          },
          {
            "source": "expected_head_branch",
            "target": "expected_head_branch"
          },
          {
            "source": "task_id",
            "target": "task_id"
          },
          {
            "source": "archive_locator",
            "target": "archive_locator"
          },
          {
            "source": "active_locator",
            "target": "active_locator"
          },
          {
            "source": "archive_commit",
            "target": "archive_commit"
          },
          {
            "source": "finding_refs",
            "target": "finding_refs"
          },
          {
            "source": "resume_target",
            "target": "resume_target"
          }
        ]
      },
      {
        "id": "project_closure_mismatch",
        "exit_id": "closure_mismatch",
        "consumer_input_id": "closure_mismatch_stop_input",
        "operation": "direct"
      },
      {
        "id": "project_review_refresh_required",
        "exit_id": "review_refresh_required",
        "consumer_input_id": "archived_review_seed_input",
        "operation": "select",
        "mappings": [
          {
            "source": "task_ref",
            "target": "task_ref"
          },
          {
            "source": "branch_review_commit",
            "target": "branch_review_commit"
          },
          {
            "source": "pr_payload_snapshot_sha256",
            "target": "pr_payload_snapshot_sha256"
          }
        ]
      }
    ],
    "private_artifacts": [
      {
        "id": "merge_gate",
        "kind": "gate_evidence",
        "schema": {
          "schema_id": "guru-task-pr-merge-gate-2.0",
          "path": "schemas/task-pr-merge-gate-2.0.schema.json"
        },
        "persistence": "ignored_runtime"
      },
      {
        "id": "archived_review_gate",
        "kind": "gate_evidence",
        "schema": {
          "schema_id": "guru-merge-task-pr-archived-review-gate-1.0",
          "path": "schemas/archived-review-gate.schema.json"
        },
        "persistence": "ignored_runtime"
      }
    ]
  },
  "external_exits": [
    {
      "id": "merged",
      "evidence": "expected-head merge succeeded and every Issue named by a live PR-body closing keyword was closed by GitHub at or after merged_at",
      "consumer": {
        "kind": "workflow",
        "id": "guru-finalization-finish-response"
      }
    },
    {
      "id": "merge_blocked",
      "evidence": "one current pre-merge semantic or objective condition prevents mutation",
      "consumer": {
        "kind": "stop",
        "id": "task-pr-merge-blocked"
      }
    },
    {
      "id": "phase2_reentry_required",
      "evidence": "the semantic owner identified a current task-work content finding and supplied the exact archived task recovery identity; Merge performs no mutation",
      "consumer": {
        "kind": "skill",
        "id": "guru-restore-archived-task"
      }
    },
    {
      "id": "closure_mismatch",
      "evidence": "the PR merged but GitHub close-keyword effects are incomplete or temporally invalid",
      "consumer": {
        "kind": "stop",
        "id": "task-pr-closure-mismatch"
      }
    },
    {
      "id": "review_refresh_required",
      "evidence": "Current completed archive and Ready PR identity checked, six entry dimensions reviewed, and exact PR payload snapshot captured without merge authority.",
      "consumer": {
        "kind": "skill",
        "id": "guru-review-branch"
      }
    }
  ],
  "reentry": {
    "identity": "repository, PR number/URL and expected head SHA",
    "freshness": "all GitHub facts are reread before gate check, mutation and post-merge projection",
    "stale_behavior": "fail_closed"
  },
  "tests": [
    "tests/test_contract.py",
    "tests/test_errors.py",
    "tests/test_archived_review.py"
  ],
  "platform_destinations": [
    "shared",
    "codex",
    "cursor",
    "claude"
  ],
  "runtime_dependency": {
    "extension_id": "guru-team",
    "api_version": "1.0",
    "manifest_path": ".trellis/guru-team/extension.json",
    "dispatcher": "run-skill-command",
    "distribution": "guru-team-preset",
    "package_portability": "not-self-contained"
  }
}
