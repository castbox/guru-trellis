{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-bind-task-session-semantic-result-2.0",
  "type": "object", "additionalProperties": false,
  "required": ["profile", "mode", "task_id", "lifecycle_generation", "continuation_id", "route", "resume_target", "ai_review_gate"],
  "properties": {
    "profile": {"enum": ["resume_current_task", "rebind_missing_session", "switch_task", "reactivate_rebind", "manual_recovery"]},
    "mode": {"enum": ["workflow", "standalone"]},
    "task_id": {"$ref": "#/$defs/taskId"},
    "lifecycle_generation": {"type": "integer", "minimum": 0},
    "continuation_id": {"type": "string", "minLength": 1},
    "route": {"enum": ["resume", "rebind", "switch", "reactivate", "manual_recovery"]},
    "resume_target": {"type": "string", "minLength": 1},
    "current_task_id": {"$ref": "#/$defs/taskId"},
    "current_lifecycle_generation": {"type": "integer", "minimum": 0},
    "ai_review_gate": {"type": "object", "additionalProperties": false, "required": ["status", "summary"],
      "properties": {"status": {"const": "passed"}, "summary": {"type": "string", "minLength": 1}}}
  },
  "$defs": {"taskId": {"type": "string", "pattern": "^(?!.*\\.\\.)(?!.*(?:\\.lock|\\.)$)[A-Za-z0-9][A-Za-z0-9._-]*$"}},
  "allOf": [
    {"if": {"properties": {"profile": {"const": "switch_task"}}, "required": ["profile"]},
      "then": {"required": ["current_task_id", "current_lifecycle_generation"]},
      "else": {"not": {"anyOf": [{"required": ["current_task_id"]}, {"required": ["current_lifecycle_generation"]}]}}},
    {"if": {"properties": {"profile": {"const": "resume_current_task"}}}, "then": {"properties": {"route": {"const": "resume"}}}},
    {"if": {"properties": {"profile": {"const": "rebind_missing_session"}}}, "then": {"properties": {"route": {"const": "rebind"}}}},
    {"if": {"properties": {"profile": {"const": "switch_task"}}}, "then": {"properties": {"route": {"const": "switch"}}}},
    {"if": {"properties": {"profile": {"const": "reactivate_rebind"}}}, "then": {"properties": {"route": {"const": "reactivate"}}}},
    {"if": {"properties": {"profile": {"const": "manual_recovery"}}}, "then": {"properties": {"route": {"const": "manual_recovery"}}}}
  ]
}
