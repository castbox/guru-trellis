{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-reactivate-task-semantic-result-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "mode", "route", "reason_refs"],
  "properties": {
    "profile": {"const": "reactivate_completed_task"},
    "mode": {"enum": ["workflow", "standalone"]},
    "reason_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "workspace_path", "branch_name", "base_branch", "base_head", "workspace_mapping", "task_mapping"],
      "properties": {
        "disposition": {"enum": ["reuse_exact", "create_new"]},
        "workspace_path": {"type": "string", "minLength": 1},
        "branch_name": {"type": "string", "minLength": 1},
        "base_branch": {"type": "string", "minLength": 1},
        "base_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "workspace_mapping": {"type": "string", "pattern": "^\\.trellis/\\.runtime/guru-team/workspaces/[A-Za-z0-9._-]+\\.json$"},
        "task_mapping": {"type": "string", "pattern": "^\\.trellis/\\.runtime/guru-team/tasks/[A-Za-z0-9._-]+\\.json$"}
      }
    },
    "route": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["typed_exit"], "properties": {"typed_exit": {"enum": ["reactivated_to_requirements", "reactivated_to_planning", "reactivated_to_implementation", "reactivated_to_evidence_refresh"]}}},
        {"type": "object", "additionalProperties": false, "required": ["typed_exit", "reason_code", "remediation"], "properties": {"typed_exit": {"const": "reactivate_blocked"}, "reason_code": {"type": "string", "minLength": 1}, "remediation": {"type": "string", "minLength": 1}}}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"route": {"properties": {"typed_exit": {"const": "reactivate_blocked"}}}}}, "then": {"not": {"required": ["workspace"]}}, "else": {"required": ["workspace"]}}
  ]
}
