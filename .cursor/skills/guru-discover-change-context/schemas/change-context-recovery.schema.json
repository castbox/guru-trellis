{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/castbox/guru-trellis/schemas/guru-change-context-recovery-1.0.json",
  "title": "Guru Change Context Recovery Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_id",
    "task_ref",
    "task_id",
    "mode",
    "continuation_id",
    "requested_exit",
    "gate_status",
    "reviewed_scope",
    "load_bearing_conclusions",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "skill_id": {
      "const": "guru-discover-change-context"
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[^/]+$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "const": "workflow"
    },
    "continuation_id": {
      "type": "string",
      "minLength": 1
    },
    "requested_exit": {
      "enum": [
        "context_ready",
        "refresh_base",
        "blocked"
      ]
    },
    "gate_status": {
      "enum": [
        "passed",
        "blocked"
      ]
    },
    "reviewed_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "load_bearing_conclusions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conclusion",
          "evidence_refs"
        ],
        "properties": {
          "conclusion": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
