{
  "schema_version": "1.1",
  "package_id": "guru-qualify-root-cause",
  "commands": [
    {
      "id": "record-root-cause-qualification",
      "owner": "guru-qualify-root-cause",
      "entrypoint": "runtime/record.py",
      "arguments": [
        {
          "flag": "--input",
          "required": true,
          "kind": "json",
          "description": "Dash; read the current AI semantic result from stdin.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "required_json",
      "stdout": "intermediate_receipt",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "stale_identity",
        "unsafe_path",
        "missing_contract",
        "internal_error"
      ],
      "side_effect": "none",
      "schema_bindings": [],
      "validator_id": "root_cause_qualification_recorder",
      "runtime_role": "record"
    },
    {
      "id": "check-root-cause-qualification",
      "owner": "guru-qualify-root-cause",
      "entrypoint": "runtime/check.py",
      "arguments": [
        {
          "flag": "--input",
          "required": true,
          "kind": "json",
          "description": "Dash; read the recorded process-local result from stdin.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "required_json",
      "stdout": "intermediate_receipt",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "stale_identity",
        "unsafe_path",
        "missing_contract",
        "internal_error"
      ],
      "side_effect": "git_read",
      "schema_bindings": [],
      "validator_id": "root_cause_qualification_checker",
      "runtime_role": "check"
    },
    {
      "id": "invoke-guru-qualify-root-cause",
      "owner": "guru-qualify-root-cause",
      "entrypoint": "runtime/invoke.py",
      "arguments": [
        {
          "flag": "--invocation",
          "required": true,
          "kind": "json",
          "description": "Dash; read one complete call-local semantic invocation from stdin.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "required_json",
      "stdout": "single_typed_exit",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "stale_identity",
        "unsafe_path",
        "missing_contract",
        "internal_error"
      ],
      "side_effect": "git_read",
      "schema_bindings": [],
      "validator_id": "public_invocation",
      "runtime_role": "invoke"
    }
  ]
}
