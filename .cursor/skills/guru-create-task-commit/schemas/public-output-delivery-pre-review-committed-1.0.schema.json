{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-create-task-commit-output-delivery-pre-review-committed-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "task_ref",
    "delivery_key",
    "branch_review_commit"
  ],
  "properties": {
    "exit_id": {
      "const": "pre_review_committed"
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "delivery_key": {
      "type": "object"
    },
    "branch_review_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
