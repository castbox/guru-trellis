{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-production-create-task-commit-input-initial-commit-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "mode", "task_ref", "source_exit", "checked_head"],
  "properties": {
    "profile": {"const": "initial_commit"},
    "mode": {"enum": ["workflow", "standalone"]},
    "task_ref": {"type": "string", "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"},
    "source_exit": {"const": "passed"},
    "checked_head": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
  }
}
