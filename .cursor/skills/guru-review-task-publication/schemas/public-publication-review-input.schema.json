{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-production-review-task-publication-input-publication-review-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "mode", "task_ref", "reviewed_head", "review_ref", "review_intent"],
  "properties": {
    "profile": {"const": "publication_review"},
    "mode": {"type": "string", "enum": ["workflow", "standalone"]},
    "task_ref": {"type": "string", "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"},
    "reviewed_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "review_ref": {"type": "string", "minLength": 1},
    "review_intent": {"type": "string", "enum": ["initial_review", "metadata_revision_review", "stale_reentry_review"]}
  }
}
