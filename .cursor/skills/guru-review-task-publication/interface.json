{
  "$schema": "../../schemas/skill-interface-1.4.schema.json",
  "schema_version": "1.4",
  "id": "guru-review-task-publication",
  "name": "guru-review-task-publication",
  "description": "Review task publication readiness through ten semantic dimensions, metadata-only revision, one private gate, and three typed exits.",
  "state": "active",
  "judgment_mode": "semantic",
  "modes": {
    "workflow": {
      "routing": "global_workflow",
      "entry_precondition_ids": ["runtime_dependency", "task_workspace", "task_identity", "branch_review_handoff", "issue_scope_ledger", "publication_content", "review_range_and_working_tree", "invocation_freshness"]
    },
    "standalone": {
      "routing": "direct_discovery",
      "entry_precondition_ids": ["runtime_dependency", "task_workspace", "task_identity", "branch_review_handoff", "issue_scope_ledger", "publication_content", "review_range_and_working_tree", "invocation_freshness"]
    }
  },
  "entry_preconditions": [
    {"id": "runtime_dependency", "evidence": "installed extension, dispatcher, active package, schemas and publication commands", "binding": "complete current Guru Team preset", "freshness": "validated before each command"},
    {"id": "task_workspace", "evidence": "current task.json, ignored runtime mapping and live Git worktree facts", "binding": "actual root equals expected task worktree", "freshness": "rebuilt before record and check"},
    {"id": "task_identity", "evidence": "active task.json and issue scope identity", "binding": "task, branch, issue and in_progress status", "freshness": "current task reread"},
    {"id": "branch_review_handoff", "evidence": "guru-review-branch passed DTO plus checked owner result", "binding": "task, branch_review_commit and reviewed-content identity", "freshness": "the Branch Review checker and reviewed-content engine are rerun before each publication check"},
    {"id": "issue_scope_ledger", "evidence": "current issue-scope-ledger.json", "binding": "primary, close, related and follow-up scope", "freshness": "current semantic projection"},
    {"id": "publication_content", "evidence": "AI-authored exact PR title/body plus current scope, diff, validation and durable docs", "binding": "one reviewer-facing PR payload and its history-summary source section", "freshness": "regenerated and rereviewed inside the owner loop"},
    {"id": "review_range_and_working_tree", "evidence": "current base-to-HEAD diff, status and reviewed-content identity", "binding": "Branch Review commit plus current content identity", "freshness": "rebuilt before record and check"},
    {"id": "invocation_freshness", "evidence": "current task and branch_review_commit", "binding": "one current owner invocation", "freshness": "checker rereads live owner state"}
  ],
  "runtime_dependency": {
    "extension_id": "guru-team",
    "api_version": "1.0",
    "manifest_path": ".trellis/guru-team/extension.json",
    "dispatcher": "run-skill-command",
    "distribution": "guru-team-preset",
    "package_portability": "not-self-contained"
  },
  "ordered_stages": ["forward_behavior", "ai_review_gate", "conditional_human_confirmation", "recorder_validator", "typed_exit"],
  "artifacts": [
    {"id": "readiness_example", "path": "examples/pr-readiness.json"},
    {"id": "publication_review_input", "path": "examples/public-publication-review-input.json"},
    {"id": "publication_review_authoring", "path": "examples/public-publication-review-authoring.json"},
    {"id": "publication_review_stale_input", "path": "examples/public-publication-review-stale-input.json"},
    {"id": "publication_review_stale_authoring", "path": "examples/public-publication-review-stale-authoring.json"},
    {"id": "public_ready_output", "path": "examples/public-ready-output.json"},
    {"id": "public_return_to_task_work_output", "path": "examples/public-return-to-task-work-output.json"},
    {"id": "public_blocked_output", "path": "examples/public-blocked-output.json"},
    {"id": "public_invocation_error", "path": "examples/public-invocation-error.json"}
  ],
  "schemas": [
    {"id": "legacy_readiness_schema_4_0", "path": "schemas/pr-readiness-4.0.schema.json"},
    {"id": "readiness_schema", "path": "schemas/pr-readiness.schema.json"},
    {"id": "public_input_publication_review", "path": "schemas/public-publication-review-input.schema.json"},
    {"id": "public_input_publication_review_stale", "path": "schemas/public-publication-review-stale-input.schema.json"},
    {"id": "public_input_aggregate", "path": "schemas/public-input.schema.json"},
    {"id": "legacy_public_ready_output_3_0", "path": "schemas/public-ready-output.schema.json"},
    {"id": "public_ready_output", "path": "schemas/public-ready-output-4.0.schema.json"},
    {"id": "public_return_to_task_work_output", "path": "schemas/public-return-to-task-work-output.schema.json"},
    {"id": "public_blocked_output", "path": "schemas/public-blocked-output.schema.json"},
    {"id": "public_invocation_error", "path": "schemas/public-invocation-error.schema.json"}
  ],
  "validators": [
    {"id": "publication_review_recorder", "command": "scripts/record-task-publication-review.sh", "runtime_command": "record-task-publication-review", "objective_scope": "Record only the completed semantic dimensions, findings, conclusions and route after current owner preflight"},
    {"id": "publication_review_checker", "command": "scripts/check-task-publication-review.sh", "runtime_command": "check-task-publication-review", "objective_scope": "Reread live owner facts and the shared Finalizer preflight without persisting derived bindings"},
    {"id": "public_invocation", "command": "scripts/invoke.sh", "runtime_command": "invoke-guru-review-task-publication", "objective_scope": "Validate public input, rerun the owner checker, select the actual exit schema and emit one minimal DTO"}
  ],
  "external_exits": [
    {"id": "ready", "evidence": "all ten current semantic dimensions pass and every current-scope finding is closed", "consumer": {"kind": "skill", "id": "guru-finalize-task"}},
    {"id": "return_to_task_work", "evidence": "one or more non-metadata current-scope findings require implementation and full downstream rerun", "consumer": {"kind": "workflow", "id": "guru-task-publication-work-router"}},
    {"id": "blocked", "evidence": "external decision, dependency or objective freshness prevents current completion", "consumer": {"kind": "stop", "id": "task-publication-review-blocked"}}
  ],
  "reentry": {
    "identity": "task_ref and branch_review_commit",
    "freshness": "metadata revision and stale handback reread current objective preconditions and rerun the shared Finalizer producer preflight",
    "stale_behavior": "fail_closed"
  },
  "tests": ["tests/test_contract.py"],
  "platform_destinations": ["shared", "codex", "cursor", "claude"],
  "public_contracts": {
    "input": {
      "kind": "structured_json",
      "aggregate_schema": {"schema_id": "guru-production-review-task-publication-input-aggregate-4.0", "path": "schemas/public-input.schema.json"},
      "profiles": [
        {
          "id": "publication_review",
          "schema": {"schema_id": "guru-production-review-task-publication-input-publication-review-3.0", "path": "schemas/public-publication-review-input.schema.json"},
          "example": {"id": "publication_review_input", "path": "examples/public-publication-review-input.json"},
          "discriminator": {"field": "profile", "value": "publication_review"}
        },
        {
          "id": "publication_review_stale",
          "schema": {"schema_id": "guru-production-review-task-publication-input-publication-review-stale-3.0", "path": "schemas/public-publication-review-stale-input.schema.json"},
          "example": {"id": "publication_review_stale_input", "path": "examples/public-publication-review-stale-input.json"},
          "discriminator": {"field": "profile", "value": "publication_review_stale"}
        }
      ]
    },
    "invocation": {
      "command_id": "run-skill-command",
      "wrapper": "scripts/invoke.sh",
      "input_binding": {"kind": "structured_json", "profile_id": "publication_review"},
      "stdout_contract": "single_typed_exit",
      "error_schema": {"schema_id": "guru-production-review-task-publication-invocation-error-1.0", "path": "schemas/public-invocation-error.schema.json"},
      "error_example": {"id": "invalid_public_input", "path": "examples/public-invocation-error.json"},
      "example_argv": ["--input", "examples/public-publication-review-input.json", "--owner-result", "examples/pr-readiness.json"]
    },
    "outputs": [
      {"exit_id": "ready", "schema": {"schema_id": "guru-production-review-task-publication-output-ready-4.0", "path": "schemas/public-ready-output-4.0.schema.json"}, "example": {"id": "ready_output", "path": "examples/public-ready-output.json"}, "consumer_use_ids": ["project_ready"]},
      {"exit_id": "return_to_task_work", "schema": {"schema_id": "guru-production-review-task-publication-output-return-to-task-work-1.0", "path": "schemas/public-return-to-task-work-output.schema.json"}, "example": {"id": "return_to_task_work_output", "path": "examples/public-return-to-task-work-output.json"}, "consumer_use_ids": ["project_return_to_task_work"]},
      {"exit_id": "blocked", "schema": {"schema_id": "guru-production-review-task-publication-output-blocked-1.0", "path": "schemas/public-blocked-output.schema.json"}, "example": {"id": "blocked_output", "path": "examples/public-blocked-output.json"}, "consumer_use_ids": ["project_blocked"]}
    ],
    "consumer_inputs": [
      {
        "id": "finalization_seed_input",
        "consumer": {"kind": "skill", "id": "guru-finalize-task"},
        "payload_kind": "structured_json",
        "contract": {
          "kind": "skill_input_authoring_seed",
          "interface_path": "packages/guru-finalize-task/interface.json",
          "input_kind": "structured_json",
          "profile_id": "publication_ready",
          "seed_fields": ["task_ref", "branch_review_commit", "pr_title", "pr_body"],
          "authoring_fields": ["profile", "mode"],
          "authoring_example": {
            "id": "finalization_publication_ready_authoring",
            "path": "examples/public-publication-ready-authoring.json"
          }
        }
      },
      {
        "id": "return_to_task_work_input",
        "consumer": {"kind": "workflow", "id": "guru-task-publication-work-router"},
        "payload_kind": "structured_json",
        "contract": {"kind": "json_schema", "schema_id": "guru-production-review-task-publication-workflow-return-to-task-work-input-1.0", "path": "consumers/workflow/production/review-task-publication-return-to-task-work.schema.json"}
      },
      {
        "id": "blocked_stop_input",
        "consumer": {"kind": "stop", "id": "task-publication-review-blocked"},
        "payload_kind": "structured_json",
        "contract": {"kind": "json_schema", "schema_id": "guru-production-review-task-publication-stop-blocked-input-1.0", "path": "consumers/stop/production/review-task-publication-blocked.schema.json"}
      }
    ],
    "projections": [
      {
        "id": "project_ready",
        "exit_id": "ready",
        "consumer_input_id": "finalization_seed_input",
        "operation": "select",
        "mappings": [
          {"source": "task_ref", "target": "task_ref"},
          {"source": "branch_review_commit", "target": "branch_review_commit"},
          {"source": "pr_title", "target": "pr_title"},
          {"source": "pr_body", "target": "pr_body"}
        ]
      },
      {"id": "project_return_to_task_work", "exit_id": "return_to_task_work", "consumer_input_id": "return_to_task_work_input", "operation": "direct"},
      {"id": "project_blocked", "exit_id": "blocked", "consumer_input_id": "blocked_stop_input", "operation": "direct"}
    ],
    "private_artifacts": [
      {
        "id": "publication_readiness",
        "kind": "gate_evidence",
        "schema": {"schema_id": "https://github.com/castbox/guru-trellis/schemas/guru-task-publication-readiness-5.0.json", "path": "schemas/pr-readiness.schema.json"},
        "persistence": "ignored_runtime"
      }
    ]
  }
}
