{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-merge-task-pr-input-archived-review-request-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "mode",
    "task_ref",
    "repo_ref",
    "pr_number",
    "expected_head_sha"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "profile": {
      "const": "archived_review_request"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/archive/[0-9]{4}-[0-9]{2}/[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "repo_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "expected_head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
