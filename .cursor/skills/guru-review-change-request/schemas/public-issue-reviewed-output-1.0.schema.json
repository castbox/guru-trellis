{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-review-change-request-output-issue-reviewed-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "report"
  ],
  "properties": {
    "exit_id": {
      "const": "issue_reviewed"
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "conclusion",
        "findings",
        "open_items"
      ],
      "properties": {
        "coverage": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "conclusion": {
          "type": "string",
          "minLength": 1
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "open_items": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
