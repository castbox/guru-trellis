{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-consumer-guru-check-task-planning_stale-delivery-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "task_ref",
    "planning_route",
    "proposal_refs",
    "delivery_key"
  ],
  "properties": {
    "exit_id": {
      "const": "planning_stale"
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "planning_route": {
      "type": "string",
      "enum": [
        "reapprove_plan",
        "clarify_requirements"
      ]
    },
    "proposal_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "delivery_key": {
      "type": "object"
    },
    "revision_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "proposal_refs": {
          "minItems": 1
        },
        "planning_route": {
          "const": "clarify_requirements"
        }
      },
      "not": {
        "required": [
          "revision_actions"
        ]
      }
    },
    {
      "properties": {
        "planning_route": {
          "const": "reapprove_plan"
        },
        "proposal_refs": {
          "maxItems": 0
        }
      },
      "required": [
        "revision_actions"
      ]
    }
  ]
}
