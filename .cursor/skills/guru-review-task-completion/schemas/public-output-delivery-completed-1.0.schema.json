{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-review-task-completion-output-delivery-completed-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "result_ref"
  ],
  "properties": {
    "exit_id": {
      "const": "completed"
    },
    "result_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "lifecycle_generation",
        "result_id"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "lifecycle_generation": {
          "type": "integer",
          "minimum": 0
        },
        "result_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      }
    }
  }
}
