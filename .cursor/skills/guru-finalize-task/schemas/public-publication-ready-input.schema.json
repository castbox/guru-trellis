{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-finalize-task-input-publication-ready-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "task_ref",
    "reviewed_content_head"
  ],
  "properties": {
    "profile": {"const": "publication_ready"},
    "mode": {"enum": ["workflow", "standalone"]},
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "reviewed_content_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
