{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-finalize-task-input-archived-review-refresh-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "mode", "task_ref", "branch_review_commit", "reviewed_base_head", "pr_title", "pr_body"],
  "properties": {
    "profile": {"const": "archived_review_refresh"},
    "mode": {"enum": ["workflow", "standalone"]},
    "task_ref": {"type": "string", "pattern": "^\\.trellis/tasks/archive/[0-9]{4}-[0-9]{2}/[A-Za-z0-9._-]+$"},
    "branch_review_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "reviewed_base_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pr_title": {"type": "string", "minLength": 1},
    "pr_body": {"type": "string", "minLength": 1}
  }
}
