{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-publish-task-delivery-input-delivery-draft-publish-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "task_ref",
    "delivery_key",
    "base_ref",
    "candidate_head",
    "pr_title",
    "pr_body"
  ],
  "properties": {
    "profile": {
      "const": "delivery_draft_publish"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "delivery_key": {
      "type": "object"
    },
    "base_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "pr_title": {
      "type": "string",
      "minLength": 1
    },
    "pr_body": {
      "type": "string",
      "minLength": 1
    }
  }
}
