{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-stage0-clarify-requirements-input-reviewed-plan-intake-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "source_exit",
    "mode",
    "target_locator",
    "continuation_id",
    "source_locators"
  ],
  "properties": {
    "profile": {
      "const": "reviewed_plan_intake"
    },
    "source_exit": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "target_locator": {
      "type": "string",
      "minLength": 1
    },
    "continuation_id": {
      "type": "string",
      "minLength": 1
    },
    "duplicate_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "checked_at",
        "target_locator",
        "authority_content_sha256",
        "candidates",
        "facts_sha256"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "target_locator": {
          "type": "string",
          "minLength": 1
        },
        "authority_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "facts_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repo",
              "number",
              "url",
              "updated_at",
              "facts_sha256"
            ],
            "properties": {
              "repo": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              },
              "facts_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "source_locators": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locator",
          "section"
        ],
        "properties": {
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_exit": {
            "const": "context_ready"
          }
        }
      },
      "then": {
        "required": [
          "duplicate_snapshot"
        ]
      }
    }
  ]
}
