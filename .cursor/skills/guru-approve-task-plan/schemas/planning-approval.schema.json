{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/castbox/guru-trellis/schemas/guru-planning-approval-3.0.json",
  "title": "Guru Planning Approval 3.0 Compact Semantic Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_id",
    "mode",
    "task_ref",
    "planning_paths",
    "reviewed_content_sha256",
    "authority_refs",
    "docs_ssot_plan",
    "semantic_review",
    "typed_exit",
    "reason",
    "consumer"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "skill_id": {"const": "guru-approve-task-plan"},
    "mode": {"enum": ["workflow", "standalone"]},
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "planning_paths": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+/(prd|design|implement)\\.md$"
      }
    },
    "reviewed_content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Owner-private composite freshness token over the three planning paths; it is not authorization, semantic approval, or a public handoff."
    },
    "authority_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "docs_ssot_plan": {"$ref": "#/$defs/docsSsotPlan"},
    "semantic_review": {"$ref": "#/$defs/semanticReview"},
    "typed_exit": {
      "enum": ["approved", "revision_required", "clarify_scope", "blocked"]
    },
    "reason": {"type": "string", "minLength": 1},
    "consumer": {"$ref": "#/$defs/consumer"}
  },
  "allOf": [
    {
      "if": {"properties": {"typed_exit": {"const": "approved"}}, "required": ["typed_exit"]},
      "then": {
        "properties": {
          "consumer": {"const": {"kind": "workflow", "id": "phase-1-task-activation"}},
          "semantic_review": {
            "properties": {
              "status": {"const": "passed"},
              "checked_dimensions": {"$ref": "#/$defs/passedDimensions"},
              "findings": {"maxItems": 0},
              "revision_actions": {"maxItems": 0},
              "scope_proposals": {"maxItems": 0},
              "blocking_reasons": {"maxItems": 0}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"typed_exit": {"const": "revision_required"}}, "required": ["typed_exit"]},
      "then": {
        "properties": {
          "consumer": {"const": {"kind": "skill", "id": "guru-approve-task-plan"}},
          "semantic_review": {
            "properties": {
              "status": {"const": "revision_required"},
              "revision_actions": {"minItems": 1},
              "scope_proposals": {"maxItems": 0}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"typed_exit": {"const": "clarify_scope"}}, "required": ["typed_exit"]},
      "then": {
        "properties": {
          "consumer": {"const": {"kind": "workflow", "id": "guru-task-plan-clarify-scope-router"}},
          "semantic_review": {
            "properties": {
              "status": {"const": "clarify_scope"},
              "scope_proposals": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"typed_exit": {"const": "blocked"}}, "required": ["typed_exit"]},
      "then": {
        "properties": {
          "consumer": {"const": {"kind": "stop", "id": "task-plan-approval-blocked"}},
          "semantic_review": {
            "properties": {
              "status": {"const": "blocked"},
              "blocking_reasons": {"minItems": 1}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "docsSsotPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "durable_paths", "summary"],
      "properties": {
        "strategy": {
          "enum": [
            "ssot_first",
            "delta_first",
            "bootstrap_or_repair_docs",
            "no_docs_update_needed"
          ]
        },
        "durable_paths": {"$ref": "#/$defs/stringList"},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_authority",
        "scope_boundary",
        "design_adequacy",
        "implementation_plan",
        "acceptance_verifiability",
        "docs_ssot",
        "provenance",
        "unusual_scenarios"
      ],
      "properties": {
        "requirement_authority": {"type": "boolean"},
        "scope_boundary": {"type": "boolean"},
        "design_adequacy": {"type": "boolean"},
        "implementation_plan": {"type": "boolean"},
        "acceptance_verifiability": {"type": "boolean"},
        "docs_ssot": {"type": "boolean"},
        "provenance": {"type": "boolean"},
        "unusual_scenarios": {"type": "boolean"}
      }
    },
    "passedDimensions": {
      "allOf": [
        {"$ref": "#/$defs/dimensions"},
        {
          "properties": {
            "requirement_authority": {"const": true},
            "scope_boundary": {"const": true},
            "design_adequacy": {"const": true},
            "implementation_plan": {"const": true},
            "acceptance_verifiability": {"const": true},
            "docs_ssot": {"const": true},
            "provenance": {"const": true},
            "unusual_scenarios": {"const": true}
          }
        }
      ]
    },
    "semanticReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "checked_dimensions",
        "findings",
        "revision_actions",
        "scope_proposals",
        "blocking_reasons"
      ],
      "properties": {
        "status": {
          "enum": ["passed", "revision_required", "clarify_scope", "blocked"]
        },
        "summary": {"type": "string", "minLength": 1},
        "checked_dimensions": {"$ref": "#/$defs/dimensions"},
        "findings": {"$ref": "#/$defs/stringList"},
        "revision_actions": {"$ref": "#/$defs/stringList"},
        "scope_proposals": {"$ref": "#/$defs/stringList"},
        "blocking_reasons": {"$ref": "#/$defs/stringList"}
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["workflow", "skill", "stop"]},
        "id": {"type": "string", "minLength": 1}
      }
    }
  }
}
