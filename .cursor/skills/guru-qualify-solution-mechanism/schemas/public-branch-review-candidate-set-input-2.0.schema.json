{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-solution-mechanism-input-branch-review-candidate-set-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "caller",
    "target_locator",
    "target",
    "candidate_refs",
    "candidate_locators"
  ],
  "properties": {
    "profile": {
      "const": "branch_review_candidate_set"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "caller": {
      "const": "guru-review-branch"
    },
    "target_locator": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_locator",
        "task_ref",
        "base_head",
        "review_head",
        "review_commit",
        "range_locator",
        "delivery_key"
      ],
      "properties": {
        "repo_locator": {
          "type": "string",
          "minLength": 1
        },
        "task_ref": {
          "type": "string",
          "minLength": 1
        },
        "base_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "review_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "review_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "range_locator": {
          "type": "string",
          "minLength": 1
        },
        "delivery_key": {
          "type": "object",
          "description": "Opaque upstream DeliveryKey; the original installed Task/Delivery API validates its complete identity and relationship."
        }
      }
    },
    "candidate_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidate_locators": {
      "$ref": "#/$defs/candidateLocators"
    }
  },
  "$defs": {
    "candidateLocators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_ref",
          "locators"
        ],
        "properties": {
          "candidate_ref": {
            "type": "string",
            "minLength": 1
          },
          "locators": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
