{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-author-task-plan-semantic-result-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "public_input",
    "output",
    "ai_review_gate"
  ],
  "properties": {
    "public_input": {
      "type": "object"
    },
    "output": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exit_id",
            "task_ref",
            "candidate"
          ],
          "properties": {
            "exit_id": {
              "const": "requirements_ready"
            },
            "task_ref": {
              "type": "string",
              "minLength": 1
            },
            "candidate": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "design_facts",
                    "constraint_refs"
                  ],
                  "properties": {
                    "design_facts": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "constraint_refs": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "design_locator"
                  ],
                  "properties": {
                    "design_locator": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exit_id",
            "task_ref"
          ],
          "properties": {
            "exit_id": {
              "const": "plan_ready"
            },
            "task_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exit_id",
            "task_ref",
            "scope_question_refs"
          ],
          "properties": {
            "exit_id": {
              "const": "clarify_scope"
            },
            "task_ref": {
              "type": "string",
              "minLength": 1
            },
            "scope_question_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exit_id",
            "task_ref",
            "missing_refs"
          ],
          "properties": {
            "exit_id": {
              "const": "blocked"
            },
            "task_ref": {
              "type": "string",
              "minLength": 1
            },
            "missing_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "ai_review_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "blocked"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
