{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-create-task-input-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "action", "creation", "acquisition", "task"],
  "properties": {
    "profile": {"const": "task_creation"},
    "action": {"enum": ["create_task", "recover_created_task_result"]},
    "creation": {"type": "object", "additionalProperties": false, "required": ["task_id", "task_ref", "source_profile", "reviewed_source", "accepted_scope_identity", "delivery_target", "selected_base_ref", "reviewed_base_head"], "properties": {
      "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
      "task_ref": {"type": "string", "pattern": "^\\.trellis/tasks/(?!archive/)[0-9]{2}-[0-9]{2}-[^/]+$"},
      "source_profile": {"enum": ["existing_issue", "standalone_request"]},
      "reviewed_source": {"type": "object"},
      "accepted_scope_identity": {"type": "string", "minLength": 1},
      "delivery_target": {"type": "object"},
      "selected_base_ref": {"type": "string", "minLength": 1},
      "reviewed_base_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
    }},
    "acquisition": {"type": "object", "additionalProperties": false, "required": ["route", "branch_ref", "decision_head", "transaction_id", "result_id"], "properties": {
      "route": {"enum": ["adopt_invocation_checkout", "provision_linked_worktree"]},
      "branch_ref": {"type": "string", "minLength": 1},
      "decision_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
      "transaction_id": {"type": "string", "minLength": 1},
      "result_id": {"type": "string", "minLength": 1},
      "provision_disposition": {"enum": ["new_branch", "existing_branch", "existing_checkout"]},
      "invocation_checkout": {"type": "string", "minLength": 1},
      "checkout_root": {"type": "string", "minLength": 1}
    }, "allOf": [
      {"if": {"properties": {"route": {"const": "adopt_invocation_checkout"}}}, "then": {"required": ["invocation_checkout"], "not": {"anyOf": [{"required": ["provision_disposition"]}, {"required": ["checkout_root"]}]}},
       "else": {"required": ["provision_disposition", "checkout_root"], "not": {"required": ["invocation_checkout"]}}}
    ]},
    "task": {"type": "object", "additionalProperties": false, "required": ["title", "description", "creator", "assignee", "scope"], "properties": {
      "title": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1},
      "creator": {"type": "string", "minLength": 1}, "assignee": {"type": "string", "minLength": 1},
      "scope": {"type": "string", "minLength": 1}
    }}
  }
}
