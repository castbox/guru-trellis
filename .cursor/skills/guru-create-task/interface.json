{
  "$schema": "../../schemas/skill-interface-1.4.schema.json",
  "schema_version": "1.4", "id": "guru-create-task", "name": "guru-create-task",
  "description": "Create one TaskId/source in the reviewed checkout and establish initial branch/ownership; recover the result without repeating creation or replacing another current session route.",
  "state": "active", "judgment_mode": "semantic",
  "modes": {"workflow":{"routing":"global_workflow","entry_precondition_ids":["reviewed_target","reviewed_base","acquisition"]},"standalone":{"routing":"direct_discovery","entry_precondition_ids":["reviewed_target","reviewed_base","acquisition"]}},
  "entry_preconditions": [
    {"id":"reviewed_target","evidence":"ready existing_issue or standalone_request and fresh live source decision","binding":"one TaskId and source profile","freshness":"reread before mutation"},
    {"id":"reviewed_base","evidence":"selected base ref and current decision HEAD","binding":"one repository and delivery target","freshness":"reread before mutation"},
    {"id":"acquisition","evidence":"reviewed invocation checkout or provision disposition and exact side-effect plan","binding":"one branch and call-local checkout path","freshness":"validate live Git before mutation or recovery"}
  ],
  "runtime_dependency":{"extension_id":"guru-team","api_version":"1.0","manifest_path":".trellis/guru-team/extension.json","dispatcher":"run-skill-command","distribution":"guru-team-preset","package_portability":"not-self-contained"},
  "ordered_stages":["forward_behavior","ai_review_gate","conditional_human_confirmation","recorder_validator","typed_exit"],
  "artifacts":[
    {"id":"create_input","path":"examples/public-create-input.json"},{"id":"recover_input","path":"examples/public-recover-input.json"},
    {"id":"created_output","path":"examples/public-created-output.json"},{"id":"refresh_output","path":"examples/public-refresh-review-output.json"},
    {"id":"blocked_output","path":"examples/public-blocked-output.json"},{"id":"invalid_output","path":"examples/public-invalid-task-state-output.json"},
    {"id":"invocation_error","path":"examples/public-invocation-error.json"}
  ],
  "schemas":[
    {"id":"public_input","path":"schemas/public-input.schema.json"},{"id":"public_output","path":"schemas/public-output.schema.json"},
    {"id":"created_output","path":"schemas/public-created-output.schema.json"},{"id":"refresh_output","path":"schemas/public-refresh-review-output.schema.json"},
    {"id":"blocked_output","path":"schemas/public-blocked-output.schema.json"},{"id":"invalid_output","path":"schemas/public-invalid-task-state-output.schema.json"},
    {"id":"invocation_error","path":"schemas/public-invocation-error.schema.json"}
  ],
  "validators":[
    {"id":"record_plan","command":"scripts/invoke.sh","runtime_command":"record-task-plan","objective_scope":"Record the reviewed task creation plan."},
    {"id":"create_task","command":"scripts/invoke.sh","runtime_command":"create-task","objective_scope":"Create the reviewed task."},
    {"id":"check_result","command":"scripts/invoke.sh","runtime_command":"check-task-creation-result","objective_scope":"Check the task creation result."},
    {"id":"recover_result","command":"scripts/invoke.sh","runtime_command":"recover-created-task-result","objective_scope":"Recover the unique task creation result."},
    {"id":"public_invocation","command":"scripts/invoke.sh","runtime_command":"invoke-guru-create-task","objective_scope":"Check reviewed acquisition, exact official task identity, initial control state and read-only recovery."}
  ],
  "external_exits":[
    {"id":"created","evidence":"TaskId and initial control state exist in the selected checkout","consumer":{"kind":"workflow","id":"guru-task-created"}},
    {"id":"refresh_review","evidence":"reviewed base authority changed or creation TaskRef date became stale","consumer":{"kind":"workflow","id":"guru-sync-base"}},
    {"id":"blocked","evidence":"checkout acquisition or session result cannot safely complete","consumer":{"kind":"stop","id":"task-creation-blocked"}},
    {"id":"invalid_task_state","evidence":"task or result identity conflicts with the reviewed creation","consumer":{"kind":"stop","id":"invalid-task-state"}}
  ],
  "reentry":{"identity":"TaskId, source, base and acquisition result","freshness":"reread task, Git branch and C4/C5 stores","stale_behavior":"fail_closed"},
  "tests":["tests/test_contract.py"],
  "platform_destinations":["shared","claude","cursor","opencode","codex","kilo","kiro","gemini","antigravity","devin","qoder","codebuddy","copilot","droid","dsh","pi","reasonix","zcode","trae","omp","grok","kimi","snow"],
  "public_contracts":{
    "input":{"kind":"structured_json","aggregate_schema":{"schema_id":"guru-create-task-input-1.0","path":"schemas/public-input.schema.json"},"profiles":[{"id":"task_creation","schema":{"schema_id":"guru-create-task-input-1.0","path":"schemas/public-input.schema.json"},"example":{"id":"create_input","path":"examples/public-create-input.json"},"discriminator":{"field":"profile","value":"task_creation"}}]},
    "invocation":{"command_id":"run-skill-command","wrapper":"scripts/invoke.sh","input_binding":{"kind":"structured_json","profile_id":"task_creation"},"stdout_contract":"single_typed_exit","error_schema":{"schema_id":"guru-create-task-error-1.0","path":"schemas/public-invocation-error.schema.json"},"error_example":{"id":"invocation_error","path":"examples/public-invocation-error.json"},"example_argv":["--input","examples/public-create-input.json"]},
    "outputs":[
      {"exit_id":"created","schema":{"schema_id":"guru-create-task-created-1.0","path":"schemas/public-created-output.schema.json"},"example":{"id":"created_output","path":"examples/public-created-output.json"},"consumer_use_ids":["created_projection"]},
      {"exit_id":"refresh_review","schema":{"schema_id":"guru-create-task-refresh-review-1.0","path":"schemas/public-refresh-review-output.schema.json"},"example":{"id":"refresh_output","path":"examples/public-refresh-review-output.json"},"consumer_use_ids":["refresh_projection"]},
      {"exit_id":"blocked","schema":{"schema_id":"guru-create-task-blocked-1.0","path":"schemas/public-blocked-output.schema.json"},"example":{"id":"blocked_output","path":"examples/public-blocked-output.json"},"consumer_use_ids":["blocked_projection"]},
      {"exit_id":"invalid_task_state","schema":{"schema_id":"guru-create-task-invalid-task-state-1.0","path":"schemas/public-invalid-task-state-output.schema.json"},"example":{"id":"invalid_output","path":"examples/public-invalid-task-state-output.json"},"consumer_use_ids":["invalid_projection"]}
    ],
    "consumer_inputs":[
      {"id":"created_input","consumer":{"kind":"workflow","id":"guru-task-created"},"payload_kind":"structured_json","contract":{"kind":"json_schema","schema_id":"guru-task-created-input-1.0","path":"consumers/workflow/production/created.schema.json"}},
      {"id":"refresh_input","consumer":{"kind":"workflow","id":"guru-sync-base"},"payload_kind":"structured_json","contract":{"kind":"json_schema","schema_id":"guru-task-creation-refresh-input-1.0","path":"consumers/workflow/production/refresh-review.schema.json"}},
      {"id":"blocked_input","consumer":{"kind":"stop","id":"task-creation-blocked"},"payload_kind":"structured_json","contract":{"kind":"json_schema","schema_id":"guru-task-creation-blocked-input-1.0","path":"consumers/stop/production/blocked.schema.json"}},
      {"id":"invalid_input","consumer":{"kind":"stop","id":"invalid-task-state"},"payload_kind":"structured_json","contract":{"kind":"json_schema","schema_id":"guru-task-creation-invalid-input-1.0","path":"consumers/stop/production/invalid-task-state.schema.json"}}
    ],
    "projections":[
      {"id":"created_projection","exit_id":"created","consumer_input_id":"created_input","operation":"direct"},
      {"id":"refresh_projection","exit_id":"refresh_review","consumer_input_id":"refresh_input","operation":"direct"},
      {"id":"blocked_projection","exit_id":"blocked","consumer_input_id":"blocked_input","operation":"direct"},
      {"id":"invalid_projection","exit_id":"invalid_task_state","consumer_input_id":"invalid_input","operation":"direct"}
    ], "private_artifacts":[]
  }
}
