{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-review-change-input-explicit-files-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "repository",
    "paths",
    "review_focus"
  ],
  "properties": {
    "profile": {
      "const": "explicit_files"
    },
    "mode": {
      "const": "standalone"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\.md$"
      }
    },
    "review_focus": {
      "const": "wording_only"
    }
  }
}
