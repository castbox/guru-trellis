{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-review-change-input-committed-range-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "repository",
    "base",
    "head"
  ],
  "properties": {
    "profile": {
      "const": "committed_range"
    },
    "mode": {
      "const": "standalone"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "head": {
      "type": "string",
      "minLength": 1
    }
  }
}
