{
  "$schema": "../../schemas/skill-interface-1.10.schema.json",
  "schema_version": "1.10",
  "id": "guru-sync-base",
  "name": "guru-sync-base",
  "description": "Resolve a fixed Git baseline for read-only Intake, or safely synchronize a selected base checkout.",
  "state": "active",
  "judgment_mode": "deterministic",
  "modes": {
    "workflow": {
      "routing": "global_workflow",
      "entry_precondition_ids": [
        "runtime_dependency",
        "decision_checkout",
        "selected_base_resolution",
        "clean_checkout",
        "result_facts"
      ]
    },
    "standalone": {
      "routing": "direct_discovery",
      "entry_precondition_ids": [
        "runtime_dependency",
        "decision_checkout",
        "selected_base_resolution",
        "clean_checkout",
        "result_facts"
      ]
    }
  },
  "entry_preconditions": [
    {
      "id": "runtime_dependency",
      "evidence": "installed extension manifest, dispatcher, managed package inventory and runtime commands",
      "binding": "complete compatible Guru Team preset runtime",
      "freshness": "validated by run-skill-command before each command"
    },
    {
      "id": "decision_checkout",
      "evidence": "Git repository toplevel and available objects; sync additionally checks checkout identity",
      "binding": "execution location is independent of the read baseline",
      "freshness": "read uses the selected immutable commit; sync checks live checkout facts"
    },
    {
      "id": "selected_base_resolution",
      "evidence": "operation-specific fixed Git object source or original synced provenance",
      "binding": "read requires explicit/config-selected ref and fixes a commit; sync preserves its original resolution",
      "freshness": "read never follows later ref movement; sync retains complete base_current provenance validation"
    },
    {
      "id": "clean_checkout",
      "evidence": "NUL-safe Git status before and after synchronization",
      "binding": "sync profile only: selected checkout has no tracked, untracked or staged changes",
      "freshness": "checked before fetch, before fast-forward and after synchronization"
    },
    {
      "id": "result_facts",
      "evidence": "baseline_ready Git-object identity or guru-base-sync-result-1.0 sync facts",
      "binding": "the selected read object or actual synchronized checkout roles",
      "freshness": "immutable object available; actual sync retains clean/ff/equality checks"
    }
  ],
  "runtime_dependency": {
    "extension_id": "guru-team",
    "api_version": "1.0",
    "manifest_path": ".trellis/guru-team/extension.json",
    "dispatcher": "run-skill-command",
    "distribution": "guru-team-preset",
    "package_portability": "not-self-contained"
  },
  "ordered_stages": [
    "forward_behavior",
    "recorder_validator",
    "typed_exit"
  ],
  "artifacts": [
    {
      "id": "base_sync_result_example",
      "path": "examples/base-sync-result.json"
    },
    {
      "id": "public_invocation_error_example",
      "path": "examples/public-invocation-error.json"
    },
    {
      "id": "legacy_public_output_synced_example_1_0",
      "path": "examples/public-synced-output.json"
    },
    {
      "id": "public_output_synced_example_2_0",
      "path": "examples/public-synced-output-2.0.json"
    },
    {
      "id": "public_output_skipped_example",
      "path": "examples/public-skipped-output.json"
    },
    {
      "id": "public_output_blocked_example",
      "path": "examples/public-blocked-output.json"
    },
    {
      "id": "public_output_baseline_ready_example",
      "path": "examples/public-baseline-ready-output.json"
    },
    {
      "id": "current_public_baseline_ready_output_2_0_json",
      "path": "examples/public-baseline-ready-output-2.0.json"
    }
  ],
  "schemas": [
    {
      "id": "base_sync_result_schema",
      "path": "schemas/base-sync-result.schema.json"
    },
    {
      "id": "public_invocation_error",
      "path": "schemas/public-invocation-error.schema.json"
    },
    {
      "id": "legacy_public_output_synced_1_0",
      "path": "schemas/public-synced-output.schema.json"
    },
    {
      "id": "public_output_synced_2_0",
      "path": "schemas/public-synced-output-2.0.schema.json"
    },
    {
      "id": "public_output_skipped",
      "path": "schemas/public-skipped-output.schema.json"
    },
    {
      "id": "public_output_blocked",
      "path": "schemas/public-blocked-output.schema.json"
    },
    {
      "id": "public_output_baseline_ready",
      "path": "schemas/public-baseline-ready-output.schema.json"
    },
    {
      "id": "current_public_baseline_ready_output_2_0_schema",
      "path": "schemas/public-baseline-ready-output-2.0.schema.json"
    },
    {
      "id": "current_public_confirmation_refresh_read_input_1_0_schema",
      "path": "schemas/public-confirmation-refresh-read-input-1.0.schema.json"
    },
    {
      "id": "current_public_input",
      "path": "schemas/public-input-current-2.0.schema.json"
    }
  ],
  "validators": [
    {
      "id": "sync_executor",
      "command": "scripts/sync-base.sh",
      "runtime_command": "sync-base",
      "objective_scope": "strict four-level resolution, pre-sync digest binding, explicit refspec fetch, selected-checkout ff-only execution, post-sync resolution generation and three-way equality facts"
    },
    {
      "id": "result_validator",
      "command": "scripts/check-base-sync.sh",
      "runtime_command": "check-base-sync",
      "objective_scope": "Draft 2020-12 schema, pre/post resolution digests, facts digest, selected refs, clean checkout and live decision/local/remote HEAD equality"
    },
    {
      "id": "public_invocation",
      "command": "scripts/invoke.sh",
      "runtime_command": "invoke-guru-sync-base",
      "objective_scope": "Caller-owned input validation and deterministic typed-exit serialization after the owner closed loop"
    }
  ],
  "external_exits": [
    {
      "id": "synced",
      "evidence": "validator-passed fresh stdout result facts carrying the post-sync resolution digest",
      "consumer": {
        "kind": "workflow",
        "id": "guru-issue-intake-base-router"
      }
    },
    {
      "id": "baseline_ready",
      "evidence": "available fixed Git commit with source-preserving selection; no checkout synchronization",
      "consumer": {
        "kind": "workflow",
        "id": "guru-issue-intake-base-router"
      }
    },
    {
      "id": "skipped",
      "evidence": "caller-classified non-repo route plus validated stdout-only skipped recorder facts",
      "consumer": {
        "kind": "workflow",
        "id": "original-request-route"
      }
    },
    {
      "id": "blocked",
      "evidence": "resolution, Git or objective validation failure",
      "consumer": {
        "kind": "stop",
        "id": "base-sync-blocked"
      }
    }
  ],
  "reentry": {
    "identity": "invocation mode, route id, repository identity, decision checkout, resolution source/base/remote/candidates, pre-sync resolution_sha256 and post_sync_resolution_sha256",
    "freshness": "each boundary consumes the preceding post-sync identity, emits the next identity, and matches clean live Git facts",
    "stale_behavior": "fail_closed"
  },
  "tests": [
    "tests/test_contract.py"
  ],
  "platform_destinations": [
    "shared",
    "claude",
    "cursor",
    "opencode",
    "codex",
    "kilo",
    "kiro",
    "gemini",
    "antigravity",
    "devin",
    "qoder",
    "codebuddy",
    "copilot",
    "droid",
    "dsh",
    "pi",
    "reasonix",
    "zcode",
    "trae",
    "omp",
    "grok",
    "kimi",
    "snow"
  ],
  "public_contracts": {
    "input": {
      "kind": "scalar_cli",
      "arguments": [
        {
          "id": "source_exit",
          "flag": "--source-exit",
          "type": "ascii_enum",
          "required": true
        },
        {
          "id": "mode",
          "flag": "--mode",
          "type": "ascii_enum",
          "required": true
        },
        {
          "id": "repo_root",
          "flag": "--repo-root",
          "type": "string",
          "required": false
        },
        {
          "id": "base_branch",
          "flag": "--base-branch",
          "type": "string",
          "required": false
        },
        {
          "id": "route",
          "flag": "--route",
          "type": "ascii_enum",
          "required": false
        },
        {
          "id": "operation",
          "flag": "--operation",
          "type": "ascii_enum",
          "required": false
        },
        {
          "id": "base_ref",
          "flag": "--base-ref",
          "type": "string",
          "required": false
        },
        {
          "id": "base_commit",
          "flag": "--base-commit",
          "type": "string",
          "required": false
        }
      ],
      "example_argv": [
        "--source-exit",
        "start",
        "--mode",
        "workflow",
        "--repo-root",
        ".",
        "--base-branch",
        "main",
        "--route",
        "repo_change"
      ]
    },
    "invocation": {
      "command_id": "run-skill-command",
      "wrapper": "scripts/invoke.sh",
      "input_binding": {
        "kind": "scalar_cli",
        "argument_ids": [
          "source_exit",
          "mode",
          "repo_root",
          "base_branch",
          "route",
          "operation",
          "base_ref",
          "base_commit"
        ]
      },
      "stdout_contract": "single_typed_exit",
      "error_schema": {
        "schema_id": "guru-stage0-sync-base-invocation-error-1.0",
        "path": "schemas/public-invocation-error.schema.json"
      },
      "error_example": {
        "id": "invalid_public_input",
        "path": "examples/public-invocation-error.json"
      },
      "call_local": {
        "flag": "--invocation",
        "stdin": "-",
        "envelope": {
          "schema_id": "guru-stage0-invocation-deterministic-sync-3.0",
          "path": "consumers/workflow/stage0/invocations/deterministic-sync-3.0.schema.json"
        },
        "public_input": {
          "schema": {
            "schema_id": "guru-stage0-sync-base-input-current-3.0",
            "path": "schemas/public-input-current-3.0.schema.json"
          },
          "example": {
            "id": "confirmation_refresh_read_input",
            "path": "examples/public-confirmation-refresh-read-input-1.0.json"
          }
        }
      },
      "example_argv": [
        "--invocation",
        "-"
      ]
    },
    "outputs": [
      {
        "exit_id": "synced",
        "schema": {
          "schema_id": "guru-stage0-sync-base-output-synced-3.0",
          "path": "schemas/public-synced-output-3.0.schema.json"
        },
        "example": {
          "id": "synced_output",
          "path": "examples/public-synced-output-2.0.json"
        },
        "consumer_use_ids": [
          "project_synced"
        ]
      },
      {
        "exit_id": "baseline_ready",
        "schema": {
          "schema_id": "guru-stage0-sync-base-output-baseline-ready-3.0",
          "path": "schemas/public-baseline-ready-output-3.0.schema.json"
        },
        "example": {
          "id": "current_public_baseline_ready_output_2_0_json",
          "path": "examples/public-baseline-ready-output-2.0.json"
        },
        "consumer_use_ids": [
          "project_baseline_ready"
        ]
      },
      {
        "exit_id": "skipped",
        "schema": {
          "schema_id": "guru-stage0-sync-base-output-skipped-1.0",
          "path": "schemas/public-skipped-output.schema.json"
        },
        "example": {
          "id": "skipped_output",
          "path": "examples/public-skipped-output.json"
        },
        "consumer_use_ids": [
          "project_skipped"
        ]
      },
      {
        "exit_id": "blocked",
        "schema": {
          "schema_id": "guru-stage0-sync-base-output-blocked-1.0",
          "path": "schemas/public-blocked-output.schema.json"
        },
        "example": {
          "id": "blocked_output",
          "path": "examples/public-blocked-output.json"
        },
        "consumer_use_ids": [
          "project_blocked"
        ]
      }
    ],
    "consumer_inputs": [
      {
        "id": "synced_pre_task_input",
        "consumer": {
          "kind": "workflow",
          "id": "guru-issue-intake-base-router"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "json_schema",
          "schema_id": "guru-stage0-sync-base-output-synced-3.0-router",
          "path": "consumers/workflow/stage0/sync-synced-router-3.0.schema.json"
        }
      },
      {
        "id": "skipped_workflow_input",
        "consumer": {
          "kind": "workflow",
          "id": "original-request-route"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "json_schema",
          "schema_id": "guru-stage0-sync-base-workflow-skipped-input-1.0",
          "path": "consumers/workflow/stage0/sync-base-skipped.schema.json"
        }
      },
      {
        "id": "blocked_stop_input",
        "consumer": {
          "kind": "stop",
          "id": "base-sync-blocked"
        },
        "payload_kind": "zero_payload"
      },
      {
        "id": "baseline_ready_pre_task_input",
        "consumer": {
          "kind": "workflow",
          "id": "guru-issue-intake-base-router"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "json_schema",
          "schema_id": "guru-stage0-sync-base-output-baseline-ready-3.0-router",
          "path": "consumers/workflow/stage0/sync-baseline_ready-router-3.0.schema.json"
        }
      }
    ],
    "projections": [
      {
        "id": "project_synced",
        "exit_id": "synced",
        "consumer_input_id": "synced_pre_task_input",
        "operation": "direct"
      },
      {
        "id": "project_skipped",
        "exit_id": "skipped",
        "consumer_input_id": "skipped_workflow_input",
        "operation": "direct"
      },
      {
        "id": "project_blocked",
        "exit_id": "blocked",
        "consumer_input_id": "blocked_stop_input",
        "operation": "select",
        "mappings": []
      },
      {
        "id": "project_baseline_ready",
        "exit_id": "baseline_ready",
        "consumer_input_id": "baseline_ready_pre_task_input",
        "operation": "direct"
      }
    ],
    "private_artifacts": [
      {
        "id": "base_sync_result",
        "kind": "runtime_checkpoint",
        "schema": {
          "schema_id": "https://github.com/castbox/guru-trellis/schemas/guru-base-sync-result-1.0.json",
          "path": "schemas/base-sync-result.schema.json"
        },
        "persistence": "stdout_only_pre_task"
      }
    ]
  }
}
