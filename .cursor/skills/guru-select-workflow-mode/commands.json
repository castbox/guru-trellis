{
  "schema_version": "1.1",
  "package_id": "guru-select-workflow-mode",
  "commands": [
    {
      "id": "check-workflow-environment",
      "owner": "guru-select-workflow-mode",
      "entrypoint": "runtime/check.py",
      "arguments": [
        {"flag": "--root", "required": false, "kind": "string", "description": "Repository root or a path below it.", "repeatable": false, "conflicts": []}
      ],
      "stdin": "none",
      "stdout": "intermediate_receipt",
      "errors": ["invalid_arguments", "conflicting_arguments", "environment_unavailable", "internal_error"],
      "side_effect": "github_read",
      "schema_bindings": [],
      "validator_id": "workflow_environment_checker",
      "runtime_role": "check"
    },
    {
      "id": "invoke-guru-select-workflow-mode",
      "owner": "guru-select-workflow-mode",
      "entrypoint": "runtime/invoke.py",
      "arguments": [
        {
          "flag": "--invocation",
          "required": false,
          "kind": "json",
          "description": "Inline JSON envelope with public_input and owner_result objects, or - for stdin; not a file locator. See references/contract.md#public-invocation.",
          "repeatable": false,
          "conflicts": [
            "--input",
            "--owner-result"
          ]
        },
        {
          "flag": "--input",
          "required": false,
          "kind": "string",
          "description": "Regular UTF-8 public input JSON file locator or - for stdin; see schemas/public-input.schema.json and examples/public-input.json.",
          "repeatable": false,
          "conflicts": [
            "--invocation"
          ]
        },
        {
          "flag": "--owner-result",
          "required": false,
          "kind": "string",
          "description": "Regular UTF-8 completed semantic owner result JSON file locator or - for stdin; see schemas/workflow-mode-selection.schema.json and examples/workflow-mode-selection.json.",
          "repeatable": false,
          "conflicts": [
            "--invocation"
          ]
        }
      ],
      "stdin": "optional_json",
      "stdout": "single_typed_exit",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "none",
      "schema_bindings": [
        "schemas/public-input.schema.json",
        "schemas/workflow-mode-selection.schema.json",
        "schemas/public-standard-intake-output.schema.json",
        "schemas/public-task-free-output.schema.json",
        "schemas/public-blocked-output.schema.json",
        "schemas/public-invocation-error.schema.json"
      ],
      "validator_id": "public_invocation",
      "runtime_role": "invoke"
    }
  ]
}
