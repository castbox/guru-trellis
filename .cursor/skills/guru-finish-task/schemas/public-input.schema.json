{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-finish-task-input-2.0",
  "oneOf": [{"$ref": "#/$defs/initial"}, {"$ref": "#/$defs/reentry"}],
  "$defs": {
    "taskId": {"type": "string", "pattern": "^(?!.*\\.\\.)(?!.*(?:\\.lock|\\.)$)[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "result": {"type": "object", "additionalProperties": false, "required": ["task_id", "lifecycle_generation", "result_id"], "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "lifecycle_generation": {"type": "integer", "minimum": 0}, "result_id": {"type": "string", "minLength": 1}}},
    "initial": {"type": "object", "additionalProperties": false, "required": ["profile", "mode", "closure_result"], "properties": {"profile": {"const": "closure_completed"}, "mode": {"enum": ["workflow", "standalone"]}, "closure_result": {"$ref": "#/$defs/result"}}},
    "reentry": {"type": "object", "additionalProperties": false, "required": ["profile", "mode", "task_id", "lifecycle_generation", "transaction_id", "result_id"], "properties": {"profile": {"const": "finish_reentry"}, "mode": {"enum": ["workflow", "standalone"]}, "task_id": {"$ref": "#/$defs/taskId"}, "lifecycle_generation": {"type": "integer", "minimum": 0}, "transaction_id": {"type": "string", "minLength": 1}, "result_id": {"type": "string", "minLength": 1}}}
  }
}
