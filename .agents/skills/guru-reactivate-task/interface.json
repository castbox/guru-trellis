{
  "$schema": "../../schemas/skill-interface-1.6.schema.json",
  "schema_version": "1.6",
  "id": "guru-reactivate-task",
  "name": "guru-reactivate-task",
  "description": "Reactivate one normally finished archived task while preserving its identity and routing the fresh work.",
  "state": "active",
  "judgment_mode": "semantic",
  "modes": {
    "workflow": {
      "routing": "global_workflow",
      "entry_precondition_ids": [
        "archived_identity",
        "current_baseline",
        "reactivation_reason"
      ]
    },
    "standalone": {
      "routing": "direct_discovery",
      "entry_precondition_ids": [
        "archived_identity",
        "current_baseline",
        "reactivation_reason"
      ]
    }
  },
  "entry_preconditions": [
    {
      "id": "archived_identity",
      "evidence": "exact shared archive Git/PR/public Task facts, independently of local resource sealing",
      "binding": "one stable TaskId and archived generation",
      "freshness": "before mutation"
    },
    {
      "id": "current_baseline",
      "evidence": "live local base and shared checkout acquisition facts",
      "binding": "next lifecycle generation",
      "freshness": "before acquisition"
    },
    {
      "id": "reactivation_reason",
      "evidence": "AI-reviewed intent, source and route",
      "binding": "one Reactivate transaction",
      "freshness": "call-local"
    }
  ],
  "runtime_dependency": {
    "extension_id": "guru-team",
    "api_version": "1.0",
    "manifest_path": ".trellis/guru-team/extension.json",
    "dispatcher": "run-skill-command",
    "distribution": "guru-team-preset",
    "package_portability": "not-self-contained"
  },
  "ordered_stages": [
    "forward_behavior",
    "ai_review_gate",
    "conditional_human_confirmation",
    "recorder_validator",
    "typed_exit"
  ],
  "artifacts": [
    {
      "id": "input",
      "path": "examples/public-input.json"
    },
    {
      "id": "semantic_result",
      "path": "examples/semantic-result.json"
    },
    {
      "id": "planning_output",
      "path": "examples/public-planning-output.json"
    },
    {
      "id": "session_output",
      "path": "examples/public-session-output.json"
    },
    {
      "id": "resume_output",
      "path": "examples/public-resume-output.json"
    },
    {
      "id": "blocked_output",
      "path": "examples/public-blocked-output.json"
    },
    {
      "id": "existing_input",
      "path": "examples/public-existing-implementation-input.json"
    },
    {
      "id": "existing_semantic",
      "path": "examples/semantic-existing-implementation.json"
    }
  ],
  "schemas": [
    {
      "id": "public_input",
      "path": "schemas/public-input.schema.json"
    },
    {
      "id": "semantic_result",
      "path": "schemas/semantic-result.schema.json"
    },
    {
      "id": "public_output",
      "path": "schemas/public-output.schema.json"
    },
    {
      "id": "planning_output",
      "path": "schemas/public-planning-output.schema.json"
    },
    {
      "id": "session_output",
      "path": "schemas/public-session-output.schema.json"
    },
    {
      "id": "resume_output",
      "path": "schemas/public-resume-output.schema.json"
    },
    {
      "id": "blocked_output",
      "path": "schemas/public-blocked-output.schema.json"
    },
    {
      "id": "reactivation_transaction",
      "path": "schemas/reactivation-transaction.schema.json"
    },
    {
      "id": "delivery_reactivate_shared_archive_input",
      "path": "schemas/public-delivery-reactivate-shared-archive-input.schema.json"
    },
    {
      "id": "selected_input",
      "path": "schemas/public-input-selected-2.0.schema.json"
    },
    {
      "id": "existing_input",
      "path": "schemas/public-existing-implementation-input-1.0.schema.json"
    },
    {
      "id": "selected_semantic",
      "path": "schemas/semantic-selected-2.0.schema.json"
    },
    {
      "id": "existing_semantic",
      "path": "schemas/semantic-existing-implementation-1.0.schema.json"
    },
    {
      "id": "existing_transaction",
      "path": "schemas/existing-implementation-transaction-3.0.schema.json"
    }
  ],
  "validators": [
    {
      "id": "public_invocation",
      "command": "scripts/invoke.sh",
      "runtime_command": "invoke-guru-reactivate-task",
      "objective_scope": "Validate exact shared archive, public successor, matching SDK and local acquisition facts."
    },
    {
      "id": "implementation_observer",
      "command": "scripts/observe.sh",
      "runtime_command": "observe-task-reactivation-implementation",
      "objective_scope": "Read exact implementation checkout content and repository-bound Draft PR facts; no semantic decision."
    }
  ],
  "external_exits": [
    {
      "id": "reactivated_to_planning",
      "evidence": "new planning incarnation and branch binding",
      "consumer": {
        "kind": "workflow",
        "id": "task-planning-router"
      }
    },
    {
      "id": "session_binding_recovery_required",
      "evidence": "new incarnation requires the Bind owner",
      "consumer": {
        "kind": "workflow",
        "id": "task-session-recovery-router"
      }
    },
    {
      "id": "resume_reactivation",
      "evidence": "same frozen transaction; pending generation locates its public plan target and does not assert an active Task",
      "consumer": {
        "kind": "workflow",
        "id": "task-reactivation-resume-router"
      }
    },
    {
      "id": "reactivate_blocked",
      "evidence": "archive, checkout or control state cannot be proven",
      "consumer": {
        "kind": "stop",
        "id": "task-reactivate-blocked"
      }
    }
  ],
  "reentry": {
    "identity": "archived TaskLifecycleKey and call-local acquisition transaction",
    "freshness": "revalidate live base, target checkout, branch and ledger",
    "stale_behavior": "fail_closed"
  },
  "tests": [
    "tests/test_reactivate_contract.py",
    "tests/test_delivery_reactivate.py",
    "tests/test_formal_archive_reactivate.py",
    "tests/test_existing_implementation.py"
  ],
  "platform_destinations": [
    "shared",
    "claude",
    "cursor",
    "opencode",
    "codex",
    "kilo",
    "kiro",
    "gemini",
    "antigravity",
    "devin",
    "qoder",
    "codebuddy",
    "copilot",
    "droid",
    "dsh",
    "pi",
    "reasonix",
    "zcode",
    "trae",
    "omp",
    "grok",
    "kimi",
    "snow"
  ],
  "public_contracts": {
    "input": {
      "kind": "structured_json",
      "aggregate_schema": {
        "schema_id": "guru-reactivate-task-input-selected-2.0",
        "path": "schemas/public-input-selected-2.0.schema.json"
      },
      "profiles": [
        {
          "id": "delivery_reactivate_shared_archive",
          "schema": {
            "schema_id": "guru-reactivate-task-input-delivery-reactivate-shared-archive-1.0",
            "path": "schemas/public-delivery-reactivate-shared-archive-input.schema.json"
          },
          "example": {
            "id": "input",
            "path": "examples/public-input.json"
          },
          "discriminator": {
            "field": "profile",
            "value": "delivery_reactivate_shared_archive"
          }
        },
        {
          "id": "delivery_reactivate_existing_implementation",
          "schema": {
            "schema_id": "guru-reactivate-task-input-existing-implementation-1.0",
            "path": "schemas/public-existing-implementation-input-1.0.schema.json"
          },
          "example": {
            "id": "existing_input",
            "path": "examples/public-existing-implementation-input.json"
          },
          "discriminator": {
            "field": "profile",
            "value": "delivery_reactivate_existing_implementation"
          }
        }
      ]
    },
    "invocation": {
      "command_id": "run-skill-command",
      "wrapper": "scripts/invoke.sh",
      "input_binding": {
        "kind": "structured_json",
        "profile_selector": {
          "source": "aggregate_public_input",
          "field": "profile"
        }
      },
      "stdout_contract": "single_typed_exit",
      "error_schema": {
        "schema_id": "guru-reactivate-task-output-3.0",
        "path": "schemas/public-output.schema.json"
      },
      "error_example": {
        "id": "blocked_output",
        "path": "examples/public-blocked-output.json"
      },
      "example_argv": [
        "--input",
        "examples/public-input.json",
        "--semantic-result",
        "examples/semantic-result.json"
      ]
    },
    "outputs": [
      {
        "exit_id": "reactivated_to_planning",
        "schema": {
          "schema_id": "guru-reactivate-task-output-planning-3.0",
          "path": "schemas/public-planning-output.schema.json"
        },
        "example": {
          "id": "planning_output",
          "path": "examples/public-planning-output.json"
        },
        "consumer_use_ids": [
          "planning"
        ]
      },
      {
        "exit_id": "session_binding_recovery_required",
        "schema": {
          "schema_id": "guru-reactivate-task-output-session-2.0",
          "path": "schemas/public-session-output.schema.json"
        },
        "example": {
          "id": "session_output",
          "path": "examples/public-session-output.json"
        },
        "consumer_use_ids": [
          "session"
        ]
      },
      {
        "exit_id": "resume_reactivation",
        "schema": {
          "schema_id": "guru-reactivate-task-output-resume-2.0",
          "path": "schemas/public-resume-output.schema.json"
        },
        "example": {
          "id": "resume_output",
          "path": "examples/public-resume-output.json"
        },
        "consumer_use_ids": [
          "resume"
        ]
      },
      {
        "exit_id": "reactivate_blocked",
        "schema": {
          "schema_id": "guru-reactivate-task-output-blocked-2.0",
          "path": "schemas/public-blocked-output.schema.json"
        },
        "example": {
          "id": "blocked_output",
          "path": "examples/public-blocked-output.json"
        },
        "consumer_use_ids": [
          "blocked"
        ]
      }
    ],
    "consumer_inputs": [
      {
        "id": "planning",
        "consumer": {
          "kind": "workflow",
          "id": "task-planning-router"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "json_schema",
          "schema_id": "guru-reactivate-task-route-3.0",
          "path": "consumers/workflow/production/reactivate-route.schema.json"
        }
      },
      {
        "id": "session",
        "consumer": {
          "kind": "workflow",
          "id": "task-session-recovery-router"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "json_schema",
          "schema_id": "guru-reactivate-session-route-2.0",
          "path": "consumers/workflow/production/reactivate-session.schema.json"
        }
      },
      {
        "id": "resume",
        "consumer": {
          "kind": "workflow",
          "id": "task-reactivation-resume-router"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "json_schema",
          "schema_id": "guru-reactivate-resume-route-2.0",
          "path": "consumers/workflow/production/reactivate-resume.schema.json"
        }
      },
      {
        "id": "blocked",
        "consumer": {
          "kind": "stop",
          "id": "task-reactivate-blocked"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "json_schema",
          "schema_id": "guru-reactivate-blocked-route-2.0",
          "path": "consumers/stop/production/reactivate-blocked.schema.json"
        }
      }
    ],
    "projections": [
      {
        "id": "planning",
        "exit_id": "reactivated_to_planning",
        "consumer_input_id": "planning",
        "operation": "select",
        "mappings": [
          {
            "source": "exit_id",
            "target": "exit_id"
          },
          {
            "source": "task_id",
            "target": "task_id"
          },
          {
            "source": "task_ref",
            "target": "task_ref"
          },
          {
            "source": "lifecycle_generation",
            "target": "lifecycle_generation"
          },
          {
            "source": "binding_revision",
            "target": "binding_revision"
          },
          {
            "source": "session_outcome",
            "target": "session_outcome"
          }
        ]
      },
      {
        "id": "session",
        "exit_id": "session_binding_recovery_required",
        "consumer_input_id": "session",
        "operation": "direct"
      },
      {
        "id": "resume",
        "exit_id": "resume_reactivation",
        "consumer_input_id": "resume",
        "operation": "direct"
      },
      {
        "id": "blocked",
        "exit_id": "reactivate_blocked",
        "consumer_input_id": "blocked",
        "operation": "direct"
      }
    ],
    "private_artifacts": [
      {
        "id": "reactivation_transaction",
        "kind": "runtime_checkpoint",
        "schema": {
          "schema_id": "guru-reactivate-task-transaction-2.0",
          "path": "schemas/reactivation-transaction.schema.json"
        },
        "persistence": "ignored_runtime"
      },
      {
        "id": "existing_transaction",
        "kind": "runtime_checkpoint",
        "schema": {
          "schema_id": "guru-reactivate-task-existing-implementation-transaction-3.0",
          "path": "schemas/existing-implementation-transaction-3.0.schema.json"
        },
        "persistence": "ignored_runtime"
      }
    ]
  }
}
