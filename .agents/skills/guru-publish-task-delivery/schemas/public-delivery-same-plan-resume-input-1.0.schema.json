{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-publish-task-delivery-input-delivery-same-plan-resume-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "task_ref",
    "transaction_ref",
    "delivery_key"
  ],
  "properties": {
    "profile": {
      "const": "delivery_same_plan_resume"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "transaction_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "delivery_key": {
      "type": "object"
    }
  }
}
