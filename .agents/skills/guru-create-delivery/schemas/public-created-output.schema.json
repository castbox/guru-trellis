{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-create-delivery-output-delivery-created-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "delivery_key",
    "task_ref",
    "planning_root"
  ],
  "properties": {
    "exit_id": {
      "const": "created"
    },
    "delivery_key": {
      "type": "object",
      "description": "Opaque public API 1.0 key; validated only by the installed upstream parser."
    },
    "task_ref": {
      "type": "string",
      "minLength": 1
    },
    "planning_root": {
      "type": "string",
      "minLength": 1
    }
  }
}
