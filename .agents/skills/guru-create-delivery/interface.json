{
  "$schema": "../../schemas/skill-interface-1.4.schema.json",
  "schema_version": "1.4",
  "id": "guru-create-delivery",
  "name": "guru-create-delivery",
  "description": "Create or select one reviewed Delivery before Planning and recover the same public identity.",
  "state": "active",
  "judgment_mode": "semantic",
  "modes": {
    "workflow": {
      "routing": "global_workflow",
      "entry_precondition_ids": [
        "public_delivery",
        "semantic_result"
      ]
    },
    "standalone": {
      "routing": "direct_discovery",
      "entry_precondition_ids": [
        "public_delivery",
        "semantic_result"
      ]
    }
  },
  "entry_preconditions": [
    {
      "id": "public_delivery",
      "evidence": "Installed Task schema 2.0 and Delivery API 1.0, current task scope and exact session selection",
      "binding": "One Task generation and explicit Delivery identity",
      "freshness": "Read public query before each operation"
    },
    {
      "id": "semantic_result",
      "evidence": "Current same-owner slice judgment or reviewed plan with current AI gate",
      "binding": "Exact input and actual authority",
      "freshness": "Fresh semantic judgment before new operation; same operation recovery reuses only applicable factual result"
    }
  ],
  "runtime_dependency": {
    "extension_id": "guru-team",
    "api_version": "1.0",
    "manifest_path": ".trellis/guru-team/extension.json",
    "dispatcher": "run-skill-command",
    "distribution": "guru-team-preset",
    "package_portability": "not-self-contained"
  },
  "ordered_stages": [
    "forward_behavior",
    "ai_review_gate",
    "conditional_human_confirmation",
    "recorder_validator",
    "typed_exit"
  ],
  "artifacts": [
    {
      "id": "delivery_creation_input",
      "path": "examples/public-delivery-creation-input.json"
    },
    {
      "id": "delivery_selection_input",
      "path": "examples/public-delivery-selection-input.json"
    },
    {
      "id": "invocation_error",
      "path": "examples/public-invocation-error.json"
    },
    {
      "id": "created_output",
      "path": "examples/public-created-output.json"
    },
    {
      "id": "scope_revision_required_output",
      "path": "examples/public-scope-revision-required-output.json"
    },
    {
      "id": "selection_required_output",
      "path": "examples/public-selection-required-output.json"
    },
    {
      "id": "blocked_output",
      "path": "examples/public-blocked-output.json"
    }
  ],
  "schemas": [
    {
      "id": "delivery_creation_input",
      "path": "schemas/public-delivery-creation-input.schema.json"
    },
    {
      "id": "delivery_selection_input",
      "path": "schemas/public-delivery-selection-input.schema.json"
    },
    {
      "id": "public_input",
      "path": "schemas/public-input.schema.json"
    },
    {
      "id": "invocation_error",
      "path": "schemas/public-invocation-error.schema.json"
    },
    {
      "id": "created_output",
      "path": "schemas/public-created-output.schema.json"
    },
    {
      "id": "scope_revision_required_output",
      "path": "schemas/public-scope-revision-required-output.schema.json"
    },
    {
      "id": "selection_required_output",
      "path": "schemas/public-selection-required-output.schema.json"
    },
    {
      "id": "blocked_output",
      "path": "schemas/public-blocked-output.schema.json"
    },
    {
      "id": "semantic_result",
      "path": "schemas/semantic-result.schema.json"
    },
    {
      "id": "pending_public_operation",
      "path": "schemas/pending-public-operation.schema.json"
    }
  ],
  "validators": [
    {
      "id": "public_invocation",
      "command": "scripts/invoke.sh",
      "runtime_command": "invoke-guru-create-delivery",
      "objective_scope": "Validate own input and result; invoke only the installed public parser/store/session; project one typed exit."
    }
  ],
  "external_exits": [
    {
      "id": "created",
      "evidence": "Exact same-owner semantic outcome with public identity/fact verification",
      "consumer": {
        "kind": "workflow",
        "id": "guru-delivery-planning-author-router"
      }
    },
    {
      "id": "scope_revision_required",
      "evidence": "Exact same-owner semantic outcome with public identity/fact verification",
      "consumer": {
        "kind": "skill",
        "id": "guru-clarify-requirements"
      }
    },
    {
      "id": "selection_required",
      "evidence": "Exact same-owner semantic outcome with public identity/fact verification",
      "consumer": {
        "kind": "workflow",
        "id": "guru-delivery-selection-router"
      }
    },
    {
      "id": "blocked",
      "evidence": "Exact same-owner semantic outcome with public identity/fact verification",
      "consumer": {
        "kind": "stop",
        "id": "delivery-creation-blocked"
      }
    }
  ],
  "reentry": {
    "identity": "Task generation, explicit DeliveryKey and same owner operation",
    "freshness": "Current public record and local planning files; no phase infers semantic pass",
    "stale_behavior": "fail_closed"
  },
  "tests": [
    "tests/test_contract.py"
  ],
  "platform_destinations": [
    "shared",
    "claude",
    "cursor",
    "opencode",
    "codex",
    "kilo",
    "kiro",
    "gemini",
    "antigravity",
    "devin",
    "qoder",
    "codebuddy",
    "copilot",
    "droid",
    "dsh",
    "pi",
    "reasonix",
    "zcode",
    "trae",
    "omp",
    "grok",
    "kimi",
    "snow"
  ],
  "public_contracts": {
    "input": {
      "kind": "structured_json",
      "aggregate_schema": {
        "schema_id": "guru-create-delivery-input-delivery-1.0",
        "path": "schemas/public-input.schema.json"
      },
      "profiles": [
        {
          "id": "delivery_creation",
          "schema": {
            "schema_id": "guru-create-delivery-input-delivery-creation-1.0",
            "path": "schemas/public-delivery-creation-input.schema.json"
          },
          "example": {
            "id": "delivery_creation_input",
            "path": "examples/public-delivery-creation-input.json"
          },
          "discriminator": {
            "field": "profile",
            "value": "delivery_creation"
          }
        },
        {
          "id": "delivery_selection",
          "schema": {
            "schema_id": "guru-create-delivery-input-delivery-selection-1.0",
            "path": "schemas/public-delivery-selection-input.schema.json"
          },
          "example": {
            "id": "delivery_selection_input",
            "path": "examples/public-delivery-selection-input.json"
          },
          "discriminator": {
            "field": "profile",
            "value": "delivery_selection"
          }
        }
      ]
    },
    "invocation": {
      "command_id": "run-skill-command",
      "wrapper": "scripts/invoke.sh",
      "input_binding": {
        "kind": "structured_json",
        "profile_id": "delivery_creation"
      },
      "stdout_contract": "single_typed_exit",
      "error_schema": {
        "schema_id": "guru-create-delivery-error-1.0",
        "path": "schemas/public-invocation-error.schema.json"
      },
      "error_example": {
        "id": "invocation_error",
        "path": "examples/public-invocation-error.json"
      },
      "example_argv": [
        "--input",
        "examples/public-delivery-creation-input.json"
      ]
    },
    "outputs": [
      {
        "exit_id": "created",
        "schema": {
          "schema_id": "guru-create-delivery-output-delivery-created-1.0",
          "path": "schemas/public-created-output.schema.json"
        },
        "example": {
          "id": "created_output",
          "path": "examples/public-created-output.json"
        },
        "consumer_use_ids": [
          "created_projection"
        ]
      },
      {
        "exit_id": "scope_revision_required",
        "schema": {
          "schema_id": "guru-create-delivery-output-delivery-scope-revision-required-1.0",
          "path": "schemas/public-scope-revision-required-output.schema.json"
        },
        "example": {
          "id": "scope_revision_required_output",
          "path": "examples/public-scope-revision-required-output.json"
        },
        "consumer_use_ids": [
          "scope_revision_required_projection"
        ]
      },
      {
        "exit_id": "selection_required",
        "schema": {
          "schema_id": "guru-create-delivery-output-delivery-selection-required-1.0",
          "path": "schemas/public-selection-required-output.schema.json"
        },
        "example": {
          "id": "selection_required_output",
          "path": "examples/public-selection-required-output.json"
        },
        "consumer_use_ids": [
          "selection_required_projection"
        ]
      },
      {
        "exit_id": "blocked",
        "schema": {
          "schema_id": "guru-create-delivery-output-delivery-blocked-1.0",
          "path": "schemas/public-blocked-output.schema.json"
        },
        "example": {
          "id": "blocked_output",
          "path": "examples/public-blocked-output.json"
        },
        "consumer_use_ids": [
          "blocked_projection"
        ]
      }
    ],
    "consumer_inputs": [
      {
        "id": "created_input",
        "consumer": {
          "kind": "workflow",
          "id": "guru-delivery-planning-author-router"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "json_schema",
          "schema_id": "guru-consumer-guru-create-delivery-created-delivery-1.0",
          "path": "consumers/workflow/delivery-1.0/create-delivery-created.schema.json"
        }
      },
      {
        "id": "scope_revision_required_input",
        "consumer": {
          "kind": "skill",
          "id": "guru-clarify-requirements"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "skill_input_authoring_seed",
          "interface_path": "packages/guru-clarify-requirements/interface.json",
          "input_kind": "structured_json",
          "profile_id": "delivery_task_scope_revision",
          "seed_fields": [
            "source_exit",
            "task_ref",
            "task_key"
          ],
          "authoring_fields": [
            "profile",
            "mode",
            "target_locator",
            "resume_target",
            "continuation_id"
          ],
          "authoring_example": {
            "id": "scope_revision_required_delivery_authoring",
            "path": "examples/authoring-delivery-scope-revision-required-1.0.json"
          }
        }
      },
      {
        "id": "selection_required_input",
        "consumer": {
          "kind": "workflow",
          "id": "guru-delivery-selection-router"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "json_schema",
          "schema_id": "guru-consumer-guru-create-delivery-selection_required-delivery-1.0",
          "path": "consumers/workflow/delivery-1.0/create-delivery-selection-required.schema.json"
        }
      },
      {
        "id": "blocked_input",
        "consumer": {
          "kind": "stop",
          "id": "delivery-creation-blocked"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "json_schema",
          "schema_id": "guru-consumer-guru-create-delivery-blocked-delivery-1.0",
          "path": "consumers/stop/delivery-1.0/create-delivery-blocked.schema.json"
        }
      }
    ],
    "projections": [
      {
        "id": "created_projection",
        "exit_id": "created",
        "consumer_input_id": "created_input",
        "operation": "direct"
      },
      {
        "id": "scope_revision_required_projection",
        "exit_id": "scope_revision_required",
        "consumer_input_id": "scope_revision_required_input",
        "operation": "rename",
        "mappings": [
          {
            "source": "exit_id",
            "target": "source_exit"
          },
          {
            "source": "task_ref",
            "target": "task_ref"
          },
          {
            "source": "task_key",
            "target": "task_key"
          }
        ]
      },
      {
        "id": "selection_required_projection",
        "exit_id": "selection_required",
        "consumer_input_id": "selection_required_input",
        "operation": "direct"
      },
      {
        "id": "blocked_projection",
        "exit_id": "blocked",
        "consumer_input_id": "blocked_input",
        "operation": "direct"
      }
    ],
    "private_artifacts": [
      {
        "id": "pending_public_operation",
        "kind": "runtime_checkpoint",
        "schema": {
          "schema_id": "guru-create-delivery-pending-public-operation-1.0",
          "path": "schemas/pending-public-operation.schema.json"
        },
        "persistence": "ignored_runtime"
      }
    ]
  }
}
