{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-production-check-task-input-resolved-reconciliation-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "mode", "task_ref", "source_exit"],
  "properties": {
    "profile": {"const": "resolved_reconciliation"},
    "mode": {"enum": ["workflow", "standalone"]},
    "task_ref": {"type": "string", "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"},
    "source_exit": {"const": "resolved_tree_ready"}
  }
}
