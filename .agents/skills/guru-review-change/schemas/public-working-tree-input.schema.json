{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-review-change-input-working-tree-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "repository"
  ],
  "properties": {
    "profile": {
      "const": "working_tree"
    },
    "mode": {
      "const": "standalone"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
