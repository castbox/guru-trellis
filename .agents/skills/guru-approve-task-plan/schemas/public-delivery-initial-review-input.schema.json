{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-approve-task-plan-input-delivery-initial-review-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "task_ref",
    "source_exit",
    "delivery_key"
  ],
  "properties": {
    "profile": {
      "const": "delivery_initial_review"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "source_exit": {
      "const": "planning_ready"
    },
    "delivery_key": {
      "type": "object",
      "description": "Opaque upstream DeliveryKey; validated by the installed public API."
    }
  }
}
