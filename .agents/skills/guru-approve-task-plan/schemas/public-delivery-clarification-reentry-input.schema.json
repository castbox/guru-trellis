{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-approve-task-plan-input-delivery-clarification-reentry-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "task_ref",
    "source_exit",
    "reentry_reason",
    "delivery_key"
  ],
  "properties": {
    "profile": {
      "const": "delivery_clarification_reentry"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "source_exit": {
      "const": "clarify_scope"
    },
    "reentry_reason": {
      "const": "authority_refreshed"
    },
    "delivery_key": {
      "type": "object",
      "description": "Opaque upstream DeliveryKey; validated by the installed public API."
    }
  }
}
