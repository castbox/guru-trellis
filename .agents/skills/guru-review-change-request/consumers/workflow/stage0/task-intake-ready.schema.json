{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-stage0-task-intake-router-input-2.0",
  "type": "object",
  "required": ["exit_id", "transition"],
  "properties": {
    "exit_id": {"const": "ready"},
    "transition": {
      "type": "object",
      "required": ["stage", "target"],
      "properties": {
        "stage": {"const": "readiness_current"},
        "target": {
          "type": "object",
          "required": ["kind"],
          "properties": {"kind": {"enum": ["proposed_draft", "existing_issue", "standalone_request"]}}
        },
        "clarify_profile": {"enum": ["standard_intake", "reviewed_plan_intake", "active_task_scope_change", "standalone_review", "normal_scenario_scope_confirmation", "solution_mechanism_scope_confirmation"]},
        "source_locators": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["locator", "section"], "properties": {"locator": {"type": "string", "minLength": 1}, "section": {"type": "string", "minLength": 1}}}},
        "source_selection": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["locator", "section", "authority_kind"], "properties": {"locator": {"type": "string", "minLength": 1}, "section": {"type": "string", "minLength": 1}, "authority_kind": {"enum": ["requirement", "design_constraint", "advisory"]}}}}
      }
    }
  }
}
