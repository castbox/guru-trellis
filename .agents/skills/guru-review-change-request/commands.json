{
  "schema_version": "1.0",
  "package_id": "guru-review-change-request",
  "commands": [
    {
      "id": "record-change-request-review",
      "owner": "guru-review-change-request",
      "entrypoint": "runtime/record.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root."
        },
        {
          "flag": "--mode",
          "required": true,
          "kind": "enum",
          "values": [
            "workflow",
            "standalone"
          ],
          "description": "Invocation mode."
        },
        {
          "flag": "--input",
          "required": true,
          "kind": "string",
          "description": "AI review JSON locator."
        },
        {
          "flag": "--change-request-input",
          "required": true,
          "kind": "string",
          "description": "Reviewed change request JSON locator."
        }
      ],
      "stdin": "none",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "runtime_write",
      "schema_bindings": [],
      "validator_id": "change_request_review_recorder"
    },
    {
      "id": "check-change-request-review",
      "owner": "guru-review-change-request",
      "entrypoint": "runtime/check.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root."
        },
        {
          "flag": "--input",
          "required": true,
          "kind": "string",
          "description": "Review result JSON locator."
        },
        {
          "flag": "--prerequisites-input",
          "required": true,
          "kind": "string",
          "description": "Prerequisites JSON locator."
        },
        {
          "flag": "--change-request-input",
          "required": true,
          "kind": "string",
          "description": "Reviewed request JSON locator."
        }
      ],
      "stdin": "none",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "git_read",
      "schema_bindings": [],
      "validator_id": "change_request_review_checker"
    },
    {
      "id": "invoke-stage0-skill",
      "owner": "guru-review-change-request",
      "entrypoint": "runtime/invoke.py",
      "arguments": [
        {
          "flag": "--invocation",
          "required": false,
          "kind": "json",
          "description": "Call-local invocation envelope or dash for stdin."
        },
        {
          "flag": "--input",
          "required": false,
          "kind": "string",
          "description": "Public input JSON locator."
        },
        {
          "flag": "--owner-result",
          "required": false,
          "kind": "string",
          "description": "Completed owner result JSON locator."
        }
      ],
      "stdin": "optional_json",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "runtime_write",
      "schema_bindings": [],
      "validator_id": "public_invocation"
    }
  ]
}
