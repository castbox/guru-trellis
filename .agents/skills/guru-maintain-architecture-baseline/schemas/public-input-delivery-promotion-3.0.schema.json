{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-maintain-architecture-baseline-input-delivery-promotion-3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "source_exit",
    "mode",
    "continuation_id",
    "stage",
    "task_locator",
    "baseline",
    "constitution",
    "project_contract",
    "freshness_identity",
    "expected_current_identity",
    "current_identity",
    "sync_kind",
    "sync_target",
    "delivery_key",
    "planning_root",
    "before_authority",
    "candidate"
  ],
  "properties": {
    "schema_version": {
      "const": "delivery-3.0"
    },
    "profile": {
      "const": "delivery_promotion"
    },
    "source_exit": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "continuation_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "const": "final_integration"
    },
    "task_locator": {
      "type": "string",
      "minLength": 1
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "identity",
        "status"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "active"
        }
      }
    },
    "constitution": {
      "$ref": "#/$defs/constitution"
    },
    "project_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guru_contract_identity",
        "change_contract_locator",
        "change_contract_identity",
        "required_concern_set_identity"
      ],
      "properties": {
        "guru_contract_identity": {
          "const": "guru-maintain-architecture-baseline:5.0"
        },
        "change_contract_locator": {
          "type": "string",
          "minLength": 1
        },
        "change_contract_identity": {
          "type": "string",
          "minLength": 1
        },
        "required_concern_set_identity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "freshness_identity": {
      "type": "string",
      "minLength": 1
    },
    "expected_current_identity": {
      "type": "string",
      "minLength": 1
    },
    "current_identity": {
      "type": "string",
      "minLength": 1
    },
    "sync_kind": {
      "const": "promotion_required"
    },
    "sync_target": {
      "$ref": "#/$defs/syncTarget"
    },
    "delivery_key": {
      "type": "object",
      "description": "Opaque public DeliveryKey; target API validates relationship."
    },
    "planning_root": {
      "type": "string",
      "minLength": 1
    },
    "before_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_revision",
        "baseline_locator",
        "constitution_locator",
        "change_contract_locator"
      ],
      "properties": {
        "git_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "baseline_locator": {
          "type": "string",
          "minLength": 1
        },
        "constitution_locator": {
          "type": "string",
          "minLength": 1
        },
        "change_contract_locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "content_identity"
      ],
      "properties": {
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "content_identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },
  "$defs": {
    "committedRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_ref",
        "base_head",
        "review_head"
      ],
      "properties": {
        "base_ref": {
          "type": "string",
          "minLength": 1
        },
        "base_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "review_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "constitution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_locator",
        "authority_status",
        "identity_kind",
        "identity",
        "principles"
      ],
      "properties": {
        "authority_locator": {
          "type": "string",
          "minLength": 1
        },
        "authority_status": {
          "enum": [
            "current",
            "pending_reviewed_promotion"
          ]
        },
        "identity_kind": {
          "enum": [
            "version",
            "content"
          ]
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "principles": {
          "$ref": "#/$defs/principles"
        }
      }
    },
    "principles": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/p1"
          },
          {
            "$ref": "#/$defs/p2"
          },
          {
            "$ref": "#/$defs/p3"
          },
          {
            "$ref": "#/$defs/p4"
          },
          {
            "$ref": "#/$defs/p5"
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "$ref": "#/$defs/p1"
          }
        },
        {
          "contains": {
            "$ref": "#/$defs/p2"
          }
        },
        {
          "contains": {
            "$ref": "#/$defs/p3"
          }
        },
        {
          "contains": {
            "$ref": "#/$defs/p4"
          }
        },
        {
          "contains": {
            "$ref": "#/$defs/p5"
          }
        }
      ]
    },
    "p1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "short_name"
      ],
      "properties": {
        "id": {
          "const": "mature-practice-applicability"
        },
        "short_name": {
          "const": "成熟实践与适用性"
        }
      }
    },
    "p2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "short_name"
      ],
      "properties": {
        "id": {
          "const": "concept-semantic-completeness"
        },
        "short_name": {
          "const": "概念与语义完整性"
        }
      }
    },
    "p3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "short_name"
      ],
      "properties": {
        "id": {
          "const": "cohesion-change-isolation"
        },
        "short_name": {
          "const": "职责内聚与变化隔离"
        }
      }
    },
    "p4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "short_name"
      ],
      "properties": {
        "id": {
          "const": "minimum-necessary-complexity"
        },
        "short_name": {
          "const": "最小必要复杂度"
        }
      }
    },
    "p5": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "short_name"
      ],
      "properties": {
        "id": {
          "const": "debt-one-way-convergence"
        },
        "short_name": {
          "const": "技术债务单向收敛"
        }
      }
    },
    "syncTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "locator",
        "expected_identity",
        "current_identity"
      ],
      "properties": {
        "kind": {
          "enum": [
            "baseline",
            "constitution",
            "contribution",
            "project_contract"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "expected_identity": {
          "type": "string",
          "minLength": 1
        },
        "current_identity": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
