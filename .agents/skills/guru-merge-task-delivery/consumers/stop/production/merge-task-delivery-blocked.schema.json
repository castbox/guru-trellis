{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-merge-task-delivery-stop-blocked-input-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["exit_id", "repo_ref", "pr_number", "reason_code", "remediation"],
  "properties": {
    "exit_id": {"const": "merge_blocked"},
    "repo_ref": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "pr_number": {"type": "integer", "minimum": 1},
    "reason_code": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
    "remediation": {"type": "string", "minLength": 1}
  }
}
