{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"guru-merge-task-delivery-history-query-1.0",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","task_identity","repo_ref","base_ref"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "task_identity":{"type":"string","minLength":1,"pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "repo_ref":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "base_ref":{"type":"string","minLength":1,"pattern":"^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"}
  }
}
