{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-complete-task-closure-semantic-result-2.0",
  "type": "object", "additionalProperties": false,
  "required": ["profile", "mode", "route"],
  "properties": {
    "profile": {"const": "completion_approved"}, "mode": {"enum": ["workflow", "standalone"]},
    "reviewed_action_set": {"type": "array", "uniqueItems": true, "items": {"type": "object"}},
    "route": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["typed_exit"], "properties": {"typed_exit": {"const": "apply"}}},
      {"type": "object", "additionalProperties": false, "required": ["typed_exit", "reason"],
       "properties": {"typed_exit": {"const": "blocked"}, "reason": {"type": "object", "additionalProperties": false,
         "required": ["reason_code", "reason_refs"], "properties": {"reason_code": {"type": "string", "minLength": 1},
           "reason_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}}}
    ]}
  },
  "allOf": [{"if": {"properties": {"route": {"properties": {"typed_exit": {"const": "apply"}}}}}, "then": {"required": ["reviewed_action_set"]}}]
}
