{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "guru-complete-task-closure-shared-result-recovery-semantic-1.0",
  "required": [
    "profile",
    "mode",
    "route"
  ],
  "properties": {
    "profile": {
      "const": "closure_shared_result_recovery"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "reviewed_action_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "route": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "typed_exit"
          ],
          "properties": {
            "typed_exit": {
              "const": "apply"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "typed_exit",
            "reason"
          ],
          "properties": {
            "typed_exit": {
              "const": "blocked"
            },
            "reason": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason_code",
                "reason_refs"
              ],
              "properties": {
                "reason_code": {
                  "type": "string",
                  "minLength": 1
                },
                "reason_refs": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "route": {
            "properties": {
              "typed_exit": {
                "const": "apply"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "reviewed_action_set"
        ]
      }
    }
  ],
  "$defs": {
    "repo": {
      "type": "string",
      "pattern": "^(?![^/]+/[^/]+\\.git$)[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_ref",
        "disposition"
      ],
      "properties": {
        "issue_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo_ref",
            "issue_number"
          ],
          "properties": {
            "repo_ref": {
              "$ref": "#/$defs/repo"
            },
            "issue_number": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "disposition": {
          "enum": [
            "close",
            "already_closed_at_review",
            "retain_open",
            "no_close_authority"
          ]
        }
      }
    }
  }
}
