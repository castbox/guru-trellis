{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"guru-reconcile-task-base-input-resolved-candidate-1.0",
  "type":"object",
  "additionalProperties":false,
  "required":["profile","mode","source_exit","task_ref","phase2_commit_anchor","branch","selected_base_ref","old_base_head","new_base_head","merge_head","stage0_tree","index_tree_sha256","parent_order","commit_message","resume_target"],
  "properties":{
    "profile":{"const":"resolved_candidate"},
    "mode":{"enum":["workflow","standalone"]},
    "source_exit":{"const":"resolved_reconciliation_passed"},
    "task_ref":{"type":"string","pattern":"^\\.trellis/tasks/[A-Za-z0-9._/-]+$"},
    "phase2_commit_anchor":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "branch":{"type":"string","minLength":1},
    "selected_base_ref":{"type":"string","minLength":1},
    "old_base_head":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "new_base_head":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "merge_head":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "stage0_tree":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "index_tree_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "parent_order":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"string","pattern":"^[0-9a-f]{40}$"}},
    "commit_message":{"type":"string","minLength":1,"maxLength":500,"pattern":"^[^\\r\\n]+$"},
    "resume_target":{"const":"branch_review"}
  }
}
