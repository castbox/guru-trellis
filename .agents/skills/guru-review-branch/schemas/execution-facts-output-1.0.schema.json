{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-review-branch-execution-facts-output-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checks"
  ],
  "properties": {
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "location",
          "status"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "available",
              "failed",
              "not_probed"
            ]
          },
          "exception_class": {
            "type": "string",
            "minLength": 1
          },
          "errno": {
            "type": [
              "integer",
              "null"
            ]
          },
          "reason_code": {
            "type": "string",
            "minLength": 1
          },
          "field_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "failed"
                }
              }
            },
            "then": {
              "required": [
                "exception_class",
                "errno"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "exception_class"
                    ]
                  },
                  {
                    "required": [
                      "errno"
                    ]
                  },
                  {
                    "required": [
                      "reason_code"
                    ]
                  },
                  {
                    "required": [
                      "field_path"
                    ]
                  }
                ]
              }
            }
          }
        ],
        "dependentRequired": {
          "reason_code": [
            "field_path"
          ],
          "field_path": [
            "reason_code"
          ]
        }
      }
    }
  }
}
