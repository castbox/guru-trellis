{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-production-review-branch-input-base-continuity-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "mode", "task_ref", "task_head", "branch_review_commit", "old_base_head", "new_base_head", "candidate_tree_sha256", "relevant_paths", "resume_target", "review_intent"],
  "properties": {
    "profile": {"const": "base_continuity"},
    "mode": {"enum": ["workflow", "standalone"]},
    "task_ref": {"type": "string", "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"},
    "task_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "branch_review_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "old_base_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "new_base_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relevant_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "resume_target": {"enum": ["task_activation", "task_commit", "branch_review", "publication_review", "task_finalization", "finalization_resume"]},
    "review_intent": {"const": "base_continuity"}
  }
}
