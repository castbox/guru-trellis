{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/castbox/guru-trellis/schemas/guru-review-gate-4.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_id", "generated_at", "task_dir", "mode", "profile", "review_intent", "typed_exit", "review_commit", "reviewed_content_sha256", "base_ref", "base_head", "integration_pair", "semantic_review", "verification_evidence", "facts_sha256"],
  "properties": {
    "schema_version": {"const": "4.0"},
    "skill_id": {"const": "guru-review-branch"},
    "generated_at": {"type": "string", "minLength": 1},
    "task_dir": {"type": "string", "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"},
    "mode": {"enum": ["workflow", "standalone"]},
    "profile": {"enum": ["branch_review", "base_continuity"]},
    "review_intent": {"enum": ["initial_review", "fresh_final_review", "base_continuity"]},
    "typed_exit": {"enum": ["passed", "continuity_passed", "implementation_required", "scope_confirmation_required", "blocked"]},
    "review_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "reviewed_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_ref": {"type": "string", "minLength": 1},
    "base_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "integration_pair": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["task_head", "old_base_head", "new_base_head", "candidate_tree_sha256", "relevant_paths", "resume_target"],
          "properties": {
            "task_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "old_base_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "new_base_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "candidate_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "relevant_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "resume_target": {"enum": ["task_activation", "task_commit", "branch_review", "publication_review", "task_finalization", "finalization_resume"]}
          }
        }
      ]
    },
    "semantic_review": {
      "type": "object", "additionalProperties": false,
      "required": ["qualified_findings", "scope_proposals", "observations", "followup_candidates", "rejected_candidates", "ai_review_gate"],
      "properties": {
        "qualified_findings": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/qualifiedFinding"}},
        "scope_proposals": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/scopeProposal"}},
        "observations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonFinding"}},
        "followup_candidates": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonFinding"}},
        "rejected_candidates": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonFinding"}},
        "ai_review_gate": {
          "type": "object", "additionalProperties": false, "required": ["status", "summary"],
          "properties": {"status": {"enum": ["passed", "continuity_passed", "implementation_required", "scope_confirmation_required", "blocked"]}, "summary": {"type": "string", "minLength": 1}}
        }
      }
    },
    "verification_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewer", "review_source", "evidence"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "review_source": {"const": "independent-agent"},
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "facts_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"typed_exit": {"const": "passed"}}, "required": ["typed_exit"]}, "then": {"properties": {"semantic_review": {"properties": {"qualified_findings": {"not": {"contains": {"properties": {"status": {"const": "open"}}, "required": ["status"]}}}, "scope_proposals": {"maxItems": 0}, "ai_review_gate": {"properties": {"status": {"const": "passed"}}}}}}}},
    {"if": {"properties": {"typed_exit": {"const": "implementation_required"}}, "required": ["typed_exit"]}, "then": {"properties": {"semantic_review": {"properties": {"qualified_findings": {"contains": {"properties": {"status": {"const": "open"}}, "required": ["status"]}}, "ai_review_gate": {"properties": {"status": {"const": "implementation_required"}}}}}}}},
    {"if": {"properties": {"typed_exit": {"const": "scope_confirmation_required"}}, "required": ["typed_exit"]}, "then": {"properties": {"semantic_review": {"properties": {"qualified_findings": {"not": {"contains": {"properties": {"status": {"const": "open"}}, "required": ["status"]}}}, "scope_proposals": {"minItems": 1}, "ai_review_gate": {"properties": {"status": {"const": "scope_confirmation_required"}}}}}}}},
    {"if": {"properties": {"typed_exit": {"const": "blocked"}}, "required": ["typed_exit"]}, "then": {"properties": {"semantic_review": {"properties": {"qualified_findings": {"not": {"contains": {"properties": {"status": {"const": "open"}}, "required": ["status"]}}}, "scope_proposals": {"maxItems": 0}, "ai_review_gate": {"properties": {"status": {"const": "blocked"}}}}}}}},
    {"if": {"properties": {"profile": {"const": "branch_review"}}}, "then": {"properties": {"integration_pair": {"type": "null"}, "typed_exit": {"enum": ["passed", "implementation_required", "scope_confirmation_required", "blocked"]}}}},
    {"if": {"properties": {"profile": {"const": "base_continuity"}}}, "then": {"properties": {"review_intent": {"const": "base_continuity"}, "integration_pair": {"type": "object"}, "typed_exit": {"enum": ["continuity_passed", "implementation_required", "scope_confirmation_required", "blocked"]}}}},
    {"if": {"properties": {"typed_exit": {"const": "continuity_passed"}}, "required": ["typed_exit"]}, "then": {"properties": {"semantic_review": {"properties": {"qualified_findings": {"not": {"contains": {"properties": {"status": {"const": "open"}}, "required": ["status"]}}}, "scope_proposals": {"maxItems": 0}, "ai_review_gate": {"properties": {"status": {"const": "continuity_passed"}}}}}}}}
  ],
  "$defs": {
    "scenario": {"enum": ["normal_required_behavior", "explicit_nonstandard_requirement", "approved_nonstandard_expansion", "unconfirmed_nonstandard_proposal", "out_of_scope"]},
    "qualifiedFinding": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_ref", "disposition", "scenario_class", "affected_behavior", "path", "evidence_refs", "requirement_refs", "scope_basis", "qualification_reason", "finding_ref", "severity", "introduced_head", "fix_head", "closure_head", "status", "closure_evidence"],
      "properties": {
        "candidate_ref": {"type": "string", "minLength": 1},
        "disposition": {"const": "qualified_finding"},
        "scenario_class": {"enum": ["normal_required_behavior", "explicit_nonstandard_requirement", "approved_nonstandard_expansion"]},
        "affected_behavior": {"type": "string", "minLength": 1},
        "path": {"type": "string"},
        "evidence_refs": {"$ref": "#/$defs/nonEmptyStringList"},
        "requirement_refs": {"$ref": "#/$defs/nonEmptyStringList"},
        "scope_basis": {"type": "string", "minLength": 1},
        "qualification_reason": {"type": "string", "minLength": 1},
        "finding_ref": {"type": "string", "minLength": 1},
        "severity": {"enum": ["P0", "P1", "P2", "P3"]},
        "introduced_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "fix_head": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "closure_head": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "status": {"enum": ["open", "resolved"]},
        "closure_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "open"}}, "required": ["status"]}, "then": {"properties": {"fix_head": {"const": null}, "closure_head": {"const": null}, "closure_evidence": {"maxItems": 0}}}},
        {"if": {"properties": {"status": {"const": "resolved"}}, "required": ["status"]}, "then": {"properties": {"fix_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "closure_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "closure_evidence": {"minItems": 1}}}}
      ]
    },
    "scopeProposal": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_ref", "disposition", "scenario_class", "affected_behavior", "path", "evidence_refs", "requirement_refs", "scope_basis", "qualification_reason", "proposal_ref", "proposal", "trigger_evidence", "clarification_route"],
      "properties": {
        "candidate_ref": {"type": "string", "minLength": 1},
        "disposition": {"const": "scope_proposal"},
        "scenario_class": {"const": "unconfirmed_nonstandard_proposal"},
        "affected_behavior": {"type": "string", "minLength": 1},
        "path": {"type": "string"},
        "evidence_refs": {"$ref": "#/$defs/nonEmptyStringList"},
        "requirement_refs": {"$ref": "#/$defs/stringList"},
        "scope_basis": {"type": "string", "minLength": 1},
        "qualification_reason": {"type": "string", "minLength": 1},
        "proposal_ref": {"type": "string", "minLength": 1},
        "proposal": {"type": "string", "minLength": 1},
        "trigger_evidence": {"$ref": "#/$defs/nonEmptyStringList"},
        "clarification_route": {"const": "guru-clarify-requirements"}
      }
    },
    "nonFinding": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_ref", "disposition", "scenario_class", "affected_behavior", "path", "evidence_refs", "requirement_refs", "scope_basis", "qualification_reason"],
      "properties": {
        "candidate_ref": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["observation", "followup_candidate", "rejected_candidate"]},
        "scenario_class": {"$ref": "#/$defs/scenario"},
        "affected_behavior": {"type": "string", "minLength": 1},
        "path": {"type": "string"},
        "evidence_refs": {"$ref": "#/$defs/nonEmptyStringList"},
        "requirement_refs": {"$ref": "#/$defs/stringList"},
        "scope_basis": {"type": "string", "minLength": 1},
        "qualification_reason": {"type": "string", "minLength": 1}
      },
      "oneOf": [
        {"properties": {"disposition": {"enum": ["observation", "followup_candidate"]}, "scenario_class": {"enum": ["unconfirmed_nonstandard_proposal", "out_of_scope"]}}},
        {"properties": {"disposition": {"const": "rejected_candidate"}, "scenario_class": {"$ref": "#/$defs/scenario"}}}
      ]
    },
    "stringList": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "nonEmptyStringList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
