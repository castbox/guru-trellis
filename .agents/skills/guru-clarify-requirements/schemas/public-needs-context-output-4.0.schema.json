{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-stage0-clarify-requirements-output-needs-context-4.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "handoff_profile",
    "handoff_mode",
    "handoff_repo_locator",
    "handoff_continuation_id",
    "transition",
    "return_identity"
  ],
  "properties": {
    "exit_id": {
      "const": "needs_context"
    },
    "handoff_profile": {
      "const": "context_request"
    },
    "handoff_mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "handoff_repo_locator": {
      "type": "string",
      "minLength": 1
    },
    "handoff_continuation_id": {
      "type": "string",
      "minLength": 1
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "transition_id",
        "stage",
        "mode",
        "repo_locator",
        "base"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            "1.0",
            "2.0"
          ]
        },
        "transition_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]+$"
        },
        "stage": {
          "const": "base_current"
        },
        "mode": {
          "enum": [
            "workflow",
            "standalone"
          ]
        },
        "repo_locator": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "$ref": "#/$defs/base"
        },
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "locator",
            "body_sha256"
          ],
          "properties": {
            "locator": {
              "type": "string",
              "minLength": 1
            },
            "body_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "base": {
                "properties": {
                  "kind": {
                    "const": "git_object"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "schema_version": {
                "const": "2.0"
              }
            }
          },
          "else": {
            "properties": {
              "schema_version": {
                "const": "1.0"
              }
            }
          }
        }
      ]
    },
    "return_identity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "target_locator",
            "continuation_id"
          ],
          "properties": {
            "profile": {
              "const": "standard_intake"
            },
            "target_locator": {
              "type": "string",
              "minLength": 1
            },
            "continuation_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "target_locator",
            "continuation_id",
            "source_locators"
          ],
          "properties": {
            "profile": {
              "const": "reviewed_plan_intake"
            },
            "target_locator": {
              "type": "string",
              "minLength": 1
            },
            "continuation_id": {
              "type": "string",
              "minLength": 1
            },
            "source_locators": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "locator",
                  "section"
                ],
                "properties": {
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "section": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "target_locator",
            "continuation_id",
            "task_locator",
            "task_id",
            "lifecycle_generation",
            "resume_target"
          ],
          "properties": {
            "profile": {
              "const": "active_task_scope_change"
            },
            "target_locator": {
              "type": "string",
              "minLength": 1
            },
            "continuation_id": {
              "type": "string",
              "minLength": 1
            },
            "task_locator": {
              "type": "string",
              "minLength": 1
            },
            "task_id": {
              "type": "string",
              "minLength": 1
            },
            "lifecycle_generation": {
              "type": "integer",
              "minimum": 0
            },
            "resume_target": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "target_locator",
            "continuation_id",
            "resume_target"
          ],
          "properties": {
            "profile": {
              "const": "standalone_review"
            },
            "target_locator": {
              "type": "string",
              "minLength": 1
            },
            "continuation_id": {
              "type": "string",
              "minLength": 1
            },
            "resume_target": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "target_locator",
            "resume_target",
            "continuation_id",
            "candidate_refs"
          ],
          "properties": {
            "profile": {
              "const": "normal_scenario_scope_confirmation"
            },
            "target_locator": {
              "type": "string",
              "minLength": 1
            },
            "resume_target": {
              "enum": [
                "guru-approve-task-plan",
                "guru-author-task-plan",
                "guru-check-task",
                "guru-clarify-requirements",
                "guru-execute-task-free-change",
                "guru-reconcile-task-base",
                "guru-resume-implementation",
                "guru-review-branch",
                "guru-review-change-request",
                "guru-review-task-delivery"
              ]
            },
            "continuation_id": {
              "type": "string",
              "minLength": 1
            },
            "candidate_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "task_ref": {
              "type": "string",
              "minLength": 1
            },
            "delivery_key": {
              "type": "object",
              "description": "Opaque upstream DeliveryKey validated by its original public owner."
            }
          },
          "allOf": [
            {
              "oneOf": [
                {
                  "required": [
                    "task_ref",
                    "delivery_key"
                  ]
                },
                {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "task_ref"
                        ]
                      },
                      {
                        "required": [
                          "delivery_key"
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "target_locator",
            "resume_target",
            "continuation_id",
            "candidate_refs"
          ],
          "properties": {
            "profile": {
              "const": "solution_mechanism_scope_confirmation"
            },
            "target_locator": {
              "type": "string",
              "minLength": 1
            },
            "resume_target": {
              "enum": [
                "guru-approve-task-plan",
                "guru-author-task-plan",
                "guru-check-task",
                "guru-clarify-requirements",
                "guru-execute-task-free-change",
                "guru-reconcile-task-base",
                "guru-resume-implementation",
                "guru-review-branch",
                "guru-review-change-request",
                "guru-review-task-delivery"
              ]
            },
            "continuation_id": {
              "type": "string",
              "minLength": 1
            },
            "candidate_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "task_ref": {
              "type": "string",
              "minLength": 1
            },
            "delivery_key": {
              "type": "object",
              "description": "Opaque upstream DeliveryKey validated by its original public owner."
            }
          },
          "allOf": [
            {
              "oneOf": [
                {
                  "required": [
                    "task_ref",
                    "delivery_key"
                  ]
                },
                {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "task_ref"
                        ]
                      },
                      {
                        "required": [
                          "delivery_key"
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "$defs": {
    "sha40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "selected_base",
            "remote",
            "ordered_candidates",
            "decision_head",
            "local_base_head",
            "remote_base_head",
            "post_sync_resolution_sha256"
          ],
          "properties": {
            "source": {
              "enum": [
                "explicit",
                "config",
                "config-candidate",
                "remote-default"
              ]
            },
            "selected_base": {
              "type": "string",
              "minLength": 1
            },
            "remote": {
              "type": "string",
              "minLength": 1
            },
            "ordered_candidates": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "decision_head": {
              "$ref": "#/$defs/sha40"
            },
            "local_base_head": {
              "$ref": "#/$defs/sha40"
            },
            "remote_base_head": {
              "$ref": "#/$defs/sha40"
            },
            "post_sync_resolution_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "source",
            "selected_ref",
            "commit",
            "identity_sha256"
          ],
          "properties": {
            "kind": {
              "const": "git_object"
            },
            "source": {
              "enum": [
                "explicit",
                "config",
                "config-candidate",
                "remote-default"
              ]
            },
            "selected_ref": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "identity_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    }
  }
}
