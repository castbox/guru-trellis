{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "target_locator",
    "resume_target",
    "continuation_id",
    "candidate_refs",
    "exit_id",
    "mode",
    "source_selection"
  ],
  "properties": {
    "profile": {
      "const": "normal_scenario_scope_confirmation"
    },
    "target_locator": {
      "type": "string",
      "minLength": 1
    },
    "resume_target": {
      "enum": [
        "guru-approve-task-plan",
        "guru-author-task-plan",
        "guru-check-task",
        "guru-clarify-requirements",
        "guru-execute-task-free-change",
        "guru-reconcile-task-base",
        "guru-resume-implementation",
        "guru-review-branch",
        "guru-review-change-request",
        "guru-review-task-delivery"
      ]
    },
    "continuation_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "task_ref": {
      "type": "string",
      "minLength": 1
    },
    "delivery_key": {
      "type": "object",
      "description": "Opaque upstream DeliveryKey validated by its original public owner."
    },
    "exit_id": {
      "const": "clear"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "source_selection": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locator",
          "section",
          "authority_kind"
        ],
        "properties": {
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "authority_kind": {
            "enum": [
              "requirement",
              "design_constraint",
              "advisory"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "required": [
            "task_ref",
            "delivery_key"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "task_ref"
                ]
              },
              {
                "required": [
                  "delivery_key"
                ]
              }
            ]
          }
        }
      ]
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-stage0-clarify-requirements-output-normal-scenario-confirmation-clear-1.0"
}
