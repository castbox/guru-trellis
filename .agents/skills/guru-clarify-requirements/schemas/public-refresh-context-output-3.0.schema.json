{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-stage0-clarify-requirements-output-refresh-context-3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "handoff_mode",
    "handoff_repo_root",
    "handoff_route"
  ],
  "properties": {
    "exit_id": {
      "const": "refresh_context"
    },
    "handoff_mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "handoff_repo_root": {
      "type": "string",
      "minLength": 1
    },
    "handoff_base_branch": {
      "type": "string",
      "minLength": 1
    },
    "handoff_route": {
      "enum": [
        "repo_change",
        "original_request"
      ]
    },
    "handoff_operation": {
      "enum": [
        "read",
        "sync"
      ]
    },
    "handoff_base_ref": {
      "type": "string",
      "minLength": 1
    },
    "return_identity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "target_locator",
            "resume_target",
            "continuation_id",
            "candidate_refs"
          ],
          "properties": {
            "profile": {
              "const": "normal_scenario_scope_confirmation"
            },
            "target_locator": {
              "type": "string",
              "minLength": 1
            },
            "resume_target": {
              "enum": [
                "guru-approve-task-plan",
                "guru-author-task-plan",
                "guru-check-task",
                "guru-clarify-requirements",
                "guru-execute-task-free-change",
                "guru-reconcile-task-base",
                "guru-resume-implementation",
                "guru-review-branch",
                "guru-review-change-request",
                "guru-review-task-delivery"
              ]
            },
            "continuation_id": {
              "type": "string",
              "minLength": 1
            },
            "candidate_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "task_ref": {
              "type": "string",
              "minLength": 1
            },
            "delivery_key": {
              "type": "object",
              "description": "Opaque upstream DeliveryKey validated by its original public owner."
            }
          },
          "allOf": [
            {
              "oneOf": [
                {
                  "required": [
                    "task_ref",
                    "delivery_key"
                  ]
                },
                {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "task_ref"
                        ]
                      },
                      {
                        "required": [
                          "delivery_key"
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "target_locator",
            "resume_target",
            "continuation_id",
            "candidate_refs"
          ],
          "properties": {
            "profile": {
              "const": "solution_mechanism_scope_confirmation"
            },
            "target_locator": {
              "type": "string",
              "minLength": 1
            },
            "resume_target": {
              "enum": [
                "guru-approve-task-plan",
                "guru-author-task-plan",
                "guru-check-task",
                "guru-clarify-requirements",
                "guru-execute-task-free-change",
                "guru-reconcile-task-base",
                "guru-resume-implementation",
                "guru-review-branch",
                "guru-review-change-request",
                "guru-review-task-delivery"
              ]
            },
            "continuation_id": {
              "type": "string",
              "minLength": 1
            },
            "candidate_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "task_ref": {
              "type": "string",
              "minLength": 1
            },
            "delivery_key": {
              "type": "object",
              "description": "Opaque upstream DeliveryKey validated by its original public owner."
            }
          },
          "allOf": [
            {
              "oneOf": [
                {
                  "required": [
                    "task_ref",
                    "delivery_key"
                  ]
                },
                {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "task_ref"
                        ]
                      },
                      {
                        "required": [
                          "delivery_key"
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "return_identity"
        ]
      },
      "then": {
        "required": [
          "handoff_operation",
          "handoff_base_ref"
        ],
        "properties": {
          "handoff_operation": {
            "const": "read"
          },
          "handoff_route": {
            "const": "repo_change"
          }
        }
      }
    }
  ]
}
