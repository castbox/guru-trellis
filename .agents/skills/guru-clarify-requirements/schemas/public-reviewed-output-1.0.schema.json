{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-clarify-requirements-output-reviewed-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "conclusion",
    "findings"
  ],
  "properties": {
    "exit_id": {
      "const": "reviewed"
    },
    "conclusion": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "location",
          "summary",
          "impact",
          "revision_owner"
        ],
        "properties": {
          "location": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "revision_owner": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
