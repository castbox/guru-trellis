{
  "$schema": "../../schemas/skill-interface-1.4.schema.json",
  "schema_version": "1.4",
  "id": "guru-merge-task-pr",
  "name": "guru-merge-task-pr",
  "description": "Merge one Ready task PR through a semantic live gate, expected-head mutation, and post-merge closure verification.",
  "state": "active",
  "modes": {
    "workflow": {
      "routing": "global_workflow",
      "entry_precondition_ids": [
        "runtime_dependency",
        "repo_bound_pr",
        "expected_head",
        "live_merge_readiness",
        "close_scope",
        "invocation_freshness"
      ]
    },
    "standalone": {
      "routing": "direct_discovery",
      "entry_precondition_ids": [
        "runtime_dependency",
        "repo_bound_pr",
        "expected_head",
        "live_merge_readiness",
        "close_scope",
        "invocation_freshness"
      ]
    }
  },
  "entry_preconditions": [
    {
      "id": "runtime_dependency",
      "evidence": "installed extension, dispatcher, active package and merge commands",
      "binding": "complete current Guru Team preset",
      "freshness": "validated before each command"
    },
    {
      "id": "repo_bound_pr",
      "evidence": "canonical repository and PR number/URL",
      "binding": "one repo-bound GitHub pull request",
      "freshness": "reread through authenticated gh before every gate and mutation"
    },
    {
      "id": "expected_head",
      "evidence": "Finalizer or caller supplied expected immutable head SHA and reviewed base/head branches",
      "binding": "PR headRefOid, baseRefName and headRefName equality",
      "freshness": "reread immediately before gh pr merge"
    },
    {
      "id": "live_merge_readiness",
      "evidence": "Open/Ready PR, checks, reviews, mergeability and repository policy",
      "binding": "one current semantic merge gate",
      "freshness": "reread by preview and checker"
    },
    {
      "id": "close_scope",
      "evidence": "Finalizer or caller supplied reviewed close-Issue set, PR body close keywords and current Issue states",
      "binding": "exact keyword-set equality and all reviewed close Issues Open before merge",
      "freshness": "reread before and after merge"
    },
    {
      "id": "invocation_freshness",
      "evidence": "current input identity and owner-private gate",
      "binding": "one repository, PR and expected head",
      "freshness": "checker recomputes live facts"
    }
  ],
  "judgment_mode": "semantic",
  "ordered_stages": [
    "forward_behavior",
    "ai_review_gate",
    "conditional_human_confirmation",
    "recorder_validator",
    "typed_exit"
  ],
  "artifacts": [
    {"id": "workflow_input", "path": "examples/public-ready-for-merge-input-2.0.json"},
    {"id": "workflow_authoring", "path": "examples/public-ready-for-merge-authoring-2.0.json"},
    {"id": "standalone_input", "path": "examples/public-standalone-merge-input-2.0.json"},
    {"id": "legacy_workflow_input_1_0", "path": "examples/public-ready-for-merge-input.json"},
    {"id": "legacy_workflow_authoring_1_0", "path": "examples/public-ready-for-merge-authoring.json"},
    {"id": "legacy_standalone_input_1_0", "path": "examples/public-standalone-merge-input.json"},
    {"id": "merged_output", "path": "examples/public-merged-output.json"},
    {"id": "merge_blocked_output", "path": "examples/public-merge-blocked-output.json"},
    {"id": "closure_mismatch_output", "path": "examples/public-closure-mismatch-output.json"},
    {"id": "invocation_error", "path": "examples/public-invocation-error.json"},
    {"id": "semantic_review", "path": "examples/semantic-review-input.json"},
    {"id": "private_gate", "path": "examples/task-pr-merge-gate-2.0.json"},
    {"id": "legacy_private_gate_1_0", "path": "examples/task-pr-merge-gate.json"}
  ],
  "schemas": [
    {"id": "workflow_input", "path": "schemas/public-ready-for-merge-input-2.0.schema.json"},
    {"id": "standalone_input", "path": "schemas/public-standalone-merge-input-2.0.schema.json"},
    {"id": "aggregate_input", "path": "schemas/public-input-2.0.schema.json"},
    {"id": "legacy_workflow_input_1_0", "path": "schemas/public-ready-for-merge-input.schema.json"},
    {"id": "legacy_standalone_input_1_0", "path": "schemas/public-standalone-merge-input.schema.json"},
    {"id": "legacy_aggregate_input_1_0", "path": "schemas/public-input.schema.json"},
    {"id": "merged_output", "path": "schemas/public-merged-output.schema.json"},
    {"id": "merge_blocked_output", "path": "schemas/public-merge-blocked-output.schema.json"},
    {"id": "closure_mismatch_output", "path": "schemas/public-closure-mismatch-output.schema.json"},
    {"id": "invocation_error", "path": "schemas/public-invocation-error.schema.json"},
    {"id": "private_gate", "path": "schemas/task-pr-merge-gate-2.0.schema.json"},
    {"id": "legacy_private_gate_1_0", "path": "schemas/task-pr-merge-gate.schema.json"}
  ],
  "validators": [
    {
      "id": "merge_previewer",
      "command": "scripts/preview-task-pr-merge.sh",
      "runtime_command": "preview-task-pr-merge",
      "objective_scope": "Read complete repo-bound PR, checks, review, policy and close-Issue facts without mutation"
    },
    {
      "id": "merge_recorder",
      "command": "scripts/record-task-pr-merge.sh",
      "runtime_command": "record-task-pr-merge",
      "objective_scope": "Record only the completed semantic dimensions and selected route"
    },
    {
      "id": "merge_checker",
      "command": "scripts/check-task-pr-merge.sh",
      "runtime_command": "check-task-pr-merge",
      "objective_scope": "Reread live facts and validate exact expected-head readiness"
    },
    {
      "id": "merge_executor",
      "command": "scripts/execute-task-pr-merge.sh",
      "runtime_command": "execute-task-pr-merge",
      "objective_scope": "Execute one repo-bound expected-head merge and post-merge read-only closure verification"
    },
    {
      "id": "public_invocation",
      "command": "scripts/invoke.sh",
      "runtime_command": "invoke-task-pr-merge",
      "objective_scope": "Check and serialize exactly one terminal merge output, then retire the private gate"
    }
  ],
  "public_contracts": {
    "input": {
      "kind": "structured_json",
      "aggregate_schema": {
        "schema_id": "guru-merge-task-pr-input-aggregate-2.0",
        "path": "schemas/public-input-2.0.schema.json"
      },
      "profiles": [
        {
          "id": "ready_for_merge",
          "schema": {
            "schema_id": "guru-merge-task-pr-input-ready-for-merge-2.0",
            "path": "schemas/public-ready-for-merge-input-2.0.schema.json"
          },
          "example": {"id": "ready_for_merge_input", "path": "examples/public-ready-for-merge-input-2.0.json"},
          "discriminator": {"field": "profile", "value": "ready_for_merge"}
        },
        {
          "id": "standalone_merge",
          "schema": {
            "schema_id": "guru-merge-task-pr-input-standalone-merge-2.0",
            "path": "schemas/public-standalone-merge-input-2.0.schema.json"
          },
          "example": {"id": "standalone_merge_input", "path": "examples/public-standalone-merge-input-2.0.json"},
          "discriminator": {"field": "profile", "value": "standalone_merge"}
        }
      ]
    },
    "invocation": {
      "command_id": "run-skill-command",
      "wrapper": "scripts/invoke.sh",
      "input_binding": {"kind": "structured_json", "profile_id": "ready_for_merge"},
      "stdout_contract": "single_typed_exit",
      "error_schema": {
        "schema_id": "guru-merge-task-pr-invocation-error-1.0",
        "path": "schemas/public-invocation-error.schema.json"
      },
      "error_example": {"id": "invalid_public_input", "path": "examples/public-invocation-error.json"},
      "example_argv": ["--input", "examples/public-ready-for-merge-input-2.0.json", "--gate", ".trellis/.runtime/guru-team/task-pr-merge/example/task-pr-merge-gate.json"]
    },
    "outputs": [
      {
        "exit_id": "merged",
        "schema": {"schema_id": "guru-merge-task-pr-output-merged-1.0", "path": "schemas/public-merged-output.schema.json"},
        "example": {"id": "merged_output", "path": "examples/public-merged-output.json"},
        "consumer_use_ids": ["project_merged"]
      },
      {
        "exit_id": "merge_blocked",
        "schema": {"schema_id": "guru-merge-task-pr-output-merge-blocked-1.0", "path": "schemas/public-merge-blocked-output.schema.json"},
        "example": {"id": "merge_blocked_output", "path": "examples/public-merge-blocked-output.json"},
        "consumer_use_ids": ["project_merge_blocked"]
      },
      {
        "exit_id": "closure_mismatch",
        "schema": {"schema_id": "guru-merge-task-pr-output-closure-mismatch-1.0", "path": "schemas/public-closure-mismatch-output.schema.json"},
        "example": {"id": "closure_mismatch_output", "path": "examples/public-closure-mismatch-output.json"},
        "consumer_use_ids": ["project_closure_mismatch"]
      }
    ],
    "consumer_inputs": [
      {
        "id": "merged_workflow_input",
        "consumer": {"kind": "workflow", "id": "guru-finalization-finish-response"},
        "payload_kind": "structured_json",
        "contract": {"kind": "json_schema", "schema_id": "guru-merge-task-pr-workflow-merged-input-1.0", "path": "consumers/workflow/production/merge-task-pr-merged.schema.json"}
      },
      {
        "id": "merge_blocked_stop_input",
        "consumer": {"kind": "stop", "id": "task-pr-merge-blocked"},
        "payload_kind": "structured_json",
        "contract": {"kind": "json_schema", "schema_id": "guru-merge-task-pr-stop-merge-blocked-input-1.0", "path": "consumers/stop/production/merge-task-pr-blocked.schema.json"}
      },
      {
        "id": "closure_mismatch_stop_input",
        "consumer": {"kind": "stop", "id": "task-pr-closure-mismatch"},
        "payload_kind": "structured_json",
        "contract": {"kind": "json_schema", "schema_id": "guru-merge-task-pr-stop-closure-mismatch-input-1.0", "path": "consumers/stop/production/merge-task-pr-closure-mismatch.schema.json"}
      }
    ],
    "projections": [
      {"id": "project_merged", "exit_id": "merged", "consumer_input_id": "merged_workflow_input", "operation": "direct"},
      {"id": "project_merge_blocked", "exit_id": "merge_blocked", "consumer_input_id": "merge_blocked_stop_input", "operation": "direct"},
      {"id": "project_closure_mismatch", "exit_id": "closure_mismatch", "consumer_input_id": "closure_mismatch_stop_input", "operation": "direct"}
    ],
    "private_artifacts": [
      {
        "id": "merge_gate",
        "kind": "gate_evidence",
        "schema": {"schema_id": "guru-task-pr-merge-gate-2.0", "path": "schemas/task-pr-merge-gate-2.0.schema.json"},
        "persistence": "ignored_runtime"
      }
    ]
  },
  "external_exits": [
    {"id": "merged", "evidence": "expected-head merge succeeded and every close Issue was closed by GitHub at or after merged_at", "consumer": {"kind": "workflow", "id": "guru-finalization-finish-response"}},
    {"id": "merge_blocked", "evidence": "one current pre-merge semantic or objective condition prevents mutation", "consumer": {"kind": "stop", "id": "task-pr-merge-blocked"}},
    {"id": "closure_mismatch", "evidence": "the PR merged but GitHub close-keyword effects are incomplete or temporally invalid", "consumer": {"kind": "stop", "id": "task-pr-closure-mismatch"}}
  ],
  "reentry": {
    "identity": "repository, PR number/URL and expected head SHA",
    "freshness": "all GitHub facts are reread before gate check, mutation and post-merge projection",
    "stale_behavior": "fail_closed"
  },
  "tests": ["tests/test_contract.py"],
  "platform_destinations": ["shared", "codex", "cursor", "claude"],
  "runtime_dependency": {
    "extension_id": "guru-team",
    "api_version": "1.0",
    "manifest_path": ".trellis/guru-team/extension.json",
    "dispatcher": "run-skill-command",
    "distribution": "guru-team-preset",
    "package_portability": "not-self-contained"
  }
}
