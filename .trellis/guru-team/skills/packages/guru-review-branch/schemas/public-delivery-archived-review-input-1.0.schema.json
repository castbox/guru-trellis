{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-review-branch-input-delivery-archived-review-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "task_ref",
    "branch_review_commit",
    "pr_payload_snapshot_sha256",
    "delivery_key"
  ],
  "properties": {
    "profile": {
      "const": "delivery_archived_review"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/archive/[A-Za-z0-9._/-]+$"
    },
    "branch_review_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "pr_payload_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "delivery_key": {
      "type": "object"
    }
  }
}
