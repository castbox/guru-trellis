{
  "schema_version": "1.1",
  "package_id": "guru-review-branch",
  "commands": [
    {
      "id": "review-branch",
      "owner": "guru-review-branch",
      "entrypoint": "runtime/record.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--task",
          "required": false,
          "kind": "string",
          "description": "Task locator.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--skill-input",
          "required": true,
          "kind": "string",
          "description": "Current public input for delivery_branch_review, delivery_base_continuity, delivery_archived_review or delivery_promotion_reference_alignment. Use a regular UTF-8 JSON file or '-' for stdin; inline JSON is not supported. See references/contract.md#recorder-authoring-and-carriers.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--semantic-review-file",
          "required": true,
          "kind": "string",
          "description": "AI-authored semantic JSON, separate from public input and the generated gate. Use a regular UTF-8 JSON file or '-' for stdin, with at most one recorder argument reading stdin. See references/contract.md#recorder-authoring-and-carriers and examples/authoring-delivery-passed-2.0.json.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--typed-exit",
          "required": true,
          "kind": "enum",
          "values": [
            "passed",
            "continuity_passed",
            "implementation_required",
            "scope_confirmation_required",
            "blocked",
            "archived_review_passed",
            "planning_stale"
          ],
          "description": "AI-selected typed exit.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "optional_json",
      "stdout": "intermediate_receipt",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "runtime_write",
      "schema_bindings": [
        "schemas/public-delivery-branch-review-input-2.0.schema.json",
        "schemas/public-delivery-base-continuity-input-2.0.schema.json",
        "schemas/public-delivery-archived-review-input-1.0.schema.json",
        "schemas/public-delivery-promotion-reference-alignment-input-2.0.schema.json",
        "schemas/delivery-review-gate-2.0.schema.json",
        "schemas/delivery-alignment-gate-2.0.schema.json",
        "schemas/delivery-archived-review-gate-1.0.schema.json"
      ],
      "validator_id": "review_gate_recorder",
      "runtime_role": "record"
    },
    {
      "id": "check-review-gate",
      "owner": "guru-review-branch",
      "entrypoint": "runtime/check.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--task",
          "required": false,
          "kind": "string",
          "description": "Task locator.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--expected-exit",
          "required": false,
          "kind": "enum",
          "values": [
            "passed",
            "continuity_passed",
            "implementation_required",
            "scope_confirmation_required",
            "blocked",
            "archived_review_passed"
          ],
          "description": "Required typed exit.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--delivery-key",
          "required": false,
          "kind": "json",
          "description": "Explicit selected public Delivery key JSON or locator; no current-selector inference.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "none",
      "stdout": "intermediate_receipt",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "git_read",
      "schema_bindings": [],
      "validator_id": "review_gate_checker",
      "runtime_role": "check"
    },
    {
      "id": "invoke-guru-review-branch",
      "owner": "guru-review-branch",
      "entrypoint": "runtime/invoke.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--task",
          "required": false,
          "kind": "string",
          "description": "Task locator.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--invocation",
          "required": false,
          "kind": "json",
          "description": "Public-input-only invocation envelope or dash for stdin.",
          "repeatable": false,
          "conflicts": [
            "--input"
          ]
        },
        {
          "flag": "--input",
          "required": false,
          "kind": "string",
          "description": "Public Branch Review input JSON locator.",
          "repeatable": false,
          "conflicts": [
            "--invocation"
          ]
        },
        {
          "flag": "--owner-result",
          "required": false,
          "kind": "json",
          "description": "Completed scope withdrawal judgment for its independent profile.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "optional_json",
      "stdout": "single_typed_exit",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "runtime_write",
      "schema_bindings": [],
      "validator_id": "public_invocation",
      "runtime_role": "invoke"
    },
    {
      "id": "review-branch-content-identity",
      "owner": "guru-review-branch",
      "entrypoint": "runtime/check.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--commit",
          "required": false,
          "kind": "string",
          "description": "Git commit; defaults to HEAD.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--include-worktree",
          "required": false,
          "kind": "boolean",
          "description": "Overlay current worktree state.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "none",
      "stdout": "intermediate_receipt",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "none",
      "schema_bindings": [
        "schemas/reviewed-content-identity-output.schema.json"
      ],
      "validator_id": "reviewed_content_identity",
      "runtime_role": "check"
    },
    {
      "id": "legacy-maintenance-guru-review-branch",
      "owner": "guru-review-branch",
      "entrypoint": "runtime/recover.py",
      "arguments": [
        {
          "flag": "--root",
          "required": true,
          "kind": "string",
          "description": "Explicit legacy target.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--input",
          "required": true,
          "kind": "json",
          "description": "Separate original-owner legacy input. Inline JSON is additive; existing regular UTF-8 JSON file and dash-for-stdin inputs remain supported. Nonregular carriers including process substitution are unsupported.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "optional_json",
      "stdout": "intermediate_receipt",
      "errors": [
        "schema_mismatch",
        "invalid_arguments",
        "invalid_json",
        "internal_error"
      ],
      "side_effect": "repo_write",
      "schema_bindings": [
        "schemas/legacy-maintenance-input-1.0.schema.json"
      ],
      "validator_id": "legacy_maintenance",
      "runtime_role": "recover"
    }
  ]
}
