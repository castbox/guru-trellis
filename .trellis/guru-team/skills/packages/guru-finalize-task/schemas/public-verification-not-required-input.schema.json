{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-finalize-task-input-verification-not-required-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "mode", "task_ref", "plan_ref", "reviewed_head", "reentry_intent"],
  "properties": {
    "profile": {"const": "verification_not_required"},
    "mode": {"const": "workflow"},
    "task_ref": {"type": "string", "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"},
    "plan_ref": {"type": "string", "minLength": 1},
    "reviewed_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "reentry_intent": {"type": "string", "minLength": 1}
  }
}
