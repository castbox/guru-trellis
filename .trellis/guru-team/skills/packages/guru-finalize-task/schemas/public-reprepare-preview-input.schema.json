{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-finalize-task-input-reprepare-preview-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "mode", "task_ref", "reason_code", "reprepare_intent", "reprepare_context"],
  "properties": {
    "profile": {"const": "reprepare_preview"},
    "mode": {"const": "workflow"},
    "task_ref": {"type": "string", "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"},
    "reason_code": {"const": "archive_month_changed"},
    "reprepare_intent": {"type": "string", "minLength": 1},
    "reprepare_context": {"type": "string", "minLength": 1}
  }
}
