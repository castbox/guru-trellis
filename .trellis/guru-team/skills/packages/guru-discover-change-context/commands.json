{
  "schema_version": "1.1",
  "package_id": "guru-discover-change-context",
  "commands": [
    {
      "id": "preview-change-context-history",
      "owner": "guru-discover-change-context",
      "entrypoint": "runtime/check.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--query-json",
          "required": false,
          "kind": "json",
          "description": "Canonical context query JSON.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--limit",
          "required": false,
          "kind": "string",
          "description": "Maximum result count.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--source-transition",
          "required": false,
          "kind": "json",
          "description": "Current base_current from baseline_ready; preview the fixed Git archive tree.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "optional_json",
      "stdout": "intermediate_receipt",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error",
        "git_failed"
      ],
      "side_effect": "git_read",
      "schema_bindings": [],
      "validator_id": "history_previewer",
      "runtime_role": "preview"
    },
    {
      "id": "record-context-discovery",
      "owner": "guru-discover-change-context",
      "entrypoint": "runtime/record.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--invocation",
          "required": true,
          "kind": "string",
          "description": "Closed semantic-owner 1.0 envelope JSON file or dash for one stdin read; mode comes from public_input.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--expected-result-sha256",
          "required": false,
          "kind": "string",
          "description": "Expected result digest.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--active-task",
          "required": false,
          "kind": "string",
          "description": "Ephemeral active task locator for workflow mode.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--recovery-continuation-id",
          "required": false,
          "kind": "string",
          "description": "Explicit same-owner recovery continuation identity.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "optional_json",
      "stdout": "intermediate_receipt",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error",
        "git_failed"
      ],
      "side_effect": "runtime_write",
      "schema_bindings": [
        "schemas/public-issue-context-request-input-1.0.schema.json",
        "schemas/public-issue-readiness-supplement-input-1.0.schema.json",
        "schemas/public-issue-context-ready-output-1.0.schema.json",
        "schemas/issue-review-owner-1.0.schema.json"
      ],
      "validator_id": "owner_result_recorder",
      "runtime_role": "record"
    },
    {
      "id": "check-context-discovery",
