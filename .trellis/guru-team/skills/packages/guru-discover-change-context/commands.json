          "kind": "string",
          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--invocation",
          "required": true,
          "kind": "string",
          "description": "Closed semantic-owner 1.0 envelope JSON file or dash for one stdin read; owner_result is recorder stdout. Binding/base failures retain reason and add result.diagnostic (code, field_path, remediation) for the current Discovery owner.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--expected-result-sha256",
          "required": false,
          "kind": "string",
          "description": "Expected result digest.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--active-task",
          "required": false,
          "kind": "string",
          "description": "Ephemeral active task locator for workflow mode.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--recovery-continuation-id",
          "required": false,
          "kind": "string",
          "description": "Explicit same-owner recovery continuation identity.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "optional_json",
      "stdout": "intermediate_receipt",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error",
        "git_failed"
      ],
      "side_effect": "git_read",
      "schema_bindings": [
        "schemas/public-issue-context-request-input-1.0.schema.json",
        "schemas/public-issue-readiness-supplement-input-1.0.schema.json",
        "schemas/public-issue-context-ready-output-1.0.schema.json",
        "schemas/issue-review-owner-1.0.schema.json"
      ],
      "validator_id": "owner_result_validator",
      "runtime_role": "check"
    },
    {
      "id": "invoke-guru-discover-change-context",
      "owner": "guru-discover-change-context",
      "entrypoint": "runtime/invoke.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--invocation",
          "required": true,
          "kind": "string",
          "description": "Closed semantic-owner 1.0 envelope JSON file or dash for one stdin read. Narrowed binding/base failures emit a three-field diagnostic on stderr; stdout remains one declared typed exit.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--active-task",
          "required": false,
          "kind": "string",
          "description": "Ephemeral active task locator for workflow mode.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--recovery-continuation-id",
          "required": false,
          "kind": "string",
          "description": "Explicit same-owner recovery continuation identity.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "optional_json",
      "stdout": "single_typed_exit",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error",
        "git_failed"
      ],
      "side_effect": "runtime_write",
      "schema_bindings": [
        "schemas/public-issue-context-request-input-1.0.schema.json",
        "schemas/public-issue-readiness-supplement-input-1.0.schema.json",
        "schemas/public-issue-context-ready-output-1.0.schema.json",
        "schemas/issue-review-owner-1.0.schema.json"
      ],
      "validator_id": "public_invocation",
      "runtime_role": "invoke"
    },
    {
      "id": "read-change-context-source",
      "owner": "guru-discover-change-context",
      "entrypoint": "runtime/check.py",
      "arguments": [
        {
          "flag": "--source-transition",
          "required": true,
          "kind": "json",
          "description": "base_current from baseline_ready.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--path",
          "required": true,
          "kind": "string",
          "description": "Repository-relative UTF-8 file in the fixed tree.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "optional_json",
      "stdout": "intermediate_receipt",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error",
        "git_failed"
      ],
      "side_effect": "git_read",
      "schema_bindings": [
        "schemas/public-issue-context-request-input-1.0.schema.json",
        "schemas/public-issue-readiness-supplement-input-1.0.schema.json",
        "schemas/public-issue-context-ready-output-1.0.schema.json",
        "schemas/issue-review-owner-1.0.schema.json"
      ],
      "validator_id": "source_reader",
      "runtime_role": "check"
