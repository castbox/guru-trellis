{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-upgrade-installation-private-plan-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "core_plan",
    "dependency_mode",
    "selected_platforms",
    "guru_decisions",
    "workflow",
    "controls"
  ],
  "properties": {
    "core_plan": {
      "type": "object"
    },
    "dependency_mode": {
      "enum": [
        "source_locked",
        "local_candidate"
      ]
    },
    "selected_platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "guru_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "action",
          "expected_sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "replace",
              "preserve"
            ]
          },
          "expected_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_ref",
        "action",
        "expected_sha256"
      ],
      "properties": {
        "provider_ref": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "replace",
            "preserve"
          ]
        },
        "expected_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "location",
          "path"
        ],
        "properties": {
          "location": {
            "enum": [
              "common",
              "checkout"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
