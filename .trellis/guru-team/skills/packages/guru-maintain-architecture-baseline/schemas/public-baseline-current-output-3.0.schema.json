{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-architecture-baseline-output-current-3.0",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_id",
        "source_profile",
        "task_locator",
        "stage",
        "baseline_identity",
        "constitution_identity",
        "constitution_status",
        "impact_kind",
        "promotion_state",
        "freshness_identity"
      ],
      "properties": {
        "exit_id": {
          "const": "baseline_current"
        },
        "source_profile": {
          "enum": [
            "bootstrap_foundation",
            "task_impact_sync",
            "promotion",
            "repair"
          ]
        },
        "task_locator": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "enum": [
            "planning",
            "implementation_discovery",
            "phase2",
            "branch_review",
            "publication",
            "acceptance_finish"
          ]
        },
        "baseline_identity": {
          "type": "string",
          "minLength": 1
        },
        "constitution_identity": {
          "type": "string",
          "minLength": 1
        },
        "constitution_status": {
          "const": "current"
        },
        "impact_kind": {
          "enum": [
            "no_architecture_impact",
            "architecture_impact"
          ]
        },
        "impact_reason": {
          "type": "string",
          "minLength": 1
        },
        "promotion_state": {
          "enum": [
            "no_change",
            "reviewed_candidate",
            "reviewed_promoted"
          ]
        },
        "contribution_locator": {
          "type": "string",
          "minLength": 1
        },
        "contribution_identity": {
          "type": "string",
          "minLength": 1
        },
        "freshness_identity": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "impact_kind": {
            "const": "architecture_impact"
          }
        },
        "required": [
          "impact_kind"
        ]
      },
      "then": {
        "required": [
          "contribution_locator",
          "contribution_identity"
        ],
        "properties": {
          "promotion_state": {
            "enum": [
              "reviewed_candidate",
              "reviewed_promoted"
            ]
          }
        },
        "not": {
          "required": [
            "impact_reason"
          ]
        }
      },
      "else": {
        "required": [
          "impact_reason"
        ],
        "properties": {
          "promotion_state": {
            "const": "no_change"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "contribution_locator"
              ]
            },
            {
              "required": [
                "contribution_identity"
              ]
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "const": "planning"
              }
            }
          },
          "then": {
            "properties": {
              "source_profile": {
                "enum": [
                  "bootstrap_foundation",
                  "promotion",
                  "repair"
                ]
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_id",
        "source_profile",
        "task_locator",
        "stage",
        "baseline_identity",
        "constitution_identity",
        "constitution_status",
        "impact_kind",
        "freshness_identity",
        "planning_purpose",
        "impact_reason"
      ],
      "properties": {
        "exit_id": {
          "const": "baseline_current"
        },
        "source_profile": {
          "const": "task_impact_sync"
        },
        "task_locator": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "const": "planning"
        },
        "baseline_identity": {
          "type": "string",
          "minLength": 1
        },
        "constitution_identity": {
          "type": "string",
          "minLength": 1
        },
        "constitution_status": {
          "const": "current"
        },
        "impact_kind": {
          "enum": [
            "no_architecture_impact",
            "architecture_impact"
          ]
        },
        "impact_reason": {
          "type": "string",
          "minLength": 1
        },
        "freshness_identity": {
          "type": "string",
          "minLength": 1
        },
        "planning_purpose": {
          "const": "candidate_assessment"
        },
        "change_path": {
          "enum": [
            "target_native",
            "legacy_boundary_convergence",
            "dedicated_refactor_slice"
          ]
        },
        "decision_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "if": {
        "properties": {
          "impact_kind": {
            "const": "architecture_impact"
          }
        },
        "required": [
          "impact_kind"
        ]
      },
      "then": {
        "required": [
          "change_path",
          "decision_refs"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "change_path"
              ]
            },
            {
              "required": [
                "decision_refs"
              ]
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_id",
        "source_profile",
        "task_locator",
        "stage",
        "baseline_identity",
        "constitution_identity",
        "constitution_status",
        "impact_kind",
        "promotion_state",
        "freshness_identity",
        "planning_purpose"
      ],
      "properties": {
        "exit_id": {
          "const": "baseline_current"
        },
        "source_profile": {
          "const": "task_impact_sync"
        },
        "task_locator": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "const": "planning"
        },
        "baseline_identity": {
          "type": "string",
          "minLength": 1
        },
        "constitution_identity": {
          "type": "string",
          "minLength": 1
        },
        "constitution_status": {
          "const": "current"
        },
        "impact_kind": {
          "enum": [
            "no_architecture_impact",
            "architecture_impact"
          ]
        },
        "impact_reason": {
          "type": "string",
          "minLength": 1
        },
        "promotion_state": {
          "enum": [
            "no_change",
            "reviewed_candidate",
            "reviewed_promoted"
          ]
        },
        "contribution_locator": {
          "type": "string",
          "minLength": 1
        },
        "contribution_identity": {
          "type": "string",
          "minLength": 1
        },
        "freshness_identity": {
          "type": "string",
          "minLength": 1
        },
        "planning_purpose": {
          "const": "final_plan"
        },
        "change_path": {
          "enum": [
            "target_native",
            "legacy_boundary_convergence",
            "dedicated_refactor_slice"
          ]
        }
      },
      "if": {
        "properties": {
          "impact_kind": {
            "const": "architecture_impact"
          }
        },
        "required": [
          "impact_kind"
        ]
      },
      "then": {
        "required": [
          "contribution_locator",
          "contribution_identity",
          "change_path"
        ],
        "properties": {
          "promotion_state": {
            "enum": [
              "reviewed_candidate",
              "reviewed_promoted"
            ]
          }
        },
        "not": {
          "required": [
            "impact_reason"
          ]
        }
      },
      "else": {
        "required": [
          "impact_reason"
        ],
        "properties": {
          "promotion_state": {
            "const": "no_change"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "contribution_locator"
              ]
            },
            {
              "required": [
                "contribution_identity"
              ]
            },
            {
              "required": [
                "change_path"
              ]
            }
          ]
        }
      }
    }
  ]
}
