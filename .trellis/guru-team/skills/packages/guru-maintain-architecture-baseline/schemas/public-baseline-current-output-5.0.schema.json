{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-architecture-baseline-output-current-5.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "source_profile",
    "task_locator",
    "stage",
    "baseline_identity",
    "constitution_identity",
    "constitution_status",
    "impact_kind",
    "promotion_state",
    "freshness_identity",
    "before_authority",
    "candidate"
  ],
  "properties": {
    "exit_id": {
      "const": "baseline_current"
    },
    "source_profile": {
      "enum": [
        "task_impact_sync",
        "promotion"
      ]
    },
    "task_locator": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "planning",
        "implementation_discovery",
        "phase2",
        "branch_review",
        "publication",
        "acceptance_finish",
        "final_integration"
      ]
    },
    "baseline_identity": {
      "type": "string",
      "minLength": 1
    },
    "constitution_identity": {
      "type": "string",
      "minLength": 1
    },
    "constitution_status": {
      "const": "current"
    },
    "impact_kind": {
      "enum": [
        "no_architecture_impact",
        "architecture_impact"
      ]
    },
    "impact_reason": {
      "type": "string",
      "minLength": 1
    },
    "promotion_state": {
      "enum": [
        "no_change",
        "reviewed_candidate",
        "reviewed_promoted"
      ]
    },
    "contribution_locator": {
      "type": "string",
      "minLength": 1
    },
    "contribution_identity": {
      "type": "string",
      "minLength": 1
    },
    "freshness_identity": {
      "type": "string",
      "minLength": 1
    },
    "before_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_revision",
        "baseline_locator",
        "constitution_locator",
        "change_contract_locator"
      ],
      "properties": {
        "git_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "baseline_locator": {
          "type": "string",
          "minLength": 1
        },
        "constitution_locator": {
          "type": "string",
          "minLength": 1
        },
        "change_contract_locator": {
          "type": "string",
          "minLength": 1
        },
        "absent_locators": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Subset of the three declared authority locators absent at git_revision; omitted or empty means all exist."
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "content_identity"
      ],
      "properties": {
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "content_identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },
  "if": {
    "properties": {
      "impact_kind": {
        "const": "architecture_impact"
      }
    },
    "required": [
      "impact_kind"
    ]
  },
  "then": {
    "required": [
      "contribution_locator",
      "contribution_identity"
    ],
    "properties": {
      "promotion_state": {
        "enum": [
          "reviewed_candidate",
          "reviewed_promoted"
        ]
      }
    },
    "not": {
      "required": [
        "impact_reason"
      ]
    }
  },
  "else": {
    "required": [
      "impact_reason"
    ],
    "properties": {
      "promotion_state": {
        "const": "no_change"
      }
    },
    "not": {
      "anyOf": [
        {
          "required": [
            "contribution_locator"
          ]
        },
        {
          "required": [
            "contribution_identity"
          ]
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_profile": {
            "const": "promotion"
          }
        },
        "required": [
          "source_profile"
        ]
      },
      "then": {
        "properties": {
          "stage": {
            "const": "final_integration"
          },
          "promotion_state": {
            "const": "reviewed_promoted"
          }
        }
      },
      "else": {
        "not": {
          "properties": {
            "stage": {
              "const": "final_integration"
            }
          },
          "required": [
            "stage"
          ]
        }
      }
    }
  ]
}
