{
  "$schema": "../../schemas/skill-interface-1.4.schema.json",
  "schema_version": "1.4",
  "id": "guru-maintain-architecture-baseline",
  "name": "guru-maintain-architecture-baseline",
  "description": "Maintain a repository Architecture Baseline through semantic bootstrap, task impact synchronization, promotion, and repair profiles.",
  "state": "active",
  "judgment_mode": "semantic",
  "modes": {
    "workflow": {"routing": "global_workflow", "entry_precondition_ids": ["runtime_dependency", "profile_binding", "architecture_authority", "project_change_contract", "invocation_freshness"]},
    "standalone": {"routing": "direct_discovery", "entry_precondition_ids": ["runtime_dependency", "profile_binding", "architecture_authority", "project_change_contract", "invocation_freshness"]}
  },
  "entry_preconditions": [
    {"id": "runtime_dependency", "evidence": "compatible Guru Team runtime", "binding": "current installation", "freshness": "validated before invocation"},
    {"id": "profile_binding", "evidence": "one closed 2.0 profile input and lifecycle stage", "binding": "the exact caller, mode, profile, stage, task, and continuation", "freshness": "fresh for every stage judgment"},
    {"id": "architecture_authority", "evidence": "live baseline and design-constitution locator plus identity and five principle identities", "binding": "the project-owned Architecture authority reread by the AI", "freshness": "identity changes require complete re-entry"},
    {"id": "project_change_contract", "evidence": "project change-contract, required-concern-set identity, and current project-check descriptors", "binding": "the task-local project architecture contract and descriptor authority", "freshness": "scope, owner, boundary, applicability, descriptor, or check changes require re-entry"},
    {"id": "invocation_freshness", "evidence": "input digest, semantic gate, exact consumer and minimal output", "binding": "one call-local semantic round", "freshness": "baseline, constitution, contribution, project check, or committed range changes invalidate the result"}
  ],
  "runtime_dependency": {"extension_id": "guru-team", "api_version": "1.0", "manifest_path": ".trellis/guru-team/extension.json", "dispatcher": "run-skill-command", "distribution": "guru-team-preset", "package_portability": "not-self-contained"},
  "ordered_stages": ["forward_behavior", "ai_review_gate", "conditional_human_confirmation", "recorder_validator", "typed_exit"],
  "artifacts": [
    {"id": "bootstrap_input", "path": "examples/public-input-bootstrap.json"},
    {"id": "impact_input", "path": "examples/public-input-impact.json"},
    {"id": "promotion_input", "path": "examples/public-input-promotion.json"},
    {"id": "repair_input", "path": "examples/public-input-repair.json"},
    {"id": "project_check_descriptor", "path": "examples/project-architecture-check-descriptor.json"},
    {"id": "project_check_result", "path": "examples/project-architecture-check-result.json"}
  ],
  "schemas": [
    {"id": "semantic_result", "path": "schemas/semantic-result.schema.json"},
    {"id": "project_architecture_check_descriptor", "path": "schemas/project-architecture-check-descriptor.schema.json"},
    {"id": "project_architecture_check_result", "path": "schemas/project-architecture-check-result.schema.json"},
    {"id": "architecture_contribution", "path": "schemas/architecture-contribution.schema.json"},
    {"id": "public_input", "path": "schemas/public-input-aggregate.schema.json"},
    {"id": "baseline_current_output", "path": "schemas/public-baseline-current-output.schema.json"},
    {"id": "sync_required_output", "path": "schemas/public-sync-required-output.schema.json"},
    {"id": "baseline_incomplete_output", "path": "schemas/public-baseline-incomplete-output.schema.json"},
    {"id": "architecture_conflict_output", "path": "schemas/public-architecture-conflict-output.schema.json"},
    {"id": "contract_incomplete_output", "path": "schemas/public-contract-incomplete-output.schema.json"},
    {"id": "fitness_regression_output", "path": "schemas/public-fitness-regression-output.schema.json"},
    {"id": "blocked_output", "path": "schemas/public-blocked-output.schema.json"}
  ],
  "validators": [{"id": "public_invocation", "command": "scripts/invoke.sh", "runtime_command": "invoke-guru-maintain-architecture-baseline", "objective_scope": "Validate the closed 2.0 profile, exact authority, committed-range and freshness binding, one-to-one owner-result project-check descriptor/result binding, semantic gate, unique consumer, and one minimal typed projection."}],
  "tests": ["tests/test_contract.py"],
  "platform_destinations": ["shared", "codex", "cursor", "claude"],
  "external_exits": [
    {"id": "baseline_current", "evidence": "fresh current or reviewed-and-promoted Architecture state", "consumer": {"kind": "workflow", "id": "guru-architecture-baseline-current-router"}},
    {"id": "sync_required", "evidence": "stale or unpromoted Architecture identity", "consumer": {"kind": "skill", "id": "guru-maintain-architecture-baseline"}},
    {"id": "baseline_incomplete", "evidence": "missing Architecture authority", "consumer": {"kind": "workflow", "id": "guru-architecture-baseline-bootstrap-router"}},
    {"id": "architecture_conflict", "evidence": "current task conflicts with Architecture authority", "consumer": {"kind": "workflow", "id": "guru-architecture-baseline-planning-router"}},
    {"id": "contract_incomplete", "evidence": "applicable project Architecture contract is incomplete", "consumer": {"kind": "workflow", "id": "guru-architecture-baseline-planning-router"}},
    {"id": "fitness_regression", "evidence": "candidate or committed diff worsens Architecture fitness", "consumer": {"kind": "workflow", "id": "guru-architecture-baseline-check-router"}},
    {"id": "blocked", "evidence": "Architecture owner cannot select a safe route", "consumer": {"kind": "stop", "id": "architecture-baseline-blocked"}}
  ],
  "reentry": {"identity": "profile, stage, baseline, constitution, project contract, contribution, and continuation identity", "freshness": "any bound identity or applicable scope change requires fresh semantic review", "stale_behavior": "fail_closed"},
  "public_contracts": {
    "input": {
      "kind": "structured_json",
      "aggregate_schema": {"schema_id": "guru-architecture-baseline-input-aggregate-2.0", "path": "schemas/public-input-aggregate.schema.json"},
      "profiles": [
        {"id": "bootstrap_foundation", "schema": {"schema_id": "guru-architecture-baseline-input-bootstrap-2.0", "path": "schemas/public-input-bootstrap.schema.json"}, "example": {"id": "bootstrap_input", "path": "examples/public-input-bootstrap.json"}, "discriminator": {"field": "profile", "value": "bootstrap_foundation"}},
        {"id": "task_impact_sync", "schema": {"schema_id": "guru-architecture-baseline-input-impact-2.0", "path": "schemas/public-input-impact.schema.json"}, "example": {"id": "impact_input", "path": "examples/public-input-impact.json"}, "discriminator": {"field": "profile", "value": "task_impact_sync"}},
        {"id": "promotion", "schema": {"schema_id": "guru-architecture-baseline-input-promotion-2.0", "path": "schemas/public-input-promotion.schema.json"}, "example": {"id": "promotion_input", "path": "examples/public-input-promotion.json"}, "discriminator": {"field": "profile", "value": "promotion"}},
        {"id": "repair", "schema": {"schema_id": "guru-architecture-baseline-input-repair-2.0", "path": "schemas/public-input-repair.schema.json"}, "example": {"id": "repair_input", "path": "examples/public-input-repair.json"}, "discriminator": {"field": "profile", "value": "repair"}}
      ]
    },
    "invocation": {"command_id": "run-skill-command", "wrapper": "scripts/invoke.sh", "input_binding": {"kind": "structured_json", "profile_id": "profile-specific"}, "stdout_contract": "single_typed_exit", "error_schema": {"schema_id": "guru-architecture-baseline-output-blocked-2.0", "path": "schemas/public-blocked-output.schema.json"}, "error_example": {"id": "blocked_output", "path": "examples/public-output-blocked.json"}, "example_argv": ["--invocation", "-"]},
    "outputs": [
      {"exit_id": "baseline_current", "schema": {"schema_id": "guru-architecture-baseline-output-current-2.0", "path": "schemas/public-baseline-current-output.schema.json"}, "example": {"id": "current_output", "path": "examples/public-output-current.json"}, "consumer_use_ids": ["current_projection"]},
      {"exit_id": "sync_required", "schema": {"schema_id": "guru-architecture-baseline-output-sync-required-2.0", "path": "schemas/public-sync-required-output.schema.json"}, "example": {"id": "sync_output", "path": "examples/public-output-sync-required.json"}, "consumer_use_ids": ["sync_projection"]},
      {"exit_id": "baseline_incomplete", "schema": {"schema_id": "guru-architecture-baseline-output-incomplete-2.0", "path": "schemas/public-baseline-incomplete-output.schema.json"}, "example": {"id": "incomplete_output", "path": "examples/public-output-baseline-incomplete.json"}, "consumer_use_ids": ["incomplete_projection"]},
      {"exit_id": "architecture_conflict", "schema": {"schema_id": "guru-architecture-baseline-output-conflict-2.0", "path": "schemas/public-architecture-conflict-output.schema.json"}, "example": {"id": "conflict_output", "path": "examples/public-output-architecture-conflict.json"}, "consumer_use_ids": ["conflict_projection"]},
      {"exit_id": "contract_incomplete", "schema": {"schema_id": "guru-architecture-baseline-output-contract-incomplete-2.0", "path": "schemas/public-contract-incomplete-output.schema.json"}, "example": {"id": "contract_output", "path": "examples/public-output-contract-incomplete.json"}, "consumer_use_ids": ["contract_projection"]},
      {"exit_id": "fitness_regression", "schema": {"schema_id": "guru-architecture-baseline-output-fitness-regression-2.0", "path": "schemas/public-fitness-regression-output.schema.json"}, "example": {"id": "fitness_output", "path": "examples/public-output-fitness-regression.json"}, "consumer_use_ids": ["fitness_projection"]},
      {"exit_id": "blocked", "schema": {"schema_id": "guru-architecture-baseline-output-blocked-2.0", "path": "schemas/public-blocked-output.schema.json"}, "example": {"id": "blocked_output", "path": "examples/public-output-blocked.json"}, "consumer_use_ids": ["blocked_projection"]}
    ],
    "consumer_inputs": [
      {"id": "current_input", "consumer": {"kind": "workflow", "id": "guru-architecture-baseline-current-router"}, "payload_kind": "structured_json", "contract": {"kind": "json_schema", "schema_id": "current_input", "path": "consumers/workflow/current.schema.json"}},
      {"id": "sync_input", "consumer": {"kind": "skill", "id": "guru-maintain-architecture-baseline"}, "payload_kind": "structured_json", "contract": {"kind": "skill_input_authoring_seed", "interface_path": "packages/guru-maintain-architecture-baseline/interface.json", "input_kind": "structured_json", "profile_id": "promotion", "seed_fields": ["task_locator", "stage", "expected_current_identity", "current_identity", "sync_kind", "sync_target", "freshness_identity"], "authoring_fields": ["schema_version", "profile", "source_exit", "mode", "continuation_id", "baseline", "constitution", "project_contract", "committed_range"], "authoring_example": {"id": "promotion_authoring", "path": "examples/public-promotion-authoring.json"}}},
      {"id": "incomplete_input", "consumer": {"kind": "workflow", "id": "guru-architecture-baseline-bootstrap-router"}, "payload_kind": "structured_json", "contract": {"kind": "json_schema", "schema_id": "incomplete_input", "path": "consumers/workflow/bootstrap.schema.json"}},
      {"id": "conflict_input", "consumer": {"kind": "workflow", "id": "guru-architecture-baseline-planning-router"}, "payload_kind": "structured_json", "contract": {"kind": "json_schema", "schema_id": "conflict_input", "path": "consumers/workflow/planning.schema.json"}},
      {"id": "contract_input", "consumer": {"kind": "workflow", "id": "guru-architecture-baseline-planning-router"}, "payload_kind": "structured_json", "contract": {"kind": "json_schema", "schema_id": "contract_input", "path": "consumers/workflow/planning.schema.json"}},
      {"id": "fitness_input", "consumer": {"kind": "workflow", "id": "guru-architecture-baseline-check-router"}, "payload_kind": "structured_json", "contract": {"kind": "json_schema", "schema_id": "fitness_input", "path": "consumers/workflow/check.schema.json"}},
      {"id": "blocked_input", "consumer": {"kind": "stop", "id": "architecture-baseline-blocked"}, "payload_kind": "structured_json", "contract": {"kind": "json_schema", "schema_id": "blocked_input", "path": "consumers/stop/blocked.schema.json"}}
    ],
    "projections": [
      {"id": "current_projection", "exit_id": "baseline_current", "consumer_input_id": "current_input", "operation": "direct"},
      {"id": "sync_projection", "exit_id": "sync_required", "consumer_input_id": "sync_input", "operation": "select", "mappings": [{"source": "task_locator", "target": "task_locator"}, {"source": "stage", "target": "stage"}, {"source": "expected_current_identity", "target": "expected_current_identity"}, {"source": "current_identity", "target": "current_identity"}, {"source": "sync_kind", "target": "sync_kind"}, {"source": "sync_target", "target": "sync_target"}, {"source": "freshness_identity", "target": "freshness_identity"}]},
      {"id": "incomplete_projection", "exit_id": "baseline_incomplete", "consumer_input_id": "incomplete_input", "operation": "direct"},
      {"id": "conflict_projection", "exit_id": "architecture_conflict", "consumer_input_id": "conflict_input", "operation": "direct"},
      {"id": "contract_projection", "exit_id": "contract_incomplete", "consumer_input_id": "contract_input", "operation": "direct"},
      {"id": "fitness_projection", "exit_id": "fitness_regression", "consumer_input_id": "fitness_input", "operation": "direct"},
      {"id": "blocked_projection", "exit_id": "blocked", "consumer_input_id": "blocked_input", "operation": "direct"}
    ],
    "private_artifacts": []
  }
}
