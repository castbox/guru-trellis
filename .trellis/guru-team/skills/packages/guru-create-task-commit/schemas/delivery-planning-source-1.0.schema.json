{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-task-commit-planning-source-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "delivery_key",
    "source_commit",
    "planning_sources"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "delivery_key": {
      "type": "object"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "planning_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prd.md",
        "design.md",
        "implement.md",
        "implement.jsonl",
        "check.jsonl"
      ],
      "properties": {
        "prd.md": {
          "type": "string",
          "minLength": 1
        },
        "design.md": {
          "type": "string",
          "minLength": 1
        },
        "implement.md": {
          "type": "string",
          "minLength": 1
        },
        "implement.jsonl": {
          "type": "string",
          "minLength": 1
        },
        "check.jsonl": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "planning_projection": {
      "const": "markdown_relative_links_v1"
    }
  }
}
