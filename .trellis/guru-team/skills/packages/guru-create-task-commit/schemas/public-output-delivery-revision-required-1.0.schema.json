{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-create-task-commit-output-delivery-revision-required-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "task_ref",
    "delivery_key"
  ],
  "properties": {
    "exit_id": {
      "const": "revision-required"
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "delivery_key": {
      "type": "object"
    }
  }
}
