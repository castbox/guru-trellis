{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-reactivate-task-source-transaction-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "task_ref", "lifecycle_generation", "current_source", "reviewed_source", "accepted_scope_identity", "target_relation_id", "result_id"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "task_ref": {"type": "string", "pattern": "^\\.trellis/tasks/archive/"},
    "lifecycle_generation": {"type": "integer", "minimum": 0},
    "current_source": {"type": "object"},
    "reviewed_source": {"type": "object"},
    "accepted_scope_identity": {"type": "string", "minLength": 1},
    "target_relation_id": {"type": "string", "minLength": 1},
    "result_id": {"type": "string", "minLength": 1}
  }
}
