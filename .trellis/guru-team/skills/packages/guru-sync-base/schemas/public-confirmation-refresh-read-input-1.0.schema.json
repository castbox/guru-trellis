{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-stage0-sync-base-input-confirmation-refresh-read-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_exit",
    "mode",
    "repo_root",
    "route",
    "operation",
    "base_ref",
    "return_identity"
  ],
  "properties": {
    "source_exit": {
      "const": "refresh_context"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "repo_root": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "const": "repo_change"
    },
    "operation": {
      "const": "read"
    },
    "base_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "return_identity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "target_locator",
            "resume_target",
            "continuation_id",
            "candidate_refs"
          ],
          "properties": {
            "profile": {
              "const": "normal_scenario_scope_confirmation"
            },
            "target_locator": {
              "type": "string",
              "minLength": 1
            },
            "resume_target": {
              "enum": [
                "guru-approve-task-plan",
                "guru-author-task-plan",
                "guru-check-task",
                "guru-clarify-requirements",
                "guru-execute-task-free-change",
                "guru-reconcile-task-base",
                "guru-resume-implementation",
                "guru-review-branch",
                "guru-review-change-request",
                "guru-review-task-delivery"
              ]
            },
            "continuation_id": {
              "type": "string",
              "minLength": 1
            },
            "candidate_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "task_ref": {
              "type": "string",
              "minLength": 1
            },
            "delivery_key": {
              "type": "object",
              "description": "Opaque upstream DeliveryKey validated by its original public owner."
            }
          },
          "allOf": [
            {
              "oneOf": [
                {
                  "required": [
                    "task_ref",
                    "delivery_key"
                  ]
                },
                {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "task_ref"
                        ]
                      },
                      {
                        "required": [
                          "delivery_key"
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "target_locator",
            "resume_target",
            "continuation_id",
            "candidate_refs"
          ],
          "properties": {
            "profile": {
              "const": "solution_mechanism_scope_confirmation"
            },
            "target_locator": {
              "type": "string",
              "minLength": 1
            },
            "resume_target": {
              "enum": [
                "guru-approve-task-plan",
                "guru-author-task-plan",
                "guru-check-task",
                "guru-clarify-requirements",
                "guru-execute-task-free-change",
                "guru-reconcile-task-base",
                "guru-resume-implementation",
                "guru-review-branch",
                "guru-review-change-request",
                "guru-review-task-delivery"
              ]
            },
            "continuation_id": {
              "type": "string",
              "minLength": 1
            },
            "candidate_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "task_ref": {
              "type": "string",
              "minLength": 1
            },
            "delivery_key": {
              "type": "object",
              "description": "Opaque upstream DeliveryKey validated by its original public owner."
            }
          },
          "allOf": [
            {
              "oneOf": [
                {
                  "required": [
                    "task_ref",
                    "delivery_key"
                  ]
                },
                {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "task_ref"
                        ]
                      },
                      {
                        "required": [
                          "delivery_key"
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
