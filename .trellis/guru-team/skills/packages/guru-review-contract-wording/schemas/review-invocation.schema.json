{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-contract-wording-review-invocation-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "mode", "change_request", "owner_result"],
  "properties": {
    "profile": {"const": "change_request"},
    "mode": {"enum": ["workflow", "standalone"]},
    "change_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "identity", "title", "body", "updated_at"],
      "properties": {
        "source_kind": {"enum": ["issue", "draft"]},
        "identity": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "body": {"type": "string"},
        "updated_at": {"type": ["string", "null"]},
        "selected_comments": {
          "type": "array",
          "description": "Optional legacy source metadata, passed through without changing the existing title/body scanner semantics."
        }
      }
    },
    "owner_result": {
      "type": "object",
      "description": "Scan: exactly {}. Record: existing flat AI authoring, validated by the recorder and review result schema. Check: exact recorded result, validated by contract-wording-review.schema.json."
    }
  }
}
