{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"guru-create-issue-input-1.0","type":"object","additionalProperties":false,"required":["profile","action","ready_target_kind","reviewed_target","reviewed_label_identity_sha256","draft","reviewed_at"],"properties":{"profile":{"const":"issue_creation"},"action":{"enum":["create_issue","recover_created_issue_result"]},"ready_target_kind":{"const":"proposed_draft"},"reviewed_at":{"type":"string","minLength":1},"reviewed_label_identity_sha256":{"$ref":"#/$defs/sha256"},"reviewed_target":{"type":"object","additionalProperties":false,"required":["kind","repo","draft_id","source_request_sha256","title_sha256","body_sha256","identity_sha256","content_sha256"],"properties":{"kind":{"const":"proposed_draft"},"repo":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},"draft_id":{"type":"string","minLength":1},"source_request_sha256":{"$ref":"#/$defs/sha256"},"title_sha256":{"$ref":"#/$defs/sha256"},"body_sha256":{"$ref":"#/$defs/sha256"},"identity_sha256":{"$ref":"#/$defs/sha256"},"content_sha256":{"$ref":"#/$defs/sha256"}}},"draft":{"type":"object","additionalProperties":false,"required":["repo_ref","title","body","labels","duplicate_disposition"],"properties":{"repo_ref":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},"title":{"type":"string","minLength":1},"body":{"type":"string","minLength":1},"labels":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"duplicate_disposition":{"const":"create_new"}}}},"$defs":{"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
