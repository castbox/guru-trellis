{
  "$schema": "../../schemas/skill-interface-1.7.schema.json",
  "schema_version": "1.7",
  "id": "guru-review-task-completion",
  "name": "guru-review-task-completion",
  "description": "Review all current task Delivery and evidence facts and select one bounded completion route.",
  "state": "active",
  "judgment_mode": "semantic",
  "modes": {
    "workflow": {
      "routing": "global_workflow",
      "entry_precondition_ids": [
        "runtime_dependency",
        "active_task",
        "current_authority",
        "delivery_history",
        "evidence_freshness"
      ]
    },
    "standalone": {
      "routing": "direct_discovery",
      "entry_precondition_ids": [
        "runtime_dependency",
        "active_task",
        "current_authority",
        "delivery_history",
        "evidence_freshness"
      ]
    }
  },
  "entry_preconditions": [
    {
      "id": "runtime_dependency",
      "evidence": "installed package and dispatcher",
      "binding": "compatible Guru Team preset",
      "freshness": "validated before invocation"
    },
    {
      "id": "active_task",
      "evidence": "current task identity and binding",
      "binding": "one task reference",
      "freshness": "reread for every review"
    },
    {
      "id": "current_authority",
      "evidence": "accepted scope, requirements, design and test authority",
      "binding": "current task contract",
      "freshness": "fresh semantic read"
    },
    {
      "id": "delivery_history",
      "evidence": "all historical Delivery facts",
      "binding": "task identity and target base",
      "freshness": "reconstructed from live history"
    },
    {
      "id": "evidence_freshness",
      "evidence": "validation and external evidence",
      "binding": "current completion round",
      "freshness": "stale evidence fails closed"
    }
  ],
  "runtime_dependency": {
    "extension_id": "guru-team",
    "api_version": "1.0",
    "manifest_path": ".trellis/guru-team/extension.json",
    "dispatcher": "run-skill-command",
    "distribution": "guru-team-preset",
    "package_portability": "not-self-contained"
  },
  "ordered_stages": [
    "forward_behavior",
    "ai_review_gate",
    "conditional_human_confirmation",
    "recorder_validator",
    "typed_exit"
  ],
  "artifacts": [
