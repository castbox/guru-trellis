  "external_exits": [
    {
      "id": "remaining_work",
      "evidence": "accepted scope still has work",
      "consumer": {
        "kind": "workflow",
        "id": "active-task-continuation"
      }
    },
    {
      "id": "evidence_pending",
      "evidence": "required evidence is not current",
      "consumer": {
        "kind": "skill",
        "id": "guru-review-task-completion"
      }
    },
    {
      "id": "additional_delivery_required",
      "evidence": "another independent business Delivery is required",
      "consumer": {
        "kind": "workflow",
        "id": "task-delivery-planning-router"
      }
    },
    {
      "id": "requirements_revision_required",
      "evidence": "requirements authority must change",
      "consumer": {
        "kind": "workflow",
        "id": "task-requirements-revision-router"
      }
    },
    {
      "id": "implementation_revision_required",
      "evidence": "implementation must change",
      "consumer": {
        "kind": "workflow",
        "id": "guru-resume-implementation"
      }
    },
    {
      "id": "completed",
      "evidence": "all accepted scope, Delivery and evidence facts pass",
      "consumer": {
        "kind": "skill",
        "id": "guru-complete-task-closure"
      }
    },
    {
      "id": "blocked",
      "evidence": "current completion judgment is not reliable",
      "consumer": {
        "kind": "stop",
        "id": "task-completion-blocked"
      }
    }
  ],
  "reentry": {
    "identity": "TaskLifecycleKey, accepted scope identity, same-generation Delivery merge result or prior archived-generation Reactivate anchor, selected current evidence slots",
    "freshness": "rebuild all facts for every call",
    "stale_behavior": "fail_closed"
  },
