{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-review-task-completion-semantic-delivery-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "reviewed_task_key",
    "reviewed_scope",
    "reviewed_delivery_result_ids",
    "evidence",
    "remaining_work_refs",
    "result_id",
    "route"
  ],
  "properties": {
    "profile": {
      "enum": [
        "delivery_completion",
        "delivery_evidence_refresh",
        "delivery_reactivation_validation"
      ]
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "reviewed_task_key": {
      "type": "object"
    },
    "reviewed_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "revision"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reviewed_delivery_result_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locator",
          "revision"
        ],
        "properties": {
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "remaining_work_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "typed_exit"
          ],
          "properties": {
            "typed_exit": {
              "const": "completed"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "typed_exit",
            "reason"
          ],
          "properties": {
            "typed_exit": {
              "enum": [
                "remaining_work",
                "evidence_pending",
                "additional_delivery_required",
                "requirements_revision_required",
                "implementation_revision_required",
                "blocked"
              ]
            },
            "reason": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason_code",
                "reason_refs"
              ],
              "properties": {
                "reason_code": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                "reason_refs": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
