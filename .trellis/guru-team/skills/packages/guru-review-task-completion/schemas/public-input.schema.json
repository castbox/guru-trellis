{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-review-task-completion-input-aggregate-2.0",
  "$defs": {
    "task_id": {"type": "string", "pattern": "^(?!.*\\.\\.)(?!.*(?:\\.lock|\\.)$)[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "task_ref": {"type": "string", "pattern": "^\\.trellis/tasks/(?!archive(?:/|$))[^/\\\\]+$|^\\.trellis/tasks/archive/[0-9]{4}-[0-9]{2}/[^/\\\\]+$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "task_ref", "lifecycle_generation"],
      "properties": {"task_id": {"$ref": "#/$defs/task_id"}, "task_ref": {"$ref": "#/$defs/task_ref"}, "lifecycle_generation": {"type": "integer", "minimum": 0}}
    },
    "merge": {"type": "object", "additionalProperties": false,
      "required": ["task_id", "task_ref", "lifecycle_generation", "delivery_cycle_ref", "repo_ref", "pr_number", "reviewed_head", "merge_commit_sha", "result_id"],
      "properties": {"task_id": {"$ref": "#/$defs/task_id"}, "task_ref": {"$ref": "#/$defs/task_ref"}, "lifecycle_generation": {"type": "integer", "minimum": 0}, "delivery_cycle_ref": {"$ref": "#/$defs/id"}, "repo_ref": {"$ref": "#/$defs/repo_ref"}, "pr_number": {"type": "integer", "minimum": 1}, "reviewed_head": {"$ref": "#/$defs/commit"}, "merge_commit_sha": {"$ref": "#/$defs/commit"}, "result_id": {"$ref": "#/$defs/id"}}},
    "reactivation_anchor": {"type": "object", "additionalProperties": false,
      "required": ["task_id", "archived_generation", "archive_ref", "archive_head"],
      "properties": {"task_id": {"$ref": "#/$defs/task_id"}, "archived_generation": {"type": "integer", "minimum": 0},
        "archive_ref": {"type": "string", "pattern": "^\\.trellis/tasks/archive/[0-9]{4}-[0-9]{2}/[^/\\\\]+$"},
        "archive_head": {"$ref": "#/$defs/commit"}}},
    "repo_ref": {"type": "string", "pattern": "^(?![^/]+/[^/]+\\.git$)[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "slots": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/id"},
              "propertyNames": {"enum": ["planning", "delivery_review", "delivery_publication", "reactivation", "validation"]}},
    "base": {"type": "object", "additionalProperties": false,
      "required": ["profile", "mode", "task_artifact", "accepted_scope_identity", "merge_result", "evidence_slots"],
      "properties": {"profile": {"const": "completion"}, "mode": {"enum": ["workflow", "standalone"]},
        "task_artifact": {"$ref": "#/$defs/artifact"}, "accepted_scope_identity": {"$ref": "#/$defs/id"},
        "merge_result": {"$ref": "#/$defs/merge"}, "evidence_slots": {"$ref": "#/$defs/slots"}}},
    "refresh": {"type": "object", "additionalProperties": false,
      "required": ["profile", "mode", "source_exit", "task_artifact", "reason", "accepted_scope_identity", "merge_result", "evidence_slots"],
      "properties": {"profile": {"const": "evidence_refresh"}, "mode": {"enum": ["workflow", "standalone"]},
        "source_exit": {"enum": ["evidence_pending", "reactivated_to_evidence_refresh"]},
        "reason": {"type": "object", "additionalProperties": false, "required": ["reason_code", "reason_refs"],
          "properties": {"reason_code": {"$ref": "#/$defs/id"}, "reason_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
        "task_artifact": {"$ref": "#/$defs/artifact"}, "accepted_scope_identity": {"$ref": "#/$defs/id"},
        "merge_result": {"$ref": "#/$defs/merge"}, "evidence_slots": {"$ref": "#/$defs/slots"}}},
    "reactivation": {"type": "object", "additionalProperties": false,
      "required": ["profile", "mode", "task_artifact", "accepted_scope_identity", "reactivation_anchor", "evidence_slots"],
      "properties": {"profile": {"const": "reactivation_validation"}, "mode": {"enum": ["workflow", "standalone"]},
        "task_artifact": {"$ref": "#/$defs/artifact"}, "accepted_scope_identity": {"$ref": "#/$defs/id"},
        "reactivation_anchor": {"$ref": "#/$defs/reactivation_anchor"}, "evidence_slots": {"$ref": "#/$defs/slots"}}},
    "reactivation_refresh": {"type": "object", "additionalProperties": false,
      "required": ["profile", "mode", "source_exit", "task_artifact", "reason", "accepted_scope_identity", "reactivation_anchor", "evidence_slots"],
      "properties": {"profile": {"const": "evidence_refresh"}, "mode": {"enum": ["workflow", "standalone"]},
        "source_exit": {"const": "evidence_pending"},
        "reason": {"type": "object", "additionalProperties": false, "required": ["reason_code", "reason_refs"],
          "properties": {"reason_code": {"$ref": "#/$defs/id"}, "reason_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
        "task_artifact": {"$ref": "#/$defs/artifact"}, "accepted_scope_identity": {"$ref": "#/$defs/id"},
        "reactivation_anchor": {"$ref": "#/$defs/reactivation_anchor"}, "evidence_slots": {"$ref": "#/$defs/slots"}}}
  },
  "oneOf": [{"$ref": "#/$defs/base"}, {"$ref": "#/$defs/refresh"}, {"$ref": "#/$defs/reactivation"}, {"$ref": "#/$defs/reactivation_refresh"}]
}
