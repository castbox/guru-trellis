{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-review-task-completion-output-delivery-remaining-work-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "task_ref",
    "task_key",
    "reason"
  ],
  "properties": {
    "exit_id": {
      "const": "remaining_work"
    },
    "task_ref": {
      "type": "string",
      "minLength": 1
    },
    "task_key": {
      "type": "object"
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_code",
        "reason_refs"
      ],
      "properties": {
        "reason_code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "reason_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
