{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-requirements-design-test-ssot-input-promotion-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "source_exit",
    "mode",
    "continuation_id",
    "authority_locator",
    "target_version",
    "contribution_locator",
    "sync_kind",
    "freshness",
    "architecture_baseline",
    "schema_version",
    "stage"
  ],
  "properties": {
    "profile": {
      "const": "promotion"
    },
    "source_exit": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "continuation_id": {
      "type": "string",
      "minLength": 1
    },
    "exit_id": {
      "const": "sync_required"
    },
    "authority_locator": {
      "type": "string",
      "minLength": 1
    },
    "target_version": {
      "type": "string",
      "minLength": 1
    },
    "contribution_locator": {
      "type": "string",
      "minLength": 1
    },
    "sync_kind": {
      "enum": [
        "promotion",
        "repair"
      ]
    },
    "freshness": {
      "type": "string",
      "minLength": 1
    },
    "architecture_baseline": {
      "$ref": "#/$defs/architectureBaseline"
    },
    "schema_version": {
      "const": "2.0"
    },
    "stage": {
      "const": "final_integration"
    }
  },
  "$defs": {
    "architectureBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "version",
        "status"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
