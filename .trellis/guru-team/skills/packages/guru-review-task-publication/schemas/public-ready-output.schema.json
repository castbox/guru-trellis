{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-production-review-task-publication-output-ready-3.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["exit_id", "task_ref", "branch_review_commit"],
  "properties": {
    "exit_id": {"const": "ready"},
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "branch_review_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
