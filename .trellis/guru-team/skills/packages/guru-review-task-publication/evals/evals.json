{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-team-skill-evals-1.0",
  "schema_version": "1.0",
  "skill_name": "guru-review-task-publication",
  "evals": [
    {
      "id": "workflow-initial-ready",
      "prompt": "Complete the workflow-mode initial publication review and pass the semantic result to the stable public wrapper.",
      "expected_exit": "ready",
      "expected_output": "The DTO contains task identity, branch_review_commit, and the exact reviewed PR title/body.",
      "input_profile_id": "publication_review",
      "assertions": {
        "deterministic": [
          {
            "id": "expected-route",
            "kind": "json_path",
            "pointer": "/exit_id",
            "operation": "equals",
            "expected": "ready"
          },
          {
            "id": "public-only",
            "kind": "trace",
            "invariant": "public_invocation_only"
          },
          {
            "id": "evals-not-loaded",
            "kind": "trace",
            "invariant": "evals_not_loaded_by_skill"
          },
          {
            "id": "private-runtime-not-read",
            "kind": "trace",
            "invariant": "private_runtime_not_read_by_agent"
          }
        ]
      },
      "files": [
        "evals/files/workflow-initial-ready-input.json",
        "evals/files/workflow-initial-ready-facts.json"
      ]
    },
    {
      "id": "standalone-initial-ready",
      "prompt": "Complete the standalone-mode initial publication review with the same owner and checker contract.",
      "expected_exit": "ready",
      "expected_output": "The standalone DTO carries the same exact reviewed PR payload.",
      "input_profile_id": "publication_review",
      "assertions": {
        "deterministic": [
          {
            "id": "expected-route",
            "kind": "json_path",
            "pointer": "/exit_id",
            "operation": "equals",
            "expected": "ready"
          }
        ]
      },
      "files": [
        "evals/files/standalone-initial-ready-input.json",
        "evals/files/standalone-initial-ready-facts.json"
      ]
    },
    {
      "id": "return-to-task-work",
      "prompt": "Record a current-scope non-metadata finding and invoke the wrapper after the owner selects task-work re-entry.",
      "expected_exit": "return_to_task_work",
      "expected_output": "The DTO contains exact finding references and the fixed phase-2 resume target.",
      "input_profile_id": "publication_review",
      "assertions": {
        "deterministic": [
          {
            "id": "expected-route",
            "kind": "json_path",
            "pointer": "/exit_id",
            "operation": "equals",
            "expected": "return_to_task_work"
          }
        ]
      },
      "files": [
        "evals/files/return-to-task-work-input.json",
        "evals/files/return-to-task-work-facts.json"
      ]
    },
    {
      "id": "blocked-external",
      "prompt": "Record an external publication blocker and invoke the wrapper without converting it into task work.",
      "expected_exit": "blocked",
      "expected_output": "The DTO contains only the stable blocker reason and remediation.",
      "input_profile_id": "publication_review",
      "assertions": {
        "deterministic": [
          {
            "id": "expected-route",
            "kind": "json_path",
            "pointer": "/exit_id",
            "operation": "equals",
            "expected": "blocked"
          }
        ]
      },
      "files": [
        "evals/files/blocked-external-input.json",
        "evals/files/blocked-external-facts.json"
      ]
    },
    {
      "id": "stale-reentry-ready",
      "prompt": "Re-enter through the stale profile, reread objective preconditions, re-review only directly affected publication dimensions, and emit a fresh ready handoff.",
      "expected_exit": "ready",
      "expected_output": "The stale profile produces a freshly checked exact PR payload.",
      "input_profile_id": "publication_review_stale",
      "assertions": {
        "deterministic": [
          {
            "id": "expected-route",
            "kind": "json_path",
            "pointer": "/exit_id",
            "operation": "equals",
            "expected": "ready"
          }
        ]
      },
      "files": [
        "evals/files/stale-reentry-ready-input.json",
        "evals/files/stale-reentry-ready-facts.json"
      ]
    },
    {
      "id": "metadata-fix-fresh-ready",
      "prompt": "Revise only task-local publication metadata, re-review directly affected dimensions while carrying forward unchanged current evidence, and emit ready.",
      "expected_exit": "ready",
      "expected_output": "The closed metadata finding remains private while ready carries the exact revised PR payload.",
      "input_profile_id": "publication_review",
      "assertions": {
        "deterministic": [
          {
            "id": "expected-route",
            "kind": "json_path",
            "pointer": "/exit_id",
            "operation": "equals",
            "expected": "ready"
          }
        ]
      },
      "files": [
        "evals/files/metadata-fix-fresh-ready-input.json",
        "evals/files/metadata-fix-fresh-ready-facts.json"
      ]
    },
    {
      "id": "metadata-fix-durable-drift-return",
      "prompt": "During metadata rereview, detect ordinary durable-document drift and return to task work.",
      "expected_exit": "return_to_task_work",
      "expected_output": "The actual owner exit selects the return schema and exact finding reference.",
      "input_profile_id": "publication_review",
      "assertions": {
        "deterministic": [
          {
            "id": "expected-route",
            "kind": "json_path",
            "pointer": "/exit_id",
            "operation": "equals",
            "expected": "return_to_task_work"
          }
        ]
      },
      "files": [
        "evals/files/metadata-fix-durable-drift-return-input.json",
        "evals/files/metadata-fix-durable-drift-return-facts.json"
      ]
    },
    {
      "id": "default-branch-close",
      "prompt": "Review a complete Issue-backed delivery targeting the repository default branch; apply the default closure rule and emit the reviewed PR payload.",
      "expected_exit": "ready",
      "expected_output": "The PR body uses a GitHub closing keyword for the completed Issue.",
      "input_profile_id": "publication_review",
      "assertions": {
        "deterministic": [
          {
            "id": "expected-route",
            "kind": "json_path",
            "pointer": "/exit_id",
            "operation": "equals",
            "expected": "ready"
          },
          {
            "id": "closing-keyword",
            "kind": "json_path",
            "pointer": "/pr_body",
            "operation": "contains",
            "expected": "Closes #146"
          }
        ]
      },
      "files": [
        "evals/files/workflow-initial-ready-input.json",
        "evals/files/default-branch-close-facts.json"
      ]
    },
    {
      "id": "remain-open-reference",
      "prompt": "Review an Issue-backed delivery whose live authority requires post-merge release observation; keep the Issue open with that concrete reason and no closing keyword.",
      "expected_exit": "ready",
      "expected_output": "The PR body references the Issue and states the current-authority remain-open reason.",
      "input_profile_id": "publication_review",
      "assertions": {
        "deterministic": [
          {
            "id": "expected-route",
            "kind": "json_path",
            "pointer": "/exit_id",
            "operation": "equals",
            "expected": "ready"
          },
          {
            "id": "remain-open-reason",
            "kind": "json_path",
            "pointer": "/pr_body",
            "operation": "contains",
            "expected": "发布观测"
          }
        ]
      },
      "files": [
        "evals/files/workflow-initial-ready-input.json",
        "evals/files/remain-open-reference-facts.json"
      ]
    },
    {
      "id": "no-external-work-item",
      "prompt": "Review a task with no external work item; emit a PR body with no Issue number, reference, or closing effect.",
      "expected_exit": "ready",
      "expected_output": "The PR body explicitly states that no external work item exists and contains no Issue reference.",
      "input_profile_id": "publication_review",
      "assertions": {
        "deterministic": [
          {
            "id": "expected-route",
            "kind": "json_path",
            "pointer": "/exit_id",
            "operation": "equals",
            "expected": "ready"
          },
          {
            "id": "no-external-reference",
            "kind": "json_path",
            "pointer": "/pr_body",
            "operation": "contains",
            "expected": "没有 external work item"
          }
        ]
      },
      "files": [
        "evals/files/workflow-initial-ready-input.json",
        "evals/files/no-external-work-item-facts.json"
      ]
    },
    {
      "id": "non-default-branch-reference",
      "prompt": "Review a complete Issue-backed delivery targeting a non-default branch; reference the Issue without claiming closure and require a fresh later default-branch Publication judgment.",
      "expected_exit": "ready",
      "expected_output": "The PR body uses a reference only and states that this non-default-branch PR has no closing effect.",
      "input_profile_id": "publication_review",
      "assertions": {
        "deterministic": [
          {
            "id": "expected-route",
            "kind": "json_path",
            "pointer": "/exit_id",
            "operation": "equals",
            "expected": "ready"
          },
          {
            "id": "non-default-effect",
            "kind": "json_path",
            "pointer": "/pr_body",
            "operation": "contains",
            "expected": "目标为非默认分支"
          }
        ]
      },
      "files": [
        "evals/files/workflow-initial-ready-input.json",
        "evals/files/non-default-branch-reference-facts.json"
      ]
    }
  ]
}
