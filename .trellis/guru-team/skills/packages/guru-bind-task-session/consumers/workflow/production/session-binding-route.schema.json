{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-bind-task-session-route-2.0",
  "type": "object", "additionalProperties": false,
  "required": ["exit_id", "task_id", "lifecycle_generation", "resume_target"],
  "properties": {
    "exit_id": {"enum": ["session_resumed", "session_rebound", "task_switched", "reactivate_rebound", "session_manually_recovered"]},
    "task_id": {"$ref": "#/$defs/taskId"},
    "lifecycle_generation": {"type": "integer", "minimum": 0},
    "resume_target": {"type": "string", "minLength": 1}
  },
  "$defs": {"taskId": {"type": "string", "pattern": "^(?!.*\\.\\.)(?!.*(?:\\.lock|\\.)$)[A-Za-z0-9][A-Za-z0-9._-]*$"}}
}
