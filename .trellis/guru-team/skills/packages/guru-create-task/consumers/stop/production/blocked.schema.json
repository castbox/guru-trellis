{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-task-creation-blocked-input-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "reason_code"
  ],
  "properties": {
    "exit_id": {
      "const": "blocked"
    },
    "reason_code": {
      "type": "string"
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_path",
        "remediation"
      ],
      "properties": {
        "field_path": {
          "type": "string",
          "minLength": 1
        },
        "remediation": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
