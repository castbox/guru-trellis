{
  "$schema": "../../schemas/skill-interface-1.6.schema.json",
  "schema_version": "1.6",
  "id": "guru-check-task",
  "name": "guru-check-task",
  "description": "Recover an already completed original Check planning rollback or maintain selected historical legacy controls; current development review belongs to guru-review-branch.",
  "state": "active",
  "judgment_mode": "semantic",
  "modes": {
    "workflow": {
      "routing": "global_workflow",
      "entry_precondition_ids": [
        "runtime_dependency",
        "task_checkout",
        "original_source",
        "rollback_identity",
        "semantic_result",
        "invocation_freshness"
      ]
    },
    "standalone": {
      "routing": "direct_discovery",
      "entry_precondition_ids": [
        "runtime_dependency",
        "task_checkout",
        "original_source",
        "rollback_identity",
        "semantic_result",
        "invocation_freshness"
      ]
    }
  },
  "entry_preconditions": [
    {
      "id": "runtime_dependency",
      "evidence": "Complete matching external provider and compatible target public Task/Delivery API.",
      "binding": "The original recovery or selected legacy owner.",
      "freshness": "Validate before every invocation."
    },
    {
      "id": "task_checkout",
      "evidence": "Exact Task/Delivery key and live registered target checkout; legacy uses its exact selected target.",
      "binding": "Same original Task/generation/Delivery or explicit legacy locator.",
      "freshness": "Reread actual target facts before recovery or mutation."
    },
    {
      "id": "original_source",
      "evidence": "Complete original Check result/input and retained rollback binding or actual original public query; legacy uses its exact source preimage.",
      "binding": "Original result, scope, plan, candidate and source relationship.",
      "freshness": "Never reconstruct cleared Planning or substitute current facts for old source."
    },
    {
      "id": "rollback_identity",
      "evidence": "Current scope/plans/candidate/content and cleared result slots, or selected legacy fixed-preimage maintenance facts.",
      "binding": "Same already executed rollback or bounded original legacy operation.",
      "freshness": "Actual content/authority changes return to their original owner."
    },
    {
      "id": "semantic_result",
      "evidence": "Current original-owner judgment of route, correction or legacy disposition.",
      "binding": "Only planning_stale, blocked or legacy_controls_retired; no development pass.",
      "freshness": "Judge before dry-run recorder or legacy executor."
    },
    {
      "id": "invocation_freshness",
      "evidence": "Exact public input, original source and actual output.",
      "binding": "One supported original recovery/maintenance operation.",
      "freshness": "Reject stale, missing or mismatched evidence and recover only its actual result."
    }
  ],
  "runtime_dependency": {
    "extension_id": "guru-team",
    "api_version": "1.0",
    "manifest_path": ".trellis/guru-team/extension.json",
    "dispatcher": "run-skill-command",
    "distribution": "guru-team-preset",
    "package_portability": "not-self-contained"
  },
  "ordered_stages": [
    "forward_behavior",
    "ai_review_gate",
    "conditional_human_confirmation",
    "recorder_validator",
    "typed_exit"
  ],
