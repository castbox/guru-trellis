{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-publish-task-delivery-output-delivery-resume-publication-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "task_ref",
    "transaction_ref",
    "delivery_key"
  ],
  "properties": {
    "exit_id": {
      "const": "resume_publication"
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "transaction_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "delivery_key": {
      "type": "object"
    }
  }
}
