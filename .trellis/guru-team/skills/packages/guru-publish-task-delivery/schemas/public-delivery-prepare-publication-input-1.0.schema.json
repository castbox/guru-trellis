{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-publish-task-delivery-input-delivery-prepare-publication-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "task_ref",
    "delivery_key",
    "branch_review_commit",
    "full_review_result_id",
    "architecture_assessment"
  ],
  "properties": {
    "profile": {
      "const": "delivery_prepare_publication"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "delivery_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "lifecycle_generation",
        "delivery_id"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle_generation": {
          "type": "integer",
          "minimum": 0
        },
        "delivery_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "branch_review_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "full_review_result_id": {
      "type": "string",
      "minLength": 1
    },
    "architecture_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "content_identity",
        "promotion_state"
      ],
      "properties": {
        "head": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "content_identity": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "promotion_state": {
          "enum": [
            "no_change",
            "reviewed_promoted"
          ]
        }
      }
    }
  }
}
