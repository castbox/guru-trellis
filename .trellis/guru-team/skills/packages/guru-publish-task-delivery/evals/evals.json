{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-team-skill-evals-1.0",
  "schema_version": "1.0",
  "skill_name": "guru-publish-task-delivery",
  "evals": [
    {
      "id": "prepare-first-publication",
      "prompt": "Assess readiness for a fixed independently reviewed candidate and show the exact pending Publication preview.",
      "expected_exit": "publication_prepared",
      "expected_output": "Current readiness, precise PR text and pending actions without remote mutation.",
      "input_profile_id": "delivery_prepare_publication",
      "files": [
        "evals/files/prepare-publication-input.json"
      ],
      "assertions": {
        "deterministic": [
          {
            "id": "route",
            "kind": "json_path",
            "pointer": "/exit_id",
            "operation": "equals",
            "expected": "publication_prepared"
          },
          {
            "id": "public-only",
            "kind": "trace",
            "invariant": "public_invocation_only"
          }
        ],
        "semantic": [
          {
            "id": "delivery-only",
            "criterion": "The preview shows the reviewed PR text, current disclosures, and precise pending actions before any remote mutation.",
            "evidence_selector": "transcript"
          }
        ]
      }
    },
    {
      "id": "same-plan-terminal-recovery",
      "prompt": "Recover the exact terminal publication transaction and rematerialize the same ready_for_merge output without another mutation.",
      "expected_exit": "ready_for_merge",
      "expected_output": "The same minimal merge seed with zero repeated push, create, edit, or Ready mutation.",
      "input_profile_id": "delivery_same_plan_resume",
      "files": [
        "evals/files/same-plan-resume-input.json"
      ],
      "assertions": {
        "deterministic": [
          {
            "id": "route",
            "kind": "json_path",
            "pointer": "/exit_id",
            "operation": "equals",
            "expected": "ready_for_merge"
          }
        ]
      }
    },
    {
      "id": "equal-head-bind-recovery",
      "prompt": "Reread the original interrupted binding and route pending work through current Publication preparation.",
      "expected_exit": "review_stale",
      "expected_output": "A same-Delivery route to assess the remaining pending action set.",
      "input_profile_id": "delivery_same_plan_resume",
      "files": [
        "evals/files/equal-head-bind-resume-input.json"
      ],
      "assertions": {
        "deterministic": [
          {
            "id": "route",
            "kind": "json_path",
            "pointer": "/exit_id",
            "operation": "equals",
            "expected": "review_stale"
          },
          {
            "id": "private-runtime",
            "kind": "trace",
            "invariant": "private_runtime_not_read_by_agent"
          }
        ]
      }
    }
  ]
}
