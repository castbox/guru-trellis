{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-finish-task-input-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "source_exit", "mode", "task_ref", "closure_exit", "closure_ref", "source_issue"],
  "properties": {
    "profile": {"const": "closure_completed"},
    "source_exit": {"enum": ["closed", "no_mutation", "resume_finish"]},
    "mode": {"enum": ["workflow", "standalone"]},
    "task_ref": {"type": "string", "pattern": "^\\.trellis/tasks/"},
    "closure_exit": {"enum": ["closed", "no_mutation"]},
    "closure_ref": {"type": "string", "pattern": "^closure:v3:[0-9a-f]{16}:[0-9a-f]{16}$"},
    "source_issue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["repo_ref", "number", "disposition"],
          "properties": {
            "repo_ref": {"type": "string", "pattern": "^[^/ ]+/[^/ ]+$"},
            "number": {"type": "integer", "minimum": 1},
            "disposition": {"const": "exact_source"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["disposition"],
          "properties": {"disposition": {"enum": ["no_issue", "reference_only", "follow_up", "parent"]}}
        }
      ]
    }
  }
}
