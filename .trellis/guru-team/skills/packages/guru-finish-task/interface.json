    "consumer_inputs": [
      {
        "id": "cleanup",
        "consumer": {
          "kind": "skill",
          "id": "guru-cleanup-task-resources"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "skill_input_authoring_seed",
          "interface_path": "packages/guru-cleanup-task-resources/interface.json",
          "input_kind": "structured_json",
          "profile_id": "normal",
          "seed_fields": [
            "task_id",
            "lifecycle_generation",
            "finish_result_id",
            "inventory_id"
