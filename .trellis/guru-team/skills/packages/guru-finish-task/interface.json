        "operation": "direct"
      },
      {
        "id": "closure_refresh",
        "exit_id": "closure_refresh_required",
        "consumer_input_id": "closure_refresh",
        "operation": "select",
        "mappings": [
          {
            "source": "task_id",
            "target": "task_id"
          },
          {
            "source": "lifecycle_generation",
            "target": "lifecycle_generation"
          },
          {
            "source": "result_id",
            "target": "result_id"
          }
        ]
      },
      {
        "id": "manual_cleanup",
        "exit_id": "manual_cleanup_required",
        "consumer_input_id": "manual_cleanup",
        "operation": "select",
        "mappings": [
          {
            "source": "task_id",
            "target": "task_id"
          },
          {
            "source": "lifecycle_generation",
            "target": "lifecycle_generation"
          },
          {
            "source": "finish_result_id",
