        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "json_schema",
          "schema_id": "guru-finish-task-blocked-stop-2.0",
          "path": "consumers/stop/production/finish-blocked.schema.json"
        }
      },
      {
        "id": "closure_refresh",
        "consumer": {
          "kind": "workflow",
          "id": "task-closure-refresh-router"
        },
        "payload_kind": "structured_json",
