      {
        "id": "manual_cleanup",
        "consumer": {
          "kind": "skill",
          "id": "guru-cleanup-task-resources"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "skill_input_authoring_seed",
          "interface_path": "packages/guru-cleanup-task-resources/interface.json",
          "input_kind": "structured_json",
          "profile_id": "select_explicit_cleanup_targets",
          "seed_fields": [
            "task_id",
            "lifecycle_generation",
            "finish_result_id"
          ],
          "authoring_fields": [
            "profile",
            "mode",
            "selected_candidate_ids"
          ],
          "authoring_example": {
            "id": "manual_cleanup_authoring",
            "path": "examples/manual-cleanup-authoring.json"
          }
        }
      },
      {
        "id": "legacy_controls_retired_input",
        "consumer": {
          "kind": "workflow",
          "id": "legacy-maintenance-finish-task-legacy-controls-retired"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "json_schema",
          "schema_id": "legacy-maintenance-finish-task-legacy-controls-retired-input-1.0",
          "path": "consumers/workflow/production/legacy-maintenance-finish-task-legacy-controls-retired.schema.json"
        }
      }
    ],
    "projections": [
