{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"guru-complete-task-closure-input-1.0","type":"object","additionalProperties":false,"required":["profile","source_exit","mode","task_ref","completion_ref","source_issue"],"properties":{"profile":{"const":"completion_approved"},"source_exit":{"enum":["completed","resume_closure"]},"mode":{"enum":["workflow","standalone"]},"task_ref":{"type":"string","pattern":"^\\.trellis/tasks/"},"completion_ref":{"type":"string","minLength":1},"closure_ref":{"type":"string","minLength":1},"source_issue":{"oneOf":[{"type":"object","additionalProperties":false,"required":["repo_ref","number","disposition"],"properties":{"repo_ref":{"type":"string","pattern":"^[^/ ]+/[^/ ]+$"},"number":{"type":"integer","minimum":1},"disposition":{"const":"exact_source"}}},{"type":"object","additionalProperties":false,"required":["disposition"],"properties":{"disposition":{"enum":["no_issue","reference_only","follow_up","parent"]}}}]}},"allOf":[{"if":{"properties":{"source_exit":{"const":"resume_closure"}}},"then":{"required":["closure_ref"]}}]}
