{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-task-execution-result-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "task_id",
    "task_ref",
    "lifecycle_generation",
    "planning_result_id",
    "selected_base_ref",
    "continuity",
    "binding_revision"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "operation": {
      "enum": [
        "activate",
        "resume_execution"
      ]
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/(?!archive(?:/|$))(?!\\.{1,2}$)[^/\\\\]+$"
    },
    "lifecycle_generation": {
      "type": "integer",
      "minimum": 0
    },
    "planning_result_id": {
      "type": "string",
      "pattern": "^planning:[0-9a-f]{64}$"
    },
    "selected_base_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "continuity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "task_head",
            "base_head"
          ],
          "properties": {
            "kind": {
              "const": "base_current"
            },
            "task_head": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "base_head": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "task_head",
            "new_base_head",
            "result_id",
            "resume_target"
          ],
          "properties": {
            "kind": {
              "const": "reconciled"
            },
            "task_head": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "new_base_head": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "result_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "resume_target": {
              "const": "task_activation"
            }
          }
        }
      ]
    },
    "binding_revision": {
      "type": "integer",
      "minimum": 0
    }
  }
}
