{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-reconcile-task-base-input-definitions-1.0-delivery-1.0",
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "task": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "common": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "workflow",
            "standalone"
          ]
        },
        "task_ref": {
          "$ref": "#/$defs/task"
        },
        "task_head": {
          "$ref": "#/$defs/sha"
        },
        "selected_base_ref": {
          "type": "string",
          "minLength": 1
        },
        "old_base_head": {
          "$ref": "#/$defs/sha"
        },
        "new_base_head": {
          "$ref": "#/$defs/sha"
        },
        "delivery_key": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "task_id",
            "lifecycle_generation",
            "delivery_id"
          ],
          "properties": {
            "task_id": {
              "type": "string",
              "minLength": 1
            },
            "lifecycle_generation": {
              "type": "integer",
              "minimum": 0
            },
            "delivery_id": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    },
    "postPlan": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "mode",
            "task_ref",
            "task_head",
            "selected_base_ref",
            "resume_target",
            "delivery_key"
          ],
          "properties": {
            "profile": {
              "const": "delivery_post_plan"
            },
            "mode": true,
            "task_ref": true,
            "task_head": true,
            "selected_base_ref": true,
            "resume_target": {
              "const": "delivery_activation"
            },
            "delivery_key": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "task_id",
                "lifecycle_generation",
                "delivery_id"
              ],
              "properties": {
                "task_id": {
                  "type": "string",
                  "minLength": 1
                },
                "lifecycle_generation": {
                  "type": "integer",
                  "minimum": 0
                },
                "delivery_id": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      ]
    },
    "postCheck": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "mode",
            "task_ref",
            "task_head",
            "selected_base_ref",
            "resume_target",
            "delivery_key"
          ],
          "properties": {
            "profile": {
              "const": "delivery_post_check"
            },
            "mode": true,
            "task_ref": true,
            "task_head": true,
            "selected_base_ref": true,
            "resume_target": {
              "const": "task_commit"
            },
            "delivery_key": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "task_id",
                "lifecycle_generation",
                "delivery_id"
              ],
              "properties": {
                "task_id": {
                  "type": "string",
                  "minLength": 1
                },
                "lifecycle_generation": {
                  "type": "integer",
                  "minimum": 0
                },
                "delivery_id": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      ]
    },
    "postCommit": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "mode",
            "task_ref",
            "task_head",
            "selected_base_ref",
            "resume_target",
            "delivery_key"
          ],
          "properties": {
            "profile": {
              "const": "delivery_post_commit"
            },
            "mode": true,
            "task_ref": true,
            "task_head": true,
            "selected_base_ref": true,
            "resume_target": {
              "const": "branch_review"
            },
            "delivery_key": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "task_id",
                "lifecycle_generation",
                "delivery_id"
              ],
              "properties": {
                "task_id": {
                  "type": "string",
                  "minLength": 1
                },
                "lifecycle_generation": {
                  "type": "integer",
                  "minimum": 0
                },
                "delivery_id": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      ]
    },
    "postBranchReview": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "mode",
            "task_ref",
            "task_head",
            "selected_base_ref",
            "old_base_head",
            "new_base_head",
            "resume_target",
            "branch_review_commit",
            "delivery_key"
          ],
          "properties": {
            "profile": {
              "const": "delivery_post_branch_review"
            },
            "mode": true,
            "task_ref": true,
            "task_head": true,
            "selected_base_ref": true,
            "old_base_head": true,
            "new_base_head": true,
            "resume_target": {
              "const": "publication_review"
            },
            "branch_review_commit": {
              "$ref": "#/$defs/sha"
            },
            "delivery_key": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "task_id",
                "lifecycle_generation",
                "delivery_id"
              ],
              "properties": {
                "task_id": {
                  "type": "string",
                  "minLength": 1
                },
                "lifecycle_generation": {
                  "type": "integer",
                  "minimum": 0
                },
                "delivery_id": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      ]
    },
    "postPublication": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "mode",
            "task_ref",
            "task_head",
            "selected_base_ref",
            "old_base_head",
            "new_base_head",
            "resume_target",
            "branch_review_commit",
            "delivery_key"
          ],
          "properties": {
            "profile": {
              "const": "delivery_post_publication"
            },
            "mode": true,
            "task_ref": true,
            "task_head": true,
            "selected_base_ref": true,
            "old_base_head": true,
            "new_base_head": true,
            "resume_target": {
              "const": "delivery_publication"
            },
            "branch_review_commit": {
              "$ref": "#/$defs/sha"
            },
            "delivery_key": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "task_id",
                "lifecycle_generation",
                "delivery_id"
              ],
              "properties": {
                "task_id": {
                  "type": "string",
                  "minLength": 1
                },
                "lifecycle_generation": {
                  "type": "integer",
                  "minimum": 0
                },
                "delivery_id": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      ]
    },
    "finalizerBaseMismatch": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "mode",
            "task_ref",
            "task_head",
            "selected_base_ref",
            "old_base_head",
            "new_base_head",
            "resume_target",
            "branch_review_commit",
            "delivery_key"
          ],
          "properties": {
            "profile": {
              "const": "delivery_finalizer_base_mismatch"
            },
            "mode": true,
            "task_ref": true,
            "task_head": true,
            "selected_base_ref": true,
            "old_base_head": true,
            "new_base_head": true,
            "resume_target": {
              "const": "finalization_resume"
            },
            "branch_review_commit": {
              "$ref": "#/$defs/sha"
            },
            "delivery_key": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "task_id",
                "lifecycle_generation",
                "delivery_id"
              ],
              "properties": {
                "task_id": {
                  "type": "string",
                  "minLength": 1
                },
                "lifecycle_generation": {
                  "type": "integer",
                  "minimum": 0
                },
                "delivery_id": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      ]
    }
  }
}
