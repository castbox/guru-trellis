{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-merge-task-delivery-private-gate-delivery-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_id",
    "public_input",
    "semantic_review",
    "pre_merge_facts",
    "action_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "skill_id": {
      "const": "guru-merge-task-delivery"
    },
    "public_input": {
      "$ref": "public-delivery-ready-for-merge-input-1.0.schema.json"
    },
    "semantic_review": {
      "$ref": "semantic-review.schema.json"
    },
    "pre_merge_facts": {
      "$ref": "delivery-live-facts-1.0.schema.json"
    },
    "action_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
