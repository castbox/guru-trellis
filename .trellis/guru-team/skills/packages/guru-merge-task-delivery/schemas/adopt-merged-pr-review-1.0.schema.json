{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-adopt-merged-pr-review-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reviewed_delivery_key",
    "reviewed_scope_ref",
    "reviewed_pr",
    "observed_checks",
    "ai_review_gate"
  ],
  "properties": {
    "reviewed_delivery_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "lifecycle_generation",
        "delivery_id"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle_generation": {
          "type": "integer",
          "minimum": 0
        },
        "delivery_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "reviewed_scope_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "anchors"
      ],
      "properties": {
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "locator",
            "revision"
          ],
          "properties": {
            "locator": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reviewed_pr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_ref",
        "pr_number",
        "head_sha",
        "merge_sha",
        "target_ref"
      ],
      "properties": {
        "repo_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "pr_number": {
          "type": "integer",
          "minimum": 1
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "merge_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "target_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observed_checks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ai_review_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "blocked"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
