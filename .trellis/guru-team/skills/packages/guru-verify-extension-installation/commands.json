{
  "schema_version": "1.0",
  "package_id": "guru-verify-extension-installation",
  "commands": [
    {
      "id": "show-extension-version",
      "owner": "guru-verify-extension-installation",
      "entrypoint": "runtime/check.py",
      "arguments": [
        {"flag": "--root", "required": false, "kind": "string", "description": "Repository root or a path below it.", "repeatable": false, "conflicts": []}
      ],
      "stdin": "none",
      "stdout": "single_json_object",
      "errors": ["invalid_arguments", "conflicting_arguments", "internal_error"],
      "side_effect": "repo_read",
      "schema_bindings": [],
      "validator_id": "extension_version_projection",
      "runtime_role": "check"
    },
    {
      "id": "execute-extension-verification",
      "owner": "guru-verify-extension-installation",
      "entrypoint": "runtime/execute.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Source root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--input",
          "required": true,
          "kind": "json",
          "description": "Standalone input.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--capability",
          "required": true,
          "kind": "enum",
          "values": [
            "marketplace_index",
            "new_repo_init",
            "existing_repo_preview_switch",
            "preset_initial_apply",
            "preset_reapply",
            "trellis_update_reapply",
            "managed_conflict_sidecars",
            "skill_contract_discovery",
            "platform_equality",
            "ownership_inventory",
            "readme_commands",
            "redaction"
          ],
          "description": "Capability.",
          "repeatable": true,
          "conflicts": []
        }
      ],
      "stdin": "optional_json",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "source_verification_failed",
        "internal_error"
      ],
      "side_effect": "git_write",
      "schema_bindings": [
        "schemas/public-source-repository-verification-input.schema.json"
      ],
      "validator_id": "verification_executor",
      "runtime_role": "execute"
    },
    {
      "id": "record-extension-verification",
      "owner": "guru-verify-extension-installation",
      "entrypoint": "runtime/record.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Source root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--input",
          "required": true,
          "kind": "json",
          "description": "Standalone input.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--execution-input",
          "required": true,
          "kind": "json",
          "description": "Execution facts.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--review-input",
          "required": true,
          "kind": "json",
          "description": "Semantic review.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "optional_json",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "source_verification_failed",
        "internal_error"
      ],
      "side_effect": "runtime_write",
      "schema_bindings": [
        "schemas/verification-result-5.0.schema.json"
      ],
      "validator_id": "verification_recorder",
      "runtime_role": "record"
    },
    {
      "id": "check-extension-verification",
      "owner": "guru-verify-extension-installation",
      "entrypoint": "runtime/check.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Source root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--input",
          "required": true,
          "kind": "json",
          "description": "Owner result.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--public-input",
          "required": false,
          "kind": "json",
          "description": "Public input.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "optional_json",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "source_verification_failed",
        "internal_error"
      ],
      "side_effect": "git_read",
      "schema_bindings": [
        "schemas/verification-result-5.0.schema.json"
      ],
      "validator_id": "verification_checker",
      "runtime_role": "check"
    },
    {
      "id": "invoke-extension-verification",
      "owner": "guru-verify-extension-installation",
      "entrypoint": "runtime/invoke.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Source root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--input",
          "required": true,
          "kind": "json",
          "description": "Standalone input.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--owner-result",
          "required": true,
          "kind": "json",
          "description": "Owner result.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "optional_json",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "source_verification_failed",
        "internal_error"
      ],
      "side_effect": "runtime_write",
      "schema_bindings": [
        "schemas/public-invocation-error.schema.json"
      ],
      "validator_id": "public_invocation",
      "runtime_role": "invoke"
    },
    {
      "id": "verify-extension-content-identity",
      "owner": "guru-verify-extension-installation",
      "entrypoint": "runtime/check.py",
      "arguments": [
        {"flag": "--root", "required": false, "kind": "string", "description": "Repository root.", "repeatable": false, "conflicts": []},
        {"flag": "--commit", "required": false, "kind": "string", "description": "Git commit; defaults to HEAD.", "repeatable": false, "conflicts": []},
        {"flag": "--include-worktree", "required": false, "kind": "boolean", "description": "Overlay current worktree state.", "repeatable": false, "conflicts": []}
      ],
      "stdin": "none",
      "stdout": "single_json_object",
      "errors": ["invalid_arguments", "conflicting_arguments", "source_verification_failed", "internal_error"],
      "side_effect": "none",
      "schema_bindings": ["schemas/reviewed-content-identity-output.schema.json"],
      "validator_id": "reviewed_content_identity",
      "runtime_role": "check"
    }
  ]
}
