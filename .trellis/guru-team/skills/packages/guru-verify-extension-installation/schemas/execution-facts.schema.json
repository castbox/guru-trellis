{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-extension-verify-installation-execution-facts-4.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_repository", "extension_source", "status", "commands", "capabilities", "asset_expectations", "asset_digests", "asset_inventory", "ownership", "sidecars"],
  "properties": {
    "schema_version": {"const": "4.0"},
    "target_repository": {"$ref": "marketplace-verification.schema.json#/$defs/targetRepository"},
    "extension_source": {"$ref": "marketplace-verification.schema.json#/$defs/extensionSource"},
    "status": {"enum": ["not_run", "passed", "failed", "blocked"]},
    "commands": {"type": "array", "items": {"$ref": "marketplace-verification.schema.json#/$defs/command"}},
    "capabilities": {"type": "array", "items": {"$ref": "marketplace-verification.schema.json#/$defs/capabilityFact"}},
    "asset_expectations": {"type": "array", "uniqueItems": true, "items": {"$ref": "marketplace-verification.schema.json#/$defs/assetExpectation"}},
    "asset_digests": {"type": "array", "uniqueItems": true, "items": {"$ref": "marketplace-verification.schema.json#/$defs/assetDigest"}},
    "asset_inventory": {"$ref": "marketplace-verification.schema.json#/$defs/assetInventory"},
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkout_owner", "current_contract", "schema_version", "inventory_id", "guru_owned_rule_count", "managed_claim_count"],
      "properties": {
        "checkout_owner": {"const": "extension_source_checkout"},
        "current_contract": {"type": "boolean"},
        "schema_version": {"enum": ["3.0", null]},
        "inventory_id": {"enum": ["guru-team-upstream-ownership", null]},
        "guru_owned_rule_count": {"type": "integer", "minimum": 0},
        "managed_claim_count": {"type": "integer", "minimum": 0}
      }
    },
    "sidecars": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkout_owner", "paths"],
      "properties": {
        "checkout_owner": {"const": "extension_source_checkout"},
        "paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
