{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-merge-task-pr-workflow-merged-input-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["exit_id", "repo_ref", "pr_number", "pr_url", "merge_commit_sha"],
  "properties": {
    "exit_id": {"const": "merged"},
    "repo_ref": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "pr_number": {"type": "integer", "minimum": 1},
    "pr_url": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[1-9][0-9]*$"},
    "merge_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
