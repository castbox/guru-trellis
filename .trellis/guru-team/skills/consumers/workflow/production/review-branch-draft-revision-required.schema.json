{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-workflow-review-branch-draft-revision-required-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_ref",
    "delivery_key",
    "revision_refs"
  ],
  "properties": {
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "delivery_key": {
      "type": "object"
    },
    "revision_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
