{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-stage0-transition-readiness-current-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transition_id", "stage", "mode", "repo_locator", "base", "target_locator", "continuation_id", "clarity_result_sha256", "wording_facts_sha256", "readiness_facts_sha256", "readiness_linkage_sha256", "target_content_sha256", "clarity", "wording", "readiness", "target", "target_disposition", "scope"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "transition_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]+$"},
    "stage": {"const": "readiness_current"},
    "mode": {"enum": ["workflow", "standalone"]},
    "repo_locator": {"type": "string", "minLength": 1},
    "base": {"$ref": "#/$defs/base"},
    "target_locator": {"type": "string", "minLength": 1},
    "continuation_id": {"type": "string", "minLength": 1},
    "clarity_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "wording_facts_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "readiness_facts_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "readiness_linkage_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "clarity": {"$ref": "#/$defs/clarity"},
    "wording": {"$ref": "#/$defs/wording"},
    "readiness": {"$ref": "#/$defs/readiness"},
    "target": {"$ref": "#/$defs/target"},
    "target_disposition": {"$ref": "#/$defs/targetDisposition"},
    "scope": {"$ref": "#/$defs/scope"}
  },
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "clarity": {
      "type": "object", "additionalProperties": false,
      "required": ["facts_sha256", "target_sha256", "disposition_sha256", "content_sha256", "scope_sha256"],
      "properties": {"facts_sha256": {"$ref": "#/$defs/sha256"}, "target_sha256": {"$ref": "#/$defs/sha256"}, "disposition_sha256": {"$ref": "#/$defs/sha256"}, "content_sha256": {"$ref": "#/$defs/sha256"}, "scope_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "wording": {
      "type": "object", "additionalProperties": false,
      "required": ["facts_sha256", "scope_sha256", "scan_sha256", "target_content_sha256"],
      "properties": {"facts_sha256": {"$ref": "#/$defs/sha256"}, "scope_sha256": {"$ref": "#/$defs/sha256"}, "scan_sha256": {"$ref": "#/$defs/sha256"}, "target_content_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "readiness": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_sha256", "facts_sha256", "content_sha256", "linkage_sha256"],
      "properties": {"payload_sha256": {"$ref": "#/$defs/sha256"}, "facts_sha256": {"$ref": "#/$defs/sha256"}, "content_sha256": {"$ref": "#/$defs/sha256"}, "linkage_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "targetDisposition": {
      "type": "object", "additionalProperties": false,
      "required": ["disposition_sha256", "duplicate_facts_sha256"],
      "properties": {"disposition_sha256": {"$ref": "#/$defs/sha256"}, "duplicate_facts_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["close_issues", "related_issues", "followup_issues"],
      "properties": {
        "close_issues": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "related_issues": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "followup_issues": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "target": {
      "oneOf": [
        {"$ref": "#/$defs/existingIssueTarget"},
        {"$ref": "#/$defs/proposedDraftTarget"},
        {"$ref": "#/$defs/standaloneRequestTarget"}
      ]
    },
    "existingIssueTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "repo", "issue_number", "url", "updated_at", "title_sha256", "body_sha256", "identity_sha256", "content_sha256"],
      "properties": {
        "kind": {"const": "existing_issue"},
        "repo": {"type": "string", "minLength": 3},
        "issue_number": {"type": "integer", "minimum": 1},
        "url": {"type": "string", "minLength": 1},
        "updated_at": {"type": "string", "format": "date-time"},
        "title_sha256": {"$ref": "#/$defs/sha256"},
        "body_sha256": {"$ref": "#/$defs/sha256"},
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "proposedDraftTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "repo", "draft_id", "source_request_sha256", "title_sha256", "body_sha256", "identity_sha256", "content_sha256"],
      "properties": {
        "kind": {"const": "proposed_draft"},
        "repo": {"type": "string", "minLength": 3},
        "draft_id": {"type": "string", "minLength": 1},
        "source_request_sha256": {"$ref": "#/$defs/sha256"},
        "title_sha256": {"$ref": "#/$defs/sha256"},
        "body_sha256": {"$ref": "#/$defs/sha256"},
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "standaloneRequestTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "repo", "caller_locator", "request_id", "source_request_sha256", "title_sha256", "body_sha256", "identity_sha256", "content_sha256"],
      "properties": {
        "kind": {"const": "standalone_request"},
        "repo": {"type": "string", "minLength": 3},
        "caller_locator": {"type": "string", "minLength": 1},
        "request_id": {"type": "string", "minLength": 1},
        "source_request_sha256": {"$ref": "#/$defs/sha256"},
        "title_sha256": {"$ref": "#/$defs/sha256"},
        "body_sha256": {"$ref": "#/$defs/sha256"},
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "selected_base", "remote", "ordered_candidates", "decision_head", "local_base_head", "remote_base_head", "post_sync_resolution_sha256"],
      "properties": {
        "source": {"enum": ["explicit", "config", "config-candidate", "remote-default"]},
        "selected_base": {"type": "string", "minLength": 1},
        "remote": {"type": "string", "minLength": 1},
        "ordered_candidates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "decision_head": {"$ref": "#/$defs/sha40"},
        "local_base_head": {"$ref": "#/$defs/sha40"},
        "remote_base_head": {"$ref": "#/$defs/sha40"},
        "post_sync_resolution_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
