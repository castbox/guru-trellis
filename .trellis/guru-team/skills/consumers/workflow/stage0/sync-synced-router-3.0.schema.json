{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-stage0-sync-base-output-synced-3.0-router",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "handoff_profile",
    "handoff_mode",
    "handoff_repo_locator",
    "handoff_base_branch",
    "handoff_continuation_id",
    "transition"
  ],
  "properties": {
    "exit_id": {
      "const": "synced"
    },
    "handoff_profile": {
      "const": "pre_task",
      "enum": [
        "pre_task",
        "context_request",
        "existing_issue_intake"
      ]
    },
    "handoff_mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "handoff_repo_locator": {
      "type": "string",
      "minLength": 1
    },
    "handoff_base_branch": {
      "type": "string",
      "minLength": 1
    },
    "handoff_continuation_id": {
      "type": "string",
      "minLength": 1
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "transition_id",
        "stage",
        "mode",
        "repo_locator",
        "base"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "transition_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]+$"
        },
        "stage": {
          "const": "base_current"
        },
        "mode": {
          "enum": [
            "workflow",
            "standalone"
          ]
        },
        "repo_locator": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "selected_base",
            "remote",
            "ordered_candidates",
            "decision_head",
            "local_base_head",
            "remote_base_head",
            "post_sync_resolution_sha256"
          ],
          "properties": {
            "source": {
              "enum": [
                "explicit",
                "config",
                "config-candidate",
                "remote-default"
              ]
            },
            "selected_base": {
              "type": "string",
              "minLength": 1
            },
            "remote": {
              "type": "string",
              "minLength": 1
            },
            "ordered_candidates": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "decision_head": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "local_base_head": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "remote_base_head": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "post_sync_resolution_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "return_identity": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "guru-issue-baseline-return-1.0",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "issue",
        "continuation_id"
      ],
      "properties": {
        "profile": {
          "const": "existing_issue_intake"
        },
        "issue": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "guru-issue-review-issue-1.0",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo_ref",
            "number"
          ],
          "properties": {
            "repo_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "number": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "continuation_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "handoff_profile": {
            "const": "existing_issue_intake"
          }
        }
      },
      "then": {
        "required": [
          "return_identity"
        ],
        "properties": {
          "return_identity": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "guru-issue-baseline-return-1.0",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profile",
              "issue",
              "continuation_id"
            ],
            "properties": {
              "profile": {
                "const": "existing_issue_intake"
              },
              "issue": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "$id": "guru-issue-review-issue-1.0",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "repo_ref",
                  "number"
                ],
                "properties": {
                  "repo_ref": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                  },
                  "number": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "continuation_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "return_identity": {}
        }
      }
    }
  ]
}
