{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-production-review-task-publication-input-archived-publication-review-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "task_ref",
    "branch_review_commit",
    "pr_payload_snapshot_sha256",
    "reviewed_base_head"
  ],
  "properties": {
    "profile": {
      "const": "archived_publication_review"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/archive/[0-9]{4}-[0-9]{2}/[A-Za-z0-9._-]+$"
    },
    "branch_review_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "pr_payload_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewed_base_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
