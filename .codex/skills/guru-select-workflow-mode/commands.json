{
  "schema_version": "1.0",
  "package_id": "guru-select-workflow-mode",
  "commands": [
    {
      "id": "check-workflow-environment",
      "owner": "guru-select-workflow-mode",
      "entrypoint": "runtime/check.py",
      "arguments": [
        {"flag": "--root", "required": false, "kind": "string", "description": "Repository root or a path below it.", "repeatable": false, "conflicts": []}
      ],
      "stdin": "none",
      "stdout": "single_json_object",
      "errors": ["invalid_arguments", "conflicting_arguments", "environment_unavailable", "internal_error"],
      "side_effect": "github_read",
      "schema_bindings": [],
      "validator_id": "workflow_environment_checker",
      "runtime_role": "check"
    },
    {
      "id": "invoke-guru-select-workflow-mode",
      "owner": "guru-select-workflow-mode",
      "entrypoint": "runtime/invoke.py",
      "arguments": [
        {
          "flag": "--invocation",
          "required": false,
          "kind": "json",
          "description": "Call-local invocation envelope or dash for stdin.",
          "repeatable": false,
          "conflicts": [
            "--input",
            "--owner-result"
          ]
        },
        {
          "flag": "--input",
          "required": false,
          "kind": "string",
          "description": "Public input JSON locator.",
          "repeatable": false,
          "conflicts": [
            "--invocation"
          ]
        },
        {
          "flag": "--owner-result",
          "required": false,
          "kind": "string",
          "description": "Completed owner result JSON locator.",
          "repeatable": false,
          "conflicts": [
            "--invocation"
          ]
        }
      ],
      "stdin": "optional_json",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "none",
      "schema_bindings": [],
      "validator_id": "public_invocation",
      "runtime_role": "invoke"
    }
  ]
}
