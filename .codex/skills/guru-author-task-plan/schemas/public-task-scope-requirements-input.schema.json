{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-author-task-plan-input-task-scope-requirements-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "task_ref",
    "source_selection",
    "revision_refs"
  ],
  "properties": {
    "profile": {
      "const": "task_scope_requirements"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "task_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_selection": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locator",
          "section",
          "authority_kind"
        ],
        "properties": {
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "authority_kind": {
            "enum": [
              "requirement",
              "design_constraint",
              "advisory"
            ]
          }
        }
      }
    },
    "revision_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
