{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-author-task-plan-output-requirements-ready-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "task_ref",
    "candidate"
  ],
  "properties": {
    "exit_id": {
      "const": "requirements_ready"
    },
    "task_ref": {
      "type": "string",
      "minLength": 1
    },
    "candidate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "design_facts",
            "constraint_refs"
          ],
          "properties": {
            "design_facts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "constraint_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "design_locator"
          ],
          "properties": {
            "design_locator": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
