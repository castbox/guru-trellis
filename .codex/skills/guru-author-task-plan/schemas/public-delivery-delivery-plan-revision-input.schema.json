{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-author-task-plan-input-delivery-delivery-plan-revision-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "task_ref",
    "revision_reason",
    "revision_refs",
    "delivery_key"
  ],
  "properties": {
    "profile": {
      "const": "delivery_delivery_plan_revision"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "task_ref": {
      "type": "string",
      "minLength": 1
    },
    "revision_reason": {
      "const": "delivery_policy_gap"
    },
    "revision_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "delivery_key": {
      "type": "object",
      "description": "Opaque upstream DeliveryKey; only the installed public parser validates identity and relationship."
    }
  }
}
