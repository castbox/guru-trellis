      "path": "schemas/public-invocation-error.schema.json"
    },
    {
      "id": "public_plan_ready_output",
      "path": "schemas/public-plan-ready-output.schema.json"
    },
    {
      "id": "public_requirements_ready_output",
      "path": "schemas/public-requirements-ready-output.schema.json"
    },
    {
      "id": "public_requirements_revision_input",
      "path": "schemas/public-requirements-revision-input.schema.json"
    },
    {
      "id": "public_solution_planning_input",
      "path": "schemas/public-solution-planning-input.schema.json"
    },
    {
      "id": "public_wording_reentry_input",
      "path": "schemas/public-wording-reentry-input.schema.json"
    },
    {
      "id": "semantic_result",
      "path": "schemas/semantic-result.schema.json"
    }
  ],
  "validators": [
    {
      "id": "public_invocation",
      "command": "scripts/invoke.sh",
      "runtime_command": "invoke-guru-author-task-plan",
      "objective_scope": "Validate a closed profile, exact call-local owner binding, live task status, current regular files and one minimal handoff; never write business planning or decide semantic routes."
    }
  ],
  "external_exits": [
    {
      "id": "requirements_ready",
      "evidence": "AI-reviewed current requirements-ready handoff",
      "consumer": {
        "kind": "workflow",
        "id": "guru-task-plan-requirements-ready-router"
      }
    },
    {
      "id": "plan_ready",
      "evidence": "AI-reviewed current plan-ready handoff",
      "consumer": {
        "kind": "workflow",
        "id": "guru-task-plan-ready-router"
      }
    },
    {
      "id": "clarify_scope",
      "evidence": "AI-reviewed current clarify-scope handoff",
      "consumer": {
        "kind": "workflow",
        "id": "guru-task-plan-clarify-scope-router"
      }
    },
    {
      "id": "blocked",
      "evidence": "AI-reviewed current blocked handoff",
      "consumer": {
        "kind": "stop",
        "id": "task-plan-author-blocked"
      }
    }
  ],
  "reentry": {
    "identity": "current TaskId/generation, source authority, profile and affected planning dependency",
    "freshness": "reread current source and earliest affected producer; never infer approval from files",
    "stale_behavior": "fail_closed"
  },
  "tests": [
    "tests/test_contract.py",
    "tests/test_runtime.py",
    "tests/test_planning_chain.py"
  ],
  "platform_destinations": [
    "shared",
    "claude",
    "cursor",
    "opencode",
    "codex",
    "kilo",
    "kiro",
    "gemini",
    "antigravity",
