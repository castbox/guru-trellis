    },
    {
      "id": "public_delivery_plan_revision_input",
      "path": "examples/public-delivery-plan-revision-input.json"
    },
    {
      "id": "public_initial_review_input",
      "path": "examples/public-initial-review-input.json"
    },
    {
      "id": "public_invocation_error",
      "path": "examples/public-invocation-error.json"
    },
    {
      "id": "public_plan_ready_output",
      "path": "examples/public-plan-ready-output.json"
    },
    {
      "id": "public_requirements_ready_output",
      "path": "examples/public-requirements-ready-output.json"
    },
    {
      "id": "public_requirements_revision_input",
      "path": "examples/public-requirements-revision-input.json"
    },
    {
      "id": "public_solution_planning_input",
      "path": "examples/public-solution-planning-input.json"
    },
    {
      "id": "public_wording_reentry_input",
      "path": "examples/public-wording-reentry-input.json"
    },
    {
      "id": "semantic_result",
      "path": "examples/semantic-result.json"
    }
  ],
  "schemas": [
    {
      "id": "public_active_task_scope_change_input",
      "path": "schemas/public-active-task-scope-change-input.schema.json"
    },
    {
      "id": "public_approval_revision_input",
