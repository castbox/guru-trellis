{
  "$schema": "../../schemas/skill-interface-1.6.schema.json",
  "schema_version": "1.6",
  "id": "guru-author-task-plan",
  "name": "guru-author-task-plan",
  "description": "Author current task planning through source-design convergence, candidate Architecture assessment, and eight closed revision profiles.",
  "state": "active",
  "judgment_mode": "semantic",
  "modes": {
    "workflow": {
      "routing": "global_workflow",
      "entry_precondition_ids": [
        "current_task",
        "current_authority"
      ]
    },
    "standalone": {
      "routing": "direct_discovery",
      "entry_precondition_ids": [
        "current_task",
        "current_authority"
      ]
    }
  },
  "entry_preconditions": [
    {
      "id": "current_task",
      "evidence": "current official task, C3/C4 checkout and source route",
      "binding": "one live TaskId/generation/task_ref",
      "freshness": "reread before every write and invocation"
    },
    {
      "id": "current_authority",
      "evidence": "fresh source selection, repository authority and current producer output",
      "binding": "selected profile and affected dependency",
      "freshness": "lost or changed upstream output re-enters its original owner"
    }
  ],
  "runtime_dependency": {
    "extension_id": "guru-team",
    "api_version": "1.0",
    "manifest_path": ".trellis/guru-team/extension.json",
    "dispatcher": "run-skill-command",
    "distribution": "guru-team-preset",
    "package_portability": "not-self-contained"
  },
  "ordered_stages": [
    "forward_behavior",
    "ai_review_gate",
    "conditional_human_confirmation",
    "recorder_validator",
    "typed_exit"
  ],
  "artifacts": [
    {
      "id": "public_active_task_scope_change_input",
      "path": "examples/public-active-task-scope-change-input.json"
    },
    {
      "id": "public_approval_revision_input",
      "path": "examples/public-approval-revision-input.json"
    },
    {
      "id": "public_architecture_conflict_resolution_input",
      "path": "examples/public-architecture-conflict-resolution-input.json"
    },
    {
      "id": "public_blocked_output",
      "path": "examples/public-blocked-output.json"
    },
    {
