{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"guru-review-task-delivery-semantic-result-1.0",
  "type":"object",
  "additionalProperties":false,
  "required":["profile","mode","delivery_policy","pr_payload","remaining_work_state","candidate_classifications","dimensions","findings","scope_proposals","conclusions","route"],
  "properties":{
    "profile":{"const":"delivery_review"},
    "mode":{"enum":["workflow","standalone"]},
    "delivery_policy":{
      "type":"object","additionalProperties":false,
      "required":["task_scope_refs","delivery_slice_refs","remaining_work_refs","independent_delivery_conditions","validation_boundaries","followup_owner"],
      "properties":{
        "task_scope_refs":{"$ref":"#/$defs/nonEmptyUniqueStrings"},
        "delivery_slice_refs":{"$ref":"#/$defs/nonEmptyUniqueStrings"},
        "remaining_work_refs":{"$ref":"#/$defs/uniqueStrings"},
        "independent_delivery_conditions":{"$ref":"#/$defs/nonEmptyUniqueStrings"},
        "validation_boundaries":{"$ref":"#/$defs/nonEmptyUniqueStrings"},
        "followup_owner":{"type":"string","minLength":1}
      }
    },
    "pr_payload":{
      "type":"object","additionalProperties":false,"required":["title","body"],
      "properties":{"title":{"type":"string","minLength":1},"body":{"type":"string","minLength":1}}
    },
    "remaining_work_state":{"enum":["none","remaining"]},
    "candidate_classifications":{
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["candidate_ref","decision","witness","consumer_use"],
        "properties":{
          "candidate_ref":{"type":"string","minLength":1},
          "decision":{"enum":["qualified_current","qualified_explicit_nonstandard","qualified_approved_expansion","rejected_no_authority","rejected_unsupported_entry","rejected_not_reproduced","rejected_out_of_scope"]},
          "witness":{
            "type":"object","additionalProperties":false,
            "required":["requirement_refs","supported_entry_refs","existing_caller_refs","honest_action_sequence","defect_observation","excluded_assumptions"],
            "properties":{
              "requirement_refs":{"$ref":"#/$defs/nonEmptyUniqueStrings"},
              "supported_entry_refs":{"$ref":"#/$defs/nonEmptyUniqueStrings"},
              "existing_caller_refs":{"$ref":"#/$defs/nonEmptyUniqueStrings"},
              "honest_action_sequence":{"$ref":"#/$defs/nonEmptyUniqueStrings"},
              "defect_observation":{"type":"string","minLength":1},
              "excluded_assumptions":{"$ref":"#/$defs/uniqueStrings"}
            }
          },
          "consumer_use":{"const":"delivery_review_route_checker"}
        }
      }
    },
    "dimensions":{
      "type":"array","minItems":10,"maxItems":10,
      "items":{"$ref":"#/$defs/judgment"}
    },
    "findings":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["finding_ref","candidate_ref","dimension","summary","evidence_refs","route_class","status","closure_evidence"],
        "properties":{
          "finding_ref":{"type":"string","minLength":1},
          "candidate_ref":{"type":"string","minLength":1},
          "dimension":{"type":"string","minLength":1},
          "summary":{"type":"string","minLength":1},
          "evidence_refs":{"$ref":"#/$defs/nonEmptyUniqueStrings"},
          "route_class":{"enum":["planning_revision","implementation","external_blocker"]},
          "status":{"enum":["open","closed"]},
          "closure_evidence":{"$ref":"#/$defs/uniqueStrings"}
        }
      }
    },
    "scope_proposals":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["proposal_ref","candidate_ref","summary","evidence_refs","status"],
        "properties":{
          "proposal_ref":{"type":"string","minLength":1},
          "candidate_ref":{"type":"string","minLength":1},
          "summary":{"type":"string","minLength":1},
          "evidence_refs":{"$ref":"#/$defs/nonEmptyUniqueStrings"},
          "status":{"enum":["open","closed"]}
        }
      }
    },
    "conclusions":{
      "type":"object","additionalProperties":false,
      "required":["delivery_readiness","docs_rdt_architecture","safety_deployment"],
      "properties":{
        "delivery_readiness":{"$ref":"#/$defs/judgment"},
        "docs_rdt_architecture":{"$ref":"#/$defs/judgment"},
        "safety_deployment":{"$ref":"#/$defs/judgment"}
      }
    },
    "route":{
      "oneOf":[
        {"type":"object","additionalProperties":false,"required":["typed_exit"],"properties":{"typed_exit":{"const":"ready"}}},
        {"type":"object","additionalProperties":false,"required":["typed_exit"],"properties":{"typed_exit":{"const":"planning_revision_required"}}},
        {"type":"object","additionalProperties":false,"required":["typed_exit"],"properties":{"typed_exit":{"const":"implementation_required"}}},
        {"type":"object","additionalProperties":false,"required":["typed_exit"],"properties":{"typed_exit":{"const":"scope_confirmation_required"}}},
        {"type":"object","additionalProperties":false,"required":["typed_exit","reason_code","remediation"],"properties":{"typed_exit":{"const":"blocked"},"reason_code":{"type":"string","pattern":"^[a-z][a-z0-9_]{1,63}$"},"remediation":{"type":"string","minLength":1}}}
      ]
    }
  },
  "$defs":{
    "uniqueStrings":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "nonEmptyUniqueStrings":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "judgment":{
      "type":"object","additionalProperties":false,
      "required":["id","status","summary","evidence_refs"],
      "properties":{"id":{"type":"string","minLength":1},"status":{"enum":["passed","finding","blocked"]},"summary":{"type":"string","minLength":1},"evidence_refs":{"$ref":"#/$defs/nonEmptyUniqueStrings"}}
    }
  }
}
