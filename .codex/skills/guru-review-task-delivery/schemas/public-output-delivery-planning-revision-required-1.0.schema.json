{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-review-task-delivery-output-delivery-planning-revision-required-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "task_ref",
    "reason_refs",
    "delivery_key"
  ],
  "properties": {
    "exit_id": {
      "const": "planning_revision_required"
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "reason_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "delivery_key": {
      "type": "object"
    }
  }
}
