{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-consumer-guru-review-task-completion-blocked-delivery-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "reason"
  ],
  "properties": {
    "exit_id": {
      "const": "blocked"
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_code",
        "reason_refs"
      ],
      "properties": {
        "reason_code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "reason_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
