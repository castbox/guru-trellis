{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-review-task-completion-input-delivery-evidence-refresh-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "task_ref",
    "task_key",
    "source_exit",
    "reason"
  ],
  "properties": {
    "profile": {
      "const": "delivery_evidence_refresh"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "task_ref": {
      "type": "string",
      "minLength": 1
    },
    "task_key": {
      "type": "object"
    },
    "source_exit": {
      "enum": [
        "evidence_pending",
        "reactivated_to_evidence_refresh"
      ]
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_code",
        "reason_refs"
      ],
      "properties": {
        "reason_code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "reason_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
