{
  "$schema":"../../schemas/skill-interface-1.4.schema.json","schema_version":"1.4","id":"guru-reconcile-task-base","name":"guru-reconcile-task-base","description":"Reconcile one exact active-task and evolved-base pair through a semantic impact review, controlled integration evidence, and six typed exits.","state":"active","judgment_mode":"semantic",
