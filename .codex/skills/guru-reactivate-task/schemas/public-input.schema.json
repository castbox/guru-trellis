{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-reactivate-task-input-delivery-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "archived_lifecycle"
  ],
  "properties": {
    "profile": {
      "const": "delivery_reactivate_completed_task"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "archived_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "lifecycle_generation"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "lifecycle_generation": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
