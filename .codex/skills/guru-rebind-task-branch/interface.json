{
  "$schema":"../../schemas/skill-interface-1.4.schema.json", "schema_version":"1.4",
  "id":"guru-rebind-task-branch", "name":"guru-rebind-task-branch",
  "description":"Rebind one active task branch at a reviewed clean and base-contained boundary, with exact read-only recovery.",
  "state":"active", "judgment_mode":"semantic",
  "modes":{
    "workflow":{"routing":"global_workflow","entry_precondition_ids":["current_task_binding","reviewed_target_base","call_local_plan"]},
    "standalone":{"routing":"direct_discovery","entry_precondition_ids":["current_task_binding","reviewed_target_base","call_local_plan"]}
  },
  "entry_preconditions":[
    {"id":"current_task_binding","evidence":"active TaskId and C4/C5 current branch ownership","binding":"one task generation and binding revision","freshness":"live control-state and Git reread"},
    {"id":"reviewed_target_base","evidence":"clean current checkout and selected base containing current HEAD","binding":"one reviewed target branch and base","freshness":"record and execution recheck"},
    {"id":"call_local_plan","evidence":"exact pre-mutation checkout snapshot and target branch","binding":"one rebind transaction or output-loss recovery","freshness":"execution re-prepares and recovery checks exact successor"}
  ],
  "runtime_dependency":{"extension_id":"guru-team","api_version":"1.0","manifest_path":".trellis/guru-team/extension.json","dispatcher":"run-skill-command","distribution":"guru-team-preset","package_portability":"not-self-contained"},
  "ordered_stages":["forward_behavior","ai_review_gate","conditional_human_confirmation","recorder_validator","typed_exit"],
  "artifacts":[
    {"id":"plan_request","path":"examples/public-plan-request.json"},{"id":"public_input","path":"examples/public-input.json"},
    {"id":"recover_input","path":"examples/public-recover-input.json"},{"id":"rebound_output","path":"examples/public-rebound-output.json"},
    {"id":"refresh_output","path":"examples/public-refresh-review-output.json"},
    {"id":"invalid_output","path":"examples/public-invalid-task-state-output.json"},
    {"id":"blocked_output","path":"examples/public-blocked-output.json"},
    {"id":"invocation_error","path":"examples/public-invocation-error.json"}
  ],
  "schemas":[
    {"id":"plan_request","path":"schemas/public-plan-request.schema.json"},{"id":"public_input","path":"schemas/public-input.schema.json"},
    {"id":"public_output","path":"schemas/public-output.schema.json"},{"id":"rebound_output","path":"schemas/public-rebound-output.schema.json"},
    {"id":"refresh_output","path":"schemas/public-refresh-review-output.schema.json"},
    {"id":"invalid_output","path":"schemas/public-invalid-task-state-output.schema.json"},
    {"id":"blocked_output","path":"schemas/public-blocked-output.schema.json"},
    {"id":"invocation_error","path":"schemas/public-invocation-error.schema.json"}
  ],
  "validators":[
    {"id":"plan_recorder","command":"scripts/record-plan.sh","runtime_command":"record-task-branch-rebind-plan","objective_scope":"Capture one clean, base-contained current checkout and target plan without mutation."},
    {"id":"rebind_executor","command":"scripts/rebind.sh","runtime_command":"rebind-task-branch","objective_scope":"Recheck and execute the reviewed C4/C5 rebind transaction."},
    {"id":"result_checker","command":"scripts/check-result.sh","runtime_command":"check-task-branch-rebind-result","objective_scope":"Read back one exact successor revision without mutation."},
    {"id":"result_recovery","command":"scripts/recover-result.sh","runtime_command":"recover-task-branch-rebind-result","objective_scope":"Recover lost output from the original plan without repeating a Git mutation."},
    {"id":"public_invocation","command":"scripts/invoke.sh","runtime_command":"invoke-guru-rebind-task-branch","objective_scope":"Serialize the reviewed execute or exact read-only recovery result."}
  ],
  "external_exits":[
    {"id":"rebound","evidence":"current branch and ownership advanced to the reviewed target","consumer":{"kind":"workflow","id":"guru-task-branch-rebound-router"}},
    {"id":"refresh_review","evidence":"selected base or recorded rebind plan is stale","consumer":{"kind":"workflow","id":"guru-task-branch-rebind-refresh-router"}},
    {"id":"invalid_task_state","evidence":"active TaskId or task artifact does not match the current generation","consumer":{"kind":"stop","id":"invalid-task-state"}},
    {"id":"blocked","evidence":"branch, checkout or ownership state prevents safe rebind or exact recovery","consumer":{"kind":"stop","id":"task-branch-rebind-blocked"}}
  ],
  "reentry":{"identity":"TaskId, generation, binding epoch and revision with original checkout snapshot","freshness":"execution re-prepares; recovery rereads successor without writing","stale_behavior":"fail_closed"},
  "tests":["tests/test_contract.py"],
  "platform_destinations":["shared","claude","cursor","opencode","codex","kilo","kiro","gemini","antigravity","devin","qoder","codebuddy","copilot","droid","dsh","pi","reasonix","zcode","trae","omp","grok","kimi","snow"],
  "public_contracts":{
    "input":{"kind":"structured_json","aggregate_schema":{"schema_id":"guru-rebind-task-branch-input-1.0","path":"schemas/public-input.schema.json"},"profiles":[
      {"id":"task_branch_rebind","schema":{"schema_id":"guru-rebind-task-branch-input-1.0","path":"schemas/public-input.schema.json"},"example":{"id":"public_input","path":"examples/public-input.json"},"discriminator":{"field":"profile","value":"task_branch_rebind"}}
    ]},
    "invocation":{"command_id":"run-skill-command","wrapper":"scripts/invoke.sh","input_binding":{"kind":"structured_json","profile_id":"task_branch_rebind"},"stdout_contract":"single_typed_exit","error_schema":{"schema_id":"guru-rebind-task-branch-error-1.0","path":"schemas/public-invocation-error.schema.json"},"error_example":{"id":"invocation_error","path":"examples/public-invocation-error.json"},"example_argv":["--input","examples/public-input.json"]},
    "outputs":[
      {"exit_id":"rebound","schema":{"schema_id":"guru-rebind-task-branch-rebound-1.0","path":"schemas/public-rebound-output.schema.json"},"example":{"id":"rebound_output","path":"examples/public-rebound-output.json"},"consumer_use_ids":["rebound_projection"]},
      {"exit_id":"refresh_review","schema":{"schema_id":"guru-rebind-task-branch-refresh-1.0","path":"schemas/public-refresh-review-output.schema.json"},"example":{"id":"refresh_output","path":"examples/public-refresh-review-output.json"},"consumer_use_ids":["refresh_projection"]},
      {"exit_id":"invalid_task_state","schema":{"schema_id":"guru-rebind-task-branch-invalid-1.0","path":"schemas/public-invalid-task-state-output.schema.json"},"example":{"id":"invalid_output","path":"examples/public-invalid-task-state-output.json"},"consumer_use_ids":["invalid_projection"]},
      {"exit_id":"blocked","schema":{"schema_id":"guru-rebind-task-branch-blocked-1.0","path":"schemas/public-blocked-output.schema.json"},"example":{"id":"blocked_output","path":"examples/public-blocked-output.json"},"consumer_use_ids":["blocked_projection"]}
    ],
    "consumer_inputs":[
      {"id":"rebound_input","consumer":{"kind":"workflow","id":"guru-task-branch-rebound-router"},"payload_kind":"structured_json","contract":{"kind":"json_schema","schema_id":"guru-task-rebound-input-1.0","path":"consumers/workflow/production/rebound.schema.json"}},
      {"id":"refresh_input","consumer":{"kind":"workflow","id":"guru-task-branch-rebind-refresh-router"},"payload_kind":"structured_json","contract":{"kind":"json_schema","schema_id":"guru-task-rebind-refresh-input-1.0","path":"consumers/workflow/production/refresh.schema.json"}},
      {"id":"invalid_input","consumer":{"kind":"stop","id":"invalid-task-state"},"payload_kind":"structured_json","contract":{"kind":"json_schema","schema_id":"guru-task-rebind-invalid-input-1.0","path":"consumers/stop/production/invalid.schema.json"}},
      {"id":"blocked_input","consumer":{"kind":"stop","id":"task-branch-rebind-blocked"},"payload_kind":"structured_json","contract":{"kind":"json_schema","schema_id":"guru-task-rebind-blocked-input-1.0","path":"consumers/stop/production/blocked.schema.json"}}
    ],
    "projections":[
      {"id":"rebound_projection","exit_id":"rebound","consumer_input_id":"rebound_input","operation":"direct"},
      {"id":"refresh_projection","exit_id":"refresh_review","consumer_input_id":"refresh_input","operation":"direct"},
      {"id":"invalid_projection","exit_id":"invalid_task_state","consumer_input_id":"invalid_input","operation":"direct"},
      {"id":"blocked_projection","exit_id":"blocked","consumer_input_id":"blocked_input","operation":"direct"}
    ],"private_artifacts":[]
  }
}
