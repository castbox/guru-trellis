{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-review-contract-wording-output-delivery-content-changed-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "profile",
    "delivery_key",
    "task_ref",
    "change_refs"
  ],
  "properties": {
    "exit_id": {
      "const": "content_changed"
    },
    "profile": {
      "const": "delivery_planning_artifacts"
    },
    "task_ref": {
      "type": "string",
      "minLength": 1
    },
    "delivery_key": {
      "type": "object",
      "description": "Opaque public DeliveryKey; the target upstream API validates it."
    },
    "change_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
