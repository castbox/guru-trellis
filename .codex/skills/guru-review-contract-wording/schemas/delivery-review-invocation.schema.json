{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-contract-wording-review-invocation-delivery-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "task_ref",
    "delivery_key",
    "owner_result"
  ],
  "properties": {
    "profile": {
      "const": "delivery_planning_artifacts"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "task_ref": {
      "type": "string",
      "minLength": 1
    },
    "delivery_key": {
      "type": "object",
      "description": "Opaque public DeliveryKey; the target upstream API validates it."
    },
    "owner_result": {
      "type": "object"
    }
  }
}
