{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-review-change-invocation-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "public_input",
    "owner_result"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "public_input": {
      "$ref": "public-input.schema.json"
    },
    "owner_result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exit_id",
            "snapshot"
          ],
          "properties": {
            "exit_id": {
              "const": "reviewed"
            },
            "snapshot": {
              "$ref": "snapshot.schema.json"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exit_id",
            "reason"
          ],
          "properties": {
            "exit_id": {
              "const": "blocked"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
