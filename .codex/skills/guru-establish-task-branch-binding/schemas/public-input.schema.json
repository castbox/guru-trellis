{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "guru-establish-task-branch-binding-input-1.0",
  "type": "object", "additionalProperties": false,
  "required": ["profile", "mode", "action", "task_id", "task_ref", "lifecycle_generation", "expected_status"],
  "properties": {
    "profile": {"const": "active_task"}, "mode": {"enum": ["workflow", "standalone"]},
    "action": {"enum": ["establish", "recover"]},
    "task_id": {"type": "string", "minLength": 1}, "task_ref": {"type": "string", "minLength": 1},
    "lifecycle_generation": {"type": "integer", "minimum": 0},
    "expected_status": {"enum": ["planning", "in_progress"]},
    "selected_candidate_id": {"type": "string", "minLength": 1},
    "expected_candidate_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "recovery": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_revision", "expected_branch_name", "expected_head"],
      "properties": {
        "expected_revision": {"type": "integer", "minimum": 0},
        "expected_branch_name": {"type": "string", "minLength": 1}, "expected_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"action": {"const": "recover"}}}, "then": {"required": ["recovery"], "properties": {"selected_candidate_id": false, "expected_candidate_head": false}}},
    {"if": {"properties": {"action": {"const": "establish"}}}, "then": {"properties": {"recovery": false}}}
  ]
}
