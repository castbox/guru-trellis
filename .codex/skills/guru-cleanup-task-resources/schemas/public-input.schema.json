{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "guru-cleanup-task-resources-input-2.0",
  "oneOf": [
    {"$ref": "#/$defs/normal"}, {"$ref": "#/$defs/manual"}, {"$ref": "#/$defs/handoff"}
  ],
  "$defs": {
    "taskId": {"type": "string", "pattern": "^(?!.*\\.\\.)(?!.*(?:\\.lock|\\.)$)[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "common": {"mode": {"enum": ["workflow", "standalone"]}, "task_id": {"$ref": "#/$defs/taskId"}, "lifecycle_generation": {"type": "integer", "minimum": 0}},
    "normal": {"type": "object", "additionalProperties": false, "required": ["profile", "mode", "task_id", "lifecycle_generation", "finish_result_id", "inventory_id"], "properties": {"profile": {"const": "normal"}, "mode": {"enum": ["workflow", "standalone"]}, "task_id": {"$ref": "#/$defs/taskId"}, "lifecycle_generation": {"type": "integer", "minimum": 0}, "finish_result_id": {"type": "string", "minLength": 1}, "inventory_id": {"type": "string", "minLength": 1}}},
    "manual": {"type": "object", "additionalProperties": false, "required": ["profile", "mode", "task_id", "lifecycle_generation", "finish_result_id", "cleanup_state", "selected_targets"], "properties": {"profile": {"const": "manual"}, "mode": {"enum": ["workflow", "standalone"]}, "task_id": {"$ref": "#/$defs/taskId"}, "lifecycle_generation": {"type": "integer", "minimum": 0}, "finish_result_id": {"type": "string", "minLength": 1}, "cleanup_state": {"const": "manual_cleanup_required"}, "selected_targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/target"}}}},
    "handoff": {"type": "object", "additionalProperties": false, "required": ["profile", "mode", "task_id", "lifecycle_generation", "handoff_inventory"], "properties": {"profile": {"const": "machine_handoff"}, "mode": {"enum": ["workflow", "standalone"]}, "task_id": {"$ref": "#/$defs/taskId"}, "lifecycle_generation": {"type": "integer", "minimum": 0}, "handoff_inventory": {"type": "object", "additionalProperties": false, "required": ["task_id", "lifecycle_generation", "handoff_id", "inventory_id"], "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "lifecycle_generation": {"type": "integer", "minimum": 0}, "handoff_id": {"type": "string", "minLength": 1}, "inventory_id": {"type": "string", "minLength": 1}}}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["resource_id", "kind", "portable_ref", "expected_cleanup_head"], "properties": {"resource_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["local_branch", "linked_worktree", "remote_branch"]}, "portable_ref": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["kind", "ref"], "properties": {"kind": {"const": "local_branch"}, "ref": {"type": "string", "pattern": "^refs/heads/"}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "branch_ref"], "properties": {"kind": {"const": "linked_worktree"}, "branch_ref": {"type": "string", "pattern": "^refs/heads/"}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "remote_name", "repository_ref", "ref"], "properties": {"kind": {"const": "remote_branch"}, "remote_name": {"type": "string", "minLength": 1}, "repository_ref": {"type": "string", "pattern": "^[^/]+/[^/]+$"}, "ref": {"type": "string", "pattern": "^refs/heads/"}}}]}, "expected_cleanup_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}}
  }
}
