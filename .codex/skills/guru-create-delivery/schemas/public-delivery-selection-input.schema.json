{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-create-delivery-input-delivery-selection-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "task_ref",
    "delivery_key"
  ],
  "properties": {
    "profile": {
      "const": "delivery_selection"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "task_ref": {
      "type": "string",
      "minLength": 1
    },
    "delivery_key": {
      "type": "object",
      "description": "Opaque upstream API 1.0 object; only the installed public parser validates this shape."
    }
  }
}
