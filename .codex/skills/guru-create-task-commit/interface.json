  "validators": [
    {
      "id": "candidate_builder",
      "command": "scripts/prepare-task-commit.sh",
      "runtime_command": "prepare-task-commit",
      "objective_scope": "Live task/Phase 2/Git projection, exact path-set derivation, structured message canonicalization, and shared parser validation before any confirmation"
    },
    {
      "id": "candidate_validator",
      "command": "scripts/check-task-commit-plan.sh",
      "runtime_command": "check-commit-messages",
      "objective_scope": "schema, live task/HEAD/Phase 2/snapshot identity and freshness, explicit rename/copy relations, independently classified copy sources, exact paths, and shared parser facts"
    },
    {
      "id": "exact_executor",
      "command": "scripts/create-task-commit.sh",
      "runtime_command": "create-task-commit",
      "objective_scope": "AI-reviewed ordinary/gitlink bindings with deletion inheritance limited to rename sources, isolated validation, standard conditional Git publication, raw commit postconditions, and private runtime cleanup"
    },
    {
      "id": "public_invocation",
      "command": "scripts/invoke.sh",
      "runtime_command": "invoke-guru-create-task-commit",
      "objective_scope": "Sole public entry: prepared Delivery candidate transaction or clean committed re-entry, typed-exit projection and same-commit stdout-loss recovery; legacy --invocation envelopes are retired"
    },
    {
      "id": "planning_source_migration",
      "command": "scripts/migrate-delivery-source.sh",
      "runtime_command": "migrate-task-commit-planning-source",
      "objective_scope": "Original owner reviewed Plan2 committed blob/mode relocation binding; no public gate or Git mutation."
    }
  ],
  "external_exits": [
    {
      "id": "committed",
      "evidence": "minimal committed DTO and current live Git HEAD",
      "consumer": {
        "kind": "skill",
        "id": "guru-review-branch"
      }
    },
    {
      "id": "revision-required",
      "evidence": "AI review or candidate validation revision evidence",
      "consumer": {
        "kind": "skill",
        "id": "guru-create-task-commit"
      }
    },
    {
      "id": "blocked",
      "evidence": "semantic conflict, dangerous operation, hook mutation or objective postcondition error",
      "consumer": {
        "kind": "stop",
        "id": "task-commit-blocked"
      }
    }
  ],
  "reentry": {
    "identity": "Delivery key, current Check result and candidate; dirty transaction also binds pre-commit HEAD",
    "freshness": "the current Delivery Check, candidate and live Git facts still match; dirty transactions also match the complete dirty snapshot",
    "stale_behavior": "fail_closed"
  },
  "tests": [
    "tests/test_contract.py",
    "tests/test_happy_path.py"
  ],
