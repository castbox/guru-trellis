          "description": "Repository root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--query-json",
          "required": false,
          "kind": "json",
          "description": "Canonical context query JSON.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--limit",
          "required": false,
          "kind": "string",
          "description": "Maximum result count.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "none",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "invalid_json",
        "schema_mismatch",
        "unsafe_path",
        "stale_identity",
        "internal_error"
      ],
      "side_effect": "git_read",
      "schema_bindings": [],
