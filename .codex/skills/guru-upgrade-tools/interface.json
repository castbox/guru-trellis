{
  "$schema": "../../schemas/skill-interface-1.6.schema.json",
  "schema_version": "1.6",
  "id": "guru-upgrade-tools",
  "name": "guru-upgrade-tools",
  "description": "Upgrade tools in one selected checkout from complete matching source, preserving all Task and session state with bounded same-operation recovery.",
  "state": "active",
  "judgment_mode": "semantic",
  "modes": {
    "workflow": {
      "routing": "not_applicable",
      "entry_precondition_ids": []
    },
    "standalone": {
      "routing": "direct_discovery",
      "entry_precondition_ids": [
        "target_source",
        "legacy_inventory",
        "reviewed_actions",
        "recovery_boundary"
      ]
    }
  },
  "entry_preconditions": [
    {
      "id": "target_source",
      "evidence": "Complete matching canonical source and public maintenance API1.0 with actual CLI/Core package identity.",
      "binding": "exact source and target checkout for this invocation",
      "freshness": "reread before preview, write, resume or rollback"
    },
    {
      "id": "legacy_inventory",
      "evidence": "Exact checkout, tools provenance, local edits, peer runtime pointers and unchanged Task/session state.",
      "binding": "exact source and target checkout for this invocation",
      "freshness": "reread before preview, write, resume or rollback"
    },
    {
      "id": "reviewed_actions",
      "evidence": "AI-owned exact tools/workflow/pointer decisions; dialogue-local confirmation is never serialized.",
      "binding": "exact source and target checkout for this invocation",
      "freshness": "reread before preview, write, resume or rollback"
    },
    {
      "id": "recovery_boundary",
      "evidence": "Fixed tool preimages and public operation reference; later owned work cannot be absorbed.",
      "binding": "exact source and target checkout for this invocation",
      "freshness": "reread before preview, write, resume or rollback"
    }
  ],
  "runtime_dependency": {
    "extension_id": "guru-team",
    "api_version": "1.0",
    "manifest_path": ".trellis/guru-team/extension.json",
    "dispatcher": "run-skill-command",
    "distribution": "guru-team-preset",
    "package_portability": "not-self-contained"
  },
  "ordered_stages": [
    "forward_behavior",
    "ai_review_gate",
    "conditional_human_confirmation",
    "recorder_validator",
    "typed_exit"
  ],
  "artifacts": [
    {
      "id": "public_blocked_output",
      "path": "examples/public-blocked-output.json"
    },
    {
      "id": "public_install_input",
      "path": "examples/public-install-input.json"
    },
    {
      "id": "public_invocation_error",
      "path": "examples/public-invocation-error.json"
    },
    {
      "id": "public_resume_input",
      "path": "examples/public-resume-input.json"
    },
    {
      "id": "public_resume_required_output",
      "path": "examples/public-resume_required-output.json"
    },
    {
      "id": "public_rollback_input",
      "path": "examples/public-rollback-input.json"
    },
    {
      "id": "public_rolled_back_output",
      "path": "examples/public-rolled_back-output.json"
    },
    {
      "id": "public_tools_upgraded_output",
      "path": "examples/public-tools_upgraded-output.json"
    }
  ],
  "schemas": [
    {
      "id": "private_plan_schema",
      "path": "schemas/private-plan.schema.json"
    },
    {
      "id": "private_prepare_schema",
      "path": "schemas/private-prepare.schema.json"
    },
    {
      "id": "private_recovery_schema",
      "path": "schemas/private-recovery.schema.json"
    },
    {
      "id": "public_blocked_output_schema",
      "path": "schemas/public-blocked-output.schema.json"
    },
    {
      "id": "public_input_schema",
      "path": "schemas/public-input.schema.json"
    },
    {
      "id": "public_install_input_schema",
      "path": "schemas/public-install-input.schema.json"
    },
    {
      "id": "public_invocation_error_schema",
      "path": "schemas/public-invocation-error.schema.json"
    },
    {
      "id": "public_resume_input_schema",
      "path": "schemas/public-resume-input.schema.json"
    },
    {
      "id": "public_resume_required_output_schema",
      "path": "schemas/public-resume_required-output.schema.json"
    },
    {
      "id": "public_rollback_input_schema",
      "path": "schemas/public-rollback-input.schema.json"
    },
    {
      "id": "public_rolled_back_output_schema",
      "path": "schemas/public-rolled_back-output.schema.json"
    },
    {
      "id": "public_tools_upgraded_output_schema",
      "path": "schemas/public-tools_upgraded-output.schema.json"
    }
  ],
  "validators": [
    {
      "id": "invoke",
      "command": "scripts/invoke.sh",
      "runtime_command": "invoke-guru-upgrade-tools",
      "objective_scope": "Read/execute exact reviewed single-checkout tools actions and fixed preimages; no task conversion or semantic pass."
    },
    {
      "id": "preview",
      "command": "scripts/preview.sh",
      "runtime_command": "preview-tools-upgrade",
      "objective_scope": "Read/execute exact reviewed single-checkout tools actions and fixed preimages; no task conversion or semantic pass."
    },
    {
      "id": "prepare",
      "command": "scripts/prepare.sh",
      "runtime_command": "prepare-tools-upgrade",
      "objective_scope": "Read/execute exact reviewed single-checkout tools actions and fixed preimages; no task conversion or semantic pass."
    }
  ],
  "external_exits": [
    {
      "id": "tools_upgraded",
      "evidence": "AI reviews actual tools/native facts and the declared boundaries before selecting this exit.",
      "consumer": {
        "kind": "stop",
        "id": "upgrade-tools-tools-upgraded"
      }
    },
    {
      "id": "resume_required",
      "evidence": "AI reviews actual tools/native facts and the declared boundaries before selecting this exit.",
      "consumer": {
        "kind": "skill",
        "id": "guru-upgrade-tools"
      }
    },
    {
      "id": "rolled_back",
      "evidence": "AI reviews actual tools/native facts and the declared boundaries before selecting this exit.",
      "consumer": {
        "kind": "stop",
        "id": "upgrade-tools-rolled-back"
      }
    },
    {
      "id": "blocked",
      "evidence": "AI reviews actual tools/native facts and the declared boundaries before selecting this exit.",
      "consumer": {
        "kind": "stop",
        "id": "upgrade-tools-blocked"
      }
    }
  ],
  "reentry": {
    "identity": "Exact source, selected checkout and original recovery_ref",
    "freshness": "Fixed original plan and preimages, matching source/runtime and unchanged owned bytes",
    "stale_behavior": "fail_closed"
  },
  "tests": [
    "tests/test_contract.py",
    "tests/test_recovery.py",
    "tests/test_native_install.py"
  ],
  "platform_destinations": [
    "shared",
    "claude",
    "cursor",
    "opencode",
    "codex",
    "kilo",
    "kiro",
    "gemini",
    "antigravity",
    "devin",
    "qoder",
    "codebuddy",
    "copilot",
    "droid",
    "dsh",
    "pi",
    "reasonix",
    "zcode",
    "trae",
    "omp",
    "grok",
    "kimi",
    "snow"
  ],
  "public_contracts": {
    "input": {
      "kind": "structured_json",
      "aggregate_schema": {
        "schema_id": "guru-upgrade-tools-input-aggregate-1.0",
        "path": "schemas/public-input.schema.json"
      },
      "profiles": [
        {
          "id": "install",
          "schema": {
            "schema_id": "guru-upgrade-tools-public-install-input-1.0",
            "path": "schemas/public-install-input.schema.json"
          },
          "example": {
            "id": "install_input",
            "path": "examples/public-install-input.json"
          },
          "discriminator": {
            "field": "profile",
            "value": "install"
          }
        },
        {
          "id": "resume",
          "schema": {
            "schema_id": "guru-upgrade-tools-public-resume-input-1.0",
            "path": "schemas/public-resume-input.schema.json"
          },
          "example": {
            "id": "resume_input",
            "path": "examples/public-resume-input.json"
          },
          "discriminator": {
            "field": "profile",
            "value": "resume"
          }
        },
        {
          "id": "rollback",
          "schema": {
            "schema_id": "guru-upgrade-tools-public-rollback-input-1.0",
            "path": "schemas/public-rollback-input.schema.json"
          },
          "example": {
            "id": "rollback_input",
            "path": "examples/public-rollback-input.json"
          },
          "discriminator": {
            "field": "profile",
            "value": "rollback"
          }
        }
      ]
    },
    "invocation": {
      "command_id": "run-skill-command",
      "wrapper": "scripts/invoke.sh",
      "input_binding": {
        "kind": "structured_json",
        "profile_selector": {
          "source": "aggregate_public_input",
          "field": "profile"
        }
      },
      "stdout_contract": "single_typed_exit",
      "error_schema": {
        "schema_id": "guru-upgrade-tools-public-invocation-error-1.0",
        "path": "schemas/public-invocation-error.schema.json"
      },
      "error_example": {
        "id": "invalid_public_input",
        "path": "examples/public-invocation-error.json"
      },
      "example_argv": [
        "--root",
        ".",
        "--input",
        "examples/public-install-input.json"
      ]
    },
    "outputs": [
      {
        "exit_id": "tools_upgraded",
        "schema": {
          "schema_id": "guru-upgrade-tools-public-tools_upgraded-output-1.0",
          "path": "schemas/public-tools_upgraded-output.schema.json"
        },
        "example": {
          "id": "tools_upgraded_output",
          "path": "examples/public-tools_upgraded-output.json"
        },
        "consumer_use_ids": [
          "project_tools_upgraded"
        ]
      },
      {
        "exit_id": "resume_required",
        "schema": {
          "schema_id": "guru-upgrade-tools-public-resume_required-output-1.0",
          "path": "schemas/public-resume_required-output.schema.json"
        },
        "example": {
          "id": "resume_required_output",
          "path": "examples/public-resume_required-output.json"
        },
        "consumer_use_ids": [
          "project_resume_required"
        ]
      },
      {
        "exit_id": "rolled_back",
        "schema": {
          "schema_id": "guru-upgrade-tools-public-rolled_back-output-1.0",
          "path": "schemas/public-rolled_back-output.schema.json"
        },
        "example": {
          "id": "rolled_back_output",
          "path": "examples/public-rolled_back-output.json"
        },
        "consumer_use_ids": [
          "project_rolled_back"
        ]
      },
      {
        "exit_id": "blocked",
        "schema": {
          "schema_id": "guru-upgrade-tools-public-blocked-output-1.0",
          "path": "schemas/public-blocked-output.schema.json"
        },
        "example": {
          "id": "blocked_output",
          "path": "examples/public-blocked-output.json"
        },
        "consumer_use_ids": [
          "project_blocked"
        ]
      }
    ],
    "consumer_inputs": [
      {
        "id": "tools_upgraded_input",
        "consumer": {
          "kind": "stop",
          "id": "upgrade-tools-tools-upgraded"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "json_schema",
          "schema_id": "guru-upgrade-tools-stop-tools_upgraded-1.0",
          "path": "consumers/stop/production/upgrade-tools-tools_upgraded.schema.json"
        }
      },
      {
        "id": "resume_required_input",
        "consumer": {
          "kind": "skill",
          "id": "guru-upgrade-tools"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "skill_input",
          "interface_path": "trellis/skills/guru-team/packages/guru-upgrade-tools/interface.json",
          "input_kind": "structured_json",
          "profile_id": "resume"
        }
      },
      {
        "id": "rolled_back_input",
        "consumer": {
          "kind": "stop",
          "id": "upgrade-tools-rolled-back"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "json_schema",
          "schema_id": "guru-upgrade-tools-stop-rolled_back-1.0",
          "path": "consumers/stop/production/upgrade-tools-rolled_back.schema.json"
        }
      },
      {
        "id": "blocked_input",
        "consumer": {
          "kind": "stop",
          "id": "upgrade-tools-blocked"
        },
        "payload_kind": "structured_json",
        "contract": {
          "kind": "json_schema",
          "schema_id": "guru-upgrade-tools-stop-blocked-1.0",
          "path": "consumers/stop/production/upgrade-tools-blocked.schema.json"
        }
      }
    ],
    "projections": [
      {
        "id": "project_tools_upgraded",
        "exit_id": "tools_upgraded",
        "consumer_input_id": "tools_upgraded_input",
        "operation": "direct"
      },
      {
        "id": "project_resume_required",
        "exit_id": "resume_required",
        "consumer_input_id": "resume_required_input",
        "operation": "select",
        "mappings": [
          {
            "source": "profile",
            "target": "profile"
          },
          {
            "source": "recovery_ref",
            "target": "recovery_ref"
          }
        ]
      },
      {
        "id": "project_rolled_back",
        "exit_id": "rolled_back",
        "consumer_input_id": "rolled_back_input",
        "operation": "direct"
      },
      {
        "id": "project_blocked",
        "exit_id": "blocked",
        "consumer_input_id": "blocked_input",
        "operation": "direct"
      }
    ],
    "private_artifacts": [
      {
        "id": "tools_recovery",
        "kind": "runtime_checkpoint",
        "schema": {
          "schema_id": "guru-upgrade-tools-private-recovery-1.0",
          "path": "schemas/private-recovery.schema.json"
        },
        "persistence": "ignored_runtime"
      }
    ]
  }
}
