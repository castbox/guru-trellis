{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-root-cause-input-author-candidate-set-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "caller",
    "target_locator",
    "target",
    "candidate_refs",
    "candidate_locators"
  ],
  "properties": {
    "profile": {
      "const": "author_candidate_set"
    },
    "mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "caller": {
      "const": "guru-author-task-plan"
    },
    "target_locator": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_locator",
        "task_ref",
        "author_paths",
        "author_identity"
      ],
      "properties": {
        "repo_locator": {
          "type": "string",
          "minLength": 1
        },
        "task_ref": {
          "type": "string",
          "minLength": 1
        },
        "author_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "author_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "candidate_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidate_locators": {
      "$ref": "#/$defs/candidateLocators"
    }
  },
  "$defs": {
    "candidateLocators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_ref",
          "locators"
        ],
        "properties": {
          "candidate_ref": {
            "type": "string",
            "minLength": 1
          },
          "locators": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
