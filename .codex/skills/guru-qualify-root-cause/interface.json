  "validators": [
    {
      "id": "root_cause_qualification_recorder",
      "command": "scripts/record-root-cause-qualification.sh",
      "runtime_command": "record-root-cause-qualification",
      "objective_scope": "stdin-only closed shape, profile and caller identity, exact candidate coverage, enums, AI-authored gate shape, exit and unique consumer binding, and call-local digests; no mechanism judgment or file write"
    },
    {
      "id": "root_cause_qualification_checker",
      "command": "scripts/check-root-cause-qualification.sh",
      "runtime_command": "check-root-cause-qualification",
      "objective_scope": "stdin-only recorded shape, current repository and Git identities, safe locators, exact digests, enums, and consumer binding; no mechanism, architecture, sufficiency, severity, decision, or route judgment"
    },
    {
      "id": "public_invocation",
      "command": "scripts/invoke.sh",
      "runtime_command": "invoke-guru-qualify-root-cause",
      "objective_scope": "validate one call-local semantic envelope in memory and serialize one schema-valid typed exit on stdout without a result locator, checkpoint, temporary file, or repository write"
    }
  ],
  "external_exits": [
    {
      "id": "classified",
      "evidence": "AI qualified the goal-specific candidate set; stage review remains separate.",
      "consumer": {
        "kind": "workflow",
        "id": "guru-root-cause-classified-router"
      }
    },
    {
      "id": "mechanism_revision_required",
      "evidence": "AI identified symptom suppression requiring removal or replacement.",
      "consumer": {
        "kind": "workflow",
        "id": "guru-root-cause-mechanism-router"
      }
    },
    {
      "id": "diagnosis_required",
      "evidence": "AI identified missing causal evidence for a claimed root-cause fix.",
      "consumer": {
        "kind": "workflow",
        "id": "guru-root-cause-diagnosis-router"
      }
    },
    {
      "id": "blocked",
      "evidence": "AI identified a concrete unavailable authority or external evidence.",
      "consumer": {
        "kind": "stop",
        "id": "root-cause-qualification-blocked"
      }
    }
  ],
  "reentry": {
    "identity": "profile, fixed caller, mode, current target, candidate refs and locators, current semantic decisions and witnesses, AI gate, typed exit, and unique consumer",
    "freshness": "call-local validation; stale facts reenter automatically; downstream owner consumes applicable same-mechanism conclusions and independently reviews its stage",
    "stale_behavior": "fail_closed"
  },
  "tests": [
    "tests/test_contract.py",
    "tests/test_runtime.py"
  ],
