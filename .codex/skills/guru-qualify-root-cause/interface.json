{
  "$schema": "../../schemas/skill-interface-1.6.schema.json",
  "schema_version": "1.6",
  "id": "guru-qualify-root-cause",
  "name": "guru-qualify-root-cause",
  "description": "Qualify new or materially changed incident mechanisms against first-failure, causal, counterfactual and protection evidence while allowing bounded diagnosis and mitigation.",
  "state": "active",
  "judgment_mode": "semantic",
  "modes": {
    "workflow": {
      "routing": "global_workflow",
      "entry_precondition_ids": [
        "runtime_dependency",
        "profile_binding",
        "live_authority",
        "candidate_set",
        "invocation_freshness"
      ]
    },
    "standalone": {
      "routing": "direct_discovery",
      "entry_precondition_ids": [
        "runtime_dependency",
        "profile_binding",
        "live_authority",
        "candidate_set",
        "invocation_freshness"
      ]
    }
  },
  "entry_preconditions": [
    {
      "id": "runtime_dependency",
      "evidence": "installed extension manifest, dispatcher, active package inventory, and declared stdin-only runtime commands",
      "binding": "complete compatible Guru Team preset runtime",
      "freshness": "run-skill-command validates the managed package before every invocation"
    },
    {
      "id": "profile_binding",
      "evidence": "one of ten closed input profiles with its fixed caller, mode, current target identity, and resume mapping",
      "binding": "the exact semantic Owner that is about to promote a candidate into a stage judgment",
      "freshness": "the caller authors a new closed input for every invocation"
    },
    {
      "id": "live_authority",
      "evidence": "current accepted scope, RDT/Architecture, code, tests and available incident evidence read through candidate locators; upstream normal/solution outcomes consumed by caller",
      "binding": "the current target and supported normal action path reviewed directly by the qualification AI",
      "freshness": "the AI rereads live sources and the checker validates current structural and Git identities"
    },
    {
      "id": "candidate_set",
      "evidence": "non-empty unique candidate refs with exactly one locator set and one AI-authored decision per candidate",
      "binding": "one invocation-local candidate set, with no worker severity or route authority",
      "freshness": "candidate, locator, decision, and AI gate ref sets must match exactly"
    },
    {
      "id": "invocation_freshness",
      "evidence": "call-local input digest, semantic result digest, current Git identities, typed exit, and unique consumer binding",
      "binding": "one stdin/stdout invocation with no repository result state",
      "freshness": "reread current facts; only new or materially changed mechanisms require fresh qualification; stage change alone does not invalidate an applicable conclusion"
    }
  ],
  "runtime_dependency": {
    "extension_id": "guru-team",
    "api_version": "1.0",
    "manifest_path": ".trellis/guru-team/extension.json",
    "dispatcher": "run-skill-command",
    "distribution": "guru-team-preset",
    "package_portability": "not-self-contained"
  },
  "ordered_stages": [
    "forward_behavior",
    "ai_review_gate",
    "conditional_human_confirmation",
    "recorder_validator",
    "typed_exit"
  ],
  "artifacts": [],
  "schemas": [
    {
      "id": "public_input_task_free_pre_write",
      "path": "schemas/public-task-free-pre-write-input.schema.json"
