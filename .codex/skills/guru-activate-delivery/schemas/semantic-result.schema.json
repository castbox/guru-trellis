{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-activate-delivery-semantic-result-delivery-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "typed_exit",
    "reason"
  ],
  "properties": {
    "typed_exit": {
      "enum": [
