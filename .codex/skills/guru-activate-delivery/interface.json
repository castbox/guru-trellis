  "state": "active",
  "judgment_mode": "semantic",
  "modes": {
    "workflow": {
      "routing": "global_workflow",
      "entry_precondition_ids": [
        "public_delivery",
        "semantic_result"
      ]
    },
    "standalone": {
      "routing": "direct_discovery",
      "entry_precondition_ids": [
        "public_delivery",
        "semantic_result"
      ]
    }
  },
  "entry_preconditions": [
    {
      "id": "public_delivery",
      "evidence": "Installed Task schema 2.0 and Delivery API 1.0, current task scope and exact session selection Scope revision instead consumes original Clarify current accepted scope and this current-stage semantic slice judgment; stale downstream gates are not prerequisites.",
      "binding": "One Task generation and explicit Delivery identity",
      "freshness": "Read public query before each operation"
    },
    {
      "id": "semantic_result",
      "evidence": "Current same-owner slice judgment or reviewed plan with current AI gate Scope revision instead consumes original Clarify current accepted scope and this current-stage semantic slice judgment; stale downstream gates are not prerequisites.",
      "binding": "Exact input and actual authority",
      "freshness": "Fresh semantic judgment before new operation; same operation recovery reuses only applicable factual result"
    }
  ],
