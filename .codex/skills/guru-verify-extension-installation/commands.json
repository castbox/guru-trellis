{
  "schema_version": "1.0",
  "package_id": "guru-verify-extension-installation",
  "commands": [
    {
      "id": "execute-extension-verification",
      "owner": "guru-verify-extension-installation",
      "entrypoint": "runtime/execute.py",
      "arguments": [
        {
          "flag": "--root",
          "required": false,
          "kind": "string",
          "description": "Source root.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--input",
          "required": true,
          "kind": "json",
          "description": "Standalone input.",
          "repeatable": false,
          "conflicts": []
        },
        {
          "flag": "--capability",
          "required": true,
          "kind": "enum",
          "values": [
            "initial_install",
            "workflow_marketplace",
            "preset_overlay",
            "upgrade_update",
            "platform_projection"
          ],
          "description": "Capability.",
          "repeatable": false,
          "conflicts": []
        }
      ],
      "stdin": "optional_json",
      "stdout": "single_json_object",
      "errors": [
        "invalid_arguments",
        "conflicting_arguments",
        "source_verification_failed",
        "internal_error"
      ],
      "side_effect": "git_write",
      "schema_bindings": [
        "schemas/public-source-repository-verification-input.schema.json"
      ],
      "validator_id": "verification_executor",
      "runtime_role": "execute"
    },
    {
