{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-production-approve-task-plan-input-clarification-reentry-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "mode", "task_ref", "source_exit", "reentry_reason"],
  "properties": {
    "profile": {"const": "clarification_reentry"},
    "mode": {"enum": ["workflow", "standalone"]},
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "source_exit": {"const": "clarify_scope"},
    "reentry_reason": {"const": "authority_refreshed"}
  }
}
