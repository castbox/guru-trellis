{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-consumer-guru-approve-task-plan-approved-delivery-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "task_ref",
    "planning_result_id",
    "delivery_key"
  ],
  "properties": {
    "exit_id": {
      "const": "approved"
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "planning_result_id": {
      "type": "string",
      "pattern": "^planning:[0-9a-f]{64}$"
    },
    "delivery_key": {
      "type": "object",
      "description": "Opaque upstream DeliveryKey; validated by the installed public API."
    }
  }
}
