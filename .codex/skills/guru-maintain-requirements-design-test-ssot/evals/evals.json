  "schema_version": "1.0",
  "skill_name": "guru-maintain-requirements-design-test-ssot",
  "evals": [
    {
      "id": "bootstrap-incomplete",
      "prompt": "The Requirements authority exists but the Test layer is absent; return baseline_incomplete after semantic review.",
      "expected_exit": "baseline_incomplete",
      "expected_output": "The incomplete authority routes to controlled bootstrap.",
      "input_profile_id": "bootstrap_foundation",
      "files": [
        "evals/files/bootstrap-incomplete-input.json",
        "evals/files/bootstrap-incomplete-facts.json"
      ],
      "assertions": {
        "deterministic": [
          {
            "id": "expected-route",
            "kind": "json_path",
            "pointer": "/exit_id",
            "operation": "equals",
            "expected": "baseline_incomplete"
          }
        ]
      }
    },
    {
      "id": "impact-current",
      "prompt": "The task changes no Requirements, Design, or Test authority; return ssot_current.",
      "expected_exit": "ssot_current",
      "expected_output": "The current authority returns to the current router.",
      "input_profile_id": "task_impact_sync",
      "files": [
        "evals/files/impact-current-input.json",
        "evals/files/impact-current-facts.json"
      ],
      "assertions": {
        "deterministic": [
          {
            "id": "expected-route",
            "kind": "json_path",
            "pointer": "/exit_id",
            "operation": "equals",
            "expected": "ssot_current"
          }
        ]
      }
    },
    {
