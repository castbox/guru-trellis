      "prompt": "After the confirmed promotion side effect, the traceable isolated contribution is reflected in canonical current authority; return ssot_current.",
      "expected_exit": "ssot_current",
      "expected_output": "Completed promotion returns the current authority to the workflow router.",
      "input_profile_id": "promotion",
