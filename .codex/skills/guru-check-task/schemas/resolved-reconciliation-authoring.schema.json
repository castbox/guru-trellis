{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-check-task-resolved-reconciliation-authoring-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "mode", "branch", "selected_base_ref", "old_base_head", "new_base_head", "merge_head", "stage0_tree", "index_tree_sha256", "parent_order", "commit_message", "resume_target"],
  "properties": {
    "profile": {"const": "resolved_candidate"},
    "mode": {"enum": ["workflow", "standalone"]},
    "branch": {"type": "string", "minLength": 1},
    "selected_base_ref": {"type": "string", "minLength": 1},
    "old_base_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "new_base_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "merge_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "stage0_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "index_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent_order": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}},
    "commit_message": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\r\\n]+$"},
    "resume_target": {"const": "branch_review"}
  }
}
