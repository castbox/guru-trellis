{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-check-task-output-delivery-passed-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "task_ref",
    "delivery_key",
    "check_result_id"
  ],
  "properties": {
    "exit_id": {
      "const": "passed"
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "delivery_key": {
      "type": "object"
    },
    "check_result_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
