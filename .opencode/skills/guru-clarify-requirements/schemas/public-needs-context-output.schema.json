{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-stage0-clarify-requirements-output-needs-context-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "handoff_profile",
    "handoff_mode",
    "handoff_repo_locator",
    "handoff_base_branch",
    "handoff_continuation_id",
    "transition"
  ],
  "properties": {
    "exit_id": {
      "const": "needs_context"
    },
    "handoff_profile": {
      "const": "pre_task"
    },
    "handoff_mode": {
      "enum": [
        "workflow",
        "standalone"
      ]
    },
    "handoff_repo_locator": {
      "type": "string",
      "minLength": 1
    },
    "handoff_base_branch": {
      "type": "string",
      "minLength": 1
    },
    "handoff_continuation_id": {
      "type": "string",
      "minLength": 1
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "transition_id", "stage", "mode", "repo_locator", "base"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "transition_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]+$"},
        "stage": {"const": "base_current"},
        "mode": {"enum": ["workflow", "standalone"]},
        "repo_locator": {"type": "string", "minLength": 1},
        "base": {"$ref": "#/$defs/base"}
      }
    }
  },
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "selected_base", "remote", "ordered_candidates", "decision_head", "local_base_head", "remote_base_head", "post_sync_resolution_sha256"],
      "properties": {
        "source": {"enum": ["explicit", "config", "config-candidate", "remote-default"]},
        "selected_base": {"type": "string", "minLength": 1},
        "remote": {"type": "string", "minLength": 1},
        "ordered_candidates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "decision_head": {"$ref": "#/$defs/sha40"},
        "local_base_head": {"$ref": "#/$defs/sha40"},
        "remote_base_head": {"$ref": "#/$defs/sha40"},
        "post_sync_resolution_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
