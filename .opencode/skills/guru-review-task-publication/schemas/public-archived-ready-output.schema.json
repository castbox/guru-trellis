{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-production-review-task-publication-output-archived-ready-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_id",
    "task_ref",
    "branch_review_commit",
    "pr_title",
    "pr_body",
    "reviewed_base_head"
  ],
  "properties": {
    "exit_id": {
      "const": "archived_ready"
    },
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/archive/[0-9]{4}-[0-9]{2}/[A-Za-z0-9._-]+$"
    },
    "branch_review_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "pr_title": {
      "type": "string",
      "minLength": 1
    },
    "pr_body": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_base_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
