{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-architecture-baseline-input-impact-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "source_exit", "mode", "continuation_id", "stage", "task_locator", "baseline", "constitution", "project_contract", "freshness_identity", "requirement_authority", "behavior_authority"],
  "properties": {
    "schema_version": {"const": "2.0"}, "profile": {"const": "task_impact_sync"}, "source_exit": {"type": "string", "minLength": 1}, "mode": {"enum": ["workflow", "standalone"]}, "continuation_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["planning", "implementation_discovery", "phase2", "branch_review", "publication", "acceptance_finish"]}, "task_locator": {"type": "string", "minLength": 1},
    "baseline": {"type": "object", "additionalProperties": false, "required": ["locator", "identity", "status"], "properties": {"locator": {"type": "string", "minLength": 1}, "identity": {"type": "string", "minLength": 1}, "status": {"const": "active"}}},
    "constitution": {"$ref": "#/$defs/constitution"},
    "project_contract": {"type": "object", "additionalProperties": false, "required": ["guru_contract_identity", "change_contract_locator", "change_contract_identity", "required_concern_set_identity"], "properties": {"guru_contract_identity": {"const": "guru-maintain-architecture-baseline:2.0"}, "change_contract_locator": {"type": "string", "minLength": 1}, "change_contract_identity": {"type": "string", "minLength": 1}, "required_concern_set_identity": {"type": "string", "minLength": 1}}},
    "freshness_identity": {"type": "string", "minLength": 1}, "requirement_authority": {"type": "string", "minLength": 1}, "behavior_authority": {"type": "string", "minLength": 1},
    "committed_range": {"$ref": "#/$defs/committedRange"}
  },
  "allOf": [
    {
      "if": {"properties": {"stage": {"const": "branch_review"}}, "required": ["stage"]},
      "then": {"required": ["committed_range"]},
      "else": {"not": {"required": ["committed_range"]}}
    }
  ],
  "$defs": {
    "committedRange": {"type": "object", "additionalProperties": false, "required": ["base_ref", "base_head", "review_head"], "properties": {"base_ref": {"type": "string", "minLength": 1}, "base_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "review_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "constitution": {"type": "object", "additionalProperties": false, "required": ["authority_locator", "authority_status", "identity_kind", "identity", "principles"], "properties": {"authority_locator": {"type": "string", "minLength": 1}, "authority_status": {"enum": ["current", "pending_reviewed_promotion"]}, "identity_kind": {"enum": ["version", "content"]}, "identity": {"type": "string", "minLength": 1}, "principles": {"$ref": "#/$defs/principles"}}},
    "principles": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"oneOf": [{"$ref": "#/$defs/p1"}, {"$ref": "#/$defs/p2"}, {"$ref": "#/$defs/p3"}, {"$ref": "#/$defs/p4"}, {"$ref": "#/$defs/p5"}]},
      "allOf": [
        {"contains": {"$ref": "#/$defs/p1"}},
        {"contains": {"$ref": "#/$defs/p2"}},
        {"contains": {"$ref": "#/$defs/p3"}},
        {"contains": {"$ref": "#/$defs/p4"}},
        {"contains": {"$ref": "#/$defs/p5"}}
      ]
    },
    "p1": {"type": "object", "additionalProperties": false, "required": ["id", "short_name"], "properties": {"id": {"const": "mature-practice-applicability"}, "short_name": {"const": "成熟实践与适用性"}}},
    "p2": {"type": "object", "additionalProperties": false, "required": ["id", "short_name"], "properties": {"id": {"const": "concept-semantic-completeness"}, "short_name": {"const": "概念与语义完整性"}}},
    "p3": {"type": "object", "additionalProperties": false, "required": ["id", "short_name"], "properties": {"id": {"const": "cohesion-change-isolation"}, "short_name": {"const": "职责内聚与变化隔离"}}},
    "p4": {"type": "object", "additionalProperties": false, "required": ["id", "short_name"], "properties": {"id": {"const": "minimum-necessary-complexity"}, "short_name": {"const": "最小必要复杂度"}}},
    "p5": {"type": "object", "additionalProperties": false, "required": ["id", "short_name"], "properties": {"id": {"const": "debt-one-way-convergence"}, "short_name": {"const": "技术债务单向收敛"}}}
  }
}
