{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guru-production-check-task-input-initial-check-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "mode", "task_ref", "source_exit"],
  "properties": {
    "profile": {"const": "initial_check"},
    "mode": {"enum": ["workflow", "standalone"]},
    "task_ref": {
      "type": "string",
      "pattern": "^\\.trellis/tasks/[A-Za-z0-9._/-]+$"
    },
    "source_exit": {"const": "implementation_complete"}
  }
}
